#!/bin/sh
# Keep vendored submodules tracking their remote branch tip after every
# checkout, so nobody has to remember to run `git submodule update` by hand.
git submodule update --init --remote --recursive --merge

# Keep the vendored JellyUI submodule on its main branch (never detached).
if ! git -C Vendor/JellyUI symbolic-ref -q HEAD >/dev/null 2>&1; then
	if git -C Vendor/JellyUI merge-base --is-ancestor main HEAD >/dev/null 2>&1; then
		git -C Vendor/JellyUI branch -f main HEAD
	fi
	if git -C Vendor/JellyUI merge-base --is-ancestor HEAD main >/dev/null 2>&1; then
		git -C Vendor/JellyUI checkout main >/dev/null 2>&1
	else
		echo "WARNING: JellyUI HEAD diverged from main - left detached" >&2
	fi
fi
exit 0
