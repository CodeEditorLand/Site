#!/bin/sh
# Keep vendored submodules tracking their remote branch tip after every
# pull/merge, so nobody has to remember to run `git submodule update` by hand.
git submodule update --init --remote --recursive --merge

# Keep the vendored JellyUI submodule on its main branch (never detached).
# The hook fires both at the parent root (WebSite checkout/merge) and inside
# the submodule itself (a checkout triggered by submodule update / the vendor
# build script) - resolve the target repo from the hook's actual root.
case "$(git rev-parse --show-toplevel 2>/dev/null)" in
	*/Vendor/JellyUI) Jelly="." ;;
	*) Jelly="Vendor/JellyUI" ;;
esac
if ! git -C "$Jelly" symbolic-ref -q HEAD >/dev/null 2>&1; then
	if git -C "$Jelly" merge-base --is-ancestor main HEAD >/dev/null 2>&1; then
		git -C "$Jelly" branch -f main HEAD
	fi
	if git -C "$Jelly" merge-base --is-ancestor HEAD main >/dev/null 2>&1; then
		git -C "$Jelly" checkout main >/dev/null 2>&1
	else
		echo "WARNING: JellyUI HEAD diverged from main - left detached" >&2
	fi
fi
exit 0
