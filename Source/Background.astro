---

<div id="Layout">
	<!-- Topographic contour map — the product is called "Land" -->
	<svg
		id="TopoMap"
		viewBox="0 0 1440 900"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
		preserveAspectRatio="xMidYMid slice"
	>
		<!-- Main peak — upper right -->
		<ellipse
			cx="1080"
			cy="260"
			rx="100"
			ry="58"
			transform="rotate(-18 1080 260)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.12"></ellipse>
		<ellipse
			cx="1080"
			cy="260"
			rx="200"
			ry="118"
			transform="rotate(-14 1080 260)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.09"></ellipse>
		<ellipse
			cx="1080"
			cy="260"
			rx="320"
			ry="192"
			transform="rotate(-10 1080 260)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.07"></ellipse>
		<ellipse
			cx="1080"
			cy="260"
			rx="460"
			ry="278"
			transform="rotate(-6 1080 260)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.05"></ellipse>
		<ellipse
			cx="1080"
			cy="260"
			rx="620"
			ry="370"
			transform="rotate(-3 1080 260)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.03"></ellipse>
		<ellipse
			cx="1080"
			cy="260"
			rx="800"
			ry="474"
			transform="rotate(-1 1080 260)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.02"></ellipse>

		<!-- Secondary peak — lower left -->
		<ellipse
			cx="280"
			cy="680"
			rx="75"
			ry="48"
			transform="rotate(22 280 680)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.10"></ellipse>
		<ellipse
			cx="280"
			cy="680"
			rx="160"
			ry="102"
			transform="rotate(17 280 680)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.08"></ellipse>
		<ellipse
			cx="280"
			cy="680"
			rx="270"
			ry="170"
			transform="rotate(12 280 680)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.06"></ellipse>
		<ellipse
			cx="280"
			cy="680"
			rx="400"
			ry="248"
			transform="rotate(7 280 680)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.04"></ellipse>
		<ellipse
			cx="280"
			cy="680"
			rx="550"
			ry="336"
			transform="rotate(3 280 680)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.02"></ellipse>

		<!-- Tertiary saddle — center bottom -->
		<ellipse
			cx="720"
			cy="820"
			rx="60"
			ry="30"
			transform="rotate(5 720 820)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.07"></ellipse>
		<ellipse
			cx="720"
			cy="820"
			rx="140"
			ry="68"
			transform="rotate(3 720 820)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.05"></ellipse>
		<ellipse
			cx="720"
			cy="820"
			rx="260"
			ry="124"
			transform="rotate(1 720 820)"
			fill="none"
			stroke="currentColor"
			stroke-width="1"
			opacity="0.03"></ellipse>
	</svg>
</div>

<style>
	@import "./Background/Stylesheet.css";
</style>

<script>
	(() => {
		const Layout = document.querySelector<HTMLDivElement>("#Layout");
		if (!Layout) return;
		Layout.classList.add("Load");
	})();
</script>
