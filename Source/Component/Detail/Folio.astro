---
/**
 * Folio - where in the document the reader has got to, and what is here.
 *
 * ─── WHY THIS BLOCK EXISTS ────────────────────────────────────────────────
 * Every band ends and the reader is otherwise nowhere: the running head says
 * which part of the document they are in, and nothing says which band, how much
 * of it there is, or when it was read. A printed page answers all three at its
 * foot, in one line, and that line is the cheapest apparatus a document has.
 *
 *   〈03〉 /LEGAL␁26 CLAUSES␁AS OF: 2026-11-18
 *
 * ─── THE GRAMMAR IT KEEPS ─────────────────────────────────────────────────
 * - The ordinal is CONTAINED: `〈03〉` is the grammar's containment bracket
 *   around a literal. A folio is a literal that identifies a place.
 * - The part is a `/ROUTE`-form label, because a part of the document is a place
 *   in the document.
 * - The separators are U+2001 and they are drawn by the stylesheet, never typed
 *   into the template: a template's newline beside U+2001 becomes a 200px gap,
 *   which the clause rail's head already paid for once.
 * - The as-of is printed only when the caller has one. A folio that invented a
 *   date would be the one figure on the page with no source.
 *
 * ─── EVERY FACT CARRIES ITS KIND ──────────────────────────────────────────
 * The right end is not one string: each field is its own span and its `kind` is
 * its slot (`count`, `figure`, `as-of`, `source`). The stylesheet needs the
 * kinds because they do not all behave alike at a narrow band: a count, a figure
 * and an as-of are unbreakable groups, and the source - a path, which is data -
 * is the one field that may break inside itself. A single `__count` class on all
 * four would have made the count breakable to save the path, which is the wrong
 * trade (a figure broken across two lines is two figures).
 *
 * The `<wbr>` after each `/` is the path's own break point: it is zero-width, it
 * is not part of the copied text, and it keeps a long `SOURCE:` fact breaking at
 * its separators instead of at whatever character happens to land at the edge.
 *
 * ─── THE PART IS A PATH TOO ───────────────────────────────────────────────
 * A `nowrap` part runs past the band's right edge on a deep page
 * (`/DOC/DEEP-DIVE-FILESYSTEM-FOOTPRINT`), which is the one thing a folio may
 * never do: it is the mark that says the band has ended. So the part carries the
 * same `<wbr>` after every `/` that the source carries, and the ordinal and the
 * part still never part company, because the place group stays `nowrap` between
 * them and only the part wraps inside itself.
 *
 * ─── NO SCRIPT ────────────────────────────────────────────────────────────
 * No `<script>`, no `client:*`. A folio is printed.
 */
import type { DetailFigure } from "./Type.js";

interface Props {
	/** The band's ordinal, as a two-digit string: `03`. */
	index: string;

	/** The part of the document: `/LEGAL`, `/THE EDITION`. */
	part: string;

	/** What the band holds, as a figure with its unit: `26` / `CLAUSES`. */
	figure?: DetailFigure;

	/** What the band holds, when it is not a number: `UNPUBLISHED`. */
	count?: string;

	/** The date the band's facts were read (`YYYY-MM-DD`). */
	asOf?: string;

	/** The file the facts were read from. */
	source?: string;

	/** Extra classes from the page. */
	class?: string;
}

const { index, part, figure, count, asOf, source, class: Class } = Astro.props;

/** One field of the right end: its slot, and the string it prints. */
type Fact = {
	readonly kind: "count" | "figure" | "as-of" | "source";
	readonly text: string;
};

/**
 * The right end's fields, in the order they are read. Each is its own span so
 * the stylesheet can set the figure tabular without touching the words, and so
 * the source alone can carry the path's break points.
 */
const Facts: Fact[] = [
	count !== undefined ? { kind: "count", text: count } : undefined,
	figure
		? { kind: "figure", text: `${figure.value} ${figure.unit}` }
		: undefined,
	asOf ? { kind: "as-of", text: `AS OF: ${asOf}` } : undefined,
	source ? { kind: "source", text: `SOURCE: ${source}` } : undefined,
].filter((Entry): Entry is Fact => Entry !== undefined);
---

<p class:list={["detail-folio", Class]}>
	<span class="detail-folio__place">
		<span class="detail-folio__index">{`〈${index}〉`}</span>
		{/* The part is a route, and a route is a path: a folio on a deep page
		    prints `/DOC/DEEP-DIVE-FILESYSTEM-FOOTPRINT`, which at 26 tracked
		    glyphs is wider than the band it closes. It breaks at its own `/`
		    separators - the same `<wbr>` the source carries, for the same
		    reason - so the part wraps inside itself instead of running past the
		    band's right edge. A short part has no break taken. */}
		<span class="detail-folio__part">
			{part
				.split("/")
				.map((Segment, Position, Segments) =>
					Position < Segments.length - 1
						? [Segment, "/", <wbr />]
						: [Segment],
				)}
		</span>
	</span>

	{Facts.length > 0 && (
		<span class="detail-folio__facts">
			{Facts.map((Field) => (
				<span
					class:list={[
						"detail-folio__fact",
						`detail-folio__${Field.kind}`,
					]}
				>
					{Field.kind === "source"
						? Field.text
								.split("/")
								.map((Segment, Position, Segments) =>
									Position < Segments.length - 1
										? [Segment, "/", <wbr />]
										: [Segment],
								)
						: Field.text}
				</span>
			))}
		</span>
	)}
</p>
