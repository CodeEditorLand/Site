---
/**
 * BlogArticle - the reading surface an article is read on.
 *
 * ─── THE COMPOSITION (the margin channel) ────────────────────────────────
 * The piece is the page; its apparatus is printed in the margin beside it. The
 * workspace is three tracks - the piece at 8, a 1px divider, the margin at 4 -
 * and the margin carries four things in reading order:
 *
 *   1. the summary (`RecordLedger`): who filed it, when, how long it takes,
 *      what it is tagged, how many sections it has;
 *   2. the section register (`ON THIS PAGE`), the article's own `##` headings;
 *   3. the margin notes (`RecordMargin`): the date, the manual page that keeps
 *      the subject current, and where a correction goes;
 *   4. the folded aside (`RecordAside`): what the piece does not cover.
 *
 * The first two are ONE object and it is the one that stays with the reader
 * (`.blog-article__pinned`): the register answers "where am I in this piece" for
 * as long as the piece is being read, and the summary's plate is five facts read
 * once. Pinned on its own the plate covered the register from the moment it
 * pinned - the margin's navigation hidden exactly while it was needed - and two
 * stickies cannot be stacked without knowing the first one's height, so the
 * wrapper is here rather than in the stylesheet.
 *
 * This is the first page on the site composed this way. The legal documents put
 * their clause rail on the *left* and it is navigation; the manual's rail is
 * navigation too. This margin is *annotation*: nothing in it moves the reader
 * somewhere else except the register's own anchors and the notes' destinations,
 * and the summary and the register stay with the reader while the piece scrolls
 * past them. A page whose margin is apparatus reads as a document someone
 * marked up, which is the whole brief.
 *
 * Below 1024px the channel is re-composed, not squeezed: the piece takes the
 * full measure, the margin becomes a ruled section under it (summary, register,
 * notes, aside), and nothing is pinned - the unit is a stacked pair there.
 * Nothing is hidden and nothing is reduced - the same four things, in the same
 * order, one column.
 *
 * ─── THE SHELL'S FOUR RULES ──────────────────────────────────────────────
 * - **One `h1`.** The title is the page's only level-one heading. The article's
 *   markdown therefore opens at `##`: a file that carries its own `# ` line
 *   produces a second `h1` the moment the shell renders the title.
 * - **The opening is the baseline's opening.** A row of tag chips, the title,
 *   the summary as a standfirst, and one mono metadata row: the author, the
 *   publication date and the reading time, separated by U+2001 EM QUAD. The
 *   summary ledger in the margin *repeats* those facts on purpose - the opening
 *   is what a reader meets, the ledger is what stays with them - and the two
 *   print from one source, so they cannot disagree.
 * - **One measure.** The body is capped at `--Measure` (the plate, 72-88ch,
 *   fluid on the window) and the opening at `--MeasureOpening` (62ch).
 * - **The contents list is generated, never hand-written.** `BuildToc` reads the
 *   pipeline's own slugs, so an anchor can never drift from its heading, and an
 *   article below the heading floor gets no register at all - it gets the
 *   sentence that says why, which is the composed empty state.
 *
 * The body is `.prose-flow`: the site's one paragraph rhythm, opening on a
 * hairline. No script and no hydration directive.
 */
import ContactBreadcrumb from "../Contact/ContactBreadcrumb.astro";
import RecordAside from "../Record/RecordAside.astro";
import RecordInset from "../Record/RecordInset.astro";
import RecordLedger from "../Record/RecordLedger.astro";
import RecordMargin from "../Record/RecordMargin.astro";
import type { Register as RegisterShape } from "../Record/RegisterLine.js";

import type { Aside, Inset, LedgerRow, MarginNote } from "../Record/Type.js";
import type { BlogToc, BlogTrailItem } from "./Type.js";

interface Props {
	/** The article's `title`. The page's only `h1`. */
	title: string;

	/** The article's `summary`, at standfirst weight. */
	summary: string;

	/** The article's `tags`, in the order the frontmatter gives them. */
	tags: readonly string[];

	/** The article's `author`, verbatim. */
	author: string;

	/** `publishedAt` verbatim, `YYYY-MM-DD`. */
	date: string;

	/** The finished reading-time label, e.g. `5 min read`. */
	readTime: string;

	/** The article's `##` headings, or `null` below the floor. */
	toc?: BlogToc | null;

	/** The trail above the article. The last crumb is this page. */
	trail: readonly BlogTrailItem[];

	/** The way back to the index, at the foot of the article. */
	backLabel: string;

	/** Its target. */
	backHref: string;

	/**
	 * The margin's summary: the article's own facts as ledger rows. The page
	 * derives them from the same frontmatter the opening prints, so the two
	 * cannot disagree.
	 */
	summaryRows: readonly LedgerRow[];

	/**
	 * The register line above the summary: a `Register`, not a string -
	 * `RegisterOf("SUMMARY", summaryRows)`. The shape carries the count, and the
	 * ledger recomposes it from the rows it prints, so the line cannot outlive
	 * the facts under it.
	 */
	summaryRegister: RegisterShape;

	/** The margin notes, in the order they hang. */
	notes: readonly MarginNote[];

	/**
	 * The margin's figures: the piece's own extent, drawn. They hang above the
	 * notes because a figure is evidence and a note is a claim about it - and
	 * because an inset is the taller object, so the margin's reading order is
	 * tallest first, exactly as the column's is.
	 */
	insets?: readonly Inset[];

	/** The folded aside: what the piece does not cover. Absent, no aside prints. */
	aside?: Aside | null;

	/**
	 * What the register says when the article has too few sections to list. A
	 * `null` toc prints this instead of an empty list.
	 */
	registerEmpty: string;
}

const {
	title,
	summary,
	tags,
	author,
	date,
	readTime,
	toc,
	trail,
	backLabel,
	backHref,
	summaryRows,
	summaryRegister,
	notes,
	insets = [],
	aside,
	registerEmpty,
} = Astro.props;

/**
 * The three facts of the metadata row, in the order the baseline printed them.
 * The date keeps its `<time>` element so the machine value and the printed value
 * can never disagree; the two separators are the only visual separator the site
 * permits (U+2001 EM QUAD).
 */
const Meta = [
	{ kind: "text" as const, value: author },
	{ kind: "separator" as const, value: "\u2001" },
	{ kind: "date" as const, value: date },
	{ kind: "separator" as const, value: "\u2001" },
	{ kind: "text" as const, value: readTime },
];
---

<article class="blog-article">
	<ContactBreadcrumb trail={trail} class="blog-article__trail" />

	<header class="blog-article__head">
		{tags.length > 0 ? (
			<ul class="blog-article__tags">
				{tags.map((Tag) => (
					<li class="blog-article__tag">
						<jelly-badge
							variant="platinum"
							shape="square"
							style="--jelly-fill:var(--Mute);--jelly-label:var(--MuteForeground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
						>
							{Tag}
						</jelly-badge>
					</li>
				))}
			</ul>
		) : null}

		<h1 class="blog-article__title">{title}</h1>
		<p class="blog-article__standfirst">{summary}</p>

		<p class="blog-article__meta">
			{Meta.map((Part) =>
				Part.kind === "date" ? (
					<time class="blog-article__date" datetime={Part.value}>
						{Part.value}
					</time>
				) : Part.kind === "separator" ? (
					<span class="blog-article__separator" aria-hidden="true">
						{Part.value}
					</span>
				) : (
					<span class="blog-article__fact">{Part.value}</span>
				),
			)}
		</p>
	</header>

	<div class="blog-article__workspace">
		<div class="blog-article__main">
			<div class="blog-article__body prose-flow">
				<slot />
			</div>

			<p class="blog-article__back">
				<a href={backHref}>
					{backLabel}{"\u2001"}<span aria-hidden="true">←</span>
				</a>
			</p>
		</div>

		<div class="blog-article__gutter" aria-hidden="true"></div>

		<aside
			class="blog-article__margin"
			aria-label="Margin: summary and notes"
		>
			{/*
			 * The summary and the register are one pinned unit: the register is
			 * navigation and has to stay with the reader, the plate is five facts
			 * read once - and a plate pinned on its own covers the register for
			 * the whole piece. The wrapper exists because two stickies cannot be
			 * stacked without knowing the first one's height.
			 */}
			<div class="blog-article__pinned">
				<RecordLedger
					rows={summaryRows}
					register={summaryRegister}
				/>

				{toc ? (
					<nav class="blog-article__register" aria-label={toc.label}>
						<p class="blog-article__register-label">{toc.label}</p>
						<ol class="blog-article__register-list">
							{toc.items.map((Item) => (
								<li class="blog-article__register-item">
									<a
										class="blog-article__register-link"
										href={Item.href}
									>
										{Item.label}
									</a>
								</li>
							))}
						</ol>
					</nav>
				) : (
					<p class="blog-article__register-empty">
						<span
							class="blog-article__register-mark"
							aria-hidden="true"
						>
							&#9678;
						</span>
						{registerEmpty}
					</p>
				)}
			</div>

			{insets.map((Inset) => (
				<RecordInset inset={Inset} />
			))}

			{notes.map((Note) => (
				<RecordMargin note={Note} />
			))}

			{aside ? <RecordAside aside={aside} /> : null}
		</aside>
	</div>
</article>
