---
/**
 * BlogArticle - the reading surface an article is read on.
 *
 * The shell owns four things an article must not re-decide in markdown:
 *
 * - **One `h1`.** The title is the page's only level-one heading. The article's
 *   markdown therefore opens at `##`: a file that carries its own `# ` line
 *   produces a second `h1` the moment the shell renders the title, and two
 *   level-one headings on one page is the defect this shell exists to prevent.
 *   (The baseline rendered the title twice - once in the header, once as the
 *   prose body's first line - and the duplicate is deliberately not restored.)
 * - **The opening is the baseline's opening.** A row of tag chips, the title,
 *   the summary as a standfirst, and one mono metadata row: the author, the
 *   publication date and the reading time, separated by U+2001 EM QUAD. That
 *   row is the baseline's own; a key/value ledger was the shape it replaced.
 * - **One measure.** The body is capped at `72ch` and the opening at `62ch`, so
 *   the standfirst ends before the prose does and neither runs the full width of
 *   the container. The container itself is `band-inner`, the same gutters every
 *   band on the site uses, so an article lines up with the index that led to it.
 * - **The contents list.** `toc` is `null` for an article below the heading
 *   floor, and a `null` contents list renders no nav at all - never an empty one.
 *
 * The body is `.prose-flow`: the site's one paragraph rhythm, opening on a
 * hairline the way the baseline's `border-t pt-8` did. The markdown's own
 * elements are styled in this component's partial, except the code blocks, which
 * the markdown pipeline renders and this surface deliberately does not restyle.
 *
 * No script and no hydration directive. The diagram renderer, when an article
 * needs one, is the page's to mount.
 */
import ContactBreadcrumb from "../Contact/ContactBreadcrumb.astro";

import type { BlogToc, BlogTrailItem } from "./Type.js";

interface Props {
	/** The article's `title`. The page's only `h1`. */
	title: string;

	/** The article's `summary`, at standfirst weight. */
	summary: string;

	/** The article's `tags`, in the order the frontmatter gives them. */
	tags: readonly string[];

	/** The article's `author`, verbatim. */
	author: string;

	/** `publishedAt` verbatim, `YYYY-MM-DD`. */
	date: string;

	/** The finished reading-time label, e.g. `5 min read`. */
	readTime: string;

	/** The article's `##` headings, or `null` below the floor. */
	toc?: BlogToc | null;

	/** The trail above the article. The last crumb is this page. */
	trail: readonly BlogTrailItem[];

	/** The way back to the index, at the foot of the article. */
	backLabel: string;

	/** Its target. */
	backHref: string;
}

const {
	title,
	summary,
	tags,
	author,
	date,
	readTime,
	toc,
	trail,
	backLabel,
	backHref,
} = Astro.props;

/**
 * The three facts of the metadata row, in the order the baseline printed them.
 * The date keeps its `<time>` element so the machine value and the printed value
 * can never disagree; the two separators are the only visual separator the site
 * permits (U+2001 EM QUAD).
 */
const Meta = [
	{ kind: "text" as const, value: author },
	{ kind: "separator" as const, value: "\u2001" },
	{ kind: "date" as const, value: date },
	{ kind: "separator" as const, value: "\u2001" },
	{ kind: "text" as const, value: readTime },
];
---

<article class="blog-article">
	<ContactBreadcrumb trail={trail} class="blog-article__trail" />

	<header class="blog-article__head">
		{
			tags.length > 0 ? (
				<ul class="blog-article__tags">
					{tags.map((Tag) => (
						<li class="blog-article__tag">
							<jelly-badge
								variant="platinum"
								shape="square"
								style="--jelly-fill:var(--Mute);--jelly-label:var(--MuteForeground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
							>
								{Tag}
							</jelly-badge>
						</li>
					))}
				</ul>
			) : null
		}

		<h1 class="blog-article__title">{title}</h1>
		<p class="blog-article__standfirst">{summary}</p>

		<p class="blog-article__meta">
			{
				Meta.map((Part) =>
					Part.kind === "date" ? (
						<time class="blog-article__date" datetime={Part.value}>
							{Part.value}
						</time>
					) : Part.kind === "separator" ? (
						<span class="blog-article__separator" aria-hidden="true">
							{Part.value}
						</span>
					) : (
						<span class="blog-article__fact">{Part.value}</span>
					),
				)
			}
		</p>
	</header>

	{
		toc ? (
			<nav class="blog-article__toc" aria-label={toc.label}>
				<p class="blog-article__toc-label">{toc.label}</p>
				<ol class="blog-article__toc-list">
					{toc.items.map((Item) => (
						<li class="blog-article__toc-item">
							<a class="blog-article__toc-link" href={Item.href}>
								{Item.label}
							</a>
						</li>
					))}
				</ol>
			</nav>
		) : null
	}

	<div class="blog-article__body prose-flow">
		<slot />
	</div>

	<p class="blog-article__back">
		<a href={backHref}>{backLabel}<span aria-hidden="true"> ←</span></a>
	</p>
</article>
