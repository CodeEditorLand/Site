---
/**
 * BlogIndex - the blog's archive page: a centred header, a full-bleed plate of
 * the archive's extent, and the articles in a three-column grid.
 *
 * ─── THE COMPOSITION ─────────────────────────────────────────────────────
 * Three gears, and the page changes gear between them:
 *
 *   open     the trail and the centred header (the baseline's, unchanged)
 *   plate    a full-bleed instrument: `# BLOG / 08 ENTRIES` and four measured
 *            facts, edge to edge, with the caption in a channel beside it
 *   archive  the eight-card grid, on the baseline's measure
 *
 * The plate is the one full-width element on any page of the site that is not a
 * hero: its rules run to the viewport edge, its content stays on the container's
 * gutters, and its caption sits in a channel at the right rather than under it.
 * That is the gear change - a centred poster head, then a wide ruled plate, then
 * the grid - and it is why this page no longer reads as a header with cards
 * under it.
 *
 * The plate is a `RecordFigure` with its composed arm: the media is the page's
 * own register (a label and four `dt`/`dd` rows), not a picture. The information
 * type is evidence - *what this archive is, measured* - and a figure whose
 * evidence is its own figures is exactly what the block's caption channel was
 * built for. When the collection is empty the same plate prints the tombstone
 * (`STATUS: UNAVAILABLE`) instead of four zeroes: a zero is a claim, and an
 * empty archive is not zero entries of something.
 *
 * ─── THE GRID IS THE KEEPER ──────────────────────────────────────────────
 * Eight cards in `1 / 2 / 3` columns, each a whole-card link, the last row's
 * hole included. Nothing about the grid changed. The plate is added above it and
 * the header keeps its `mb-24`, so the first screen still shows the heading and
 * the top edge of the first row.
 *
 * No script and no hydration directive: the index is static.
 */
import RecordFigure from "../Record/RecordFigure.astro";
import Register from "../Record/Register.astro";
import type { Register as RegisterShape } from "../Record/RegisterLine.js";
import ContactBreadcrumb from "../Contact/ContactBreadcrumb.astro";

import type { BlogRow, BlogTrailItem } from "./Type.js";
import type { FieldRecordStatusState } from "../Brand/FieldRecordStatus";

/** One measure on the plate: a label, a figure and its unit. */
interface PlateMeasure {
	readonly label: string;
	readonly value: string;
	readonly unit?: string;
}

interface Props {
	/** The trail above the opening. The last crumb is this page. */
	trail: readonly BlogTrailItem[];

	/** The page's only `h1`. */
	heading: string;

	/** One sentence under the `h1`. */
	standfirst?: string;

	/** Every article, already ordered newest first. */
	rows: readonly BlogRow[];

	/** Shown instead of the grid when the collection is empty. */
	emptyTitle: string;

	/** The second line of the empty state. */
	emptyNote: string;

	/** The back-to-top label at the foot of the page. */
	backLabel: string;

	/** Its target - the page's own top. */
	backHref: string;

	/**
	 * The plate's register: `# BLOG / 08 ENTRIES`, built by the page with
	 * `RegisterOf("BLOG", rows, { unit: "ENTRIES" })`. A `Register`, never a
	 * string - the shape carries the count, so the plate cannot print a label
	 * without the extent it names.
	 */
	register: RegisterShape;

	/** The plate's four measures, each counted from the collection. */
	plateMeasures: readonly PlateMeasure[];

	/** What the plate is the extent of, at caption weight. */
	plateCaption: string;

	/** Where the figures came from. */
	plateSource: string;
}

const {
	trail,
	heading,
	standfirst,
	rows,
	emptyTitle,
	emptyNote,
	backLabel,
	backHref,
	register,
	plateMeasures,
	plateCaption,
	plateSource,
} = Astro.props;

/** The one heading id the grid's `aria-labelledby` points at. */
const HeadingID = "BlogPostsHeading";

/**
 * The plate's state. An empty archive is not a plate of zeroes: it is evidence
 * that is not there, so the figure prints the vocabulary's word instead of four
 * figures that would each be a claim.
 */
const PlateState: FieldRecordStatusState | undefined =
	rows.length === 0 ? "unavailable" : undefined;

/**
 * The card's seed scatter: the baseline's cards sat very slightly rotated and
 * offset from one another, which its client engine applied per card. Two small
 * deterministic numbers reproduce that placement without shipping the engine,
 * and `nth` is stable between builds because it is the row's own position.
 */
const Seed = (Position: number): string =>
	`--StaccatoSeed:${Position % 3};--StaccatoSeedPhase:${Position % 2}`;
---

<div class="blog-index">
	<div class="blog-index__open">
		<ContactBreadcrumb trail={trail} class="blog-index__trail" />

		<header class="blog-index__head">
			<h1 class="blog-index__heading" id={HeadingID}>
				{heading}
			</h1>
			{standfirst ? (
				<p class="blog-index__standfirst">{standfirst}</p>
			) : null}
		</header>
	</div>

	<div class="blog-index__plate">
		<div class="blog-index__plate-inner">
			<RecordFigure
				caption={plateCaption}
				provenance={plateSource}
				captionPlacement="channel"
				state={PlateState}
			>
				<div class="blog-index__register">
					<Register register={register} class="blog-index__register-label" />
					<dl class="blog-index__register-rows">
						{plateMeasures.map((Measure) => (
							<div class="blog-index__register-row">
								<dt class="blog-index__register-key">
									{Measure.label}:
								</dt>
								<dd class="blog-index__register-value">
									{Measure.value}
									{Measure.unit ? (
										<span class="blog-index__register-unit">
											{Measure.unit}
										</span>
									) : null}
								</dd>
							</div>
						))}
					</dl>
				</div>
			</RecordFigure>
		</div>
	</div>

	<div class="blog-index__archive-wrap">
		{rows.length === 0 ? (
			<div class="blog-index__empty">
				<p class="blog-index__empty-title">{emptyTitle}</p>
				<p class="blog-index__empty-note">{emptyNote}</p>
			</div>
		) : (
			<section class="blog-index__archive" aria-labelledby={HeadingID}>
				<ul class="blog-index__grid">
					{rows.map((Row, Position) => (
						<li class="blog-index__item">
							<a class="blog-index__link" href={Row.href}>
								<article
									class="blog-index__card StaccatoCard"
									style={Seed(Position)}
								>
									{Row.tags.length > 0 ? (
										<ul class="blog-index__tags">
											{Row.tags.map((Tag) => (
												<li class="blog-index__tag">
													<jelly-badge
														variant="platinum"
														shape="square"
														style="--jelly-fill:transparent;--jelly-label:var(--CardForeground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
													>
														{Tag}
													</jelly-badge>
												</li>
											))}
										</ul>
									) : null}

									<h3 class="blog-index__title">
										{Row.title}
									</h3>
									<p class="blog-index__summary">
										{Row.summary}
									</p>

									<p class="blog-index__foot">
										<span class="blog-index__author">
											{Row.author}
										</span>
										<time
											class="blog-index__date"
											datetime={Row.date}
										>
											{Row.date}
										</time>
										<span class="blog-index__read">
											{Row.readTime}
										</span>
									</p>
								</article>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<p class="blog-index__back">
			<a href={backHref}>
				{backLabel}
				<span aria-hidden="true"> ↑</span>
			</a>
		</p>
	</div>
</div>
