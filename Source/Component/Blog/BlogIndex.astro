---
/**
 * BlogIndex - the blog's archive page: a centred header and the articles in a
 * three-column grid.
 *
 * The shape is the baseline render's, and the baseline is the acceptance
 * criterion here:
 *
 *   breadcrumb
 *   header          the page's only h1, centred, and one line under it
 *   grid            8 cards in `1 / 2 / 3` columns, each a whole-card link
 *   back to top
 *
 * The grid is deliberately not a row ledger. A row per article was this page's
 * previous shape, on the argument that eight articles in a three-across grid
 * leave a hole in the last row; the page a reader remembers is the grid, the
 * hole included, and the design document's preference for rows is reported as a
 * conflict rather than applied (see the card's fidelity rule: the baseline wins).
 *
 * Four decisions inside the card:
 *
 * - **The whole card is the link.** The anchor wraps the article, so a click
 *   anywhere in the card opens it - the baseline's own behaviour, and the reason
 *   the title is not a second nested link.
 * - **The title is the card's `h3`.** Eight titles under one `h1` are the page's
 *   third level, not its second: the grid has no heading of its own, so an `h2`
 *   per card would invent a section that does not exist.
 * - **The tags are `jelly-badge` elements on a transparent fill.** The baseline
 *   printed them as plain ink chips; the Jelly element carries the same ink and
 *   the same quiet padding, and it is the site's one form for a term badge.
 * - **The footer row carries the author, the date and the reading time.** The
 *   baseline printed the author at the left and the reading time at the right;
 *   the date sits between them, because it is a fact this archive carries and the
 *   baseline's own article pages print.
 *
 * No script and no hydration directive: the index is static.
 */
import ContactBreadcrumb from "../Contact/ContactBreadcrumb.astro";

import type { BlogRow, BlogTrailItem } from "./Type.js";

interface Props {
	/** The trail above the opening. The last crumb is this page. */
	trail: readonly BlogTrailItem[];

	/** The page's only `h1`. */
	heading: string;

	/** One sentence under the `h1`. */
	standfirst?: string;

	/** Every article, already ordered newest first. */
	rows: readonly BlogRow[];

	/** Shown instead of the grid when the collection is empty. */
	emptyTitle: string;

	/** The second line of the empty state. */
	emptyNote: string;

	/** The back-to-top label at the foot of the page. */
	backLabel: string;

	/** Its target - the page's own top. */
	backHref: string;
}

const {
	trail,
	heading,
	standfirst,
	rows,
	emptyTitle,
	emptyNote,
	backLabel,
	backHref,
} = Astro.props;

/** The one heading id the grid's `aria-labelledby` points at. */
const HeadingID = "BlogPostsHeading";

/**
 * The card's seed scatter: the baseline's cards sat very slightly rotated and
 * offset from one another, which its client engine applied per card. Two small
 * deterministic numbers reproduce that placement without shipping the engine,
 * and `nth` is stable between builds because it is the row's own position.
 */
const Seed = (Position: number): string =>
	`--StaccatoSeed:${Position % 3};--StaccatoSeedPhase:${Position % 2}`;
---

<div class="blog-index">
	<ContactBreadcrumb trail={trail} class="blog-index__trail" />

	<header class="blog-index__head">
		<h1 class="blog-index__heading" id={HeadingID}>{heading}</h1>
		{standfirst ? <p class="blog-index__standfirst">{standfirst}</p> : null}
	</header>

	{
		rows.length === 0 ? (
			<div class="blog-index__empty">
				<p class="blog-index__empty-title">{emptyTitle}</p>
				<p class="blog-index__empty-note">{emptyNote}</p>
			</div>
		) : (
			<section class="blog-index__archive" aria-labelledby={HeadingID}>
				<ul class="blog-index__grid">
					{rows.map((Row, Position) => (
						<li class="blog-index__item">
							<a class="blog-index__link" href={Row.href}>
								<article
									class="blog-index__card StaccatoCard"
									style={Seed(Position)}
								>
									{Row.tags.length > 0 ? (
										<ul class="blog-index__tags">
											{Row.tags.map((Tag) => (
												<li class="blog-index__tag">
													<jelly-badge
														variant="platinum"
														shape="square"
														style="--jelly-fill:transparent;--jelly-label:var(--CardForeground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
													>
														{Tag}
													</jelly-badge>
												</li>
											))}
										</ul>
									) : null}

									<h3 class="blog-index__title">{Row.title}</h3>
									<p class="blog-index__summary">{Row.summary}</p>

									<p class="blog-index__foot">
										<span class="blog-index__author">{Row.author}</span>
										<time class="blog-index__date" datetime={Row.date}>
											{Row.date}
										</time>
										<span class="blog-index__read">{Row.readTime}</span>
									</p>
								</article>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<p class="blog-index__back">
		<a href={backHref}>{backLabel}<span aria-hidden="true"> ↑</span></a>
	</p>
</div>
