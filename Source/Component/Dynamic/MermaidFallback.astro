---
// Client-side Mermaid fallback renderer.
// Catches any ```mermaid blocks that the remarkMermaid build-time
// plugin couldn't handle (missing SVGs, MDX pages, etc.) and renders
// them in-browser using the mermaid library.
---

<style>
	.mermaid-fb {
		background: var(--Card);
		border-radius: 0;
		padding: 1rem;
		margin: 1.5rem 0;
		overflow-x: auto;
	}
	.mermaid-fb svg {
		max-width: 100%;
		height: auto;
	}
	.mermaid-fb-error {
		color: #d1242f;
		font-family: monospace;
		font-size: 0.85em;
		padding: 0.5rem;
	}
</style>

<script>
	/**
	 * The fallback is a *fallback*: the remark plugin inlines every diagram it
	 * can at build time, and in the committed output not one of the 124 routes
	 * carries a `language-mermaid` block (measured: 0 markers). So the honest
	 * cost of this component is the cost of finding out there is nothing to do,
	 * and that cost used to be paid during page load.
	 *
	 * Two changes, both about *when*:
	 *
	 * - The scan runs at idle, not at module evaluation. It used to walk the
	 *   whole document while the page's islands were still hydrating.
	 * - `querySelector` answers "is there anything at all?" first. It returns at
	 *   the first match and allocates one element, where `querySelectorAll`
	 *   allocates a NodeList for every page whether it has a diagram or not.
	 *   Only a page that actually has a block pays for the full list.
	 *
	 * The dynamic import stays dynamic, and stays behind the gate: a static
	 * `import mermaid from "mermaid"` made every documentation page evaluate the
	 * whole mermaid graph (the elk layout alone is 1.5 MB) to discover it had
	 * nothing to draw. Nothing is lost by waiting - a page that does keep a
	 * client-side block still renders it, one dynamic import later.
	 */
	const Render = async (): Promise<void> => {
		if (!document.querySelector('pre > code[class*="language-mermaid"]'))
			return;

		const blocks = document.querySelectorAll(
			'pre > code[class*="language-mermaid"]',
		);

		const { default: mermaid } = await import("mermaid");

		// Single daylight theme: always the default (light) mermaid theme
		mermaid.initialize({
			startOnLoad: false,
			theme: "default",
			securityLevel: "loose",
			themeVariables: {
				primaryColor: "#ffffff",
				primaryTextColor: "#1c1c1e",
				lineColor: "#1c1c1e",
			},
		});

		for (const code of blocks) {
			const pre = code.parentElement!;
			const source = code.textContent || "";

			// Create a wrapper for the rendered diagram
			const wrapper = document.createElement("div");
			wrapper.className = "mermaid-fb";

			// If this is inside a .mermaid-diagram wrapper (the remark plugin
			// tried but failed), replace the whole thing; otherwise replace the pre
			const container = pre.closest(".mermaid-diagram") || pre;

			try {
				const { svg } = await mermaid.render(
					`mermaid-fb-${Math.random().toString(36).slice(2, 8)}`,
					source,
				);
				wrapper.innerHTML = svg;
			} catch (err) {
				wrapper.innerHTML = `<div class="mermaid-fb-error"><strong>Mermaid parse error:</strong> ${(err as Error).message}</div>`;
			}

			container.replaceWith(wrapper);
		}
	};

	/* Idle, so the scan never competes with the page's own hydration. The
	   timeout is the fallback for browsers without `requestIdleCallback`, and
	   the cast is because the property is not in every lib this project compiles
	   against. */
	type IdleWindow = Window & {
		requestIdleCallback?: (
			callback: () => void,
			options?: { timeout: number },
		) => number;
	};

	const Idle = (window as IdleWindow).requestIdleCallback;

	if (typeof Idle === "function") {
		Idle(
			() => {
				void Render();
			},
			{ timeout: 2000 },
		);
	} else {
		setTimeout(() => {
			void Render();
		}, 200);
	}
</script>
