---
// Client-side Mermaid fallback renderer.
// Catches any ```mermaid blocks that the remarkMermaid build-time
// plugin couldn't handle (missing SVGs, MDX pages, etc.) and renders
// them in-browser using the mermaid library.
---

<style>
	.mermaid-fb {
		background: var(--Card);
		border-radius: 0;
		padding: 1rem;
		margin: 1.5rem 0;
		overflow-x: auto;
	}
	.mermaid-fb svg {
		max-width: 100%;
		height: auto;
	}
	.mermaid-fb-error {
		color: #d1242f;
		font-family: monospace;
		font-size: 0.85em;
		padding: 0.5rem;
	}
</style>

<script>
	import mermaid from "mermaid";

	// Find any pre/code blocks with language-mermaid that haven't been inlined yet
	const blocks = document.querySelectorAll(
		'pre > code.language-mermaid, pre > code[class*="language-mermaid"]',
	);

	if (blocks.length === 0) {
		// No fallback needed - all inlined at build time
	} else {
		// Single daylight theme: always the default (light) mermaid theme
		mermaid.initialize({
			startOnLoad: false,
			theme: "default",
			securityLevel: "loose",
			themeVariables: {
				primaryColor: "#ffffff",
				primaryTextColor: "#1c1c1e",
				lineColor: "#1c1c1e",
			},
		});

		for (const code of blocks) {
			const pre = code.parentElement!;
			const source = code.textContent || "";

			// Create a wrapper for the rendered diagram
			const wrapper = document.createElement("div");
			wrapper.className = "mermaid-fb";

			// If this is inside a .mermaid-diagram wrapper (the remark plugin
			// tried but failed), replace the whole thing; otherwise replace the pre
			const container = pre.closest(".mermaid-diagram") || pre;

			try {
				const { svg } = await mermaid.render(
					`mermaid-fb-${Math.random().toString(36).slice(2, 8)}`,
					source,
				);
				wrapper.innerHTML = svg;
			} catch (err) {
				wrapper.innerHTML = `<div class="mermaid-fb-error"><strong>Mermaid parse error:</strong> ${(err as Error).message}</div>`;
			}

			container.replaceWith(wrapper);
		}
	}
</script>
