---
/**
 * Requirements - what a build needs, and what the source build needs first.
 *
 * The region prints the requirements in three parts:
 *
 * - the `download-requirements` grid, with the panel anatomy, the
 *   case-preserving panel heading, and the source-build toolchain as a card of
 *   its own;
 * - the two-panel comparison, "Minimum Requirements" beside "Recommended for the
 *   Best Experience", the second one marked;
 * - the strip of one chip per supported OS, which carries the per-platform OS,
 *   arch and installer values once each - one line per platform instead of three
 *   lists with the same two shared rows under them.
 *
 * The two icon-tooltip sentences are the region's footnote, so they survive the
 * comparison they qualify.
 *
 * THE TWO PANELS ARE ONE `RecordPair`. Minimum and recommended are not two
 * options and not two cards: they are the same three keys answered twice, which
 * is the comparison the block layer's frame exists for. The pair gives them one
 * frame, one hairline gutter and one caption that says what the reader is
 * comparing - and the recommended side keeps its mark as a 2px rule under its
 * title rather than a 1px outline around its box: the same claim, stated by
 * border weight in the place the eye already is. The pair is a section of this
 * region, so its pod labels print at the region's heading level (`h4`), and the
 * page's outline keeps its count.
 *
 * The panels carry the figures that differ between minimum and recommended, and
 * the shared rows keep the recommendation as the row's `note`. The rows arrive
 * already resolved: `Download/Data.ts` owns the values, their order and the
 * recommended figure each row carries as a note. This file maps them into
 * ledgers and nothing else.
 */
import RecordLedger from "../../Record/RecordLedger.astro";
import RecordPair from "../../Record/RecordPair.astro";

import type { LedgerRow } from "../../Record/Type.js";

import type { RequirementsPanel, SupportedOS } from "./Type.js";

interface Props {
	/** The panels, in the order the page prints them: minimum, then recommended. */
	panels: readonly RequirementsPanel[];

	/** The supported-OS strip's heading. */
	osLabel: string;

	/** One chip per platform: its OS floor, its architectures, its installer. */
	operatingSystems: readonly SupportedOS[];

	/** The source-build toolchain, as one more card. */
	toolchain: readonly LedgerRow[];

	/** The toolchain card's own heading, printed above its ledger. */
	toolchainLabel: string;
}

const { panels, osLabel, operatingSystems, toolchain, toolchainLabel } =
	Astro.props;

/**
 * The pair's two sides, in the order the page hands them in. The recommended
 * panel is the subject: the one the other is read against. A pair is two-sided
 * by definition, so the region renders the pair only when both sides exist; the
 * data owns the list, and a third panel would be a third claim that the
 * caption's comparison could not describe.
 */
const [Minimum, Recommended] = panels;

/**
 * The pair's caption: what the reader is comparing, and where the figures come
 * from. It is the one statement made about both panels, so it names the shared
 * keys rather than repeating either column.
 */
const Caption =
	"The same three keys in both columns; only the figures differ. Values from Download/Data.ts.";

/**
 * The card's Jelly custom properties, the same box the manifest's platform
 * groups use: white on the creme field, square, the documented inset, and
 * `font-size: inherit` so the card never resets type to Jelly's 15px default.
 */
const Card =
	"--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:var(--space-group)";
---

<div class="download-requirements">
	{Minimum && Recommended ? (
		<RecordPair
			class="download-requirements__pair"
			pair={{
				left: { label: Minimum.label },
				right: { label: Recommended.label, subject: true },
				caption: Caption,
				heading: "h4",
			}}
		>
			<RecordLedger slot="left" rows={Minimum.rows} />
			<RecordLedger slot="right" rows={Recommended.rows} />
		</RecordPair>
	) : null}

	<div class="download-requirements__os">
		<h4 class="download-requirements__os-label">{osLabel}</h4>
		<ul class="download-requirements__os-list">
			{operatingSystems.map((operatingSystem) => (
				<li class="download-requirements__os-chip">
					<p class="download-requirements__os-name">
						{operatingSystem.name}
					</p>
					<p class="download-requirements__os-note">
						{operatingSystem.note}
					</p>
				</li>
			))}
		</ul>
	</div>

	<jelly-card
		class="download-requirements__group download-requirements__group--wide"
		style={Card}
	>
		<h4 class="download-requirements__platform">{toolchainLabel}</h4>
		<RecordLedger rows={toolchain} />
	</jelly-card>
</div>
