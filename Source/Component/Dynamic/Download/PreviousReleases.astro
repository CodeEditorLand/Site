---
/**
 * PreviousReleases - the releases that came before this one, as a disclosure.
 *
 * The region's heading says the fact ("There is nothing to go back to yet.") and
 * the disclosure under it is the record: closed, it is one mono row reading
 * `RECORD: EMPTY` and the way in; open, it is the sentence that explains the
 * state and the header of the matrix that will print one row per release. The
 * closed state is the composition decision - a list of releases that does not
 * exist yet should not take a screen - and the open state is the shape of the
 * record the day it does exist.
 *
 * CSS only, no script: `<details>` works with JavaScript off, and it prints open
 * when the page is printed, which is what a dossier does.
 *
 * The empty matrix keeps its header and its caption rather than disappearing: a
 * header with no rows is the record's shape, and a caption saying "one row per
 * release, newest first" is a claim about what will be here - not a blank box.
 *
 * The rows carry three columns - published, platform, change - because those are
 * the three the tree can fill; `Size` and `Downloads` are not here, because no
 * release row exists to carry them and this page may not invent a size, a
 * checksum or a date.
 */
import RecordMatrix from "../../Record/RecordMatrix.astro";

import Mark from "../../Mark/Mark.astro";

import type { MatrixColumn } from "../../Record/Type.js";

import type { Release } from "./Type.js";

interface Props {
	/** The releases, newest first, in the order the page prints them. */
	releases: readonly Release[];

	/** The matrix columns after the version column. */
	columns: readonly MatrixColumn[];

	/** §7's label for a record with no rows: `RECORD: EMPTY`. */
	label: string;

	/** What an empty release list says instead of rendering nothing. */
	empty: string;

	/** The caption the matrix carries: the shape of the record to come. */
	caption: string;
}

const { releases, columns, label, empty, caption } = Astro.props;

/** One matrix row per release: the version labels the row. */
const Rows = releases.map((release) => ({
	label: release.version,
	cells: [release.published, release.platform, release.change],
}));
---

<details class="download-releases">
	<summary class="download-releases__summary">
		<span class="download-releases__label">{label}</span>
		<Mark kind="fold" class="download-releases__marker" />
	</summary>

	<div class="download-releases__body">
		<p class="download-releases__sentence">{empty}</p>

		<RecordMatrix
			columns={columns}
			rows={releases.length === 0 ? [] : Rows}
			caption={caption}
			class="download-releases__matrix"
		/>
	</div>
</details>
