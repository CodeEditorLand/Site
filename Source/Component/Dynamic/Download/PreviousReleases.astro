---
/**
 * PreviousReleases - the releases that came before this one.
 *
 * This is the recovered `DynamicPreviousReleases.astro` (`3480853ac^`), rehomed
 * into the Download surface's own directory beside the band that renders it.
 * The `.tsx` island it replaced is where the five-column table lived: `Version`,
 * `Published` as a real `<time>`, `Size`, `Downloads`, and one outline button per
 * asset with a gated Changelog link. That step dropped the buttons deliberately -
 * the release list in the tree is empty, so no button was ever reachable, and
 * nothing on the site calls the download API - and it is the last committed form,
 * so it is the one recovered rather than reinvented.
 *
 * What survives of the five columns is the three the tree can fill: the version
 * labels the row, and the cells are when it shipped, on what, and what changed.
 * `Size` and `Downloads` are not here because no release row exists to carry
 * them, and this page may not invent a size, a checksum or a date.
 *
 * Two states, both written out. With releases, one matrix row each. Without
 * releases - the state today - §7's `RECORD: EMPTY` label followed by one
 * sentence, because an empty table is a blank box and a blank box is a defect
 * (DESIGN.md §3.3; `DesignSystem-Components.md` §7).
 *
 * The empty state is text, not a card: a box with no claim in it would be the
 * defect it is meant to avoid, and there is nothing here to put in one.
 */
import RecordMatrix from "../../Record/RecordMatrix.astro";

import type { MatrixColumn } from "../../Record/Type.js";

import type { Release } from "./Type.js";

interface Props {
	/** The releases, newest first, in the order the page prints them. */
	releases: readonly Release[];

	/** The matrix columns after the version column. */
	columns: readonly MatrixColumn[];

	/** §7's label for a record with no rows: `RECORD: EMPTY`. */
	label: string;

	/** What an empty release list says instead of rendering nothing. */
	empty: string;
}

const { releases, columns, label, empty } = Astro.props;

/** One matrix row per release: the version labels the row. */
const Rows = releases.map((release) => ({
	label: release.version,
	cells: [release.published, release.platform, release.change],
}));
---

{
	releases.length === 0 ? (
		<div class="download-releases__empty">
			<p class="download-releases__label">{label}</p>
			<p class="download-releases__sentence">{empty}</p>
		</div>
	) : (
		<RecordMatrix columns={columns} rows={Rows} />
	)
}
