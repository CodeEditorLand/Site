---
/**
 * DynamicPreviousReleases - the releases that came before this one.
 *
 * This replaces the `.tsx` island of the same name. The interaction it drops is
 * the per-asset download button and the changelog button each row carried, and
 * the Staccato noise it seeded: the release list in the tree is empty, so no
 * button was ever reachable. A release row is a fact to read, not an action to
 * take, and the ledger says so.
 *
 * Two states, both written out. With releases, one matrix row each: the version
 * as the row label, then when it shipped, on what, and what changed. Without
 * releases - the state today - one sentence, because an empty table is a blank
 * box and a blank box is a defect (BRIDGE §7).
 */
import RecordMatrix from "../Record/RecordMatrix.astro";

import type { MatrixColumn } from "../Record/Type.js";

import type { Release } from "./Download/Type.js";

interface Props {
	/** The releases, newest first, in the order the page prints them. */
	releases: readonly Release[];

	/** The matrix columns after the version column. */
	columns: readonly MatrixColumn[];

	/** What an empty release list says instead of rendering nothing. */
	empty: string;
}

const { releases, columns, empty } = Astro.props;

/** One matrix row per release: the version labels the row. */
const Rows = releases.map((release) => ({
	label: release.version,
	cells: [release.published, release.platform, release.change],
}));
---

{
	releases.length === 0 ? (
		<p class="download-releases__empty">{empty}</p>
	) : (
		<RecordMatrix columns={columns} rows={Rows} />
	)
}
