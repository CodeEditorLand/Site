---
/**
 * Trail - the site's one breadcrumb grammar.
 *
 * Two trail grammars live in the tree - the mono `/LABEL` strip on Contact and
 * Blog, and the plain `Home /` list on Contributing, License, the two legal
 * pages, the doc article and the account index - and `DESIGN.md` §9 Q3 settled
 * on the mono form: a trail is a Route Strip artifact (§1.8), not a detail of
 * whichever page first needed one.
 *
 * The grammar, in four rules:
 *
 * - **The label is printed as the caller wrote it, `/`-prefixed.** `/HOME`,
 *   `/DASHBOARD`, `/ACCOUNT`. The component adds nothing to it.
 * - **The leading slash is the only separator.** There is no separator element
 *   between crumbs, because a second `/` prints the grammar twice.
 * - **The current page is not a link, and it is the LAST crumb by position.**
 *   It is a `<span>` carrying `aria-current="page"`. Position decides, not the
 *   data: a page that passes a target on its final crumb gets a statement rather
 *   than a link to itself, which would be a route statement that lies about where
 *   the reader is. The target is dropped rather than honoured.
 * - **A trail with no crumb renders nothing.** `<nav aria-label="Breadcrumb">
 *   <ol></ol></nav>` is a landmark a screen reader announces and a reader cannot
 *   use. A breadcrumb with nothing in it is not an empty state, it is a defect -
 *   the page has no route to state, so the block states none.
 *
 * It publishes `.trail`, `.trail__list`, `.trail__item`, `.trail__link` and
 * `.trail__current` from `System/Component/Route/_Trail.scss`.
 *
 * No script and no hydration: a trail is markup. It is also not a heading - the
 * trail says where the reader is, and the page's `h1` says what they are reading.
 *
 * `Component/Contact/ContactBreadcrumb.astro` and
 * `System/Component/Contact/_Breadcrumb.scss` are absorbed, not deleted: they are
 * the same trail under a surface's own name, kept and marked absorbed for any
 * caller that still reaches through them. This file is the one trail, and both
 * blog surfaces import it directly.
 */
import type { TrailItem } from "./Type.js";

interface Props {
	/** The crumbs, first to last. The last one is the current page. */
	trail: readonly TrailItem[];

	/**
	 * The landmark's accessible name. Defaults to `Breadcrumb`; a page whose
	 * document has a name of its own can say so - `Breadcrumb: Documentation` -
	 * because a landmark is announced out of context and `Breadcrumb` alone does
	 * not say which document.
	 */
	label?: string;

	/** A class the page adds to the shell, for its own spacing. */
	class?: string;
}

const { trail, label: Label = "Breadcrumb", class: Class } = Astro.props;

/** The last crumb is the page the reader is on, whatever the caller passed. */
const Last = trail.length - 1;
---

{
	trail.length === 0 ? null : (
		<nav class:list={["trail", Class]} aria-label={Label}>
			<ol class="trail__list">
				{trail.map((Item, Index) => (
					<li class="trail__item">
						{Item.href && Index !== Last ? (
							<a class="trail__link" href={Item.href}>
								{Item.label}
							</a>
						) : (
							<span class="trail__current" aria-current="page">
								{Item.label}
							</span>
						)}
					</li>
				))}
			</ol>
		</nav>
	)
}
