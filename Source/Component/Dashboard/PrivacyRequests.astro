---
// PrivacyRequests - the dashboard's data-rights directory: the six statutory
// rights, the five support channels, and the one entry that ends the account.
//
// Nothing hydrates: the directory is static links, so it is an Astro block and
// not a "use client" island - the same destinations, in the same order, with the
// same copy, at zero JavaScript. There is no client state, no handler and no hook
// to keep, because the surface has no interaction to keep.
//
// The three blocks are three shapes and are rendered as three blocks, not as
// one list with a `kind` branch: a right ends in `Open form`, a support
// channel ends in the mailbox its request lands at, and the erasure entry is
// one red card. Flattening them is a list of rows where three objects belong.
//
// ─── THE THREE ARMS THE DIRECTORY STATES ─────────────────────────────────
// The directory has one rendering: the full list. Three states are printed
// beside it, because in each one the list would be a label over a hole.
//
//   - **An empty grid.** A block whose registry returns no card still prints
//     its heading and its intro sentence, so a grid of nothing under them is a
//     label over a hole - the exact defect `SurfaceAbsent` exists to prevent.
//     Each block carries its own composed `empty` sentence from `Data.ts` and
//     prints it under the same heading, with `STATUS: UNAVAILABLE`.
//   - **A denied reader.** A signed-out reader must not be shown the whole
//     directory as though they could act on it. `state="denied"` prints what
//     the page is, why it is not being shown, and the one way in - in the
//     site's own three rows, not in an apology.
//   - **No count.** Three sets, three headings, and every other counted line on
//     the site prints `# LABEL / NN`. Each block prints its register through
//     `Register.astro`, composed with `RegisterOf` from the rows it is about to
//     render, so the counted line cannot outlive its set.
//
// `erase` is optional: a route that is not offered prints nothing rather than an
// erasure card that leads to a page which does not answer.
//
// No script tag, no client directive, no inline style.
import SurfaceAbsent from "../Surface/SurfaceAbsent.astro";

import Register from "../Record/Register.astro";

import { RegisterOf } from "../Record/RegisterLine.js";

import { Erase as EraseDefault, Rights as RightsDefault, Support as SupportDefault } from "./Data.js";

import type { EraseBlock, RequestGrid, RightsCard, SupportCard } from "./Type.js";

interface Props {
	/** The six statutory rights. Defaults to the registry's own grid. */
	rights?: RequestGrid<RightsCard>;

	/** The support channels. Defaults to the registry's own grid. */
	support?: RequestGrid<SupportCard>;

	/** The erasure block. `null` prints no erasure section at all. */
	erase?: EraseBlock | null;

	/**
	 * `rest` prints the directory. `denied` prints the absence instead: what the
	 * page is, why the reader cannot see it, and the way in.
	 */
	state?: "rest" | "denied";

	/** The sentence the denied arm prints as `WHY NOT:`. */
	denied?: string;
}

const {
	rights: Rights = RightsDefault,
	support: Support = SupportDefault,
	erase: Erase = EraseDefault,
	state = "rest",
	denied = "The directory is read with the session that owns the account. This browser has no session the dashboard recognises, so the six rights and the five channels are not being listed - they have not gone anywhere.",
} = Astro.props;

/** The three counted lines: the set's kind, and the count of the rows below it. */
const RightsLine = RegisterOf("THE RIGHTS", Rights.cards);

const SupportLine = RegisterOf("THE CHANNELS", Support.cards);

const EraseLine = RegisterOf("THE ERASURE", Erase ? [Erase] : []);
---

<div class="privacy-requests space-y-12">
	{state === "denied" ? (
		<SurfaceAbsent
			status="UNAVAILABLE"
			wouldBe="The six statutory rights, the five support channels and the one erasure entry, each opening the form that files it."
			whyNot={denied}
			next={{ label: "SIGN IN", href: "/Account/SignIn" }}
			retry={{ label: "READ THE ACCOUNT PAGE", href: "/Account" }}
			note="SOURCE: SOURCE/COMPONENT/DASHBOARD/DATA.TS"
		/>
	) : (
		<>
			<div>
				<Register register={RightsLine} class="privacy-requests__register" />

				<h3 class="font-medium font-mono mb-2">{Rights.label}</h3>
				<p class="mb-6 text-muted-foreground">{Rights.intro}</p>

				{Rights.cards.length > 0 ? (
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:grid-cols-3">
						{Rights.cards.map((Card) => (
							<a
								class="flex StaccatoBorderShimmer StaccatoCard bg-card transition-all p-5 flex-col focus:outline-2 focus:outline-[var(--Primary)] focus:outline-offset-2 hover:bg-secondary"
								href={Card.href}
							>
								<div class="flex justify-between gap-2 items-start mb-3">
									<h4 class="text-card-foreground font-medium leading-snug">
										{Card.title}
									</h4>
									<div class="flex flex-col gap-1 items-end shrink-0">
										<span class="font-medium text-sm font-mono tracking-widest bg-[var(--SpineIPCSurface)] border border-[color:var(--SpineIPCMute)] px-2 py-0.5 text-[color:var(--SpineIPCFore)]">
											{Card.code}
										</span>
										<span class="text-card-foreground text-sm font-mono opacity-70">
											{Card.article}
										</span>
									</div>
								</div>
								<p class="text-card-foreground text-sm flex-1 leading-relaxed mb-4">
									{Card.body}
								</p>
								<span class="text-card-foreground font-medium text-sm inline-flex items-center mt-auto">
									Open form<span class="ml-1">→</span>
								</span>
							</a>
						))}
					</div>
				) : (
					<p class="privacy-requests__empty">
						<span class="privacy-requests__empty-mark" aria-hidden="true">
							◎
						</span>
						<span class="privacy-requests__empty-sentence">
							{Rights.empty}
						</span>
						<span class="privacy-requests__empty-status">
							STATUS: UNAVAILABLE
						</span>
					</p>
				)}
			</div>

			<div>
				<Register register={SupportLine} class="privacy-requests__register" />

				<h3 class="font-medium font-mono mb-2">{Support.label}</h3>
				<p class="mb-6 text-muted-foreground">{Support.intro}</p>

				{Support.cards.length > 0 ? (
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:grid-cols-4">
						{Support.cards.map((Card) => (
							<a
								class="flex StaccatoBorderShimmer StaccatoCard bg-card transition-all p-5 flex-col focus:outline-2 focus:outline-[var(--Primary)] focus:outline-offset-2 hover:bg-secondary"
								href={Card.href}
							>
								<div class="flex items-center justify-between gap-2 mb-2">
									<h4 class="text-card-foreground font-medium">
										{Card.title}
									</h4>
									<span class="text-card-foreground font-medium text-sm font-mono shrink-0 tracking-widest">
										{Card.code}
									</span>
								</div>
								<p class="text-card-foreground text-sm flex-1 leading-relaxed mb-4">
									{Card.body}
								</p>
								<span class="text-card-foreground text-sm font-mono mt-auto">
									{Card.address}
								</span>
							</a>
						))}
					</div>
				) : (
					<p class="privacy-requests__empty">
						<span class="privacy-requests__empty-mark" aria-hidden="true">
							◎
						</span>
						<span class="privacy-requests__empty-sentence">
							{Support.empty}
						</span>
						<span class="privacy-requests__empty-status">
							STATUS: UNAVAILABLE
						</span>
					</p>
				)}
			</div>

			{Erase ? (
				<div>
					<Register register={EraseLine} class="privacy-requests__register" />

					<h3 class="font-medium font-mono mb-2">{Erase.label}</h3>
					<p class="mb-6 text-muted-foreground">{Erase.intro}</p>
					<a
						class="bg-card StaccatoCard transition-all focus:outline-2 focus:outline-offset-2 block border border-[color:var(--DestructMute)] focus:outline-[var(--Destruct)] hover:bg-[var(--DestructSurface)] p-6"
						href={Erase.href}
					>
						<div class="flex items-start gap-4 mb-4">
							<div class="flex items-center justify-center shrink-0 border h-10 w-10 bg-[var(--DestructSurface)] border-[color:var(--DestructMute)] text-[color:var(--Destruct)]">
								<svg
									aria-hidden="true"
									viewBox="0 0 24 24"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									height="20"
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									width="20"
								>
									<path d="M3 6h18"></path>
									<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
									<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
									<line x1="10" x2="10" y1="11" y2="17"></line>
									<line x1="14" x2="14" y1="11" y2="17"></line>
								</svg>
							</div>
							<div class="flex-1">
								<div class="flex items-center gap-2 mb-1">
									<h4 class="font-medium text-[color:var(--DestructFore)]">
										{Erase.title}
									</h4>
									<span class="font-medium text-sm font-mono tracking-widest text-[color:var(--DestructFore)]">
										{Erase.code}
									</span>
								</div>
								<p class="text-card-foreground text-sm">{Erase.body}</p>
							</div>
							<span class="font-medium text-[color:var(--Destruct)] shrink-0">
								→
							</span>
						</div>
					</a>
				</div>
			) : null}
		</>
	)}
</div>
