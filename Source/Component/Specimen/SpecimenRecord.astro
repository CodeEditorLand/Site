/** The set's data for one specimen. */
const PlateSetProps = (Row: Specimen): { set: PlateSet } => {
	const Count = Row.rows ?? 6;

	if (Row.state === "empty" || Count === 0) {
		return {
			set: {
				index: "PLATES_01",
				label: Row.label,
				plates: [],
				state: "empty",
				empty: "No capture is filed for this element yet: its manifest names the subject and the mode and carries no image, so the set prints what it would hold rather than eight empty frames.",
				source: "Public/Evidence/manifest.yaml",
			},
		};
	}

	if (Row.variant === "window") {
		return {
			set: {
				index: "PLATES_01",
				label: Row.label,
				plates: Array.from({ length: Count }, (_, Index) => ({
					index: String(Index + 1).padStart(2, "0"),
					subject: `ELEMENT CAPTURE ${String(Index + 1).padStart(2, "0")}`,
					state: Index === 0 ? undefined : ("unavailable" as const),
					...(Index === 0
						? {
								src: "/Evidence/Land/NightGlass-01.png",
								alt: "Rain-speckled glass reflecting a green light at night",
							}
						: { note: "filed in the manifest, no plate in the build" }),
				})),
				window: { showing: Count, total: "240" },
				caption:
					"Twelve of the two hundred and forty captures this edition would carry: a page that rendered all of them would have stopped being a field and started being a directory.",
				source: "Public/Evidence/manifest.yaml",
			},
		};
	}

	if (Row.variant === "absent") {
		return {
			set: {
				index: "PLATES_01",
				label: Row.label,
				plates: ElementPlates.slice(0, Count).map((Plate, Index) =>
					Index === 0
						? Plate
						: { ...Plate, state: "unavailable" as const },
				),
				caption:
					"Seven of the eight elements have a manifest and no plate, and one has both. The set prints each cell's own state and reason in the same grammar, so it reads as one register of attempts rather than as a broken gallery.",
				source: "Public/Evidence/manifest.yaml",
			},
		};
	}

	return {
		set: {
			index: "PLATES_01",
			label: Row.label,
			plates: ElementPlates.slice(0, Count),
			caption:
				"The eight elements of this document, at one size. A frame that is absent prints its state and its reason where the capture would be, because an absent plate is a fact about the build and not a gap in the page.",
			source: "Public/Evidence/manifest.yaml",
		},
	};
};

/* ─── THE REGISTER'S LINE ────────────────────────────────────────────────── */

/** The register's props for one specimen. */
const RegisterProps = (Row: Specimen) => ({
	register: RegisterCount(Row.label ?? "WHAT CHANGES", Row.count ?? "00", {
		...(Row.unit === undefined ? {} : { unit: Row.unit }),
		...(Row.separator === "quad"
			? { separator: "quad" as const }
			: {}),
	}),
	...(Row.state === undefined
		? {}
		: { state: Row.state as RegisterState }),
	class: "specimen-record__register-line",
});

/* ─── THE STAGE ──────────────────────────────────────────────────────────── */

/** The stage's own width, from the row. */
const SkinClass = (Row: Specimen): string => {
	const Width = Row.width ?? "band";

	return `specimen-record__stage specimen-record__stage--${Width}`;
};
---

<div class="specimen-record">
	{
		Groups.map((Group) => (
			<section class="specimen-record__group" key={Group.key}>
				<p class="specimen-record__group-head">
					<span class="specimen-record__group-kicker">
						{Group.label}
					</span>
					<span class="specimen-record__group-count">
						{InGroup(Group.key).length}
					</span>
				</p>

				<p class="specimen-record__group-note">{Group.note}</p>

				<div class="specimen-record__rows">
					{InGroup(Group.key).map((Entry) => (
						<article
							class="specimen-record__row"
							id={`record-${Entry.mark}`}
						>
							<header class="specimen-record__spec">
								<p class="specimen-record__mark">
									<span
										class="specimen-record__mark-hash"
										aria-hidden="true"
									>
										#
									</span>
									{Entry.mark}
								</p>

								<h3 class="specimen-record__state">
									{Entry.state_name}
								</h3>

								<p class="specimen-record__part">
									{Entry.component}
								</p>

								<p class="specimen-record__when">
									{Entry.when}
								</p>
							</header>

							<div
								class={SkinClass(Entry)}
								data-skin={Entry.width ?? "band"}
							>
								{Entry.kind === "ledger" ? (
									<RecordLedger {...LedgerProps(Entry)} />
								) : Entry.kind === "matrix" ? (
									<RecordMatrix {...MatrixProps(Entry)} />
								) : Entry.kind === "compare" ? (
									<RecordCompare {...CompareProps(Entry)} />
								) : Entry.kind === "trace" ? (
									<RecordTrace {...TraceProps(Entry)} />
								) : Entry.kind === "instrument" ? (
									<RecordInstrument
										{...InstrumentProps(Entry)}
									/>
								) : Entry.kind === "plateset" ? (
									<RecordPlateSet {...PlateSetProps(Entry)} />
								) : Entry.kind === "register" ? (
									<Register {...RegisterProps(Entry)} />
								) : Entry.kind === "registerline" ? (
									<div class="specimen-record__constructors">
										<Register
											register={RegisterOf(
												"A SET THE BLOCK HOLDS",
												[1, 2, 3, 4, 5, 6, 7, 8],
											)}
											class="specimen-record__register-line"
										/>
										<Register
											register={RegisterCount(
												"A COUNT IT DOES NOT",
												26,
												{ unit: "ROUTES" },
											)}
											class="specimen-record__register-line"
										/>
										<Register
											register={RegisterUnavailable(
												"A COUNT IT CANNOT KNOW",
											)}
											class="specimen-record__register-line"
										/>
										<Register
											register={RegisterWindow(
												"A WINDOW OF A LARGER SET",
												12,
												240,
											)}
											class="specimen-record__register-line"
										/>
									</div>
								) : null}
							</div>
						</article>
					))}
				</div>
			</section>
		))
	}
</div>
