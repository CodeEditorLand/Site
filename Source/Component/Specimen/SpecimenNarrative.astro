/**
 * SpecimenNarrative - the record narrative family, printed live.
 *
 * ─── WHY THIS STAGE IS NOT AN ISLAND ─────────────────────────────────────
 * The display family's rows are a React island because half of them measure a
 * container or draw a month. This family ships no JavaScript of its own: a band
 * is a `<section>`, a stage an `<ol>`, a figure a `<figure>`, a well a `<pre>`, a
 * transcript a list, a failure a `<dl>`. The only interactive things it prints
 * are `<details>` disclosures and the copy control two of its blocks already
 * wire through `WireWells`. So the stage is static Astro, and the band on the
 * specimen sheet costs the page nothing - which is itself a claim about the
 * family, printed by how it is mounted.
 *
 * ─── THE RENDERER DECIDES NOTHING ────────────────────────────────────────
 * A row states what it is, which part it exercises, when that state is right and
 * the props its specimen needs; this file builds the data and mounts the block.
 * That split is why the matrix and the rows cannot drift: both read
 * `Content/Specimen/Narrative.ts`, and a state added there appears on both with
 * no second edit.
 *
 * ─── THE DATA IS THE SITE'S OWN ──────────────────────────────────────────
 * Every fact, figure and path below is the kind of thing this document states: a
 * target, a licence, a stage of the build, a turn of a session, a capture's
 * manifest, a failure's three fields. A specimen printed with lorem ipsum would
 * prove that the block can hold text; a specimen printed with the document's own
 * facts proves that the block can hold THIS document.
 */
import {
	Groups,
	InGroup,
	type Specimen,
} from "../../Content/Specimen/Narrative.js";

import RecordArchive from "../Record/RecordArchive.astro";
import RecordAside from "../Record/RecordAside.astro";
import RecordBand from "../Record/RecordBand.astro";
import RecordEntry from "../Record/RecordEntry.astro";
import RecordFailure from "../Record/RecordFailure.astro";
import RecordFigure from "../Record/RecordFigure.astro";
import RecordHero from "../Record/RecordHero.astro";
import RecordInset from "../Record/RecordInset.astro";
import RecordLedger from "../Record/RecordLedger.astro";
