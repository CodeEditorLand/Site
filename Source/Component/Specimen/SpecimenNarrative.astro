/* ─── THE ARCHIVE ────────────────────────────────────────────────────────── */

/** The doc tree's own rows, as an archive of records. */
const DocRows = [
	{ title: "Build Pipeline", note: "the three stages, and the artifact each one produces", marker: "/DOC" },
	{ title: "Install", note: "from source, on the three targets", marker: "/DOC" },
	{ title: "Extensions", note: "the unmodified VS Code API", marker: "/DOC" },
	{ title: "Protocols", note: "gRPC, IPC, TCP and WASM, and when each is used", marker: "/DOC" },
	{ title: "Verify", note: "the checksums, and what they are checksums of", marker: "/DOC" },
	{ title: "License", note: "CC0, and what it permits", marker: "/DOC" },
	{ title: "Glossary", note: "the document's twenty terms", marker: "/MORE" },
	{ title: "Compare", note: "the editor against the alternatives", marker: "/MORE" },
	{ title: "Status", note: "what is built and what is not", marker: "/MORE" },
	{ title: "Changelog", note: "every edition, with its date", marker: "/MORE" },
	{ title: "Contributing", note: "how a change is proposed", marker: "/MORE" },
	{ title: "Privacy", note: "what is collected, which is nothing", marker: "/LEGAL" },
];

const ArchiveOf = (Row: Specimen): Archive => {
	const Count = Row.rows ?? 6;

	const Entries = Array.from({ length: Count }, (_, Index) => {
		const Doc = DocRows[Index % DocRows.length]!;

		return {
			title: Doc.title,
			href: "/Doc",
			note: Doc.note,
			marker: Doc.marker,
			group: Index < 4 ? "/THE BUILD" : "/THE RECORD",
			...(Row.variant === "gone" && Index === 2
				? { state: "gone" as const }
				: {}),
		};
	});

	return {
		index: "ARCHIVE_01",
		heading: "The document, filed",
		count:
			Row.variant === "window"
				? "240 ENTRIES"
				: `${Count} ${Count === 1 ? "ENTRY" : "ENTRIES"}`,
		entries: Entries,
		...(Row.state === "empty" || Count === 0
			? { state: "empty" as const, empty: Row.empty }
			: {}),
		...(Row.variant === "window"
			? { window: { showing: Count, total: "240" } }
			: {}),
		note: "READ FROM THE DOC COLLECTION AT BUILD TIME\u2001AS OF THIS COMMIT",
	};
};

