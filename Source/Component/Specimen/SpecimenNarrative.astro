/* ─── THE DOCUMENT'S OWN PROSE ───────────────────────────────────────────── */

/** One sentence the site states about itself, used wherever a body is needed. */
const Prose =
	"The editor runs natively on macOS, Windows and Linux: Rust and Tauri underneath, the VS Code extension API on top, and no Chromium in the process tree.";

/** A second sentence, for the blocks that hold two. */
const ProseSecond =
	"Extensions are unmodified: the marketplace's packages load as they are, and nothing in the editor has to be rebuilt to carry them.";

/* ─── THE BAND ───────────────────────────────────────────────────────────── */

const BandOf = (Row: Specimen): Band => ({
	kicker: Row.label ?? "/THE SUBSTITUTION",
	heading:
		Row.state_name === "DENSE"
			? "The section, inside the card"
			: "The substitution, and what it costs",
	standfirst:
		"One subject per band: a claim the chapter makes in one sentence, at most two lines.",
	footnote: "SOURCE: /DOC/BUILD-PIPELINE\u2001READ AT THIS COMMIT",
	/**
	 * The band is printed on a white insert unless the row is already inside the
	 * card stage: the sheet composes one band inside another to print the block at
	 * 1:1, and a `paper` tone is what keeps the inner one a box rather than a
	 * second chapter rule inside the outer band's body.
	 */
	...(Row.width === "card" ? {} : { tone: "paper" as const }),
	...(Row.dense === true ? { dense: true } : {}),
	...(Row.state === "empty" || Row.state === "loading"
		? { state: Row.state }
		: {}),
	...(Row.empty === undefined ? {} : { empty: Row.empty }),
});

/* ─── THE ENTRY ──────────────────────────────────────────────────────────── */

/** The eight elements, as records - the site's own set. */
const ElementNames = [
	"LAND",
	"MOUNTAIN",
	"COCOON",
	"WIND",
	"SKY",
	"AIR",
	"ECHO",
	"GROVE",
] as const;

/** The facts an entry prints when it is read as a row of them. */
const EntryFacts = [
	{ key: "TARGET:", value: "MACOS\u2001AARCH64" },
	{ key: "LICENSE:", value: "CC0\u2001PUBLIC DOMAIN" },
	{ key: "STATUS:", value: "ACTIVE" },
];

const EntryOf = (Row: Specimen): EntryRecord => {
	const Name = Row.label ?? "LAND";

	return {
		index: `# ${Name}_01`,
		name: Name,
		glyph: "↳",
		chips: ["RUST", "TAURI", "CC0"],
		body: `${Name.charAt(0)}${Name.slice(1).toLowerCase()}: ${Prose}`,
		href: "/Doc",
		...(Row.state === undefined
			? {}
			: { state: Row.state as Entry["state"] }),
		...(Row.empty === undefined ? {} : { empty: Row.empty }),
		...(Row.variant === "facts" ? { facts: EntryFacts } : {}),
		note: "Component/Record/Type.ts\u2001THE ELEMENT RECORD",
		...(Row.dense === true ? { dense: true } : {}),
		...(Row.surface === undefined
			? {}
			: { surface: Row.surface as "card" | "bare" }),
	};
};

/* ─── THE STAGE ──────────────────────────────────────────────────────────── */

/** The build's own stages, as the pipeline documents them. */
const Pipeline = [
	{ label: "SOURCE", line: "the tree at the commit this page was built from" },
	{ label: "VERIFY", line: "the checksums, against the registry" },
	{ label: "PREPARE", line: "the Tauri bundle, per target" },
	{ label: "SIGN", line: "the artifact, once a key exists" },
	{ label: "PUBLISH", line: "to the channel the release names" },
	{ label: "ANNOUNCE", line: "the record, with its figures" },
	{ label: "ARCHIVE", line: "the edition, under its stamp" },
	{ label: "AUDIT", line: "the run, against its own transcript" },
	{ label: "RETIRE", line: "the previous edition, when it expires" },
];

const StageOf = (Row: Specimen): Stage[] => {
	const Count = Row.rows ?? 4;

	return Array.from({ length: Count }, (_, Index) => {
		const Step = Pipeline[Index % Pipeline.length]!;

		/**
		 * The run's own facts, where the row is about a run: the step the run is
		 * at is `ACTIVE`, the steps before it are `VERIFIED`, and the step the
		 * run stopped on is `INTERRUPTED` with everything after it `PREPARING`.
		 */
		const Position = Row.current === undefined
			? undefined
			: Number(Row.current);

		const Index_ = Index + 1;

		const State =
			Row.state === "interrupted"
				? Index_ === 3
					? ("interrupted" as const)
					: Index_ < 3
						? ("verified" as const)
						: ("preparing" as const)
				: Position === undefined
					? undefined
					: Index_ < Position
						? ("verified" as const)
						: Index_ === Position
							? ("active" as const)
							: ("preparing" as const);

		return {
			index: String(Index_).padStart(2, "0"),
			label: Step.label,
			line: Step.line,
			href: "/Doc/Build-Pipeline",
			...(State === undefined ? {} : { state: State }),
			...(Row.variant === "detail"
				? {
						detail: `${Step.label} is the stage that ${Step.line}. It runs once per target, in the order the pipeline prints, and it writes its own transcript so the run can be checked afterwards.`,
					}
				: {}),
		};
	});
};

/* ─── THE FIGURE ─────────────────────────────────────────────────────────── */

const LongCaption =
	"The workbench at first paint, before any document is open: the tree on the left, the editor's own field in the centre, and the panel that will carry the terminal, the problems and the extensions. The capture was taken on the reference machine at the commit this page was built from, at the default window size, with no theme installed - so what it shows is the editor as it ships and not as it can be dressed. The three marks in the corner are the render's own, not an overlay: the plate is a flash observation and the flash is part of what it records.";

const FigureOf = (Row: Specimen): Figure => {
	if (Row.variant === "nofigure") {
		return {
			caption:
				"The figure's evidence is its sentence: three stages, in order, each one a fact the pipeline prints about itself.",
			provenance: "Source/Function/Build/Index.ts\u2001THE STAGE LIST",
			folio: "〈FIGURE 02〉",
		};
	}

	if (Row.variant === "long") {
		return {
			caption: LongCaption,
			provenance: "Public/Evidence/Land/Workbench-01.png\u2001FLASH OBSERVATION",
			folio: "〈FIGURE 03〉",
			src: "/Evidence/Land/NightGlass-01.png",
			alt: "Rain-speckled glass reflecting a green light at night",
		};
	}

	if (Row.variant === "open") {
		return {
			caption: LongCaption,
			provenance: "Public/Evidence/Land/Workbench-01.png\u2001FLASH OBSERVATION",
			folio: "〈FIGURE 04〉",
			open: true,
			src: "/Evidence/Land/NightGlass-01.png",
			alt: "Rain-speckled glass reflecting a green light at night",
		};
	}

	if (Row.state === "unavailable") {
		return {
			caption:
				"The workbench at first paint. The capture is filed in the element's manifest and is not in this build.",
			provenance: "Public/Evidence/manifest.yaml\u2001STATUS: PLACEHOLDER",
			folio: "〈FIGURE 05〉",
			state: "unavailable",
			next: "READ THE ELEMENT'S MANIFEST, WHICH NAMES THE SUBJECT AND THE MODE",
		};
	}

	return {
		caption:
			"Rain on glass at night, lit from behind: the element's own plate, and the one capture of the fifteen the manifests name that is in the build.",
		provenance: "Public/Evidence/Land/NightGlass-01.png\u2001FLASH OBSERVATION",
		folio: "〈FIGURE 01〉",
		src: "/Evidence/Land/NightGlass-01.png",
		alt: "Rain-speckled glass reflecting a green light at night",
	};
};

/* ─── THE PLATE ──────────────────────────────────────────────────────────── */

