				revoked:
					"THE EDITION WAS SUPERSEDED BY EDITION 02 ON 2026-11-19",
				state: "archived" as const,
			}
		: {}),
	...(Row.variant === "expires"
		? {
				expires: "2027-11-19",
				verify: { label: "VERIFY THE MARK", href: "/Verify" },
			}
		: {}),
});

/* ─── THE FAILURE ────────────────────────────────────────────────────────── */

const FailureOf = (Row: Specimen): Failure => ({
	index: "FAILURE_01",
	name: "BLANK WORKBENCH",
	symptom:
		"The window opens, the tree is empty, and no document is loaded: the editor is running and has nothing to show.",
	cause:
		"The workspace was opened at a path the editor cannot read, so the tree resolved to nothing and the last document's handle was stale.",
	next:
		Row.variant === "deadend"
			? "UNAVAILABLE"
			: "OPEN THE WORKSPACE FROM ITS ROOT, NOT FROM A PARENT DIRECTORY",
	state: "interrupted",
	source: "/Doc/Troubleshooting\u2001SECTION 2",
	...(Row.variant === "deadend" ? {} : {}),
	...(Row.variant === "recovery"
		? {
				recovery: {
					label: "RE-OPEN THE WORKSPACE",
					href: "/Doc/Troubleshooting",
				},
				detail:
					"The failure reproduces when the editor is started from a shell whose working directory is the repository's parent: the tree walks up, finds no package manifest, and stops. Starting from the root, or passing the path explicitly, resolves it. The log line is `workspace: resolve -> none` at the moment the window is created.",
			}
		: {}),
});

/* ─── THE STAGE'S BOX ────────────────────────────────────────────────────── */

/** The stage's own width, from the row. */
const SkinClass = (Row: Specimen): string => {
	const Width = Row.width ?? "band";

	return `specimen-narrative__stage specimen-narrative__stage--${Width}`;
};
---

<div class="specimen-narrative">
	{Groups.map((Group) => (
		<section class="specimen-narrative__group" key={Group.key}>
			<p class="specimen-narrative__group-head">
				<span class="specimen-narrative__group-kicker">
					{Group.label}
				</span>
				<span class="specimen-narrative__group-count">
					{InGroup(Group.key).length}
				</span>
			</p>

			<p class="specimen-narrative__group-note">{Group.note}</p>

			<div class="specimen-narrative__rows">
				{InGroup(Group.key).map((Entry) => (
					<article
						class="specimen-narrative__row"
						id={`narrative-${Entry.mark}`}
					>
						<header class="specimen-narrative__spec">
							<p class="specimen-narrative__mark">
								<span
									class="specimen-narrative__mark-hash"
									aria-hidden="true"
								>
									#
								</span>
								{Entry.mark}
							</p>

							<h3 class="specimen-narrative__state">
								{Entry.state_name}
							</h3>

							<p class="specimen-narrative__part">
								{Entry.component}
							</p>

							<p class="specimen-narrative__when">
								{Entry.when}
							</p>
						</header>

						<div
							class={SkinClass(Entry)}
							data-skin={Entry.width ?? "band"}
						>
							{Entry.kind === "band" ? (
								<RecordBand band={BandOf(Entry)}>
									<p class="specimen-narrative__prose">
										{Prose}
									</p>
									<RecordLedger
										rows={[
											{
												key: "STAGES:",
												value: "03",
												note: "source, verify, prepare",
											},
											{
												key: "TARGET:",
												value: "MACOS\u2001AARCH64",
											},
										]}
									/>
								</RecordBand>
							) : Entry.kind === "entry" ? (
								<RecordEntry {...EntryOf(Entry)} />
							) : Entry.kind === "stage" ? (
								<RecordStage
									stages={StageOf(Entry)}
									variant={
										Entry.variant === "plates"
											? "plates"
											: "rail"
									}
									orientation={
										Entry.rows === 9 ? "stack" : "row"
									}
									current={Entry.current}
									state={
										Entry.rows === 0
											? "empty"
											: undefined
									}
									empty={Entry.empty}
								/>
							) : Entry.kind === "figure" ? (
								<RecordFigure {...FigureOf(Entry)} />
							) : Entry.kind === "plate" ? (
								<RecordPlate plate={PlateOf(Entry)} />
							) : Entry.kind === "well" ? (
								<RecordWell {...WellOf(Entry)} />
							) : Entry.kind === "transcript" ? (
								<RecordTranscript
									transcript={TranscriptOf(Entry)}
								/>
							) : Entry.kind === "pair" ? (
								<RecordPair pair={PairOf(Entry)} />
							) : Entry.kind === "hero" ? (
								<RecordHero {...HeroOf(Entry)} />
							) : Entry.kind === "archive" ? (
								<RecordArchive {...ArchiveOf(Entry)} />
							) : Entry.kind === "aside" ? (
								<RecordAside aside={AsideOf(Entry)} />
							) : Entry.kind === "margin" ? (
								<RecordMargin note={MarginOf(Entry)} />
							) : Entry.kind === "inset" ? (
								<RecordInset inset={InsetOf(Entry)} />
							) : Entry.kind === "stamp" ? (
								<RecordStamp stamp={StampOf(Entry)} />
							) : Entry.kind === "failure" ? (
								<RecordFailure
									failure={FailureOf(Entry)}
								/>
							) : null}
						</div>
					</article>
				))}
			</div>
		</section>
	))}
</div>
