	subject: "The editor at first paint, with no document open.",
	caption:
		"Read the tree first, then the field, then the panel: the three regions the interface is made of, in the order a reader meets them.",
	facts: PlateFacts,
	source: "Public/Evidence/Land/manifest.yaml",
	asOf: "2026-11-14",
	...(Row.variant === "open" ? { open: true } : {}),
	...(Row.state === "unavailable"
		? {
				state: "unavailable" as const,
				next: "READ THE MANIFEST, WHICH NAMES THE SUBJECT AND THE MODE",
			}
		: {
				src: "/Evidence/Land/NightGlass-01.png",
				alt: "Rain-speckled glass reflecting a green light at night",
			}),
});

/* ─── THE WELL ───────────────────────────────────────────────────────────── */

/** A config block with one line that will not fit any column. */
const LongConfig = [
	"{",
	'  "target": "macos-aarch64",',
	'  "features": ["telemetry", "updater", "signing"],',
	'  "identifier": "land.editor.desktop.application.bundle.for.macos.aarch64.with.the.default.entitlements.and.no.sandbox.profile",',
	'  "window": { "width": 1440, "height": 900 },',
	"}",
];

/** A command's output, twelve lines of it, of which four print. */
const BuildOutput = Array.from(
	{ length: 12 },
	(_, Index) =>
		`stage ${String(Index + 1).padStart(2, "0")} / 12\u2001${Pipeline[Index % Pipeline.length]!.label.toLowerCase()}\u2001ok`,
);

const WellOf = (Row: Specimen): Well => {
	if (Row.state === "empty") {
		return {
			label: "INSTALL",
			language: "bash",
			lines: [],
			state: "empty",
			empty: Row.empty,
			source: "/Doc/Install",
		};
	}

	if (Row.variant === "wrap") {
		return {
			label: "CONFIG",
			language: "json",
			lines: LongConfig,
			wrap: true,
			note: "THE CONFIG IS READ, NOT TYPED: THE WELL WRAPS IT SO THE LONGEST VALUE PRINTS IN FULL.",
			source: "tauri.conf.json",
		};
	}

	if (Row.variant === "window") {
		return {
			label: "OUTPUT",
			language: "text",
			lines: BuildOutput,
			window: { showing: 4, total: "240" },
			note: "THE COPY PAYLOAD IS EVERY LINE THE BLOCK HOLDS; THE PAGE PRINTS THE FIRST FOUR AND NAMES THE REST.",
			source: "the build's own log, at this commit",
		};
	}

	return {
		label: "INSTALL",
		language: "bash",
		lines: [
			"$ git clone https://github.com/CodeEditorLand/Site",
			"$ cd Site && dum install",
			"$ dum Run\u2001# http://localhost:9999/",
		],
		source: "/Doc/Install",
	};
};

/* ─── THE TRANSCRIPT ─────────────────────────────────────────────────────── */

const Turns = [
	{ mark: "→", speaker: "READER", line: "dum Run", stamp: "00:00" },
	{
		mark: "↳",
		speaker: "BUILD",
		line: "reading Source/Content/Record/Land.ts",
		stamp: "00:01",
	},
	{
		mark: "↳",
		speaker: "BUILD",
		line: "stage 01 / 12 source\u2001ok",
		stamp: "00:04",
	},
	{
		mark: "→",
		speaker: "READER",
		line: "open /Doc/Build-Pipeline",
		stamp: "00:06",
	},
	{
		mark: "↳",
		speaker: "BUILD",
		line: "route resolved: 26 routes in the register",
		stamp: "00:07",
	},
	{
		mark: "#",
		speaker: "DESK",
		line: "the session is recorded from the first command",
		stamp: "00:09",
	},
];

const TranscriptOf = (Row: Specimen): Transcript => {
	const Count = Row.rows ?? Turns.length;

	const Printed = Array.from({ length: Count }, (_, Index) => {
		const Turn = Turns[Index % Turns.length]!;

		return Row.state === "failed" && Index === 3
			? {
					...Turn,
					mark: "◎",
					speaker: "BUILD",
					line: "stage 04 / 12 sign\u2001failed",
					state: "interrupted" as const,
					cause: "no signing key is configured for this target",
					next: "SET LAND_SIGNING_KEY, OR BUILD WITH SIGNING DISABLED",
				}
			: Turn;
	});

	return {
		index: "TRANSCRIPT_01",
		label: "BUILD",
		turns: Printed,
		source: "/Doc/Build-Pipeline\u2001THE RUN AT THIS COMMIT",
		asOf: "2026-11-19",
		...(Row.state === "loading"
			? { state: "loading" as const }
			: Row.state === "empty" || Count === 0
				? { state: "empty" as const, empty: Row.empty }
				: {}),
		...(Row.variant === "window"
			? { window: { showing: Count, total: "240" } }
			: {}),
		...(Row.state === "failed"
			? {
					retry: {
						label: "RE-RUN THE BUILD",
						href: "/Doc/Build-Pipeline",
					},
					note: "THE SESSION STOPS AT THE FIRST FAILED STAGE AND DOES NOT RETRY ITSELF.",
				}
			: {}),
	};
};

/* ─── THE PAIR ───────────────────────────────────────────────────────────── */

const PairOf = (Row: Specimen): Pair => ({
