	return `specimen-reading__stage specimen-reading__stage--${Width}`;
};
---

<div class="specimen-reading">
	{Groups.map((Group) => (
		<section class="specimen-reading__group">
			<p class="specimen-reading__group-head">
				<span class="specimen-reading__group-kicker">{Group.label}</span>
				<span class="specimen-reading__group-count">
					{InGroup(Group.key).length}
				</span>
			</p>

			<p class="specimen-reading__group-note">{Group.note}</p>

			<div class="specimen-reading__rows">
				{InGroup(Group.key).map((Entry) => (
					<article class="specimen-reading__row" id={`reading-${Entry.mark}`}>
						<header class="specimen-reading__spec">
							<p class="specimen-reading__mark">
								<span class="specimen-reading__mark-hash" aria-hidden="true">
									#
								</span>
								{Entry.mark}
							</p>

							<h3 class="specimen-reading__state">{Entry.state_name}</h3>

							<p class="specimen-reading__part">{Entry.component}</p>

							<p class="specimen-reading__when">{Entry.when}</p>
						</header>

						<div class={SkinClass(Entry)} data-skin={Entry.width ?? "band"}>
							{Entry.kind === "article" ? (
								<DocArticle
									kicker="/Deep Dive"
									title={
										Entry.variant === "longheading"
											? "The runtime, its boundaries, and the parts of the platform it deliberately does not own"
											: "What the editor is"
									}
									standfirst={
										Entry.variant === "nosummary"
											? undefined
											: "One native application, with the editor's API on top and no Chromium in the process tree."
									}
									strip={STRIP}
									contents={TocFor(Entry.mark)}
									crumbs={CRUMBS}
									source="Source/Content/Doc/WhatItIs.md"
									state={
										Entry.variant === "empty"
											? "empty"
											: Entry.variant === "loading"
												? "loading"
												: "rest"
									}
									empty="This page's prose has not been set in this build: its source is in the documentation collection, and the setter has not run over it yet."
								>
									<h2 id={`spec-read-1-${Entry.mark}`}>What the editor is</h2>
									<p>{Prose}</p>
									<h2 id={`spec-read-2-${Entry.mark}`}>
										The runtime, and what it does not own
									</h2>
									<p>{ProseSecond}</p>
									<h2 id={`spec-read-3-${Entry.mark}`}>
										The extension host
									</h2>
									<p>{ProseThird}</p>
								</DocArticle>
							) : Entry.kind === "layout" ? (
								<DocLayout
									sections={
										Entry.variant === "notree"
											? SECTIONS_NONE
											: Entry.variant === "ninety"
												? SECTIONS_MANY
												: Entry.variant === "onesection"
													? SECTIONS_ONE
													: SECTIONS
									}
									contents={
										Entry.variant === "ninety"
											? TOC_MANY
											: Entry.variant === "onesection"
												? TOC_ONE
												: TOC
									}
									activeId="runtime"
									mobile={false}
									id={`spec-read-layout-${Entry.mark}`}
								>
									<p class="specimen-reading__prose">{Prose}</p>
									<p class="specimen-reading__prose">{ProseSecond}</p>
								</DocLayout>
							) : Entry.kind === "contents" ? (
								<DocContents
									toc={
										Entry.variant === "one"
											? TOC_ONE
											: Entry.variant === "many"
												? TOC_MANY
												: Entry.variant === "long"
													? TOC_LONG
													: TOC
									}
									variant={
										Entry.variant === "disclosure" ? "disclosure" : "rail"
									}
									collapsible={Entry.variant === "fold"}
									dense={Entry.dense}
								/>
							) : Entry.kind === "contentslist" ? (
								<DocContentsList
									items={
										Entry.variant === "many" ? TOC_MANY.Items : TOC.Items
									}
								/>
							) : Entry.kind === "layer" ? (
								<DocLayer
									label="LAYER:"
									heading="Deep Dive"
									unit="PAGES"
									unitOne="PAGE"
									entries={
										Entry.variant === "one"
											? [
													{
														Id: "solo",
														Label: "The Only Page Of This Layer",
														Href: "/Doc/solo",
													},
												]
											: Entry.variant === "long"
												? [
														{
															Id: "long",
															Label:
																"The Runtime, Its Boundaries, And The Parts Of The Platform It Does Not Own",
															Href: "/Doc/long",
														},
														{
															Id: "runtime",
															Label: "The Runtime",
															Href: "/Doc/runtime",
														},
													]
												: [
														{
															Id: "land",
															Label: "Land",
															Href: "/Doc/land",
														},
														{
															Id: "mountain",
															Label: "Mountain",
															Href: "/Doc/mountain",
														},
														{
															Id: "cocoon",
															Label: "Cocoon",
															Href: "/Doc/cocoon",
														},
														{
															Id: "wind",
															Label: "Wind",
															Href: "/Doc/wind",
														},
														{
															Id: "sky",
															Label: "Sky",
															Href: "/Doc/sky",
														},
														{
															Id: "air",
															Label: "Air",
															Href: "/Doc/air",
														},
														{
															Id: "echo",
															Label: "Echo",
															Href: "/Doc/echo",
														},
														{
															Id: "grove",
															Label: "Grove",
															Href: "/Doc/grove",
														},
														{
															Id: "pipeline",
															Label: "The Build Pipeline",
															Href: "/Doc/pipeline",
														},
														{
															Id: "compat",
															Label: "The Compatibility Surface",
															Href: "/Doc/compat",
														},
														{
															Id: "footprint",
															Label: "The Filesystem Footprint",
															Href: "/Doc/footprint",
														},
														{
															Id: "back-matter",
															Label: "The Back Matter",
															Href: "/Doc/back-matter",
														},
														{
															Id: "verify",
															Label: "How To Verify A Claim",
															Href: "/Doc/verify",
														},
														{
															Id: "unbuilt",
															Label: "What Is Not Built Yet",
															Href: "/Doc/unbuilt",
														},
														{
															Id: "glossary",
															Label: "The Glossary",
															Href: "/Doc/glossary",
														},
													]
									}
									activeId="land"
								/>
							) : Entry.kind === "index" ? (
								<DocIndex
									section={{
										...(Entry.variant === "absent"
											? CHAPTER_ABSENT
											: Entry.variant === "many"
												? CHAPTER_MANY
												: CHAPTER),
										Id: `${Entry.variant ?? "chapter"}-${Entry.mark}`,
									}}
								/>
							) : Entry.kind === "card" ? (
								<ul class="specimen-reading__cards">
									<DocCard
										card={
											Entry.variant === "absent"
												? {
														Id: "runtime",
														Label: "The runtime",
														Href: "/Doc/runtime",
													}
												: Entry.variant === "feature"
													? {
															Id: "start",
															Label: "Where to Start",
															Note: "Three pages: what the editor is, how it is built, and how to check the claim.",
															Href: "/Doc#start",
														}
													: CARDS[0]!
										}
										level={Entry.variant === "feature" ? 2 : 3}
									/>
								</ul>
							) : Entry.kind === "appendix" ? (
								<DocAppendix
									appendix={{
										...(Entry.variant === "stripabsent"
											? STRIP_ABSENT
											: Entry.variant === "backend"
												? BACKEND
												: Entry.variant === "deployments"
													? DEPLOYMENTS
													: ARCHITECTURE),
										Id: `${Entry.variant ?? "architecture"}-${Entry.mark}`,
									}}
									state={Entry.variant === "empty" ? "empty" : "rest"}
									empty="The destinations this panel lists have not been read in this build, so the panel states what would be here rather than printing an empty body."
								/>
							) : Entry.kind === "rust" ? (
								<RustViewer
									crates={
										Entry.variant === "empty"
											? []
											: Entry.variant === "one"
												? CRATE_ONE
												: Entry.variant === "many"
													? CRATES_MANY
													: CRATES
									}
									label="Rust crate group"
									title="Rust API Documentation"
									id={`Specimen-${Entry.mark}`}
								/>
							) : Entry.kind === "foot" ? (
								<BandFoot
									index="03"
									part="/DEEP DIVE"
									see={
										Entry.variant === "noxref"
											? undefined
											: Entry.variant === "loading"
												? []
												: REFERENCES
									}
									seeState={
										Entry.variant === "loading" ? "loading" : "rest"
									}
									figure={{ value: "26", unit: "CLAUSES" }}
									asOf="2026-11-18"
									source="Source/Content/Index/Chapters.ts"
									surface={Entry.variant === "card" ? "card" : "band"}
								/>
							) : Entry.kind === "folio" ? (
								<Folio
									index="03"
									part={
										Entry.variant === "part"
											? "/DOC/DEEP-DIVE-FILESYSTEM-FOOTPRINT-USER-DOTFILE"
											: "/LEGAL"
									}
									figure={{ value: "26", unit: "CLAUSES" }}
									asOf="2026-11-18"
									source={
										Entry.variant === "source" || Entry.variant === "part"
											? "Source/Content/Doc/DeepDive/FilesystemFootprint/UserDotfile.md"
											: Entry.variant === "partial"
												? undefined
												: "Source/Content/Index/Chapters.ts"
									}
								/>
							) : Entry.kind === "see" ? (
								<See
									items={Entry.variant === "bare" ? BARE : REFERENCES}
									state={Entry.variant === "loading" ? "loading" : "rest"}
								/>
							) : Entry.kind === "reading" ? (
								<ReadingDocument
									kicker="/LEGAL"
									heading="Terms of Use"
									standfirst={
										Entry.variant === "nosummary"
											? undefined
											: "The terms the software is offered under, and what they do and do not promise."
									}
									rows={FACTS}
									index={
										Entry.variant === "empty"
											? ClauseOneFor(Entry.mark)
											: Entry.variant === "loading"
												? ClauseOneFor(Entry.mark)
												: Entry.variant === "stack"
													? ClausesFor(Entry.mark).slice(0, 6)
													: ClausesFor(Entry.mark)
									}
									indexLabel="Clauses"
									layout={Entry.variant === "rail" ? "rail" : "stack"}
									ledgerSurface="standard"
									ledgerColumns={2}
									bodyClass="LegalCard"
									state={
										Entry.variant === "empty"
											? "empty"
											: Entry.variant === "loading"
												? "loading"
												: "rest"
									}
								>
									<h2 id={`spec-clause-1-${Entry.mark}`}>
										§01 The software is offered as it is
									</h2>
									<p>{Prose}</p>
									<h2 id={`spec-clause-2-${Entry.mark}`}>
										§02 No warranty is given or implied
									</h2>
									<p>{ProseSecond}</p>
									<h2 id={`spec-clause-3-${Entry.mark}`}>
										§03 The mark covers the tree
									</h2>
									<p>{ProseThird}</p>
								</ReadingDocument>
							) : Entry.kind === "leader" ? (
								<Leader
									items={
										Entry.variant === "one"
											? LEADER_ONE
											: Entry.variant === "many"
												? LEADER_MANY
												: Entry.variant === "unavailable"
													? LEADER_UNAVAILABLE
													: Entry.variant === "empty"
														? []
														: Entry.variant === "loading"
															? CHAPTER_ENTRIES
															: CHAPTER_ENTRIES
									}
									register={
										Entry.variant === "many"
											? MANY_REGISTER
											: Entry.variant === "empty"
												? RegisterOf("CHAPTERS", [])
												: CHAPTER_REGISTER
									}
									columns={Entry.variant === "many" ? 2 : 1}
									state={
										Entry.variant === "empty"
											? "empty"
											: Entry.variant === "loading"
												? "loading"
												: "rest"
									}
									empty="No chapter is filed for this set: the index is generated from the collection, and the collection has not been read."
									limit={Entry.variant === "many" ? 6 : undefined}
									more={
										Entry.variant === "many"
											? { label: "READ THE INDEX", href: "/Contents" }
											: undefined
									}
								/>
							) : null}
						</div>
					</article>
				))}
			</div>
		</section>
	))}
</div>
