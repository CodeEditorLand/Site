/* ─── THE DOCUMENT'S OWN PROSE ───────────────────────────────────────────── */

/** One sentence the site states about itself, used wherever a body is needed. */
const Prose =
	"The editor runs natively on macOS, Windows and Linux: Rust and Tauri underneath, the VS Code extension API on top, and no Chromium in the process tree.";

/** A second sentence, for the blocks that hold two. */
const ProseSecond =
	"Extensions are unmodified: the marketplace's packages load as they are, and nothing in the editor has to be rebuilt to carry them.";

/** A third, for the article bodies that need a third paragraph. */
const ProseThird =
	"The build is a pipeline of three stages - source, verify, prepare - and every stage writes what it read, so a claim in this document can be checked against the file it came from.";

/* ─── THE CONTENTS ───────────────────────────────────────────────────────── */

/** One section of a document, as the contents register files it. */
const Toc = (Label: string, Position: number) => ({
	Label,
	Href: `#spec-read-${Position}`,
});

/** The twelve sections a resting documentation page has. */
const TOC_LABELS = [
	"What the editor is",
	"The runtime, and what it does not own",
	"The extension host",
	"Unmodified extensions",
	"The build pipeline",
	"What a build reads",
	"What a build writes",
	"The compatibility surface",
	"The filesystem footprint",
	"Where the source lives",
	"How to verify a claim",
	"What is not built yet",
];

const TocItems = TOC_LABELS.map((Label, Position) => Toc(Label, Position + 1));

const TOC: DocToc = { Label: "On this page", Items: TocItems };

/**
 * The same list with this row's own targets.
 *
 * The sheet mounts five articles, so an id may not be `spec-read-1` five times:
 * each row's headings carry the row's mark and its contents point at them, which
 * keeps every specimen a working jump list instead of a picture of one.
 */
const TocFor = (Mark: string): DocToc => ({
	Label: TOC.Label,
	Items: TOC.Items.map((Item, Position) => ({
		Label: Item.Label,
		Href: `#spec-read-${Position + 1}-${Mark}`,
	})),
});

const TOC_ONE: DocToc = {
	Label: "On this page",
	Items: [Toc("What the editor is", 1)],
};

/** Ninety sections: the document the register folds itself for. */
const TOC_MANY: DocToc = {
	Label: "On this page",
	Items: Array.from({ length: 90 }, (_, Index) =>
		Toc(`SECTION ${String(Index + 1).padStart(2, "0")}`, Index + 1),
	),
};

