---
/**
 * SpecimenSheet - the contact sheet: every part as one cell, on one page.
 *
 * ─── GRAMMAR ─────────────────────────────────────────────────────────────
 * INFORMATION TYPE  a set of like objects, read as a set: the parts of this
 *                   document, each one a cell. Not an archive (which files
 *                   records under names a reader already knows), not a matrix
 *                   (which reads one row across several columns), and not a
 *                   ledger (which states facts about a single object).
 * RANK              set.
 * SLOT CONTRACT     rows[] -> mark, name, note, kind, disposition, href?
 *                   label  -> the register line's word, `SHEET`
 * MAY HOLD          cells. One mark, one name, one line, one disposition.
 * MAY NOT HOLD      prose, a figure, a part's contract, an action.
 * WIDE              four equal cells across. Equal is right here and almost
 *                   nowhere else: the parts are genuinely equal, and the reader
 *                   is choosing between them rather than reading them in order.
 * NARROW            two cells across, then one below 30rem. The cell keeps its
 *                   four lines and its disposition; it does not become a row.
 * DENSE             yes, by construction - it is a sheet. The density is the
 *                   cell's, not the type's: nothing here is smaller than the
 *                   meta tier, because a contact sheet is not a fine print.
 *
 * ─── THE DISPOSITION IS THE CELL'S FOURTH LINE ────────────────────────────
 * A printed part prints `→ PLATE 03` and links to it. An absent part prints
 * `◎ ABSENT` and does not link, because the sheet prints that part's reason in
 * place of a plate and a link to a plate that does not exist is a dead link
 * dressed as a live one. The mark is the grammar's: `→` is a direction, `◎` is
 * the fallback mark for a thing with no glyph.
 *
 * ─── IT IS A LIST, NOT A GRID OF CARDS ────────────────────────────────────
 * The cells are `<li>` in an `<ol>` and they paint no surface: one hairline
 * between cells, no fill, no radius. A contact sheet is a printed grid, and a
 * grid of white boxes would be nine cards wearing a sheet's name.
 *
 * No script and no hydration: a sheet is printed.
 */
import type { Part } from "../../Content/Specimen/Parts.js";

interface Props {
	/** The cells, in the sheet's order. The block sorts nothing. */
	rows: readonly Pick<
		Part,
		"mark" | "name" | "note" | "kind" | "disposition" | "plate"
	>[];

	/** The register line's word: `SHEET`. */
	label: string;

	/** The register line's count, printed after the label. */
	count: number | string;

	/**
	 * What the sheet says when it has no rows. Required, because the empty sheet
	 * is the one state a contact sheet must be able to state: a grid with no
	 * cells is otherwise a page that failed to load.
	 */
	empty: string;

	/** Extra classes from the page. */
	class?: string;
}

const { rows, label, count, empty, class: ClassName } = Astro.props;

/** The word and the mark each disposition prints in the cell's fourth line. */
const Disposition = {
	printed: { mark: "\u2192", word: "PRINTED" },
	absent: { mark: "\u25ce", word: "ABSENT" },
	folded: { mark: "\u21b3", word: "FOLDED" },
} as const;
---

<section
	class:list={["specimen-sheet", ClassName]}
	aria-label={`${label}: ${count} parts`}
>
	<p class="specimen-sheet__register">
		<span class="specimen-sheet__register-mark" aria-hidden="true">
			#
		</span>
		<span class="specimen-sheet__register-word">{label}</span>
		<span class="specimen-sheet__register-sep" aria-hidden="true">
			{"\u2001"}
		</span>
		<span class="specimen-sheet__register-count">{count}</span>
	</p>

	{rows.length === 0 ? (
		<p class="specimen-sheet__empty">{empty}</p>
	) : (
		<ol class="specimen-sheet__cells">
			{rows.map((Row) => {
				const State = Disposition[Row.disposition];
				const Body = (
					<>
						<span class="specimen-sheet__mark" aria-hidden="true">
							{Row.mark}
						</span>
						<span class="specimen-sheet__body">
							<span class="specimen-sheet__name">{Row.name}</span>
							<span class="specimen-sheet__note">{Row.note}</span>
						</span>
						<span class="specimen-sheet__kind">{Row.kind}</span>
						<span
							class:list={[
								"specimen-sheet__state",
								`specimen-sheet__state--${Row.disposition}`,
							]}
						>
							<span
								class="specimen-sheet__state-mark"
								aria-hidden="true"
							>
								{State.mark}
							</span>
							{State.word}
						</span>
					</>
				);

				return (
					<li
						class="specimen-sheet__cell"
						data-disposition={Row.disposition}
					>
						{Row.plate === undefined ? (
							<span class="specimen-sheet__cell-inner">
								{Body}
							</span>
						) : (
							<a
								class="specimen-sheet__cell-inner"
								href={Row.plate}
							>
								{Body}
							</a>
						)}
					</li>
				);
			})}
		</ol>
	)}
</section>
