/** The stage's own width, from the row. */
const SkinClass = (Entry: Specimen): string => {
	const Width = Entry.width ?? "band";

	return `specimen-apparatus__stage specimen-apparatus__stage--${Width}`;
};

/** A ledger row set, as the register line above it. */
