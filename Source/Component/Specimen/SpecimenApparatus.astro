/**
 * The same part for the field stage.
 *
 * A plate's anchor is derived from its part's `plate` reference, so two plates
 * printing one part would print one id twice - and a duplicate id is a document
 * that cannot be cited. The second row therefore carries its own reference, and
 * the two plates are two anchors.
 */
const PLATE_PART_FIELD: Part & { readonly plate: string } = {
	...PLATE_PART,
