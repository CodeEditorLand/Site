/** The tags a head writes, as the ledger rows the sheet prints. */
const TagRows = (Tags: readonly { kind: string; key: string; value: string }[]) =>
	Tags.filter((Tag) => Tag.kind !== "jsonld").map((Tag) => ({
		key: `${Tag.key}:`,
		value: Tag.value,
	}));

/** The JSON-LD node, as its own ledger: the three facts a feed reads. */
const NodeRows = (Tags: readonly { kind: string; key: string; value: string }[]) => {
	const Node = Tags.find((Tag) => Tag.kind === "jsonld");

	if (Node === undefined) return [] as readonly LedgerRow[];

	const Parsed = JSON.parse(Node.value) as Record<string, unknown>;

	return [
		{ key: "@TYPE:", value: String(Parsed["@type"]) },
		{ key: "NAME:", value: String(Parsed["name"]) },
		{ key: "URL:", value: String(Parsed["url"]) },
	];
};

