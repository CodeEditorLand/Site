	RegisterOf(Label, Rows);
---

<div class="specimen-apparatus">
	{Groups.map((Group) => (
		<section class="specimen-apparatus__group">
			<p class="specimen-apparatus__group-head">
				<span class="specimen-apparatus__group-kicker">{Group.label}</span>
				<span class="specimen-apparatus__group-count">
					{InGroup(Group.key).length}
				</span>
			</p>

			<p class="specimen-apparatus__group-note">{Group.note}</p>

			<div class="specimen-apparatus__rows">
				{InGroup(Group.key).map((Entry) => (
					<article
						class="specimen-apparatus__row"
						id={`apparatus-${Entry.mark}`}
					>
						<header class="specimen-apparatus__spec">
							<p class="specimen-apparatus__mark">
								<span
									class="specimen-apparatus__mark-hash"
									aria-hidden="true"
								>
									#
								</span>
								{Entry.mark}
							</p>

							<h3 class="specimen-apparatus__state">
								{Entry.state_name}
							</h3>

							<p class="specimen-apparatus__part">
								{Entry.component}
							</p>

							<p class="specimen-apparatus__when">{Entry.when}</p>
						</header>

						<div
							class={SkinClass(Entry)}
							data-skin={Entry.width ?? "band"}
						>
							{Entry.kind === "motionfold" ? (
								<MotionFold
									name="OPEN QUESTIONS"
									label={
										Entry.variant === "long" ? "THE RUN" : "AS FILED"
									}
									count={
										Entry.variant === "long"
											? "40"
											: Entry.variant === "empty"
												? "00"
												: Entry.variant === "loading"
													? undefined
													: "03"
									}
									leaves={
										Entry.variant === "gone"
											? FOLD_LEAVES_GONE
											: Entry.variant === "long"
												? FOLD_LEAVES_LONG
												: Entry.variant === "empty" ||
													  Entry.variant === "loading"
													? []
													: FOLD_LEAVES
									}
									state={
										Entry.variant === "loading" ? "loading" : "rest"
									}
									keys={
										Entry.variant === "loading"
											? SKELETON_KEYS
											: []
									}
									waiting={
										Entry.variant === "loading"
											? "THE FOUR ANSWERS THIS FOLD IS FOR"
											: undefined
									}
									long={Entry.variant === "long"}
									more={
										Entry.variant === "long"
											? "Forty leaves. The run scrolls inside its own frame and the summary still prints the whole count."
											: undefined
									}
									empty="No question is filed against this subject yet, so the fold opens onto a statement rather than onto a blank: the count above is the set's own zero."
								/>
							) : Entry.kind === "motionexpand" ? (
								<MotionExpand
									marker="# EXPAND / 03"
									records={
										Entry.variant === "gone"
											? EXPAND_GONE
											: Entry.variant === "nofact"
												? EXPAND_NOFACT
												: EXPAND_RECORDS
									}
									empty="No record is filed, so there is nothing to open: the set states what it would hold rather than printing a disclosure onto nothing."
								/>
							) : Entry.kind === "motionsequence" ? (
								<MotionSequence
									sequence={
										Entry.variant === "one"
											? SEQUENCE_ONE
											: Entry.variant === "unmeasured"
												? SEQUENCE_UNMEASURED
												: Entry.variant === "reduced"
													? SEQUENCE_REDUCED
													: SEQUENCE
									}
								/>
							) : Entry.kind === "motionskeleton" ? (
								<MotionSkeleton
									marker="# LOADING / 04"
									keys={
										Entry.variant === "empty"
											? []
											: SKELETON_KEYS
									}
									waiting="THE RELEASE MANIFEST"
									age={
										Entry.variant === "empty"
											? "318 DAYS"
											: "3 DAYS"
									}
									empty="The manifest's own field names have not arrived either, so this block can state that it is waiting and not what it is waiting for - the arm this card added."
								/>
							) : Entry.kind === "motionspecimen" ? (
								<MotionSpecimen
									motion={
										Entry.variant === "plate" ? undefined : FOLD
									}
									variant="wide"
									note={
										Entry.variant === "plate"
											? "The plate arm: no register column, because the class was stated above it."
											: "The stage holds a real fold. Open it: the leaves move and the box does not."
									}
								>
									<MotionFold
										name="WHAT THE FOLD KEEPS"
										label="THE RULE"
										count="02"
										leaves={STAGE_FOLD_LEAVES}
										empty="No rule is filed."
									/>
								</MotionSpecimen>
							) : Entry.kind === "motionorigin" ? (
								<MotionOrigin />
							) : Entry.kind === "sheet" ? (
								<SpecimenSheet
									rows={
										Entry.variant === "one"
											? SheetRows.slice(0, 1)
											: Entry.variant === "many"
												? SHEET_FORTY
												: Entry.variant === "empty"
													? []
													: SheetRows
									}
									label="SHEET"
									count={
										Entry.variant === "one"
											? "01 PART"
											: Entry.variant === "many"
												? "40 PARTS"
												: Entry.variant === "empty"
													? "00 PARTS"
													: `${SheetRows.length} PARTS`
									}
									empty="No part is filed, so there is nothing on this sheet. A specimen sheet with no parts is a document that has not been written yet, not a page that failed to load."
								/>
							) : Entry.kind === "plate" ? (
								<SpecimenPlate
									part={
										Entry.variant === "field"
											? PLATE_PART_FIELD
											: PLATE_PART
									}
									caption="The material strip at 1:1 on the surface it is printed on. A plate is one part, its contract beside it, and the caption that says what to look at."
									source="SOURCE/COMPONENT/SPECIMEN/SPECIMENMATERIAL.ASTRO"
									stage={Entry.variant === "field" ? "field" : "insert"}
								>
									<SpecimenMaterial
										items={Material}
										label="MATERIAL"
										count={`${Material.length} SPECIMENS`}
										empty="No specimen is filed, so the strip prints nothing."
									/>
								</SpecimenPlate>
							) : Entry.kind === "material" ? (
								<SpecimenMaterial
									items={Entry.variant === "empty" ? [] : Material}
									label="MATERIAL"
									count={
										Entry.variant === "empty"
											? "00 SPECIMENS"
											: `${Material.length} SPECIMENS`
									}
									empty="No specimen is filed, so the strip prints nothing. The material is not a preference that can be missing: it is read from the token sheet, and a strip with no rows is a build that lost the file."
								/>
							) : Entry.kind === "families" ? (
								<SpecimenFamilies
									families={
										Entry.variant === "one"
											? Families.slice(0, 1)
											: Families
									}
									label="GALLERY"
									count={
										Entry.variant === "one"
											? "01 BAND"
											: `${Families.length} BANDS`
									}
									empty="No band is filed, so the gallery states that it has nothing to index rather than printing a contents list with no contents."
								/>
							) : Entry.kind === "head" ? (
								<div class="specimen-apparatus__register">
									<RecordLedger
										rows={
											Entry.variant === "noimage"
												? TagRows(HEAD_NO_IMAGE)
												: Entry.variant === "article"
													? TagRows(HEAD_ARTICLE)
													: Entry.variant === "noindex"
														? TagRows(HEAD_NOINDEX)
														: TagRows(HEAD_PAGE)
										}
										columns={2}
										register={LedgerOf(
											"HEAD",
											TagRows(
												Entry.variant === "noimage"
													? HEAD_NO_IMAGE
													: Entry.variant === "article"
														? HEAD_ARTICLE
														: Entry.variant === "noindex"
															? HEAD_NOINDEX
															: HEAD_PAGE,
											),
										)}
									/>

									<RecordLedger
										rows={NodeRows(
											Entry.variant === "article"
												? HEAD_ARTICLE
												: Entry.variant === "noindex"
													? HEAD_NOINDEX
													: Entry.variant === "noimage"
														? HEAD_NO_IMAGE
														: HEAD_PAGE,
										)}
										columns={3}
										register={LedgerOf(
											"JSON-LD",
											NodeRows(
												Entry.variant === "article"
													? HEAD_ARTICLE
													: Entry.variant === "noindex"
														? HEAD_NOINDEX
														: Entry.variant === "noimage"
															? HEAD_NO_IMAGE
															: HEAD_PAGE,
											),
										)}
									/>
								</div>
							) : Entry.kind === "analytics" ? (
								<div class="specimen-apparatus__register">
									<RecordLedger
										rows={
											Entry.variant === "blocked"
												? ANALYTICS_BLOCKED
												: ANALYTICS_LIVE
										}
										columns={2}
										register={LedgerOf(
											"CONTEXT",
											Entry.variant === "blocked"
												? ANALYTICS_BLOCKED
												: ANALYTICS_LIVE,
										)}
									/>
								</div>
							) : Entry.kind === "auth0" ? (
								<div class="specimen-apparatus__register">
									<RecordLedger
										rows={
											Entry.variant === "unconfigured"
												? AUTH0_UNCONFIGURED
												: AUTH0_CONFIGURED
										}
										columns={2}
										register={LedgerOf(
											"IDENTITY",
											Entry.variant === "unconfigured"
												? AUTH0_UNCONFIGURED
												: AUTH0_CONFIGURED,
										)}
									/>
								</div>
							) : Entry.kind === "tracker" ? (
								<div class="specimen-apparatus__register">
									<RecordLedger
										rows={
											Entry.variant === "inert"
												? TRACKER_INERT
												: TRACKER_LIVE
										}
										columns={2}
										register={LedgerOf(
											"TRACKER",
											Entry.variant === "inert"
												? TRACKER_INERT
												: TRACKER_LIVE,
										)}
									/>
								</div>
							) : Entry.kind === "trail" ? (
								<Trail
									trail={
										Entry.variant === "one"
											? TRAIL_ONE
											: Entry.variant === "empty"
												? []
												: Entry.variant === "long"
													? TRAIL_LONG
													: TRAIL_FIVE
									}
								/>
							) : Entry.kind === "blogindex" ? (
								<BlogIndex
									trail={[
										{ label: "/HOME", href: "/" },
										{ label: "/BLOG" },
									]}
									heading="The archive"
									standfirst="Every piece filed against this project, newest first."
									rows={
										Entry.variant === "one"
											? BLOG_ROWS.slice(0, 1)
											: Entry.variant === "empty"
												? []
												: BLOG_ROWS
									}
									emptyTitle="No entry is filed"
									emptyNote="The archive is built from the collection, and the collection answered with nothing. The plate above states the same fact in the record grammar rather than printing four zeroes."
									backLabel="Back to the top"
									backHref="#apparatus-APPARATUS_43"
									register={
										Entry.variant === "one"
											? RegisterOf("BLOG", BLOG_ROWS.slice(0, 1), {
													unit: "ENTRIES",
												})
											: Entry.variant === "empty"
												? RegisterOf("BLOG", [], {
														unit: "ENTRIES",
													})
												: BLOG_REGISTER
									}
									plateMeasures={
										Entry.variant === "empty"
											? []
											: BLOG_MEASURES
									}
									plateCaption="What this archive is, measured: the entries it holds, the tags they carry, the authors who filed them, and the newest date among them."
									plateSource="SOURCE/CONTENT/BLOG/INDEX.TS"
								/>
							) : Entry.kind === "blogarticle" ? (
								<BlogArticle
									title="How the build system is designed"
									summary="Every artefact the editor ships is built from source, and the pipeline that does it is part of the product."
									tags={["BUILD", "RUST"]}
									author="Nikola R. Hristov"
									date="2026-11-19"
									readTime="9 min read"
									toc={
										Entry.variant === "noregister" ? null : ARTICLE_TOC
									}
									trail={[
										{ label: "/HOME", href: "/" },
										{ label: "/BLOG", href: "/Blog" },
										{ label: "/BUILD SYSTEM DESIGN" },
									]}
									backLabel="Back to the archive"
									backHref="#apparatus-APPARATUS_46"
									summaryRows={ARTICLE_SUMMARY}
									summaryRegister={ARTICLE_REGISTER}
									notes={ARTICLE_NOTES}
									aside={null}
									registerEmpty="This piece is shorter than the register's floor: it has fewer than five sections, so a contents list would be a list of two and a reader can see both by scrolling."
								>
									<p id="the-shape-of-the-pipeline">
										The editor is built from source, and the
										pipeline that builds it is part of the
										product rather than a script beside it.
										Every artefact the site publishes is
										produced by the same pass that reads the
										tree, which is why a figure on a page and
										the file it cites cannot disagree.
									</p>
									<p id="what-is-built">
										The pipeline has three stages: the tree is
										read, the content is composed, and the
										artefacts are written. The first stage is
										the only one that can fail in a way a
										reader sees, and it fails at build time
										rather than at request time.
									</p>
								</BlogArticle>
							) : (
								<SurfaceAbsent
									status="UNAVAILABLE"
									wouldBe="The fold's leaves, printed on paper, under the register line that counts them."
									whyNot={Entry.when}
									next={{
										label: "READ THE OBSERVATION",
										href: "#apparatus-matrix",
									}}
									note="SOURCE: SOURCE/STYLESHEET/SYSTEM/MOTION/_FOLD.SCSS"
								/>
							)}
						</div>
					</article>
				))}
			</div>
		</section>
	))}
</div>
