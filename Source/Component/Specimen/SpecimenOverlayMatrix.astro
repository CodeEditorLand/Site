---
/**
 * SpecimenOverlayMatrix - the overlay family's state matrix, and the one
 * dismissal contract every slip in the family holds.
 *
 * ─── TWO ARTIFACTS, ONE ARGUMENT ──────────────────────────────────────────
 * The matrix says what the family was asked to survive. The contract table says
 * what it does when the reader leaves - escape, outside click, focus return,
 * scroll lock, and the trigger that is removed while the slip is open. They sit
 * on one plate because they are the same claim from two sides: a component that
 * survives its worst combination is only half a component if it forgets where
 * the reader was.
 *
 * ─── THE NOTES ARE THE ARTIFACT'S OTHER HALF ──────────────────────────────
 * A cell that cannot exist carries a reason, and a reason is a sentence: it will
 * not fit in a six-rem column, and a truncated reason is a reason that has been
 * tidied into an excuse. So the cell prints `N/A` and the reason's mark in the
 * containment brackets - `N/A 〈04〉` - and the notes below print all of them in
 * full, numbered, in the order they are met reading across and down.
 *
 * ─── THE ROW NAME IS PINNED, THE MATRIX SCROLLS ───────────────────────────
 * Twenty columns do not fit a page and must not be compressed to. The table
 * scrolls inside its own frame and the component's name stays at the leading
 * edge, which is the same device the input family's matrix and the plate's spec
 * column use.
 *
 * ─── EVERY FIGURE IS DERIVED ──────────────────────────────────────────────
 * `BuiltOf(Row)` under each name, the note count in the notes' head, and the
 * register under the table are all counted from the tables in
 * `Content/Specimen/Overlay.ts`. A cell added there changes every figure here.
 */
import {
	BuiltCount,
	BuiltOf,
	CellCount,
	Columns,
	MatrixCell,
	MatrixRegister,
	ReasonCount,
	Rows,
} from "../../Content/Specimen/Overlay.js";

import { Dismissals } from "../UI/Overlay";

import RecordLedger from "../Record/RecordLedger.astro";

import { RegisterOf } from "../Record/RegisterLine.js";

/** Every cell that cannot exist, numbered - the matrix's footnotes. */
const Notes = Rows.flatMap((Row) =>
	Columns.filter((Column) => MatrixCell(Row, Column).disposition === "na").map(
		(Column) => ({ Row, Column, Cell: MatrixCell(Row, Column) }),
	),
).map((Note, Index) => ({ ...Note, mark: String(Index + 1).padStart(2, "0") }));

/** The footnote a cell points at. */
const NoteMark = (RowName: string, Key: string): string | undefined =>
	Notes.find((Note) => Note.Row.name === RowName && Note.Column.key === Key)
		?.mark;

/**
 * Whether a column opens a new group.
 *
 * The matrix prints a heavier rule where a state becomes a shape and where a
 * shape becomes a context, because those are three different questions and a
 * reader scanning the head should see where one set ends.
 */
const OpensGroup = (Index: number): boolean =>
	Index > 0 && Columns[Index]!.group !== Columns[Index - 1]!.group;

/** The figures, and the register that counts them. */
const Figures = MatrixRegister();

const Matrix = RegisterOf("THE MATRIX", Figures);
---

<figure class="overlay-matrix" id="overlay-matrix">
	<div class="overlay-matrix__scroll">
		<table class="overlay-matrix__table">
			<thead>
				<tr class="overlay-matrix__head-row">
					<th class="overlay-matrix__corner" scope="col">
						<span class="overlay-matrix__corner-label">COMPONENT</span>
						<span class="overlay-matrix__corner-ask">
							{Columns.length} CONDITIONS
						</span>
					</th>

					{
						Columns.map((Column, Index) => (
							<th
								class:list={[
									"overlay-matrix__head",
									OpensGroup(Index) && "overlay-matrix__head--group",
								]}
								scope="col"
							>
								<span class="overlay-matrix__head-label">
									{Column.label}
								</span>
								<span class="overlay-matrix__head-ask">
									{Column.ask}
								</span>
							</th>
						))
					}
				</tr>
			</thead>

			<tbody>
				{
					Rows.map((Row) => (
						<tr class="overlay-matrix__row">
							<th class="overlay-matrix__name" scope="row">
								<span class="overlay-matrix__name-text">
									{Row.name}
								</span>
								<span class="overlay-matrix__name-part">
									{Row.part}
								</span>
								<span class="overlay-matrix__name-count">
									{BuiltOf(Row)} / {Columns.length}
								</span>
							</th>

							{Columns.map((Column, Index) => {
								const Cell = MatrixCell(Row, Column);

								return (
									<td
										class:list={[
											"overlay-matrix__cell",
											OpensGroup(Index) &&
												"overlay-matrix__cell--group",
										]}
										data-disposition={Cell.disposition}
									>
										{Cell.disposition === "built" ? (
											<span class="overlay-matrix__built">
												BUILT
											</span>
										) : (
											<span class="overlay-matrix__na">
												N/A
												<span class="overlay-matrix__note-mark">
													〈{NoteMark(Row.name, Column.key)}〉
												</span>
											</span>
										)}
									</td>
								);
							})}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<div class="overlay-matrix__notes">
		<p class="overlay-matrix__notes-head">
			<span class="overlay-matrix__notes-label">NOTES:</span>
			<span class="overlay-matrix__notes-count">
				{Notes.length} CELLS THAT CANNOT EXIST
			</span>
		</p>

		<ol class="overlay-matrix__notes-list">
			{
				Notes.map((Note) => (
					<li class="overlay-matrix__note" id={`overlay-note-${Note.mark}`}>
						<span class="overlay-matrix__note-mark">
							〈{Note.mark}〉
						</span>
						<span class="overlay-matrix__note-where">
							{Note.Row.name} / {Note.Column.label}
						</span>
						<span class="overlay-matrix__note-reason">
							{Note.Cell.reason}
						</span>
					</li>
				))
			}
		</ol>
	</div>

	<figcaption class="overlay-matrix__caption">
		<span class="overlay-matrix__caption-key">READ:</span>
		<span class="overlay-matrix__caption-value">
			A cell is `BUILT` when the family renders that combination and
			`N/A` when it cannot exist - and a cell that cannot exist carries
			its reason in the notes below rather than a truncated one in the
			cell. {BuiltCount} of {CellCount} cells are built; {ReasonCount}
			are reasons. The default is `BUILT` because this matrix was
			written after the family was put on one surface: the absences are
			the interesting cells and the built ones are the family.
		</span>
		<span class="overlay-matrix__caption-source">
			<span class="overlay-matrix__caption-key">SOURCE:</span>
			<span class="overlay-matrix__caption-value overlay-matrix__caption-value--code">
				SOURCE/CONTENT/SPECIMEN/OVERLAY.TS
			</span>
		</span>
	</figcaption>

	<div class="overlay-matrix__register">
		<RecordLedger rows={Figures} columns={2} register={Matrix} />
	</div>
</figure>

<figure class="overlay-contract" id="overlay-contract">
	<p class="overlay-contract__head">
		<span class="overlay-contract__label">THE DISMISSAL CONTRACT:</span>
		<span class="overlay-contract__count">
			{Dismissals.length} RULES, EVERY SLIP
		</span>
	</p>

	<ol class="overlay-contract__list">
		{
			Dismissals.map((Dismissal) => (
				<li class="overlay-contract__row">
					<span class="overlay-contract__key">{Dismissal.key}</span>
					<span class="overlay-contract__value">{Dismissal.value}</span>
					<span class="overlay-contract__held">{Dismissal.held}</span>
				</li>
			))
		}
	</ol>

	<figcaption class="overlay-contract__caption">
		<span class="overlay-contract__caption-key">WHY ONE TABLE:</span>
		<span class="overlay-contract__caption-value">
			Eight primitives each dismiss slightly differently, and the
			differences are invisible until they bite. A reader does not
			experience eight correct implementations - they experience one
			document that sometimes forgets where they were. The `HELD` column
			names which component keeps each rule, so a row cannot claim a
			behaviour nothing implements.
		</span>
		<span class="overlay-contract__caption-source">
			<span class="overlay-contract__caption-key">SOURCE:</span>
			<span class="overlay-contract__caption-value overlay-contract__caption-value--code">
				SOURCE/COMPONENT/UI/OVERLAY.TSX
			</span>
		</span>
	</figcaption>
</figure>
