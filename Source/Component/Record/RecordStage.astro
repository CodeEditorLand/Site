---
// RecordStage - an ordered process: a rail of numbered steps, or a field of
// numbered plates.
//
// The site describes several sequences in prose (Mountain starts the native
// process, Cocoon hosts extensions, Sky renders the interface, Wind applies
// configuration). Prose is the wrong shape for an order a reader must hold, so
// a stage is one step: an index, a label and one line. A step that needs a
// paragraph is not a step.
//
// ─── GRAMMAR ─────────────────────────────────────────────────────────────
// INFORMATION TYPE  a process: the order a thing happens in.
// RANK              set.
// SLOT CONTRACT     stages[]        -> one step each: index, label, line, href?
//                   orientation?    -> `row` (across the band) or `stack` (down its edge)
//                   variant?        -> `rail` (the default) or `plates`
//                   current?        -> the index of the step the run is at
//                   state?          -> `rest` (default), `empty` or `loading`, when no steps print
//                   empty?          -> the sentence the absence prints
// MAY HOLD          steps only.
// MAY NOT HOLD      prose, a figure, a second process.
// NARROW            the rail stacks at any orientation; the plates go one across.
// WIDE              the rail runs across the measure; the plates tile two across.
// DENSE             `orientation` and `variant` are the two axes - a rail reads as
//                   a sequence, plates read as a field of numbered instruments.
//
// THE TWO VARIANTS ANSWER TWO DIFFERENT READINGS OF THE SAME DATA. A rail is
// read left to right: *then, then, then*. Plates are read as a field: each step
// is its own small instrument with its number in the corner, so a reader can
// enter at any plate and still see where it sits. The rail is right for a
// process the reader follows (a build); plates are right for a process the
// reader is being told about and may need to refer back to (what happens after a
// request is sent). Same data, same grammar, two compositions - which is the
// difference between a variant and a second block.
//
// The index is printed exactly as the caller writes it - `01`, `02`, or `A`,
// `B`. The block never renumbers and never derives a number from the position,
// because the caller's numbering is itself a fact (a `01`-prefixed rail and an
// `A`-prefixed one are two different processes).
//
// ─── THE STAGE CAN ADVANCE ────────────────────────────────────────────────
// A rail of steps that says nothing about where the run is today is a diagram of
// a process, not a record of one. Two additions make it a record without turning
// the block into a stepper (there is still nothing to click):
//
// - `current` names the step the run is at, by its INDEX as the caller wrote it.
//   That step prints `aria-current="step"`, takes the attested square and the
//   heavier rule; the steps before it are done and the ones after are pending,
//   and a reader sees the run's position in one glance.
// - a step's own `state` prints the vocabulary's word in the step's register,
//   for the run that stopped (`INTERRUPTED`) or the step that is being prepared
//   (`PREPARING`). It is the same eight words as everywhere else.
//
// A step's `detail` is disclosed, not printed: the line becomes a `<details>`
// summary and the paragraph lives one level in. A stage that needs a paragraph
// per step is not a stage - but a stage whose steps each have one deserves to
// keep them, closed, findable, and out of the rail's reading rhythm.
//
// No script and no client directive: the stage is a list, and the browser owns
// the one disclosure it prints.
import type { Stage } from "./Type.js";

import { Tone } from "../Surface/State.js";

import Mark from "../Mark/Mark.astro";

interface Props {
	/** The steps, in order. Order is the content: nothing here sorts. */
	stages: readonly Stage[];

	/**
	 * `row` lays the rail across the band, `stack` runs it down its left edge.
	 * Below 1024px the rail is a stack whatever this says - the stylesheet owns
	 * that switch, so a page never has to know the breakpoint.
	 */
	orientation?: "row" | "stack";

	/**
	 * `rail` is the sequence (the default); `plates` is the same steps as a field
	 * of numbered instruments, two across on wide screens.
	 */
	variant?: "rail" | "plates";

	/**
	 * The step the run is at, named by its own index (`"03"`). That step prints
	 * `aria-current="step"` and the attested mark, and the rail reads as a
	 * position rather than as a diagram. Absent, no step is current - a stage
	 * that is not a run is a process, and a process has no position.
	 */
	current?: string;

	/**
	 * The stage's own state, when there are no steps to print: `empty` (the
	 * process is not documented yet) or `loading` (it is being read). The frame
	 * prints the composed absence in the record grammar rather than an empty
	 * `<ol>`.
	 */
	state?: "rest" | "empty" | "loading";

	/** What the stage says when it has no steps. */
	empty?: string;
}

const { stages, orientation, variant = "rail", current, state, empty } =
	Astro.props;

/** The stage's state, and whether it replaces the list. */
const State = state ?? "rest";
const Absent = State !== "rest" || stages.length === 0;

/** What the absence prints: the caller's sentence, or the vocabulary's word. */
const Absence = empty ?? "UNAVAILABLE";

/** The absence's tone, from the one table that decides tones. */
const AbsenceTone = State === "loading" ? "quiet" : "ink";

/**
 * Whether a step is the run's position. Compared on the index the caller wrote,
 * never on the step's position in the array - the caller's numbering is the fact.
 */
const IsCurrent = (stage: Stage): boolean =>
	current !== undefined && stage.index === current;

/** A step's state word's tone, from the same table. Never chosen here. */
const ToneOf = (stage: Stage) =>
	stage.state ? (Tone(stage.state.toUpperCase()) ?? "ink") : "ink";
---

{Absent ? (
	<div class="record-stage__absent" role="status" data-state={State}>
		<p class="record-stage__absent-head">
			<span class="record-stage__absent-mark" aria-hidden="true">
				&#9678;
			</span>
			<span class="record-stage__absent-key">STATUS:</span>
			<span
				class:list={[
					"record-stage__absent-state",
					`record-stage__absent-state--${AbsenceTone}`,
				]}
			>
				{State === "rest" ? "EMPTY" : State.toUpperCase()}
			</span>
		</p>
		<p class="record-stage__absent-line">{Absence}</p>
	</div>
) : variant === "plates" ? (
	<ol class="record-stage record-stage--plates">
		{stages.map((stage) => (
			<li
				class:list={[
					"record-stage__plate",
					IsCurrent(stage) && "record-stage__plate--current",
					stage.state && "record-stage__plate--state",
				]}
				aria-current={IsCurrent(stage) ? "step" : undefined}
				data-state={stage.state?.toUpperCase()}
			>
				<span class="record-stage__plate-index">
					{IsCurrent(stage) ? (
						<Mark kind="square" size="attested" tone={ToneOf(stage)} />
					) : null}
					{stage.index}
				</span>
				<div class="record-stage__plate-body">
					{stage.href ? (
						<a class="record-stage__plate-label" href={stage.href}>
							{stage.label}
						</a>
					) : (
						<span class="record-stage__plate-label">
							{stage.label}
						</span>
					)}
					{stage.state ? (
						<span
							class:list={[
								"record-stage__state",
								`record-stage__state--${ToneOf(stage)}`,
							]}
						>
							<span class="record-stage__state-key">STATUS:</span>
							{stage.state.toUpperCase()}
						</span>
					) : null}
					{stage.detail ? (
						<details class="record-stage__detail">
							<summary class="record-stage__plate-line record-stage__summary">
								{stage.line}
								<Mark kind="fold" />
							</summary>
							<p class="record-stage__detail-body">{stage.detail}</p>
						</details>
					) : (
						<span class="record-stage__plate-line">{stage.line}</span>
					)}
				</div>
			</li>
		))}
	</ol>
) : (
	<ol class={`record-stage record-stage--${orientation ?? "row"}`}>
		{stages.map((stage) => (
			<li
				class:list={[
					"record-stage__item",
					IsCurrent(stage) && "record-stage__item--current",
					stage.state && "record-stage__item--state",
				]}
				aria-current={IsCurrent(stage) ? "step" : undefined}
				data-state={stage.state?.toUpperCase()}
			>
				<span class="record-stage__index">
					{IsCurrent(stage) ? (
						<Mark kind="square" size="attested" tone={ToneOf(stage)} />
					) : null}
					{stage.index}
				</span>
				{stage.href ? (
					<a class="record-stage__label" href={stage.href}>
						{stage.label}
					</a>
				) : (
					<span class="record-stage__label">{stage.label}</span>
				)}
				{stage.state ? (
					<span
						class:list={[
							"record-stage__state",
							`record-stage__state--${ToneOf(stage)}`,
						]}
					>
						<span class="record-stage__state-key">STATUS:</span>
						{stage.state.toUpperCase()}
					</span>
				) : null}
				{stage.detail ? (
					<details class="record-stage__detail">
						<summary class="record-stage__line record-stage__summary">
							{stage.line}
							<Mark kind="fold" />
						</summary>
						<p class="record-stage__detail-body">{stage.detail}</p>
					</details>
				) : (
					<span class="record-stage__line">{stage.line}</span>
				)}
			</li>
		))}
	</ol>
)}
