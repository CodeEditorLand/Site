---
// RecordEntry - one record in a set (element, edition, article, doc): index
// marker, optional glyph, name, chip row, one-paragraph body, optional link.
//
// The name is the accessible label, so the glyph is decorative (`aria-hidden`)
// and the index is meta that renders exactly as the caller wrote it - never
// re-derived from the name, never re-cased.
//
// `href` makes the name the link: the anchor wraps the name and nothing else,
// so the body stays selectable text and the card is not one big click target.
// No `href` means no anchor at all - never an empty one.
//
// No script tags and no client directives: the block is static.
import type { Entry } from "./Type.js";

/**
 * `Entry` plus the one additive page hook: a composing page needs to place the
 * entry in its own grid, and `class` is the pass-through the sibling blocks
 * publish. Nothing else is added - the six `Entry` fields are the whole surface.
 *
 * `surface` is the second hook, and it follows `RecordBand`'s `tone="bare"`: an
 * entry that is structure *inside* a Jelly surface (a tier card, a panel) drops
 * its own fill and frame, because a card drawn inside a card is a second
 * surface, and the block may never be one (`DESIGN.md` §4.3). The anatomy -
 * index, name, chips, body - is identical either way; only the shell changes.
 */
type Props = Entry & {
	readonly class?: string;
	readonly surface?: "card" | "bare";
};

const {
	index,
	name,
	glyph,
	chips,
	body,
	href,
	state,
	empty,
	facts,
	note,
	dense,
	class: ClassName,
	surface = "card",
} = Astro.props;

/**
 * The entry's state, and whether it replaces the body.
 *
 * `archived` is not an absence - a retired record still has its claim - so it
 * prints the body and a state row above it. `empty` and `loading` are the two
 * that have nothing to print, and both keep the index, the name and the chips:
 * the record is still filed, and the list still knows where it sits.
 */
const State = state ?? "rest";
const Absent = State === "empty" || State === "loading";

/** The absence's sentence. A caller that wrote nothing gets the vocabulary's word. */
const Absence = empty ?? "UNAVAILABLE";
---

<article
	class:list={[
		"record-entry",
		`record-entry--${surface}`,
		dense && "record-entry--dense",
		Absent && "record-entry--absent",
		State === "archived" && "record-entry--archived",
		ClassName,
	]}
	data-state={State}
>
	<p class="record-entry__index">{index}</p>
	{glyph ? (
		<span class="record-entry__glyph" aria-hidden="true">
			{glyph}
		</span>
	) : null}
	<h3 class="record-entry__name">
		{href ? (
			<a class="record-entry__link" href={href}>
				<span class="record-entry__arrow" aria-hidden="true">
					→
				</span>
				{"\u2001"}
				{name}
			</a>
		) : (
			name
		)}
	</h3>
	{chips?.length ? (
		<ul class="record-entry__chips">
			{chips.map((chip) => (
				<li class="record-entry__chip">{chip}</li>
			))}
		</ul>
	) : null}
	{State !== "rest" ? (
		<p
			class:list={[
				"record-entry__state",
				`record-entry__state--${Absent ? "ink" : "quiet"}`,
			]}
		>
			<span class="record-entry__state-key">STATUS:</span>
			{State.toUpperCase()}
		</p>
	) : null}
	{Absent ? (
		<p class="record-entry__absent">
			<span class="record-entry__absent-mark" aria-hidden="true">
				&#9678;
			</span>
			{Absence}
		</p>
	) : (
		<p class="record-entry__body">{body}</p>
	)}
	{facts && facts.length > 0 ? (
		<dl class="record-entry__facts">
			{facts.map((Fact) => (
				<div class="record-entry__fact">
					<dt class="record-entry__fact-key">{Fact.key}</dt>
					<dd class="record-entry__fact-value">{Fact.value}</dd>
				</div>
			))}
		</dl>
	) : null}
	{note ? (
		<p class="record-entry__note">
			<span class="record-entry__note-key">SOURCE:</span>
			{note}
		</p>
	) : null}
</article>
