---
/**
 * RecordMatrix - comparison across columns: a header row carrying one ink per
 * column, hairline rows and an optional caption.
 *
 * ─── GRAMMAR ─────────────────────────────────────────────────────────────
 * INFORMATION TYPE  a comparison of one state across N columns - three
 *                   platforms against five artifact fields, releases against
 *                   their dates. Not two things (that is a Pair) and not a set
 *                   of records (that is an Archive).
 * RANK              set.
 * SLOT CONTRACT     columns[] -> one header cell per column: label, ink token
 *                   rows[]    -> the row label, then one cell per column
 *                   caption?  -> the provenance line under the matrix
 *                   density?  -> `rest` (default) or `dense` (halved row rhythm
 *                                for a long comparison)
 *                   state?    -> `rest` (default), `loading` or `empty`
 *                   empty?    -> the composed sentence a matrix with no rows prints
 * MAY HOLD          nothing. Cells are values, not blocks.
 * MAY NOT HOLD      a block in a cell. A cell that needs a block needs a
 *                   different artifact.
 * WIDE              the table takes its container; the row label column is the
 *                   first cell and every cell refuses to wrap.
 * NARROW            THE ROW LABEL PINS. The shell scrolls sideways and the
 *                   label column stays on the left edge, over a `--Card` fill
 *                   and under a hairline seam, so a five-column comparison on a
 *                   phone is read one row at a time with the row's name still
 *                   attached to its cells. That is the difference between a
 *                   comparison that survives a narrow column and a table that
 *                   is merely squeezed into one.
 * DENSE             `density="dense"` halves the row rhythm and nothing else -
 *                   never the type, never the rules. For a long comparison
 *                   (every previous release) where the rows are read as a scan
 *                   rather than as five facts each.
 *
 * This is tabular data, so it is a real table element, not a grid of divs. A
 * grid can be made to look identical, but only a table gives every cell its
 * column header and every row its label without a script - which is the one
 * thing this block is for: reading Land against a Chromium editor, one
 * platform at a time.
 *
 * Two things travel with a column, and they travel differently on purpose:
 * `ink` is an open set of token names (`MatrixColumn.ink` is a `string`), so it
 * is handed over as the `--col-ink` custom property on that column's header
 * cell - the only inline declaration in this file. `align` is a closed
 * two-value union, so it travels as a modifier class and the stylesheet owns
 * it.
 *
 * ─── THE THREE STATES A TABLE IS ASKED FOR AND NEVER HAD ──────────────────
 * The record family's matrix found this block printing a bare head over nothing
 * in three different ways, and each one is now a shape rather than a hole:
 *
 * - `empty` - the head STAYS, because the head is the schema and the schema is
 *   still true when there are no rows, and one cell spanning the table says what
 *   would be here, why it is not and where to read it.
 * - `loading` - the head stays and three skeleton rows print, each with its
 *   label and a hairline bar in every cell: the columns are known before the
 *   values are, so the skeleton is the comparison's own shape.
 * - a cell whose value is a state word (`UNAVAILABLE`, `PREPARING`) now prints
 *   the vocabulary's mark and takes its tone. A comparison whose one honest
 *   answer is "not measured" used to read as a value that happened to be a word.
 *
 * ─── THE TOTAL ROW ────────────────────────────────────────────────────────
 * `MatrixRow.total` marks the row that sums the column above it. It prints
 * under the divider's ink rather than the structural hairline, at the sub role,
 * and it is never computed here: a block derives nothing it was not given, so
 * the caller passes the figure and the matrix prints the row that says what it
 * is. A total row carries its cells like any other row - one per column, because
 * a comparison's total is a total per column.
 *
 * No script, no hydration: a printed table that happens to be markup.
 */
import Mark from "../Mark/Mark.astro";

import { Tone } from "../Surface/State.js";

import type { MatrixColumn, MatrixDensity } from "./Type.js";

/**
 * One row: the label in the first column, then one value per column.
 *
 * `Type.ts` publishes `MatrixColumn` but no row shape, so the row is declared
 * here rather than forced into the shared module - its own header says a block
 * that needs a shape the module does not carry declares a local type. A short
 * row is legal: a missing value renders as an empty cell.
 */
interface MatrixRow {
	/** The row's key, printed in the first column. */
	label: string;

	/** One value per column, in the order the columns are given. */
	cells: readonly string[];

	/**
	 * The row is the set's total. It prints under the divider's ink at the sub
	 * role, and a total that carries a single figure spans every value column -
	 * one sum of the set rather than one sum per column. A total that carries a
	 * value per column prints one cell each, because a comparison's total is a
	 * total per column.
	 */
	total?: boolean;
}

/** The matrix's own state: the rows, or the shape of the rows. */
type MatrixState = "rest" | "loading" | "empty";

interface Props {
	/** The columns: header label, optional ink token name, optional align. */
	columns: readonly MatrixColumn[];

	/** The rows, each read left to right across the columns. */
	rows: readonly MatrixRow[];

	/** A caption under the matrix. Absent means no caption element. */
	caption?: string;

	/**
	 * A class the page adds to the shell, for its own spacing or grid slot.
	 * Additive: the block owns `record-matrix`, the page owns the rest.
	 */
	class?: string;

	/**
	 * The shell's id, when a control drives this table.
	 *
	 * `MatrixControl` adopts the table it was pointed at, so the page has to be
	 * able to point at it. The id belongs on the shell rather than on the
	 * `<table>`: the caption, the scroll container and the density modifier are
	 * all the shell's, and a control that found only the table would drive a
	 * table whose frame it could not reach.
	 */
	id?: string;

	/**
	 * The row rhythm. `rest` (the default) is the reading rhythm; `dense` halves
	 * it for a long comparison, where the rows are scanned rather than read. The
	 * type and the rules never change - a dense matrix is a tighter ledger, not
	 * a smaller one.
	 */
	density?: MatrixDensity;

	/**
	 * `rest` prints the rows. `loading` keeps the head and prints three skeleton
	 * rows - a hairline bar in every cell, because the columns are the schema and
	 * are known before the values are. `empty` keeps the head and prints one
	 * cell that says what would be here: an empty table that dropped its head
	 * would have thrown away the only part of itself that was still true.
	 */
	state?: MatrixState;

	/**
	 * What the matrix says when it has no rows: what would be here, why it is
	 * not, and what to do. Absent, an empty matrix prints the composed default -
	 * never a head over a blank body, which is the one thing a comparison must
	 * not print.
	 */
	empty?: string;
}

const {
	columns,
	rows,
	caption,
	density = "rest",
	class: Class,
	id,
	state = "rest",
	empty,
} = Astro.props;

/** The shell's classes: the block's own, its density, then whatever the page adds. */
const shellClass = [
	"record-matrix",
	density === "dense" ? "record-matrix--dense" : null,
	Class,
]
	.filter(Boolean)
	.join(" ");

/**
 * The value a row carries at a column index.
 *
 * This is the ragged-row guard: the row is indexed by the column, not the
 * other way round, so a row with fewer values than there are columns still
 * renders exactly one cell per column - the missing ones empty - instead of
 * throwing or shifting the columns. Values past the last column are not
 * rendered, because a cell with no header is an unlabelled column.
 */
const valueAt = (row: MatrixRow, index: number): string =>
	row.cells?.[index] ?? "";

/**
 * The mark class a value earns. `yes` and `no` are the two verdicts the
 * stylesheet names by shape, and they are matched case-insensitively because the
 * content tables are written by hand.
 *
 * A value that is one of the eight state words is not a verdict but a STATE, and
 * it earns the vocabulary's tone plus the mark layer's square: `UNAVAILABLE` in
 * a comparison is a measurement that could not be taken, and a reader must be
 * able to see that it is a state and not a value that happens to read that way.
 * Every other value earns no modifier and prints verbatim - a value is never
 * translated into an icon.
 */
const markOf = (value: string): string => {
	const normalised = value.trim().toLowerCase();

	if (normalised === "yes") return " record-matrix__cell--yes";
	if (normalised === "no") return " record-matrix__cell--no";

	const tone = Tone(value);

	return tone === undefined
		? ""
		: ` record-matrix__cell--state record-matrix__cell--${tone}`;
};

/** Whether a value is a state word, and therefore carries the mark's square. */
const isState = (value: string): boolean => Tone(value) !== undefined;

/** A header cell's classes: its own, plus the centre modifier when asked. */
const columnClass = (column: MatrixColumn): string =>
	`record-matrix__column${
		column.align === "center" ? " record-matrix__column--center" : ""
	}`;

/** A body cell's classes: its own, the centre modifier, and the mark. */
const cellClass = (column: MatrixColumn, value: string): string =>
	`record-matrix__cell${
		column.align === "center" ? " record-matrix__cell--center" : ""
	}${markOf(value)}`;

/** The state word's tone, for the square that precedes it. */
const stateTone = (value: string) => Tone(value) ?? "ink";

/**
 * The empty matrix's composed default. A caller that hands no sentence still
 * gets a sentence: a head over a blank body is the one thing a comparison must
 * not print, and a blank cell is an excuse rather than a fact.
 */
const EmptyText =
	empty ??
	"No row is recorded for this comparison yet. The head prints because the columns are still the schema - what is being compared is known before the values are - and the body states the absence rather than leaving a blank.";

/** The skeleton's three rows: the shape of a comparison whose values have not arrived. */
const Skeleton = [0, 1, 2];

/** How many cells a body cell spans: the label column plus every value column. */
const Span = columns.length + 1;

const Busy = state === "loading";

const Empty = state === "empty" || (!Busy && rows.length === 0);
---

<div class={shellClass} id={id}>
	<table class="record-matrix__table" aria-busy={Busy ? "true" : undefined}>
		{caption && <caption class="record-matrix__caption">{caption}</caption>}
		<thead>
			<tr class="record-matrix__head">
				<td class="record-matrix__corner"></td>
				{columns.map((column) => (
					<th
						scope="col"
						class={columnClass(column)}
						style={
							column.ink
								? `--col-ink:var(--${column.ink})`
								: undefined
						}
					>
						{column.label}
					</th>
				))}
			</tr>
		</thead>
		<tbody>
			{Busy ? (
				Skeleton.map((Index) => (
					<tr class="record-matrix__row record-matrix__row--skeleton">
						<th scope="row" class="record-matrix__label">
							FACT_{String(Index + 1).padStart(2, "0")}
						</th>
						{columns.map((column) => (
							<td class={cellClass(column, "")}>
								<span
									class="record-matrix__bar"
									aria-hidden="true"
								/>
							</td>
						))}
					</tr>
				))
			) : Empty ? (
				<tr class="record-matrix__row record-matrix__row--empty">
					<td class="record-matrix__empty" colspan={Span}>
						<span
							class="record-matrix__empty-mark"
							aria-hidden="true"
						>
							◎
						</span>{" "}
						{EmptyText}
					</td>
				</tr>
			) : (
				rows.map((row) => (
					<tr
						class:list={[
							"record-matrix__row",
							row.total && "record-matrix__row--total",
						]}
					>
						<th scope="row" class="record-matrix__label">
							{row.label}
						</th>
						{/*
							THE TOTAL ROW'S ONE FIGURE. A total that carries a value per
							column is a total per column and prints one cell each; a total
							that carries a single figure is the sum of the whole set, so it
							prints once, across every value column - a sum printed in the
							first column would read as the total of that column alone.
						*/}
						{row.total === true &&
						row.cells.length === 1 &&
						columns.length > 1 ? (
							<td
								class="record-matrix__cell"
								colspan={columns.length}
							>
								{valueAt(row, 0)}
							</td>
						) : (
							columns.map((column, index) => {
								const value = valueAt(row, index);

								return (
									<td class={cellClass(column, value)}>
										{isState(value) ? (
											<span class="record-matrix__state">
												<Mark
													kind="square"
													fill={
														value
															.trim()
															.toLowerCase() ===
														"loading"
															? "loading"
															: "unknown"
													}
													tone={stateTone(value)}
												/>
												{value}
											</span>
										) : (
											value
										)}
									</td>
								);
							})
						)}
					</tr>
				))
			)}
		</tbody>
	</table>
</div>
