---
// RecordBand - the section grammar itself. One subject per band, opened by a
// kicker and a heading, with an optional standfirst, index strip and footnote.
//
// The anatomy is the same on every page, so it lives here once instead of being
// retyped per page: kicker, heading, standfirst, index strip, body, footnote.
//
// Four decisions worth knowing before you compose a band:
//
// - The band is a section with the page's only level-two heading inside it. The
//   page owns the only level-one heading; a block never renders one.
// - The kicker is printed exactly as the caller wrote it. The `/LABEL` voice is
//   the caller's to supply - this block never invents the leading slash and
//   never re-cases the text.
// - The kicker is NOT a register. A register counts a set (`# WHAT CHANGES /
//   08`) and is built with `RegisterLine.ts` by the block that holds the rows; a
//   band holds a subject, not a set, so its opening is a `/LABEL` with no figure
//   to state. A page that needs a counted line inside a band mounts the block
//   that counts - `RecordLedger`, `Leader` - and that block prints it.
// - The band adds no second expressive element. Exactly one thing per band may
//   be ink-inverted, and which thing that is belongs to the page, not here.
//
// `tone` picks the surface: `paper` (white card), `canvas` (creme, the default),
// `flush` (the first band after the header, which drops its top rule) or `bare`
// (structure inside a Jelly surface: no fill, no frame, no inset).
//
// ─── THE BAND'S OWN ADVERSE STATE ─────────────────────────────────────────
// A band whose subject is not written yet is still a band: `state` keeps the
// kicker, the heading, the standfirst and the index strip - the reader has to
// know WHAT is missing before being told that it is - and replaces the body with
// the composed absence: `◎`, the vocabulary's word, the sentence in `empty`, and
// the band's footnote underneath as the next step. The alternative, a band that
// renders nothing, is a page with a hole where a chapter should be.
//
// `dense` is the band read as a section inside an artifact: the same anatomy with
// a heading one tier down and the body opening at the tight step. It exists
// because a hero's evidence section and a card's second subject both need a
// heading, and neither may spend the page's air on one.
//
// No client-side script and no hydration directive: the block is static.
import type { Band } from "./Type.js";

interface Props {
	band: Band;
}

const { band } = Astro.props;
const tone = band.tone ?? "canvas";

/**
 * The band's interval, and the one class it implies.
 *
 * `turn` is a chapter, so the block prints `record-band--chapter` for it: the
 * boundary rule is the turn's, not a second decision a page could forget. A
 * `bare` band drops both - it is structure inside a Jelly card, and a chapter
 * rule drawn inside a card would be a boundary of nothing.
 */
const interval = tone === "bare" ? undefined : (band.interval ?? "beat");
const chapter = interval === "turn" ? "record-band--chapter" : undefined;

/** The band's state: `rest` prints its body, the other two print the absence. */
const State = band.state ?? "rest";

/**
 * Whether the body is replaced. `empty` and `loading` are the two states a band
 * can be in with no body, and both keep the head: the head is what names the
 * thing that is not there.
 */
const Absent = State !== "rest";

/** The absence's tone, from the same vocabulary the rest of the layer prints. */
const AbsenceTone = State === "loading" ? "quiet" : "ink";

/** What the band says it is missing. A caller that wrote nothing gets the word. */
const Absence = band.empty ?? "UNAVAILABLE";
---

<section
	class:list={[
		"record-band",
		`record-band--${tone}`,
		chapter,
		band.dense && "record-band--dense",
		Absent && "record-band--absent",
	]}
	id={band.id}
	data-interval={interval}
	data-state={State}
>
	<div class="record-band__inner">
		<p class="record-band__kicker">{band.kicker}</p>
		<h2 class="record-band__heading">{band.heading}</h2>
		{band.standfirst ? (
			<p class="record-band__standfirst">{band.standfirst}</p>
		) : null}
		{band.index?.length ? (
			<nav class="record-band__index" aria-label={band.heading}>
				{band.index.map((item) => (
					<a class="record-band__index-item" href={item.href}>
						{item.label}
					</a>
				))}
			</nav>
		) : null}
		{Absent ? (
			<div class="record-band__absent" role="status">
				<p class="record-band__absent-head">
					<span class="record-band__absent-mark" aria-hidden="true">
						&#9678;
					</span>
					<span class="record-band__absent-key">STATUS:</span>
					<span
						class:list={[
							"record-band__absent-state",
							`record-band__absent-state--${AbsenceTone}`,
						]}
					>
						{State.toUpperCase()}
					</span>
				</p>
				<p class="record-band__absent-line">{Absence}</p>
			</div>
		) : (
			<div class="record-band__body">
				<slot />
			</div>
		)}
		{band.footnote ? (
			<p class="record-band__footnote">{band.footnote}</p>
		) : null}
		{Astro.slots.has("foot") ? (
			<div class="record-band__foot">
				<slot name="foot" />
			</div>
		) : null}
	</div>
</section>
