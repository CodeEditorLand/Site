---
/**
 * RecordPlateSet - many figures of one subject, read as a field.
 *
 * ─── GRAMMAR ─────────────────────────────────────────────────────────────
 * INFORMATION TYPE  evidence as a set: the fifteen element captures, the three
 *                   platform captures, the plates one edition would carry. A
 *                   matrix compares values across columns and an archive files
 *                   records as rows; pictures are compared by being seen at one
 *                   size, side by side - which is what a plate-set is.
 * RANK              set.
 * SLOT CONTRACT     set.index      -> `# PLATES_01`
 *                   set.label?     -> `/ ELEMENT EVIDENCE`
 *                   set.plates[]   -> index, subject, src+alt?, state?, note?, href?
 *                   set.columns?   -> `2` or `3` across on wide screens
 *                   set.caption?   -> the one statement made about the set
 *                   set.source?    -> `SOURCE: ...` on the foot
 *                   set.state?     -> `rest` | `loading` | `empty`
 *                   set.window?    -> `SHOWING 12 OF 240` on the foot
 * MAY HOLD          cells only. A cell is a number, a figure, a subject and its
 *                   own reason.
 * MAY NOT HOLD      a block, prose, a second set. A cell is not a card: it has
 *                   no surface of its own, only a frame around its figure.
 * WIDE (>=1024)     three across at `--space-group`, each cell a 4:3 frame with
 *                   its number and state on a register line above it and its
 *                   subject under it - a field, not a grid of cards.
 * NARROW            one across. Two across at 640. The cell never shrinks its
 *                   frame below 4:3: a plate that changes shape with the
 *                   viewport is a different plate.
 * DENSE             none. A set of figures is scanned at one size; a denser set
 *                   is a smaller claim about each picture.
 *
 * WHY THIS IS NOT RecordStage's `plates` VARIANT. The stage's plates are *steps*
 * - numbered instruments of a process, with an index in the corner. These are
 * *figures*: they have a subject, a source and a state, and their number is the
 * position in the set rather than an order in time. Same word, two objects; the
 * routing table keeps them apart.
 *
 * THE SET'S HONEST DEFAULT IS THAT MOST OF ITS CELLS ARE EMPTY. Eight of the
 * fifteen elements have an evidence manifest and none of those manifests has a
 * plate beside it; seven have no manifest at all. A plate-set that drew seven
 * empty frames would be a hole with a caption; this one prints each cell's own
 * state and reason in the same grammar the present cells use, so the set reads
 * as one register of fifteen attempts rather than as a broken gallery.
 *
 * `window` is the too-much state: a set of two hundred plates prints the first
 * twelve and names the rest on the foot, because a page that renders two hundred
 * figures has stopped being a field and started being a directory.
 *
 * No `<script>` and no `client:*`: a plate-set is printed.
 */
import { FieldRecordEvidence } from "../Brand/FieldRecordEvidence";
import { Tone } from "../Surface/State.js";

import type { PlateSet } from "./Type.js";

interface Props {
	/** The set: its cells, its caption and its states. */
	set: PlateSet;

	/** Extra classes from the page, appended after the block's own. */
	class?: string;
}

const { set, class: Class } = Astro.props;

/** The set's state; `rest` prints the cells. */
const State = set.state ?? "rest";

/** How many across: three is a field, two is a pair of pairs. */
const Columns = set.columns ?? 3;

/** The cells actually printed: `window.showing` when the set is longer. */
const Printed =
	set.window !== undefined
		? set.plates.slice(0, set.window.showing)
		: set.plates;

/** The count the head prints: the plates in the set, verbatim when measured. */
const Count = set.window?.total ?? String(set.plates.length);

/** The unit the head prints beside the count. */
const Unit = set.plates.length === 1 ? "PLATE" : "PLATES";

const Id = `plates-${set.index.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<figure
	class:list={[
		"record-plate-set",
		`record-plate-set--${Columns}`,
		State === "loading" && "record-plate-set--loading",
		State === "empty" && "record-plate-set--empty",
		Class,
	]}
	id={Id}
>
	<figcaption class="record-plate-set__head">
		<span class="record-plate-set__head-main">
			<span class="record-plate-set__index"># {set.index}</span>
			{set.label ? (
				<span class="record-plate-set__label">/ {set.label}</span>
			) : null}
		</span>
		<span class="record-plate-set__count">
			{Count}
			<span class="record-plate-set__count-unit">{Unit}</span>
		</span>
	</figcaption>

	{State === "empty" ? (
		<p class="record-plate-set__empty">
			<span class="record-plate-set__empty-mark" aria-hidden="true">
				&#9678;
			</span>
			{set.empty}
		</p>
	) : (
		<ol class="record-plate-set__field">
			{Printed.map((Cell) => {
				const Tone_ = Cell.state
					? (Tone(Cell.state.toUpperCase()) ?? "ink")
					: undefined;

				return (
					<li class="record-plate-set__cell">
						<p class="record-plate-set__cell-head">
							<span class="record-plate-set__cell-index">
								{Cell.index}
							</span>
							{Cell.state ? (
								<span
									class:list={[
										"record-plate-set__cell-state",
										`record-plate-set__cell-state--${Tone_}`,
									]}
								>
									<span
										class="record-plate-set__cell-marker"
										aria-hidden="true"
									/>
									{Cell.state.toUpperCase()}
								</span>
							) : null}
						</p>

						<div
							class:list={[
								"record-plate-set__frame",
								Cell.state && "record-plate-set__frame--absent",
							]}
						>
							{Cell.state ? (
								<span
									class="record-plate-set__absent"
									aria-hidden="true"
								>
									&#9678;
								</span>
							) : State === "loading" ? (
								<span
									class="record-plate-set__skeleton"
									aria-hidden="true"
								/>
							) : Cell.src !== undefined &&
							  Cell.alt !== undefined ? (
								Cell.href === undefined ? (
									<FieldRecordEvidence
										src={Cell.src}
										alt={Cell.alt}
										className="record-plate-set__picture"
									/>
								) : (
									<a
										class="record-plate-set__link"
										href={Cell.href}
									>
										<FieldRecordEvidence
											src={Cell.src}
											alt={Cell.alt}
											className="record-plate-set__picture"
										/>
									</a>
								)
							) : (
								<span
									class="record-plate-set__absent"
									aria-hidden="true"
								>
									&#9678;
								</span>
							)}
						</div>

						<p class="record-plate-set__subject">
							<span
								class="record-plate-set__arrow"
								aria-hidden="true"
							>
								&#8627;
							</span>
							{Cell.subject}
						</p>

						{Cell.note ? (
							<p class="record-plate-set__note">{Cell.note}</p>
						) : null}
					</li>
				);
			})}
		</ol>
	)}

	{set.caption || set.source || set.window ? (
		<figcaption class="record-plate-set__foot">
			{set.caption ? (
				<span class="record-plate-set__caption">{set.caption}</span>
			) : null}
			{set.window ? (
				<span class="record-plate-set__window">
					<span class="record-plate-set__window-key">SHOWING:</span>
					{set.window.showing}
					<span class="record-plate-set__window-of">OF</span>
					{set.window.total}
				</span>
			) : null}
			{set.source ? (
				<span class="record-plate-set__source">
					<span class="record-plate-set__source-key">SOURCE:</span>
					{set.source}
				</span>
			) : null}
		</figcaption>
	) : null}
</figure>
