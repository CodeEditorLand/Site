---
/**
 * RecordHero - the site's signature artifact as one block: the field record
 * beside its evidence, one hairline between them, and the record's mandatory
 * blank interval inside the card.
 *
 * ─── GRAMMAR ─────────────────────────────────────────────────────────────
 * INFORMATION TYPE  what this page is. One artifact per page, and it opens the
 *                   page - the record's identity, its claim, its state and its
 *                   facts, beside the evidence the claim rests on.
 * RANK              artifact. The only block that prints an `h1`.
 * SLOT CONTRACT     index        -> `# MARKER` (the `#` is the block's to print)
 *                   claim        -> the artifact's one `h1`, in the stamp grammar
 *                   route?       -> the record's one `/ROUTE:VALUE` line
 *                   status       -> `STATUS:` and a word from the vocabulary
 *                   metadata     -> the record's facts, as a RecordLedger
 *                   relation?    -> the nameplate at section weight (`LAND:`)
 *                   proposition? -> the `↳` line under the blank interval
 *                   evidence?    -> the plate (FieldRecordEvidence)
 *                   seal?        -> the artifact's one seal
 *                   action?      -> the artifact's one action
 *                   default slot -> composed evidence instead of a picture
 *                                  (a RecordFigure with its caption)
 * MAY HOLD          a RecordLedger (the facts), a RecordFigure or a chart (the
 *                   evidence), a RecordStage (the trace foot), and at most one
 *                   RecordBand at `tone="bare"` as a sectioning level.
 * MAY NOT HOLD      a second hero, a second seal, a second `h1`, or a band that
 *                   paints its own fill or chapter padding.
 * WIDE (>=768)      `49fr / 1px / 51fr`: the record, the hairline gutter, the
 *                   evidence. The gutter draws `--Divider`, never `--Border` -
 *                   the hairline dissolves against a photograph and this is the
 *                   one rule M1 restored twice.
 * NARROW            the record first, the evidence second, the gutter gone: the
 *                   information arrives before the illustration, and the
 *                   interval falls back to its floor token because a percentage
 *                   has no card height to resolve against.
 * DENSE             none. The artifact gets the screen - that is what makes it
 *                   the artifact.
 *
 * THE ORDER IS THE GRAMMAR. Mark, claim, route, state, facts - then the blank
 * interval - then the relation, the proposition and the action. The interval
 * separates what the record *is* from what it *asks*, which is what gives the
 * proposition the weight of a second headline. A hero whose facts came after the
 * interval would spend its silence on a list.
 *
 * Three things this file does NOT do, and why:
 *
 * - **No second evidence component and no second status line.** Both
 *   primitives exist in `Brand/`; a copy here would drift from the one the
 *   rest of the site renders.
 * - **No JavaScript.** Every part is an `.astro` block or a React component
 *   rendered on the server with no `client:*`, so the artifact ships as HTML
 *   and CSS.
 * - **No page conversion.** The surfaces that consume this block move in their
 *   own cards, one at a time.
 */
import FieldRecordAction from "../Brand/FieldRecordAction.astro";
import FieldRecordDataCard from "../Brand/FieldRecordDataCard.astro";
import FieldRecordIndex from "../Brand/FieldRecordIndex.astro";
import { FieldRecordEvidence } from "../Brand/FieldRecordEvidence";
import { FieldRecordSeal } from "../Brand/FieldRecordSeal";
import { FieldRecordStatus } from "../Brand/FieldRecordStatus";
import { RouteText, StampText } from "../Brand/SemanticLedger";

import RecordLedger from "./RecordLedger.astro";

import type { Hero } from "./Type.js";

type Props = Hero & {
	/** Extra classes from the page, appended after the block's own. */
	readonly class?: string;
};

const {
	index,
	claim,
	route,
	status,
	relation,
	proposition,
	metadata,
	evidence,
	seal,
	action,
	class: Class,
} = Astro.props;

/**
 * The marker without its `#`. `FieldRecordIndex` owns the glyph and prints it
 * itself, so a page that writes `"# LAND_01"` and a page that writes
 * `"LAND_01"` render the same marker.
 */
const Marker = index.replace(/^#\s*/, "");

/**
 * Composed evidence: a figure, a chart, a rendered element, instead of an
 * image. The image wins when a page passes both - one artifact shows one
 * thing.
 */
const Composed = Astro.slots.has("default");

/**
 * Whether the artifact has an evidence panel at all. Neither an image nor
 * composed children means the record stands alone at the full width, rather
 * than leaving a gap where a picture would be.
 */
const HasEvidence = evidence !== undefined || Composed;

/**
 * The seal's box, in pixels. The hero's seal is the artifact's own mark, so
 * its size is the artifact's geometry rather than a page's choice.
 */
const SEAL = "m";
---

<section class:list={["record-hero", Class]}>
	<div
		class:list={[
			"record-hero__pair",
			HasEvidence ? null : "record-hero__pair--single",
		]}
	>
		<div class="record-hero__record">
			<FieldRecordDataCard className="record-hero__card">
				<div class="record-hero__inset">
					<div class="record-hero__mark">
						<FieldRecordIndex index={Marker} />
						{seal && (
							<FieldRecordSeal
								element={seal}
								size={SEAL}
								className="record-hero__seal"
							/>
						)}
					</div>

					<h1 class="type-display record-hero__claim">
						<StampText Line={claim} />
					</h1>

					{route && (
						<p class="record-hero__route">
							<RouteText Line={route} />
						</p>
					)}

					<div class="record-hero__status">
						<FieldRecordStatus
							status={status.state}
							tone={status.tone}
							copy={status.copy}
						/>
					</div>

					<RecordLedger rows={metadata} class="record-hero__facts" />

					<div class="record-hero__blank" aria-hidden="true"></div>

					{relation && (
						<p class="record-hero__relation">{relation}</p>
					)}

					{proposition && (
						<p class="record-hero__proposition">
							<span
								class="record-hero__proposition-mark"
								aria-hidden="true"
							>
								↳
							</span>
							{proposition}
						</p>
					)}

					{action && (
						<div class="record-hero__action">
							<FieldRecordAction
								label={action.label}
								href={action.href}
								variant={action.variant ?? "button"}
							/>
						</div>
					)}
				</div>
			</FieldRecordDataCard>
		</div>

		{HasEvidence && <div class="record-hero__gutter" aria-hidden="true" />}

		{HasEvidence && (
			<div class="record-hero__evidence">
				{evidence ? (
					<FieldRecordEvidence
						src={evidence.src}
						alt={evidence.alt}
						position={evidence.position}
						className="record-hero__plate"
					/>
				) : (
					<slot />
				)}
			</div>
		)}
	</div>
</section>
