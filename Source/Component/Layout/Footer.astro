---
/**
 * Footer - the record's closing band, read as a colophon.
 *
 * A dossier does not end on a link list. It ends on a colophon: the facts of the
 * record, then the facts of its making, then the index, then the imprint. That is
 * the order here, and it is one artifact from the marker to the last hairline.
 *
 * 1. `# LAND / RECORD END` opens it with the locale switcher on the same row.
 * 2. Two ledgers side by side under a hairline gutter: **FACTS** (SOURCE,
 *    LICENSE, MAINTAINED BY, SUPPORT, STATUS - the keeper ledger, untouched) and
 *    **COLOPHON** (TYPE, BUILD, FIELD, INK, EXTENT, EDITION - how this document
 *    was set). Both are `RecordLedger`, because a colophon is facts, not a second
 *    kind of widget.
 * 3. The labelled rows: `ROUTES:` the `/LABEL` destinations, `LEGAL:` the
 *    legal set, and `INDEX:` the one door back to `/Contents` - the document's
 *    own table of contents, which is not a route among the others.
 * 4. The imprint: copyright, the baseline's own `Back to top ↑`, the runtime
 *    badge.
 *
 * The marker was printed last by the rebuild; it opens the record in the
 * pre-programme footer and in the document's own block, so it opens it here.
 *
 * This was a `.tsx` island. It is now an `.astro` component because the ledger
 * it composes is an `.astro` block and an `.astro` component cannot be imported
 * from a `.tsx` file. What that removed: the footer's strings were re-translated
 * client-side by react-i18next when the reader switched locale. They are now
 * rendered once, in English, by the server translator - which is what every other
 * prerendered surface on this site already does (`GetI18n` is English-only by
 * design). `LocaleSwitcher` stays and still lists all five locales.
 */
import { GetI18n } from "../../Library/I18n/Server";
import RecordLedger from "../Record/RecordLedger.astro";
import { FooterData, FooterLinkAttributes } from "./Footer/Data.js";
import { LocaleSwitcher } from "./LocaleSwitcher";

const T = GetI18n();

const Year = new Date().getFullYear();

const Data = FooterData(T, Year);

const Copyright = T("footer:bottomBar.copyright", {
	year: Year,
	defaultValue: `© ${Year} Code Editor Land. CC0 1.0 Universal: no rights reserved.`,
});
---

<footer class="Footer" role="contentinfo" aria-label="Site footer">
	<div class="FooterRecord">
		<div class="FooterRule" aria-hidden="true"></div>

		<div class="FooterRecordHeader">
			<p class="FooterRecordEnd">
				<span class="FooterRecordMarker" aria-hidden="true">
					#
				</span>
				{T("footer:record.end", { defaultValue: "LAND / RECORD END" })}
			</p>

			<div class="FooterRecordLocale">
				<LocaleSwitcher client:idle />
			</div>
		</div>

		{/* The record's facts and the record's making, as two ledgers under one
		    gutter - the same hairline division the hero pair uses. */}
		<div class="FooterBody">
			<div class="FooterFacts">
				<p class="FooterField">
					{T("footer:field.facts", { defaultValue: "FACTS:" })}
				</p>

				<RecordLedger rows={Data.Ledger} class="FooterLedger" />
			</div>

			<div class="FooterColophon">
				<p class="FooterField">
					{T("footer:field.colophon", { defaultValue: "COLOPHON:" })}
				</p>

				<RecordLedger
					rows={Data.Colophon}
					class="FooterColophonLedger"
				/>
			</div>
		</div>

		<div class="FooterRows">
			<div class="FooterRow">
				<p class="FooterField">
					{T("footer:field.routes", { defaultValue: "ROUTES:" })}
				</p>

				<nav class="FooterQuickLinks" aria-label="Routes">
					{Data.Quick.map((Link) => (
						<a
							class="FooterQuickLink"
							href={Link.Href}
							{...FooterLinkAttributes(Link.Target)}
						>
							{Link.Label}
						</a>
					))}
				</nav>
			</div>

			<div class="FooterRow">
				<p class="FooterField">
					{T("footer:field.legal", { defaultValue: "LEGAL:" })}
				</p>

				<nav class="FooterLegal" aria-label="Legal">
					{Data.Legal.map((Link) => (
						<a
							class="FooterLegalLink"
							href={Link.Href}
							{...FooterLinkAttributes(Link.Target)}
						>
							{Link.Label}
						</a>
					))}
				</nav>
			</div>

			{/* The index closes the register: not a category of destination like
			    the two rows above, but the page that lists them all. */}
			<div class="FooterRow">
				<p class="FooterField">
					{T("footer:field.index", { defaultValue: "INDEX:" })}
				</p>

				<nav class="FooterQuickLinks" aria-label="Index">
					{Data.Index.map((Link) => (
						<a
							class="FooterQuickLink"
							href={Link.Href}
							{...FooterLinkAttributes(Link.Target)}
						>
							{Link.Label}
						</a>
					))}
				</nav>
			</div>
		</div>

		<div class="FooterBottom">
			<span class="FooterCopyright">{Copyright}</span>

			<a class="FooterTop" href="#" aria-label="Back to top">
				{T("footer:bottomBar.top", { defaultValue: "Back to top ↑" })}
			</a>

			<span class="FooterTauri">
				<a
					class="FooterTauriLink"
					href="https://tauri.app"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						src="/Image/GitHub/Made/Tauri.svg"
						alt="Made with Tauri"
						width="160"
						height="32"
						loading="lazy"
						decoding="async"
					/>
				</a>
			</span>
		</div>
	</div>
</footer>
