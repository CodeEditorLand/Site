---
/**
 * SurfaceState - the state register of an app surface.
 *
 * A status is not a fact: `DESIGN-COMPLETE.md` §1.5 requires ACTIVE and
 * VERIFIED to carry a specimen marker beside the word, because a status that
 * renders exactly like an ordinary fact has lost its state. This block is that
 * marker's one home on the static surfaces - the shell's head and each portal
 * tier's band render it, so the shape cannot drift between them.
 *
 * The marker is ONE 2px rule standing before the word, at the word's own ink: a
 * shape, so the state survives greyscale and is never colour-only, with the
 * tone carried by the ink (`specimen` = the record's ink plus the state square
 * at `--state-mark-scale-attested`, `ink` = the foreground, `quiet` = the muted
 * foreground). The tone used to be the accent for `specimen`; the accent
 * authenticates a route, a link, a focus and a seal, so a state that spent it
 * left a page with nine green states and no way to find where the reader was.
 * It is the same marker the header draws at the foot of the current
 * destination, turned to stand in a row.
 *
 * A state keeps its key, and the key keeps its colon: `STATUS:` then the word,
 * the same `KEY: WORD` grammar the state's own sentence prints elsewhere on the
 * site (`STATUS: LOADING`, `RECORD: EMPTY`). The key column is the ledger's
 * own, so the register and the facts under it read as one block rather than two
 * lists - and a reader who sees `STATUS: LOADING` in a card sees the same
 * `STATUS:` here.
 *
 * The tone is not a prop and not a page's choice: it is the row's, and the row
 * came from `State.ts`, which is the one table of §1.5's eight values. A page
 * that hands in a ninth word hands in `ink`, because `Row()` resolves the tone
 * and never guesses one.
 *
 * The React islands print the same register through `StateBadge` - one grammar,
 * two renderers, because an Astro block cannot run inside a hydrated island.
 *
 * No script and no hydration: a state register is static.
 */
import type { SurfaceState as State } from "./State.js";

import Mark from "../Mark/Mark.astro";

interface Props {
	/** The states, in the order the page states them. */
	states: readonly State[];

	/**
	 * How many columns the register prints at a wide container. `1` (the
	 * default) is the ledger's own column - key left, word right, one row each.
	 * `2` reads a set of eight words as a set, which is what a legend needs and
	 * what a head's two states never do. The rows keep their order: the columns
	 * fill left to right, so the reading order is the array's.
	 */
	columns?: 1 | 2;

	/** Print the rows at the tight step, for a register inside a card. */
	dense?: boolean;

	/** Extra classes from the page. */
	class?: string;
}

const {
	states,
	columns = 1,
	dense = false,
	class: ClassName,
} = Astro.props;
---

<ul
	class:list={[
		"surface__states",
		columns === 2 && "surface__states--two",
		dense && "surface__states--dense",
		ClassName,
	]}
>
	{states.map((Row) => (
		<li class="surface__state-row">
			<span class="surface__state-key">{Row.key}:</span>
			<span
				class:list={[
					"surface__state-word",
					`surface__state-word--${Row.tone}`,
				]}
			>
				<Mark kind="square" tone={Row.tone} />
				{Row.value}
			</span>
		</li>
	))}
</ul>
