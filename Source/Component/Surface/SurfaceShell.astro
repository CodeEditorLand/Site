---
/**
 * SurfaceShell - the one shell both app surfaces wear: portal and dashboard.
 *
 * Both pages are tools, not marketing pages, so they open the same way: a
 * record marker, the page's only `h1` at `--type-section`, one sentence of
 * context, and a status ledger that states the page's own facts before any
 * band explains them. Everything after the shell is a stack of bands, and the
 * page supplies those through the slot.
 *
 * Four decisions this file makes, so a page cannot get them wrong:
 *
 * - It renders a `<div>`, not a `<main>`. `Layout/Base.astro` already owns
 *   `<main id="main-content">`, and a second one nested inside it was a
 *   duplicate landmark with a duplicate id.
 * - The `h1` is the only level-one heading the shell emits, and it is the
 *   only place either page gets one.
 * - The `〈 〉` brackets around the title are the shell's own, drawn at
 *   `--MuteForeground` in the partial. They were inline-styled spans before;
 *   the keyword ink they asked for resolved to the card foreground anyway, so
 *   nothing is lost and the markup stops carrying colour.
 * - The ledger is `RecordLedger`, never a second `<dl>`: the status block on
 *   both pages is key/value facts, which is the ledger's job.
 *
 * No script and no hydration directive: the shell is static.
 */
import RecordLedger from "../Record/RecordLedger.astro";

import type { LedgerRow } from "../Record/Type.js";

interface Props {
	/** `# PORTAL_01` - the surface's record marker, printed verbatim. */
	index: string;

	/** The page's `h1`. */
	title: string;

	/** One sentence of context under the title. */
	standfirst?: string;

	/** The status facts, in the order they are read. */
	rows: readonly LedgerRow[];

	/** Extra classes from the page. */
	class?: string;
}

const {
	index,
	title,
	standfirst,
	rows,
	class: ClassName,
} = Astro.props;
---

<div class:list={["surface", ClassName]}>
	<header class="surface__head">
		<div class="surface__head-inner">
			<p class="surface__index">{index}</p>
			<h1 class="surface__title">{title}</h1>
			{standfirst ? <p class="surface__standfirst">{standfirst}</p> : null}
			<div class="surface__status">
				<RecordLedger rows={rows} columns={2} />
			</div>
		</div>
	</header>
	<slot />
</div>
