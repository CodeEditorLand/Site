---
/**
 * SurfaceShell - the shell both app surfaces wear: the instrument head, then the
 * page's own bands.
 *
 * The head itself is `SurfaceHead` (nameplate, `h1`, `↳` proposition, status
 * line, facts ledger). This file only adds the two things a *page* needs and a
 * head does not:
 *
 * - the `.surface` wrapper on the creme field, so the page's bands inherit the
 *   canvas and the ink instead of each section restating them;
 * - the `slot`, which is where the page's regions go. The shell owns the opening
 *   and nothing below it - a region is a band, and bands belong to the page.
 *
 * It renders a `<div>`, not a `<main>`: `Layout/Base.astro` already owns
 * `<main id="main-content">`, and a second one nested inside it was a duplicate
 * landmark with a duplicate id.
 *
 * The `h1` is the only level-one heading the shell emits, and `SurfaceHead`
 * prints it at L with the `〈 〉` brackets drawn by the partial. States are
 * lifted out of the ledger into the status line, so a state never renders as a
 * row that merely looks like a fact.
 *
 * No script and no hydration directive: the shell is static.
 */
import SurfaceHead from "./SurfaceHead.astro";

import type { LedgerRow } from "../Record/Type.js";
import type { Declaration, SurfaceState as State } from "./State.js";

interface Props {
	/** `# PORTAL_01` - the surface's record marker, printed verbatim. */
	index: string;

	/** The page's `h1`. */
	title: string;

	/** The `↳` line: one proposition or one sentence of context. */
	standfirst?: string;

	/** The page's states, in the order they are read. */
	states?: readonly State[];

	/** The declarations that make those states auditable. */
	declarations?: readonly Declaration[];

	/** The status facts, in the order they are read. */
	rows?: readonly LedgerRow[];

	/**
	 * The surface's lifecycle - `LIVE`, `BETA`, `PLANNED`, `RETIRED`,
	 * `UNAVAILABLE`. Printed by `SurfaceHead` in the one vocabulary the site
	 * owns; see `Surface/State.ts`'s `Life`.
	 */
	life?: string;

	/** Provenance for the lifecycle word. Ignored without `life`. */
	lifeNote?: string;

	/** Extra classes from the page. */
	class?: string;
}

const {
	index,
	title,
	standfirst,
	states = [],
	declarations = [],
	rows = [],
	life,
	lifeNote,
	class: ClassName,
} = Astro.props;
---

<div class:list={["surface", ClassName]}>
	<SurfaceHead
		index={index}
		title={title}
		proposition={standfirst}
		states={states}
		declarations={declarations}
		rows={rows}
		life={life}
		lifeNote={lifeNote}
	/>
	<slot />
</div>
