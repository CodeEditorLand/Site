---
/**
 * ShellPanes - the workspace's panes: two instruments side by side with the
 * site's hairline between them, and a drawer for what does not fit either.
 *
 * ─── WHY A GUTTER AND NOT A GAP ───────────────────────────────────────────
 * The endorsed hero pair is 49fr / 1px / 51fr: two panels with one hairline
 * gutter that is a *track*, not a border on one of them. At pane scale the same
 * object holds: `5fr 1px 7fr`, asymmetric, one 1px track in `--Divider` ink. Two
 * panes with a `gap` read as two cards that happen to be near each other; two
 * panes with a gutter read as one instrument divided - which is the whole
 * difference between a workspace and a dashboard of dashboards.
 *
 * ─── THE DRAWER ───────────────────────────────────────────────────────────
 * A pane holds one instrument. When the workspace has a third thing - the
 * transcript, the log, the reference the reader consults rather than reads - it
 * goes in the drawer: a `<details>` spanning both panes at the foot, closed by
 * default, its summary a register line. CSS-only, works with JavaScript off, and
 * found by the browser's own in-page search when closed.
 *
 * ─── NARROW ───────────────────────────────────────────────────────────────
 * The gutter rotates: the two panes stack, and the 1px rule becomes the seam
 * between them at the same ink. The panes keep their heads, their marks and their
 * order - the primary pane stays first, because on a phone the reader meets the
 * instrument they came for before the context beside it.
 *
 * ─── STACKED BY CHOICE: AN INDEX ABOVE A SURFACE ──────────────────────────
 * `layout="stack"` rotates the seam at every width, and it is not the narrow
 * fallback: it is the composition for an instrument whose halves are not two
 * comparable readings. A list of N with a note per row, above an embedded
 * application, is that case - in a 5fr pane the notes are squeezed to a couple
 * of characters and the application is a frame inside a frame. Stacked, the
 * primary pane is the band (its head is the band's head, its rows get the full
 * measure) and the secondary pane is the surface (its head is the surface's
 * head, its body gets the column). Same heads, same marks, same counts, same
 * drawer - only the axis of the seam changes.
 *
 * No script and no hydration.
 */
interface Pane {
	/** `# PANE_01` - the pane's marker, printed verbatim. */
	readonly mark: string;

	/** The pane's `h2`/`h3`-level name, printed at heading weight. */
	readonly label: string;

	/** The value cell at the pane head: a count, a state, a source. */
	readonly meta?: string;

	/** One sentence under the pane's head, when the pane needs its scope stated. */
	readonly note?: string;
}

interface Props {
	/** The leading pane - the context, the record, the thing beside the work. */
	primary: Pane;

	/** The trailing pane - the instrument the reader came to operate. */
	secondary: Pane;

	/**
	 * The ratio. `5/7` (the default) puts the instrument in the wider pane;
	 * `7/5` mirrors it for a workspace whose instrument is the record; `1/1` is
	 * for two panes that are genuinely equal, and it is the only case where
	 * equal columns are right.
	 */
	ratio?: "5/7" | "7/5" | "1/1";

	/**
	 * The composition. `panes` (the default) is two columns with the hairline
	 * gutter between them - the right instrument when both halves are readable
	 * at a column width. `stack` puts the primary above the secondary with the
	 * seam rotated at every width: the composition for an index above a
	 * surface, where the primary is a list of N whose rows carry a note and the
	 * secondary is an embedded application that needs the column. `ratio` is
	 * not read when the layout is `stack`.
	 */
	layout?: "panes" | "stack";

	/** The drawer at the foot: what neither pane holds. Absent, no drawer. */
	drawer?: {
		readonly label: string;
		readonly note?: string;
		readonly open?: boolean;
	};

	/** Extra classes from the page. */
	class?: string;
}

const {
	primary,
	secondary,
	ratio = "5/7",
	layout = "panes",
	drawer,
	class: ClassName,
} = Astro.props;

import Mark from "../Mark/Mark.astro";

const HasDrawer = Astro.slots.has("drawer");
---

<div
	class:list={[
		"ShellPanes",
		layout === "stack"
			? "ShellPanes--stack"
			: `ShellPanes--${ratio.replace("/", "-")}`,
		ClassName,
	]}
>
	<div class="ShellPanes__grid">
		<section class="ShellPanes__pane ShellPanes__pane--primary">
			<header class="ShellPanes__head">
				<p class="ShellPanes__mark">{primary.mark}</p>
				<p class="ShellPanes__label">{primary.label}</p>
				{primary.meta ? (
					<p class="ShellPanes__meta">{primary.meta}</p>
				) : null}
			</header>
			{primary.note ? (
				<p class="ShellPanes__note">{primary.note}</p>
			) : null}
			<div class="ShellPanes__body">
				<slot name="primary" />
			</div>
		</section>

		<div class="ShellPanes__gutter" aria-hidden="true"></div>

		<section class="ShellPanes__pane ShellPanes__pane--secondary">
			<header class="ShellPanes__head">
				<p class="ShellPanes__mark">{secondary.mark}</p>
				<p class="ShellPanes__label">{secondary.label}</p>
				{secondary.meta ? (
					<p class="ShellPanes__meta">{secondary.meta}</p>
				) : null}
			</header>
			{secondary.note ? (
				<p class="ShellPanes__note">{secondary.note}</p>
			) : null}
			<div class="ShellPanes__body">
				<slot name="secondary" />
			</div>
		</section>
	</div>

	{drawer && HasDrawer ? (
		<details class="ShellPanes__drawer" open={drawer.open}>
			<summary class="ShellPanes__drawer-summary">
				<Mark kind="fold" class="ShellPanes__drawer-mark" />
				<span class="ShellPanes__drawer-label">{drawer.label}</span>
				{drawer.note ? (
					<span class="ShellPanes__drawer-note">{drawer.note}</span>
				) : null}
			</summary>
			<div class="ShellPanes__drawer-body">
				<slot name="drawer" />
			</div>
		</details>
	) : null}
</div>
