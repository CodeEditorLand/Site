---
/**
 * DocCard - one card of the documentation index: a title, the page's
 * `description` under it, and the whole card as the way in.
 *
 * The destination is an ANCHOR, not a click handler: the card is reachable from
 * the keyboard, opens in a new tab with the platform's own gesture, and needs no
 * script. The surface is a `jelly-card` and the anchor fills it, so the whole
 * card is the target.
 *
 * `level` is the one thing a caller decides:
 *
 * - `3` - a page inside a section (`<h3>`), the section's `h2` above it.
 * - `2` - one of the three ways in, which has no section above it, so the card's
 *   own title is the level-two heading.
 *
 * A page with no `description` still prints a note: `◎ DESCRIPTION: UNAVAILABLE`
 * in the note's own slot, at the note's own size. A card that closed up by two
 * lines would be a card that read as a failure rather than as a page whose
 * description has not been written yet, and the grid is a set - the set's rows
 * are the same height or the reader counts the difference as damage.
 *
 * No script and no hydration directive: the card is static.
 */
import type { DocLink } from "./Type.js";

interface Props {
	/** The card's content. */
	card: DocLink;

	/** The card's heading level: `2` above the sections, `3` inside one. */
	level?: 2 | 3;

	/**
	 * What the card prints when the page has no `description`.
	 *
	 * Absent, the card says so in the record grammar rather than closing up:
	 * a grid of cards is a set, and a card that is two lines shorter than its
	 * neighbours reads as a card that failed to load, not as a page whose
	 * description has not been written. `UNAVAILABLE` is the vocabulary's word
	 * for a fact the tree cannot fill - never a zero, never a blank cell.
	 */
	absent?: string;
}

const { card, level = 3, absent = "DESCRIPTION: UNAVAILABLE" } = Astro.props;
---

<li class:list={["doc-card", level === 2 ? "doc-card--feature" : null]}>
	<jelly-card
		class="doc-card__surface"
		style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
	>
		<a
			class="doc-card__link"
			href={card.Href}
			target={card.Blank ? "_blank" : undefined}
			rel={card.Blank ? "noopener noreferrer" : undefined}
		>
			{level === 2 ? (
				<h2 class="doc-card__title">{card.Label}</h2>
			) : (
				<h3 class="doc-card__title">{card.Label}</h3>
			)}
			{card.Note ? (
				<p class="doc-card__note">{card.Note}</p>
			) : (
				<p class="doc-card__note doc-card__note--absent" data-state="empty">
					<span class="doc-card__mark" aria-hidden="true">
						◎
					</span>
					{absent}
				</p>
			)}
		</a>
	</jelly-card>
</li>
