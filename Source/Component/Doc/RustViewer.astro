---
/**
 * RustViewer - the rustdoc frame and the crate switcher above it.
 *
 * One component, because the two halves are one interaction: the tab bar is the
 * frame's only control, and the frame is what every tab loads. Splitting them
 * would leave a bar with nothing to point at.
 *
 * What this file owns and what it does not:
 *
 * - It renders one tab per crate and one `<iframe>` whose `src` starts on the
 *   first crate, so the page is readable before any script runs.
 * - It ships the switching script, because the switching IS this component's
 *   behaviour. The script is the interaction the page had before this shell
 *   existed, unchanged: click a tab, the frame loads that crate, the URL hash
 *   follows, and a hash on load restores the tab.
 * - It does not print the crate list. The list is `RustBand` in `Rust/Data.ts`,
 *   rendered by the same `DocIndex` the documentation index uses.
 *
 * The active tab is marked by `aria-selected` and by `--active` - attribute and
 * ink, so the state is not colour-only. No inline style, no Tailwind string: the
 * partial `System/Component/Doc/_Rust.scss` owns the anatomy.
 */
import type { RustCrate } from "./Rust/Type.js";

interface Props {
	/** The crates, in tab order. The first one is what the frame opens on. */
	crates: readonly RustCrate[];

	/** The tab list's accessible name. */
	label: string;

	/** The frame's accessible name. */
	title: string;

	/**
	 * What the viewer prints when the page passed no crate.
	 *
	 * An empty tab bar and an `<iframe>` with no `src` is a frame around
	 * nothing, which is the one composition a reader reads as broken rather than
	 * as absent. The viewer keeps its frame and states the absence inside it, in
	 * the record grammar.
	 */
	empty?: string;

	/** The one line under the absence: why there is no crate, and what to do. */
	emptyNote?: string;

	/**
	 * The viewer's own name, so two viewers on one page cannot collide.
	 *
	 * The frame's id is derived from this, and the script is scoped to the
	 * viewer's own root: `document.querySelectorAll` over the page would let one
	 * bar's click move another bar's ink and every arrow key walk both lists,
	 * which is wrong for any page that mounts more than one viewer (the specimen
	 * sheet mounts three).
	 */
	id?: string;
}

const {
	crates,
	label,
	title,
	empty = "No crate is filed for this group, so the frame has nothing to open.",
	emptyNote = "The crates are read from the Rust workspace at build time; a group with none is a workspace that has not been generated yet.",
	id = "RustDoc",
} = Astro.props;

/** The crate the frame opens on, or `undefined` if the page passed none. */
const First = crates.at(0);

/** The frame's element id: the viewer's own name, so instances never collide. */
const FrameId = `${id}Frame`;
---

{crates.length === 0 ? (
	<div class="doc-rust__viewer doc-rust__viewer--absent" data-state="empty">
		<div class="doc-rust__absent">
			<p class="doc-rust__absent-mark" aria-hidden="true">◎</p>
			<p class="doc-rust__absent-value">{empty}</p>
			<p class="doc-rust__absent-note">{emptyNote}</p>
		</div>
	</div>
) : (
	<div class="doc-rust__viewer" data-state="loading" data-rust-viewer>
		<div class="doc-rust__bar" role="tablist" aria-label={label}>
			{crates.map((Crate, Index) => (
				<button
					type="button"
					role="tab"
					aria-selected={Index === 0 ? "true" : "false"}
					aria-controls={FrameId}
					tabindex={Index === 0 ? 0 : -1}
					data-id={Crate.Id}
					data-rustdoc-url={Crate.Url}
					class:list={[
						"doc-rust__tab",
						Index === 0 ? "doc-rust__tab--active" : null,
					]}
				>
					{Crate.Label}
				</button>
			))}
		</div>

		{/* The frame's own state line. It prints `LOADING` until the frame has
		    loaded, and the script removes it then; with JavaScript off it stays,
		    because a viewer that cannot know whether rustdoc arrived should say
		    so rather than imply it did. */}
		<p class="doc-rust__state" data-rust-state>
			<span class="doc-rust__state-key">STATUS:</span>
			LOADING
		</p>

		{/* The frame's permission set, written once, here. rustdoc needs scripts
		    and its own origin to render, and the two navigation permissions are
		    the reader's own gesture - so the sandbox is a window with a lock on
		    it, never a page that can navigate the document it is embedded in.
		    `System/Component/Doc/_Rust.scss` documents the box this frame sits
		    in and names this file as the owner of the list; neither file
		    states the other's half. */}
		<iframe
			id={FrameId}
			class="doc-rust__frame"
			src={First?.Url}
			title={title}
			loading="lazy"
			sandbox="allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"
		></iframe>
	</div>
)}

<script>
	/**
	 * One viewer's behaviour, scoped to its own root.
	 *
	 * The root is the instrument, and the instrument is what a script may touch:
	 * every query below starts at `Root`, so a second viewer on the page cannot
	 * answer for this one's tabs, frame or state line.
	 */
	const Wire = (Root: HTMLElement): void => {
		const Tabs = Array.from(
			Root.querySelectorAll<HTMLButtonElement>(".doc-rust__tab"),
		);

		const Frame = Root.querySelector<HTMLIFrameElement>(".doc-rust__frame");

		const State = Root.querySelector<HTMLElement>("[data-rust-state]");

		if (!Tabs.length) return;

		/** Move the active state to one tab: attribute first, ink follows the class. */
		const SetActive = (ActiveTab: HTMLButtonElement): void => {
			Tabs.forEach((Tab) => {
				const IsActive = Tab === ActiveTab;

				Tab.setAttribute("aria-selected", IsActive ? "true" : "false");
				Tab.tabIndex = IsActive ? 0 : -1;
				Tab.classList.toggle("doc-rust__tab--active", IsActive);
			});
		};

		/**
		 * The tab list's keyboard path.
		 *
		 * `role="tablist"` is a promise the browser does not keep by itself: a
		 * reader who tabs into the bar lands on one tab, and the pattern they are
		 * owed is the arrows moving between tabs, Home and End going to the ends,
		 * and focus following the selection. Without it the bar is three buttons
		 * in a row that happen to be called tabs.
		 */
		const Move = (Tab: HTMLButtonElement, Step: 1 | -1): void => {
			const At = Tabs.indexOf(Tab);

			if (At === -1) return;

			const Next = Tabs[(At + Step + Tabs.length) % Tabs.length];

			if (!Next) return;

			Next.focus();
			Next.click();
		};

		const Choose = (Tab: HTMLButtonElement): void => {
			const Url = Tab.dataset["rustdocUrl"];
			const Id = Tab.dataset["id"];

			if (!Url || !Frame) return;

			Frame.src = Url;

			SetActive(Tab);

			if (Id) history.replaceState(null, "", `#${Id}`);
		};

		Tabs.forEach((Tab) => {
			Tab.addEventListener("click", () => Choose(Tab));

			Tab.addEventListener("keydown", (Event) => {
				switch (Event.key) {
					case "ArrowRight":
					case "ArrowDown":
						Event.preventDefault();
						Move(Tab, 1);
						break;
					case "ArrowLeft":
					case "ArrowUp":
						Event.preventDefault();
						Move(Tab, -1);
						break;
					case "Home":
						Event.preventDefault();
						Tabs[0]?.focus();
						Tabs[0]?.click();
						break;
					case "End": {
						Event.preventDefault();
						const Last = Tabs.at(-1);

						Last?.focus();
						Last?.click();
						break;
					}
					default:
						break;
				}
			});
		});

		/* The frame's state line, and the viewer's own `data-state`: the pair says
		   `loading` until rustdoc has arrived and `rest` after, so the block's
		   stylesheet can paint the wait without a spinner. */
		const Settle = (): void => {
			Root.setAttribute("data-state", "rest");
			State?.remove();
		};

		Frame?.addEventListener("load", Settle);

		/* Restore the active tab from the URL hash on load. Clicking the tab runs
		   the same handler the reader would, so the frame, the attribute and the
		   hash can never disagree. Only the first viewer whose bar holds the
		   crate answers, so a page with three viewers restores one tab. */
		const Hash = window.location.hash.slice(1);

		if (Hash && Root.dataset["rustRestored"] === undefined) {
			const Match = Tabs.find((Tab) => Tab.dataset["id"] === Hash);

			if (Match) {
				Root.dataset["rustRestored"] = "true";
				Match.click();
			}
		}
	};

	document
		.querySelectorAll<HTMLElement>("[data-rust-viewer]")
		.forEach((Root) => Wire(Root));
</script>
