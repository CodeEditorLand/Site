---
/**
 * DocAppendix - one of the three artifacts that close the documentation index.
 *
 * They share a shape - an `h2`, then one panel holding a sentence and a set of
 * destinations - and differ only in how the destinations print. The baseline
 * rendered three different bodies, so this file has three branches and switches
 * on `appendix.Kind` rather than on the heading:
 *
 * - **`architecture`** - the fifteen elements as a badge strip, then one link
 *   out to the organisation. Each badge is an anchor, so the element a reader
 *   taps is the element that opens.
 * - **`backend`** - four workers, each a link and its own sentence. The sentence
 *   is printed with the `-` the baseline printed in front of it, because that
 *   hyphen is part of the row: the link names the service and the dash opens its
 *   description.
 * - **`deployments`** - twelve destinations as a two-column tile grid, each tile
 *   a name, its arrow and one line of context.
 *
 * Every string is `appendix.Rows` (or `appendix.Index` for the badges) - this
 * file prints data, it does not carry copy.
 *
 * No script and no hydration directive: the appendices are static.
 */
import type { DocAppendix } from "./Type.js";

interface Props {
	/** The artifact to render. */
	appendix: DocAppendix;

	/**
	 * The artifact's own state. `rest` prints its body; `empty` and `loading`
	 * print the panel's absence under the same heading and lede.
	 *
	 * The three appendices are the index's last three subjects, and until this
	 * prop existed a build that could not read one of them printed an `h2`, a
	 * sentence and then nothing - a heading over a hole at the foot of the page
	 * a reader scrolls to when they want the map. The absence is the panel's
	 * own: the sentence stays, the mark says what is missing.
	 */
	state?: "rest" | "empty" | "loading";

	/** The sentence an empty panel prints. */
	empty?: string;

	/** The keys a loading panel prints, barred. */
	keys?: readonly string[];
}

const {
	appendix,
	state = "rest",
	empty,
	keys,
} = Astro.props;

const Panel = appendix.Kind;

/** The keys a loading panel shows when the page passed none. */
const LoadingKeys = keys ?? ["DESTINATION", "ROUTE", "NOTE"];

/**
 * The architecture strip's own partial state: the fifteen elements are read
 * from the record, and a build that read the panel and not its strip prints the
 * sentence and the absence rather than an empty `<ul>` - an empty badge run
 * under a lede about the elements reads as a strip that collapsed.
 */
const Badges = appendix.Index ?? [];

const StripAbsent = state === "rest" && Panel === "architecture" && Badges.length === 0;
---

<section class="doc-appendix" id={appendix.Id}>
	<h2 class="doc-section__heading">{appendix.Heading}</h2>
	<div class="doc-appendix__panel" data-state={state}>
		<p class="doc-appendix__lede">{appendix.Lede}</p>

		{state === "empty" ? (
			<p class="doc-appendix__absent" data-state="empty">
				<span class="doc-appendix__absent-mark" aria-hidden="true">
					◎
				</span>
				{empty ??
					"The destinations this panel lists have not been read in this build, so it states what would be here rather than printing an empty body."}
			</p>
		) : state === "loading" ? (
			<dl class="doc-appendix__keys" aria-busy="true">
				{LoadingKeys.map((Key) => (
					<div class="doc-appendix__key">
						<dt class="doc-appendix__key-label">{Key}:</dt>
						<dd class="doc-appendix__key-value">
							<span class="doc-appendix__bar" aria-hidden="true" />
						</dd>
					</div>
				))}
			</dl>
		) : (
			<>
				{Panel === "architecture" ? (
					StripAbsent ? (
						<p class="doc-appendix__absent" data-state="empty">
							<span class="doc-appendix__absent-mark" aria-hidden="true">
								◎
							</span>
							STATUS:{"\u2001"}UNAVAILABLE
						</p>
					) : (
						<ul class="doc-badges">
							{Badges.map((Entry) => (
								<li class="doc-badges__item">
									<a class="doc-badge" href={Entry.href}>
										{Entry.label}
									</a>
								</li>
							))}
						</ul>
					)
				) : null}

		{Panel === "backend" ? (
			<ul class="doc-services">
				{appendix.Rows.map((Row) => (
					<li class="doc-services__item">
						<a
							class="doc-services__link"
							href={Row.Href}
							target={Row.Blank ? "_blank" : undefined}
							rel={Row.Blank ? "noopener noreferrer" : undefined}
						>
							{Row.Label}
							<span
								class="doc-appendix__arrow"
								aria-hidden="true"
							>
								↗
							</span>
						</a>{" "}
						<span class="doc-services__note">- {Row.Note}</span>
					</li>
				))}
			</ul>
		) : null}

		{Panel === "deployments" ? (
			<ul class="doc-tiles">
				{appendix.Rows.map((Row) => (
					<li class="doc-tiles__item">
						<a
							class="doc-tile"
							href={Row.Href}
							target={Row.Blank ? "_blank" : undefined}
							rel={Row.Blank ? "noopener noreferrer" : undefined}
						>
							<span class="doc-tile__label">
								{Row.Label}
								<span
									class="doc-appendix__arrow"
									aria-hidden="true"
								>
									↗
								</span>
							</span>
							{Row.Note ? (
								<span class="doc-tile__note">{Row.Note}</span>
							) : null}
						</a>
					</li>
				))}
			</ul>
		) : null}

		{Panel === "architecture" ? (
			<div class="doc-appendix__foot">
				{appendix.Rows.map((Row) => (
					<a
						class="doc-appendix__link"
						href={Row.Href}
						target={Row.Blank ? "_blank" : undefined}
						rel={Row.Blank ? "noopener noreferrer" : undefined}
					>
						{Row.Label}
						<span class="doc-appendix__arrow" aria-hidden="true">
							↗
						</span>
					</a>
				))}
			</div>
		) : null}
			</>
		)}
	</div>
</section>
