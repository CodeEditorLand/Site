---
/**
 * DocContents - the page's own contents: the sections of this document, or the
 * sections of this index, as a list of in-page anchors that marks where the
 * reader is.
 *
 * It answers a different question from the rail's tree. The tree says *which page
 * of the manual am I on*; this says *which part of this page am I in*. A
 * nine-hundred-line article has ten or twenty `##` sections, and before this
 * block the page printed none of them: a reader who landed mid-article had the
 * tree, which never changes while they read.
 *
 * Two registers, one data shape, and the register is the only thing a caller
 * chooses:
 *
 * - **`rail`** - the pinned block at the top of the sticky rail, >= 1024px. The
 *   rail's head; the tree takes the rail's scroll underneath it.
 * - **`disclosure`** - a CSS-only `<details>` between the metadata strip and the
 *   paper, below 1024px, where the rail is not painted at all. Collapsed by
 *   default: the page's sections are one tap away, and the reading column stays
 *   the first thing on the screen.
 *
 * What the block does NOT do, and a caller must not add: it does not build the
 * list from markup. The items come from `Function/Doc/BuildDocToc`, which reads
 * the headings `render()` reported - so the anchors are the pipeline's ids and
 * the entries are the document's own sections. A page with fewer than two
 * sections, or one that carries its own `## Table of Contents`, gets no list at
 * all (`BuildDocToc` returns `null`): an empty nav is worse than none, and two
 * contents lists on one page are worse than one.
 *
 * The current entry is marked by `Contents.ts` - `aria-current="location"`, the
 * ink, the weight and a 2px `--Accent` rule on the row's leading edge, the same
 * four marks the tree marks its current page with. The rule was 1px `--Primary`
 * and moved with `Stylesheet/System/Component/Doc/_Contents.scss`; the rule's
 * width is reserved on every row, so a row becoming current shifts nothing. With
 * JavaScript off the list is still a working jump list; only the marking is
 * absent.
 *
 * Two facts about the register itself, and both came out of the state matrix:
 *
 * - **It counts itself.** `ON THIS PAGE␁12` is the same counted line the rest of
 *   the site prints, and the figure is `Items.length` - derived, never passed in,
 *   so it cannot outlive the rows. It prints in both registers, because closed
 *   the summary's count is the only figure the reader has.
 * - **It can fold and it can tighten.** The rail's head is capped at half the
 *   rail; a document with ninety sections spends that cap on its own contents
 *   and leaves the tree a slit. `collapsible` prints the rail register as a
 *   `<details open>` - one row with the label, the count and the way back in -
 *   and `dense` is the tight step. Nothing is hidden: the fold is open by
 *   default, so it is the reader's choice and never a page's.
 */
import DocContentsList from "./DocContentsList.astro";

import type { DocToc } from "./Type.js";

interface Props {
	/** The list to render. Absent or empty renders nothing at all. */
	toc?: DocToc | null;

	/** Where the list sits. `rail` in the sticky rail, `disclosure` in the flow. */
	variant?: "rail" | "disclosure";

	/**
	 * Fold the rail register into a `<details open>`.
	 *
	 * The rail's head is capped at half the rail (`Doc/_Layout.scss`), and a
	 * document with ninety sections spends that cap on rows the reader can
	 * scroll. Folded, the register is one row - its label, its count and the
	 * way back in - and the tree underneath gets the rail's whole scroll.
	 * Open by default, so the fold is a reader's choice and never a page's
	 * decision to hide its own contents. CSS only: no script, no hydration,
	 * and it prints open.
	 */
	collapsible?: boolean;

	/**
	 * The tight step. Ninety rows at the reading step are 4,000px of rail; at
	 * the dense step they are 2,600px, and the row grammar - marker, name,
	 * reserved rule - is unchanged. Nothing is dropped, only the air.
	 */
	dense?: boolean;

	/** Extra classes from the caller, appended after the block's own. */
	class?: string;
}

const {
	toc,
	variant = "rail",
	collapsible = false,
	dense = false,
	class: Class,
} = Astro.props;

const Items = toc?.Items ?? [];

const Label = toc?.Label ?? "";

/**
 * The count is the list's own length.
 *
 * A contents register is a register: `# ON THIS PAGE / 12` is what the site
 * prints for every other counted line, and a rail that named the register and
 * not its extent was the one place the grammar was missing. It is derived here
 * and never passed in, so it cannot outlive the rows it counts - and it is
 * printed in both registers, because the disclosure's summary needs it more
 * than the rail does (closed, it is the only figure the reader has).
 */
const Count = String(Items.length).padStart(2, "0");

const RootClass = (Base: string): string =>
	[
		"doc-contents",
		Base,
		collapsible ? "doc-contents--fold" : null,
		dense ? "doc-contents--dense" : null,
		Class,
	]
		.filter((Part): Part is string => Part !== null)
		.join(" ");
---

{Items.length > 0 ? (
	variant === "disclosure" ? (
		<details class={RootClass("doc-contents--disclosure")} data-doc-contents>
			<summary class="doc-contents__summary">
				<span class="doc-contents__label">{Label}</span>
				<span class="doc-contents__count">{Count}</span>
				<span class="doc-contents__marker" aria-hidden="true">
					›
				</span>
			</summary>
			<nav class="doc-contents__nav" aria-label={Label}>
				<DocContentsList items={Items} />
			</nav>
		</details>
	) : collapsible ? (
		/* The rail's register, folded. Open by default: the fold exists so a
		   reader can give the rail's scroll to the tree, not so a page can
		   withhold its own contents. The summary carries the same label, the
		   same count and the same `›` the disclosure carries, so one row means
		   the same thing in both registers. */
		<details
			class={RootClass("doc-contents--rail")}
			open
			data-doc-contents
		>
			<summary class="doc-contents__summary">
				<span class="doc-contents__label">{Label}</span>
				<span class="doc-contents__count">{Count}</span>
				<span class="doc-contents__marker" aria-hidden="true">
					›
				</span>
			</summary>
			<nav class="doc-contents__nav" aria-label={Label}>
				<DocContentsList items={Items} />
			</nav>
		</details>
	) : (
		<nav
			class={RootClass("doc-contents--rail")}
			aria-label={Label}
			data-doc-contents
		>
			<p class="doc-contents__label">
				<span class="doc-contents__label-text">{Label}</span>
				<span class="doc-contents__count">{Count}</span>
			</p>
			<DocContentsList items={Items} />
		</nav>
	)
) : null}

<script>
	import { WireContents } from "./Contents.js";

	WireContents();
</script>
