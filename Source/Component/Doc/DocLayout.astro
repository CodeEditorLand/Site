---
/**
 * DocLayout - the documentation column: a sticky navigation rail beside the
 * content column, and the same navigation collapsed into a panel above it on
 * narrow viewports.
 *
 * **The rail carries two registers, and they answer two questions.** Its head is
 * the page's own contents (`DocContents`, pinned): *which part of this page am I
 * in*. Under a hairline, the tree takes the rail's scroll: *which page of the
 * manual am I on*. Before this, the rail only ever answered the second - and a
 * nine-hundred-line article never changed the answer while the reader was
 * reading it. The pinned head is bounded (it never takes more than half the rail)
 * and scrolls on its own if a document has more sections than fit; the tree is
 * what scrolls, because it is the list a reader walks.
 *
 * Both pages that have a sidebar render this instead of retyping the aside, so
 * the rail's width, its sticky behaviour, its two scroll areas and the mobile
 * panel are one decision in one file.
 *
 * Four notes on what this file does NOT do:
 *
 * - **It does not render `<main>`.** `Base.astro` already owns the page's one
 *   `<main id="main-content">`, and a `<main>` inside a `<main>` is invalid
 *   markup that leaves the skip link pointing at the outer element anyway. The
 *   content column is a `<div>`; the rail is the `<aside>` that names the
 *   landmark.
 * - **It does not render `<h1>`.** The content the page passes in owns the
 *   page's only level-one heading.
 * - **It does not wrap the content in a container of its own.** `.doc-layout`
 *   carries the page's one container and gutter; a second one inside the column
 *   would indent the content away from the rail it is read beside.
 * - **It does not build the contents.** `contents` is the page's `DocToc` - the
 *   same object `DocArticle` renders as its narrow-viewport disclosure - so the
 *   two registers cannot disagree about what this page contains.
 *
 * `id="top"` is here because the documentation pages link back to `#top` and
 * nothing on the page defined it.
 *
 * The sidebar is an island because it collapses: it is the one part of this
 * shell that hydrates. It is rendered twice - once as the rail, once as the
 * mobile panel - and exactly one of the two is painted at any viewport width
 * (`.doc-layout__aside` is `display:none` below 1024px, `.doc-sidebar--mobile`
 * is `display:none` above it), so each instance carries `client:media` with the
 * complement of its own `display:none` rule instead of `client:load`:
 * hydrating both meant hydrating a 78-row tree that was never painted.
 *
 * The two queries are written without spaces on purpose. The build strips
 * attribute quotes, and an unquoted attribute value cannot contain a space -
 * `(min-width: 1024px)` would be truncated at the space and the island would
 * silently never hydrate.
 */
import { GetI18n } from "../../Library/I18n/Server";
import { DynamicDocSidebar } from "../Dynamic/DynamicDocSidebar";

import DocContents from "./DocContents.astro";

import type { DocSection } from "../Dynamic/Interface/Content/Page/Doc.js";
import type { DocToc } from "./Type.js";

interface Props {
	sections: DocSection[];

	/** The current page's collection id, so the rail can mark it. */
	activeId?: string;

	/**
	 * Render the collapsed navigation panel above the content below the rail's
	 * breakpoint. `true` on a page, where the rail is the only way around the
	 * tree; `false` on the index, where the page's own card grid IS the
	 * navigation and the baseline showed no panel at all.
	 */
	mobile?: boolean;

	/**
	 * The page's own contents, pinned at the head of the rail. Absent on a page
	 * that has no sections to list, and then the rail is the tree alone.
	 */
	contents?: DocToc | null;
}

const { sections, activeId, mobile = true, contents } = Astro.props;

/**
 * The margin channel.
 *
 * The manual's article had two tracks - the rail and the measure - and no place
 * for apparatus: the facts about the page itself (which section filed it, which
 * group it nests under, where a correction goes). A third track exists only when
 * a page hands one in, so the 34 pages that need none keep the two-track grid
 * they had, and the article that does gets the reading language's full three.
 *
 * THE CHANNEL HAS THREE FORMS AND ONE MARKUP (`_Layout.scss`). Above 84rem of
 * desk it is a sticky column at the page's right edge; between the rail's
 * breakpoint and that, it leaves the flow and becomes the bar pinned under the
 * header - the same items laid inline, scrolling horizontally when they do not
 * fit; below 1024 it prints under the paper, opened by the divider. Nothing is
 * hidden in any of them, which is why there is no second copy of this aside
 * anywhere in the tree.
 */
const HasMargin = Astro.slots.has("margin");

const T = GetI18n();

const SidebarTitle = T("sidebar.title", {
	ns: "doc",
	defaultValue: "Documentation",
});
---

<div class="doc-layout" id="top">
	<div class="doc-layout__shell">
		<aside class="doc-layout__aside" aria-label="Documentation navigation">
			<div class="doc-layout__sticky">
				{contents && contents.Items.length > 0 ? (
					<div class="doc-layout__head">
						<DocContents toc={contents} variant="rail" />
					</div>
				) : null}

				<div class="doc-layout__tree">
					<p class="doc-layout__title">{SidebarTitle}</p>
					<DynamicDocSidebar
						Sections={sections}
						ActiveId={activeId}
						client:media="(min-width:1024px)"
					/>
				</div>

				<div class="doc-layout__foot">
					<a class="doc-layout__rust" href="/Doc/Rust">
						Rust API{"\u2001"}<span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</aside>

		<div class="doc-layout__main">
			{mobile ? (
				<DynamicDocSidebar
					Sections={sections}
					ActiveId={activeId}
					Mobile={true}
					client:media="(max-width:1023.98px)"
				/>
			) : null}
			<slot />
		</div>

		{HasMargin ? (
			<aside class="doc-layout__margin" aria-label="Page apparatus">
				<slot name="margin" />
			</aside>
		) : null}
	</div>
</div>
