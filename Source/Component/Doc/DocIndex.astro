---
/**
 * DocIndex - one section of the documentation index: the section name as the
 * heading, then one card per page underneath.
 *
 * The baseline rendered ten of these, each a `<section>` whose `h2` was the
 * section name and whose body was a three-column card grid. That is what this
 * file renders, and it is the whole of it: the section's cards arrive already
 * ordered and already filtered (`Function/Doc/BuildDocIndex.ts`), so no
 * decision about content is taken here.
 *
 * Two notes a caller should know:
 *
 * - **The `h2` is the section's, the `h3` is the card's.** A card title is a
 *   level below the heading it is filed under, which is why `DocCard` takes a
 *   level and this component passes `3`.
 * - **The anchor id is the section's slug**, so `/Doc#deep-dive` addresses the
 *   same section the sidebar calls `Deep Dive`. It is on the `<section>`, not
 *   on the heading, so the whole grid is the target.
 *
 * No script and no hydration directive: the section is static.
 */
import DocCard from "./DocCard.astro";

import type { DocSection } from "./Type.js";

interface Props {
	/** The section to render. */
	section: DocSection;
}

const { section } = Astro.props;
---

<section class="doc-section" id={section.Id}>
	<h2 class="doc-section__heading">{section.Heading}</h2>
	<ul class="doc-grid">
		{
			section.Rows.map((Card) => (
				<DocCard card={Card} level={3} />
			))
		}
	</ul>
</section>
