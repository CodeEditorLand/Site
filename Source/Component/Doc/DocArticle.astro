---
/**
 * DocArticle - the reading shell every documentation surface shares: the
 * page-level breadcrumb, then kicker, the page's only `h1`, standfirst, the
 * metadata strip, then the body.
 *
 * That is the whole sequence: breadcrumb, kicker, the page's only `h1`,
 * standfirst, the metadata strip, then the body.
 *
 * Three things the shell owns so no page re-decides them:
 *
 * - **One `h1`.** The title is the page's single level-one heading; the blocks
 *   inside the body never render one, and the markdown's own `# ` line is
 *   demoted by `Function/Markdown/Heading.ts`, so a page cannot produce two.
 * - **The metadata strip.** `DesignSystem-Pages.md` §5 requires a mono
 *   `STATUS` / `LAYER` / `SOURCE` / `COMPAT` / `UPDATED` strip above doc prose,
 *   and it is the record grammar on a page that prints a record: `STATUS:` and
 *   `LAYER:` are the `:` field labels, and `UNAVAILABLE` is the grammar's own
 *   word for a field the tree cannot fill. The page builds the fields
 *   (`Function/Doc/BuildDocStrip`) because only the page knows its section and
 *   its source; the shell owns where they sit - between the header and the body,
 *   at the header's measure, above the prose it describes. It is the record's
 *   metadata row, not a second paragraph of the standfirst.
 * - **One measure.** The header, the strip and (by default) the body are capped
 *   at the same `var(--Measure)` - the plate, 72-88ch, fluid on the window - so
 *   the standfirst ends where the prose ends at every width, and a wider window
 *   widens the page's paper rather than the prose's line.
 *   `measure={false}` drops the body cap and nothing else - the index's card
 *   grid and the Rust page's viewer need the full column, the header still
 *   reads at one measure.
 *
 * The shell renders the page's own contents in one place: a CSS-only
 * `<details>` between the strip and the paper, **below** the rail's breakpoint.
 * Above it the sticky rail carries the same list (`DocLayout`), so the page never
 * prints two contents lists side by side; below it the rail is not painted at
 * all, and this is the only signpost the reading column has. The list itself is
 * `BuildDocToc`'s - the headings `render()` reported, never a second slug
 * function - and a page with fewer than two sections, or one that carries its own
 * `## Table of Contents`, passes nothing and renders nothing.
 *
 * The container contract: the shell adds no gutter and no max width of its own:
 * the page owns the one container (`DocLayout` on the rail pages, the page's own
 * class on a page without a rail).
 *
 * The kicker is the section's own name, printed as the caller wrote it and
 * upper-cased by the type role - `/Deep Dive` on the page, `/DEEP DIVE` on
 * screen. A page with no section (the index itself) passes no kicker at all and
 * renders no paragraph.
 *
 * One script, no hydration: `Well.ts` wraps the body's fenced blocks in the
 * site's own well anatomy and hands them to `WireWells`. It runs after the
 * markup, it only adds, and with JavaScript off the blocks stay the framed mono
 * they were.
 */
import type { DocStripItem, DocToc } from "./Type.js";
import DocContents from "./DocContents.astro";

import RecordPlate from "../Record/RecordPlate.astro";

import type { Plate } from "../Record/Type.js";

interface Props {
	/** The section's name, e.g. `Deep Dive`. Printed verbatim; upper-cased in CSS. */
	kicker?: string;

	/** The page's `title`. The page's only `h1`. */
	title: string;

	/** The page's `description`, at standfirst weight. */
	standfirst?: string;

	/**
	 * The same sentence, already carrying the site's inline term links. A page
	 * that runs its copy through `LinkMentions` passes the result here instead
	 * of `standfirst`, so the anchors in the opening sentence survive.
	 */
	standfirstHtml?: string;

	/**
	 * The mono metadata strip: one `DocStripItem` per field, rendered with U+2001
	 * between them. Built by `Function/Doc/BuildDocStrip`, which supplies the five
	 * documented fields in their documented order and appends whatever else the
	 * page can prove.
	 */
	strip?: readonly DocStripItem[];

	/**
	 * The page's own contents, for the disclosure between the strip and the
	 * paper. The shell renders it once, below the rail's breakpoint, where the
	 * sticky rail is not painted; above it the rail carries the same list and
	 * this one is hidden. Absent means the page has no sections of its own to
	 * list (`BuildDocToc` said so), and then nothing is rendered at all.
	 */
	contents?: DocToc | null;

	/** Cap the body at the reading measure. Defaults to `true`. */
	measure?: boolean;

	/**
	 * The page's plate, when the page is about something the build has a capture
	 * of (or a manifest for). It prints between the metadata strip and the paper:
	 * the evidence comes after the page has said what it is and before the prose
	 * argues it. Absent, the shell renders no plate at all - never an empty frame.
	 */
	plate?: Plate | null;

	/**
	 * The page's position, as a page-level nav. Position is the kicker's job
	 * inside a band (LAYER-MAP §4), so this is the one place the documentation
	 * surfaces carry a breadcrumb: rendered by the shell, never retyped per page.
	 * The last crumb is the current page and renders as text, not a link.
	 */
	crumbs?: readonly { label: string; href?: string }[];

	/**
	 * The file the page was set from, declared on the body for the wells.
	 *
	 * A fenced block in an article is a claim about the software - a command
	 * that runs, a config that loads, a signature that compiles - and until this
	 * prop existed the well printed it with no citation at all: `Well.ts` wraps
	 * every block in the site's well anatomy in the browser, and the browser
	 * cannot know which markdown file the block came from. The shell knows, or
	 * its caller does, so it is written on the body as `data-doc-source` and
	 * each well prints `SOURCE: <file> BLOCK NN OF NN` under its body.
	 *
	 * Absent, the wells print `◎ UNAVAILABLE` in that row rather than nothing:
	 * a page that cannot cite its blocks should say so, not look cited.
	 */
	source?: string;

	/** Extra classes from the page, appended after the shell's own. */
	class?: string;

	/**
	 * The paper's own state. `rest` prints the body; `empty` and `loading`
	 * print the paper's absence in the record grammar instead.
	 *
	 * A white card with nothing in it is a page that reads as broken - the one
	 * composition a documentation surface cannot leave to chance, because the
	 * header, the strip and the frame above it all say the page exists. `empty`
	 * prints the page's own sentence about what would be here; `loading` prints
	 * the keys with their values barred, because the keys are the schema and
	 * arrive first.
	 */
	state?: "rest" | "empty" | "loading";

	/** The sentence an empty paper prints. Required by `state="empty"`. */
	empty?: string;

	/** The keys a loading paper prints, barred. */
	keys?: readonly string[];
}

const {
	kicker,
	title,
	standfirst,
	standfirstHtml,
	strip,
	contents,
	measure = true,
	plate,
	crumbs,
	source,
	class: Class,
	state = "rest",
	empty,
	keys,
} = Astro.props;

/** The keys a loading paper shows when the page passed none. */
const LoadingKeys = keys ?? ["SECTION", "HEADING", "BLOCK"];
---

<article class:list={["doc-article", Class]}>
	{crumbs?.length ? (
		<nav class="doc-article__crumbs" aria-label="Breadcrumb">
			<ol class="doc-article__crumb-list">
				{crumbs.map((Crumb) => (
					<li class="doc-article__crumb">
						{Crumb.href ? (
							<a
								class="doc-article__crumb-link"
								href={Crumb.href}
							>
								{Crumb.label}
							</a>
						) : (
							<span
								class="doc-article__crumb-current"
								aria-current="page"
							>
								{Crumb.label}
							</span>
						)}
					</li>
				))}
			</ol>
		</nav>
	) : null}
	<header class="doc-article__header">
		{kicker ? <p class="doc-article__kicker">{kicker}</p> : null}
		<h1 class="doc-article__title">{title}</h1>
		{standfirst ? (
			<p class="doc-article__standfirst">{standfirst}</p>
		) : null}
		{standfirstHtml && (
			<p class="doc-article__standfirst" set:html={standfirstHtml} />
		)}
	</header>

	{strip?.length ? (
		<p class="doc-article__strip">
			{strip.map((Item, Position) => (
				<>
					{Position > 0 ? (
						<span class="doc-article__separator" aria-hidden="true">
							{"\u2001"}
						</span>
					) : null}
					<span class="doc-article__field">
						<span class="doc-article__label">{Item.Label}</span>
						<span
							class:list={[
								"doc-article__value",
								Item.Tone
									? `doc-article__value--${Item.Tone}`
									: null,
							]}
						>
							{Item.Value}
						</span>
					</span>
				</>
			))}
		</p>
	) : null}

	{plate ? (
		<div class="doc-article__plate">
			<RecordPlate plate={plate} />
		</div>
	) : null}

	{contents && contents.Items.length > 0 ? (
		<div class="doc-article__contents">
			<DocContents toc={contents} variant="disclosure" />
		</div>
	) : null}

	<div
		class:list={[
			"doc-article__body",
			measure ? "doc-article__body--measure" : null,
		]}
		data-doc-source={source}
		data-state={state}
	>
		{state === "empty" ? (
			<div class="doc-article__absent" data-state="empty">
				<p class="doc-article__absent-mark" aria-hidden="true">
					◎
				</p>
				<p class="doc-article__absent-value">
					{empty ??
						"This page has no prose in this build: its source has not been set, so there is nothing to read here yet."}
				</p>
				<p class="doc-article__absent-note">
					STATUS:{"\u2001"}UNAVAILABLE
				</p>
			</div>
		) : state === "loading" ? (
			<dl class="doc-article__keys" aria-busy="true">
				{LoadingKeys.map((Key) => (
					<div class="doc-article__key">
						<dt class="doc-article__key-label">{Key}:</dt>
						<dd class="doc-article__key-value">
							<span class="doc-article__bar" aria-hidden="true" />
						</dd>
					</div>
				))}
			</dl>
		) : (
			<slot />
		)}
	</div>
</article>

<script>
	import { WireDocument } from "./Well.js";

	WireDocument();
</script>
