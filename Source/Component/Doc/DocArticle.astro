---
/**
 * DocArticle - the reading shell every documentation surface shares: the
 * page-level breadcrumb, then kicker, the page's only `h1`, standfirst, then
 * the body.
 *
 * That is the whole sequence, and it is the sequence the baseline rendered on
 * every documentation page. Two things the shell deliberately does NOT render,
 * because the baseline did not:
 *
 * - **No metadata strip.** The baseline article carried no `STATUS` / `LAYER` /
 *   `SOURCE` / `COMPAT` / `UPDATED` row - the only `STATUS` and `SOURCE` on the
 *   page belong to the footer's own record. A strip above the prose would be an
 *   invented element on a page whose reference is readable from git, so the
 *   shell has none.
 * - **No generated contents list.** The one table of contents the baseline
 *   rendered was the document's own (`## Table of Contents` in the markdown,
 *   which the prose renders in place). A second list above it was the shell's,
 *   and it is gone.
 *
 * What the shell still owns:
 *
 * - **One `h1`.** The title is the page's single level-one heading; the blocks
 *   inside the body never render one, so a page that composes from blocks can
 *   never produce two.
 * - **One measure.** The header and (by default) the body are capped at the same
 *   `72ch`, so the standfirst ends where the prose ends. `measure={false}` drops
 *   the body cap and nothing else - the index's card grid and the Rust page's
 *   viewer need the full column, the header still reads at one measure.
 * - **The container contract.** The shell adds no gutter and no max width of its
 *   own: the page owns the one container (`DocLayout` on the rail pages, the
 *   page's own class on a page without a rail).
 *
 * The kicker is the section's own name, printed as the caller wrote it and
 * upper-cased by the type role - `Deep Dive` on the page, `DEEP DIVE` on screen.
 * The baseline printed the section, not a `/SECTION` path, and this shell never
 * invents a leading slash. A page with no section (the index itself) passes no
 * kicker at all and renders no paragraph.
 *
 * No script and no hydration directive.
 */
interface Props {
	/** The section's name, e.g. `Deep Dive`. Printed verbatim; upper-cased in CSS. */
	kicker?: string;

	/** The page's `title`. The page's only `h1`. */
	title: string;

	/** The page's `description`, at standfirst weight. */
	standfirst?: string;

	/**
	 * The same sentence, already carrying the site's inline term links. A page
	 * that runs its copy through `LinkMentions` passes the result here instead
	 * of `standfirst`, so the anchors in the opening sentence survive.
	 */
	standfirstHtml?: string;

	/** Cap the body at the reading measure. Defaults to `true`. */
	measure?: boolean;

	/**
	 * The page's position, as a page-level nav. Position is the kicker's job
	 * inside a band (LAYER-MAP §4), so this is the one place the documentation
	 * surfaces carry a breadcrumb: rendered by the shell, never retyped per page.
	 * The last crumb is the current page and renders as text, not a link.
	 */
	crumbs?: readonly { label: string; href?: string }[];

	/** Extra classes from the page, appended after the shell's own. */
	class?: string;
}

const {
	kicker,
	title,
	standfirst,
	standfirstHtml,
	measure = true,
	crumbs,
	class: Class,
} = Astro.props;
---

<article class:list={["doc-article", Class]}>
	{
		crumbs?.length ? (
			<nav class="doc-article__crumbs" aria-label="Breadcrumb">
				<ol class="doc-article__crumb-list">
					{crumbs.map((Crumb) => (
						<li class="doc-article__crumb">
							{Crumb.href ? (
								<a class="doc-article__crumb-link" href={Crumb.href}>
									{Crumb.label}
								</a>
							) : (
								<span class="doc-article__crumb-current" aria-current="page">
									{Crumb.label}
								</span>
							)}
						</li>
					))}
				</ol>
			</nav>
		) : null
	}
	<header class="doc-article__header">
		{kicker ? <p class="doc-article__kicker">{kicker}</p> : null}
		<h1 class="doc-article__title">{title}</h1>
		{standfirst ? <p class="doc-article__standfirst">{standfirst}</p> : null}
		{
			standfirstHtml && (
				<p class="doc-article__standfirst" set:html={standfirstHtml} />
			)
		}
	</header>

	<div
		class:list={[
			"doc-article__body",
			measure ? "doc-article__body--measure" : null,
		]}
	>
		<slot />
	</div>
</article>
