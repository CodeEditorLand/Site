---
// ContactShell - one request route: its document chrome, its opening, and its
// workspace.
//
// ─── WHAT THIS FILE IS ───────────────────────────────────────────────────
// The route's three parts are three blocks, and this file is the composition
// that joins them:
//
//   ContactPage       the document: `<Base>`, the site header, the page's measure
//   ContactHead       the opening: the trail and the route's record head
//   ContactWorkspace  the composition: the record column beside the form
//
// Each part is a block so it can be printed and re-composed outside a document;
// this file holds no markup of its own. The route is unchanged by the split: the
// same trail, the same record head, the same 4/1px/8 split, the same form, the
// same order on a phone.
//
// ─── WHAT THE SHELL KEEPS ────────────────────────────────────────────────
// The trail keeps the three destinations the routes already had: `/`, then
// `/Dashboard`, then this request's own title. The opening is the trail and the
// route's record head. The Auth0 identifiers are read the same way the routes
// read them. The form is the only island.
//
// `state` is the route's condition, passed to the workspace: an interrupted send
// prints `STATUS: INTERRUPTED` at the top of the record column.
import ContactPage from "./ContactPage.astro";
import ContactWorkspace from "./ContactWorkspace.astro";
import { Requests, type IncomeCode } from "../../Library/Contact/Request.js";
import type { ContactTrailItem } from "../../Library/Contact/Data.js";

interface Props {
	/** The income code whose configuration this route renders. */
	code: IncomeCode;

	/**
	 * `rest` is the route at rest. `interrupted` states that the form's last send
	 * did not complete: the record column prints `STATUS: INTERRUPTED` and the
	 * route's declarations, so the failure is auditable beside the form that
	 * reports it.
	 */
	state?: "rest" | "interrupted";
}

const { code, state = "rest" } = Astro.props;

const Config = Requests[code];

/** The trail: home, the dashboard the request is filed from, then the request. */
const trail: readonly ContactTrailItem[] = [
	{ label: "/HOME", href: "/" },
	{ label: "/DASHBOARD", href: "/Dashboard" },
	{ label: `/${Config.Title.toUpperCase()}` },
];
---

<ContactPage
	metaTitle={`${Config.Title} | Code Editor Land`}
	metaDescription={Config.Subtitle}
	trail={trail}
	record={{
		code: Config.Code,
		article: Config.Article,
		route: "/CONTACT",
		window: Config.ResponseDays,
	}}
	opening="trail"
>
	<ContactWorkspace code={code} state={state} />
</ContactPage>
