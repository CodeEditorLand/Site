---
/**
 * ContactBreadcrumb - the Contact surface's trail adapter.
 *
 * The site has one trail grammar: the mono `/LABEL` form `DESIGN.md` §9 Q3
 * settled on, published as `.trail` from `System/Component/Route/_Trail.scss`
 * and rendered by `Component/Route/Trail.astro`. This file renders that
 * component and writes a caller's crumb labels into the grammar, so a caller
 * that hands in `Home` gets `/HOME` and a caller that already writes `/HOME`
 * gets `/HOME` back unchanged. The transform lives here rather than in `Trail`
 * because `Trail` prints its label as written and never re-cases it.
 *
 * It is kept rather than deleted because a card does not delete a component. No
 * Blog component imports it any more - `Blog/BlogIndex.astro` and
 * `Blog/BlogArticle.astro` import `Route/Trail` directly and write their own
 * crumbs through `Blog/Data.ts`'s `TrailOf` - so the blog no longer reaches
 * through a Contact-named adapter for the site's breadcrumb.
 */
import Trail from "../Route/Trail.astro";
import type { TrailItem } from "../Route/Type.js";

interface Props {
	/** The crumbs, first to last. The last one is the current page. */
	trail: readonly TrailItem[];

	/** A class the page adds to the shell, for its own spacing. */
	class?: string;
}

const { trail, class: Class } = Astro.props;

/** Write a crumb into the grammar: one leading slash, upper case, nothing else. */
const Written = (Label: string): string =>
	`/${Label.replace(/^\/+/, "").toUpperCase()}`;

/**
 * The crumbs, with their labels written into the grammar and every other field
 * carried through untouched.
 *
 * The bridge spreads each crumb and overrides only the one field it is here to
 * write. Rebuilding the item as `{ label, href }` would silently drop any field
 * `TrailItem` grows - a `current` marker, a title, a count - and a bridge that
 * reconstructs a shape is a bridge that loses the next thing the shape learns.
 */
const Crumbs: readonly TrailItem[] = trail.map((Crumb) => ({
	...Crumb,
	label: Written(Crumb.label),
}));
---

<Trail trail={Crumbs} {...(Class ? { class: Class } : {})} />
