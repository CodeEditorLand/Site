---
// ContactPage - the page chrome every Contact route shares.
//
// Fifteen routes opened with the same eleven lines: the document layout, the
// header, a container, a breadcrumb and an `h1` with a standfirst. That is one
// page opening, so it lives here once and the routes compose it.
//
// The shell's opening, in order: the trail, the route's record head, and - on
// the two pages that have one - the page's `h1` and the sentence under it.
//
// The record head is the four facts that are the route's rather than the
// visit's: `# REACH`, the statutory basis `〈GDPR Art. 15 + 20〉`, the route
// `/CONTACT`, and the window `SLA: 30d`. The baseline printed them inside the
// form's chip row; they are the same on every visit, so they belong to the page
// and the form keeps what changes per visit - the pair reference and the state
// word. A route with no statutory basis prints no bracket, because an empty
// `〈 〉` is a claim the page cannot back.
//
// What the shell does not own is anything below the opening: a request route
// hands in its form, which prints its own `h1` (the request title, inside the
// form's own opening), the hub hands in its grid, the sale page its two panels.
//
// The trail is `Component/Route/Trail.astro` - the site's one breadcrumb
// grammar (`DESIGN.md` §9 Q3), not a Contact detail. It prints each crumb as
// `/LABEL`, so the page reads `/HOME  /CONTACT` above its heading.
//
// The shell prints the route's record head. The baseline renders no `# CODE` /
// `〈 〉` / `/CONTACT` line on any contact page, so the card that added one had
// to justify it; the justification is that the facts already existed as chips
// inside the form, and a chip row that prints the same route fact on every
// visit is a page fact wearing the form's clothes. The record head prints them
// once, where the page's own facts go, and the form keeps the pair reference.
//
// `opening` is the one difference between the two shapes: a page opens with the
// breadcrumb and its heading at `py-16`; a request route opens with the
// breadcrumb alone, at `pt-6`, and its body starts immediately.
//
// `width` is the opening's measure - the hub and the request routes are
// `max-w-5xl`, the sale page `max-w-4xl` - and the body that follows repeats it
// so the two line up on the same left edge.
//
// `mode` is a pass-through to the site header, not a second layout.
//
// No script of its own: the header is the only island here.
import Base from "../../Layout/Base.astro";
import { Header } from "../Layout/Header";
import Trail from "../Route/Trail.astro";
import type { ContactTrailItem } from "../../Library/Contact/Data.js";
import type { ContactRecord } from "./Type.js";

interface Props {
	/** The document title. */
	metaTitle: string;

	/** The document description. */
	metaDescription: string;

	/** The breadcrumb trail, last crumb being this page. */
	trail: readonly ContactTrailItem[];

	/**
	 * The route's record head: `# REACH  〈GDPR Art. 15 + 20〉  /CONTACT  SLA: 30d`.
	 *
	 * The four facts are the route's, not the form's - they are the same on every
	 * visit - so they belong to the page. The form keeps what changes per visit:
	 * the pair reference and the state word. One screen, one copy of each fact.
	 */
	record?: ContactRecord;

	/** The page's only `h1`, when the page opens with one. */
	heading?: string;

	/** The sentence under the `h1`, when the page has one. */
	standfirst?: string;

	/** The opening's measure. `wide` is the hub and the request routes. */
	width?: "wide" | "narrow";

	/** `page` opens with a heading; `trail` is the breadcrumb alone. */
	opening?: "page" | "trail";

	/** The site header's presentation, passed through unchanged. */
	mode?: "minimal" | "functional";
}

const {
	metaTitle,
	metaDescription,
	trail,
	record,
	heading,
	standfirst,
	width = "wide",
	opening = "page",
	mode,
} = Astro.props;
---

<Base
	Title={metaTitle}
	Description={metaDescription}
	Url={Astro.url.href}
	Language="en"
>
	<Header client:load {...(mode ? { Mode: mode } : {})} slot="Header" />

	<div class="contact-page">
		<div
			class:list={[
				"contact-page__open",
				`contact-page__open--${width}`,
				`contact-page__open--${opening}`,
			]}
		>
			<Trail trail={trail} />

			{record && (
				<p class="contact-page__record">
					<span class="contact-page__record-code">
						# {record.code}
					</span>
					{record.article ? (
						<span class="contact-page__record-article">
							〈{record.article}〉
						</span>
					) : null}
					<span class="contact-page__record-route">
						{record.route}
					</span>
					{record.window ? (
						<span class="contact-page__record-window">
							SLA: {record.window}d
						</span>
					) : null}
					{record.count ? (
						<span class="contact-page__record-count">
							REGISTER: {record.count} ENTRIES
						</span>
					) : null}
				</p>
			)}

			{heading && (
				<header class="contact-page__header">
					<h1 class="contact-page__heading">{heading}</h1>
					{standfirst ? (
						<p class="contact-page__standfirst">{standfirst}</p>
					) : null}
				</header>
			)}
		</div>

		<slot />
	</div>
</Base>
