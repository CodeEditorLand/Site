---
// ContactPage - the page chrome every Contact route shares.
//
// Fifteen routes opened with the same eleven lines: the document layout, the
// header, a container, a breadcrumb list and an `h1` with a standfirst. That is
// one page opening, so it lives here once and the routes compose it.
//
// What the shell owns, in order: the document (`Base`), the site header, the
// record header (`# CODE`, the `〈 〉` stamp, `/CONTACT`), the breadcrumb trail,
// the page's only `h1` at `--type-section`, and the standfirst at `--type-sub`.
// What it does not own is anything below that - a request route hands in its
// form, the hub and the sale page hand in their records.
//
// `mode` is a pass-through to the site header, not a second layout: the hub
// opens in the functional header it already used, and the request routes keep
// the minimal one they already used.
//
// No script of its own: the header is the only island here.
import Base from "../../Layout/Base.astro";
import { Header } from "../Layout/Header";
import ContactBreadcrumb from "./ContactBreadcrumb.astro";
import type { ContactTrailItem } from "../../Library/Contact/Data.js";

interface Props {
	/** The document title. */
	metaTitle: string;

	/** The document description. */
	metaDescription: string;

	/** The breadcrumb trail, last crumb being this page. */
	trail: readonly ContactTrailItem[];

	/** The page's only `h1`. */
	heading: string;

	/** The sentence under the `h1`, when the page has one. */
	standfirst?: string;

	/**
	 * The record header - the grammar's opening line, above the trail.
	 *
	 * Three symbols, and each one is a different fact (`DesignSystem-Grammar.md`
	 * §1): `#` is the series marker, `〈 〉` is the stamp that classifies the
	 * record, `/` is the route it is filed on. A request route prints its income
	 * code, its statutory basis and `/CONTACT`; the hub and the sale page print
	 * their own. Optional, because a surface with no basis to print passes the
	 * index and the route and nothing else - the block never invents a stamp.
	 */
	record?: {
		/** The series marker, e.g. `# AMEND`. Printed exactly as given. */
		readonly index: string;

		/** The classification, printed inside `〈 〉`, e.g. `GDPR Art. 16`. */
		readonly stamp?: string;

		/** The route, e.g. `/CONTACT`. Printed exactly as given. */
		readonly route: string;
	};

	/** The site header's presentation, passed through unchanged. */
	mode?: "minimal" | "functional";
}

const {
	metaTitle,
	metaDescription,
	trail,
	heading,
	standfirst,
	record,
	mode,
} = Astro.props;
---

<Base
	Title={metaTitle}
	Description={metaDescription}
	Url={Astro.url.href}
	Language="en"
>
	<Header client:load {...mode ? { Mode: mode } : {}} slot="Header" />

	<div class="contact-page">
		<header class="contact-page__header">
			{
				record && (
					<p class="contact-page__record">
						<span class="contact-page__index">{record.index}</span>
						{record.stamp && (
							<span class="contact-page__stamp">
								〈{record.stamp}〉
							</span>
						)}
						<span class="contact-page__route">{record.route}</span>
					</p>
				)
			}
			<ContactBreadcrumb trail={trail} />
			<h1 class="contact-page__heading">{heading}</h1>
			{standfirst ? <p class="contact-page__standfirst">{standfirst}</p> : null}
		</header>

		<slot />
	</div>
</Base>
