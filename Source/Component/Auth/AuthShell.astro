---
/**
 * AuthShell - the one card the account and verify routes render.
 *
 * The baseline's shape, restored: a `py-20` section, a centred `max-w-md`
 * measure, and a single `jelly-card` on the canvas. The route supplies the
 * card's interior - the heading block, the fields and the states - so the
 * surfaces cannot disagree about the measure, the surface or the vertical
 * rhythm.
 *
 * The heading is deliberately NOT the shell's. The baseline prints an `h3`
 * inside the card on Verify and on both password routes, and the account
 * index prints no heading at all, so a shell that owned an `h1` would print
 * one the baseline never had. Each route names itself inside the card.
 *
 * The root is a `<div>`, not a `<main>`: `Base.astro` already renders the
 * document's single `<main id="main-content">`, and the skip link points at
 * it. A second `<main>` here would be a second landmark and a duplicate ID.
 *
 * `min-h-screen` reproduces the baseline's page-start treatment - the content
 * column fills the viewport before the footer, even on the short states.
 */
interface Props {
	/** The section's accessible name - the route's own surface name. */
	Label: string;

	/** `md` is the card's 28rem measure; `2xl` is for a field table. */
	Width?: "md" | "2xl";

	/** Centre the card's own text block (the reset route's loading state). */
	Center?: boolean;

	/** Announce the interior's changes (the verify route's state machine). */
	Live?: boolean;
}

const { Label, Width = "md", Center = false, Live = false } = Astro.props;

/* The card paints itself from its own custom properties, so the interior
   controls its own padding - the baseline's blocks carry their own `p-6`. */
const Surface = {
	"--jelly-fill": "var(--Card)",
	"--jelly-radius": "0px",
	"--jelly-card-color": "inherit",
	"--jelly-card-padding-block": "0px",
	"--jelly-card-padding-inline": "0px",
	"--jelly-card-font-size": "inherit",
};
---

<div class="flex min-h-screen flex-col">
	<div class="flex-1">
		<section class="py-20" aria-label={Label}>
			<div class="container mx-auto px-4">
				<div
					class:list={[
						"mx-auto",
						Width === "2xl" ? "max-w-2xl" : "max-w-md",
						Center && "text-center",
					]}
					aria-live={Live ? "polite" : undefined}
				>
					<jelly-card
						class="StaccatoBorderShimmer StaccatoCard StaccatoShadowLift text-card-fg"
						style={Surface}
					>
						<slot />
					</jelly-card>
				</div>
			</div>
		</section>
	</div>
</div>
