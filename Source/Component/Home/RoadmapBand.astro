---
/**
 * RoadmapBand - `# CONDITIONS_01`: the two release records, as one manifest.
 *
 * The band used to print two white cards in two equal columns - two objects
 * floating on the creme field, each with its own filled button. It now prints
 * ONE plate divided by the same hairline gutter the hero's pair uses, with the
 * two states as its columns. That is the density budget's own instruction
 * (`DesignSystem-Grammar.md` §8: "release state = one manifest/table"), and it
 * makes the page's second spread rhyme with its first: a claim beside its
 * evidence at the top, a state beside its successor here.
 *
 * The band sits between the features and the architecture bands, which is where
 * the baseline printed it: the page states the claim, then what is released,
 * then what the thing is made of, then where it runs.
 */
import { BandOf, HomeBands, Sequence } from "../../Content/Home/Band.js";
import { ReleaseCards } from "../../Content/Home/Roadmap.js";
import { GetI18n } from "../../Library/I18n/Server";

import Band from "./Band.astro";
import ReleaseCard from "./ReleaseCard.astro";

const T = GetI18n();

const Head = BandOf(HomeBands(T), "pricing");
---

<Band head={Head} series="CONDITIONS" rhythm={Sequence.pricing}>
	<jelly-card class="home-manifest">
		{/*
		 * The grid lives on this div, not on the Jelly surface: Jelly's shadow
		 * `.card` is a block wrapper, so slotted children are laid out inside
		 * it and never become grid items of the host. A wrapper is the only
		 * thing that makes the two states two columns.
		 */}
		<div class="home-manifest__grid">
			{ReleaseCards.map((Card, Index) => (
				<>
					{Index > 0 && (
						<div class="home-manifest__gutter" aria-hidden="true" />
					)}
					<ReleaseCard card={Card} />
				</>
			))}
		</div>
	</jelly-card>
</Band>
