---
/**
 * ReleaseCard - one of the two release records in the roadmap manifest.
 *
 * The record is a **column of the manifest plate**, not a card of its own: the
 * band owns the white surface and the hairline gutter, and this file prints one
 * state on its half of it. A card inside a card is the one thing `DESIGN.md`
 * §1.3 forbids, and two cards side by side were what made the release state read
 * as two offers rather than two states of one offer.
 *
 * The record is read as: a stamped header (`# RELEASE_01`, `〈ACTIVE SOURCE〉`,
 * `/ CHANNEL: PUBLIC`, `STATUS:`, `TARGET:`, `SIGNAL:`), the state's one action,
 * the state's name, and then the two labelled lists it is read through.
 *
 * `Elements` is one row per element the release carries - its name as a badge
 * that opens the element's documentation page, its role, and the line that says
 * what it replaces or which technology it uses, with that technology lifted into
 * a badge of its own. `Manifest` is six `KEY: VALUE` rows and prints as six.
 *
 * THE ACTION IS ONE PER ARTIFACT. `# RELEASE_01` is the state a reader can act
 * on today, so it carries the ink action - the one `.emphasis-expressive` in
 * this manifest. `# RELEASE_02` is the state a reader can only watch, so it
 * carries its destination as the site's route line at the accent. Two filled
 * buttons in one plate would be two primary actions, and a Jelly button left on
 * its default ink would wear a blue that is in neither the palette nor the
 * accent.
 */
import type { ReleaseCard as ReleaseCardData } from "../../Content/Home/Type.js";

import Mark from "../Mark/Mark.astro";

interface Props {
	card: ReleaseCardData;
}

const { card } = Astro.props;

/**
 * A segment's ink, as the one style it prints.
 *
 * The template below prints each segment with NO whitespace between them: a
 * whitespace-only line between two elements in an `.astro` template survives as
 * a text node and collapses to a real space, which is what put air on one side
 * of the containment pair and none on the other. Every gap a stamp line prints
 * is a mark's (`Mark/_Punctuation.scss`), so the template must contribute none.
 */
const InkStyle = (Ink?: string) => (Ink ? `color:${Ink}` : undefined);

/**
 * Which state carries the ink action. The record's own marker is the only
 * identity the data gives a state, so it is the thing the decision reads: the
 * first state is the one that is out.
 */
const Primary = card.Index === "# RELEASE_01";

/** The action's Jelly ink: the same five properties the hero's action sets. */
const ActionInk =
	"--jelly-button-radius:var(--RadiusButton);--jelly-button-height:44px;" +
	"--jelly-button-padding-inline:2.6rem;--jelly-button-min-width:0px;" +
	"--jelly-color-background-accent:var(--Foreground);" +
	"--jelly-color-foreground-on-accent:var(--Background)";
---

<article class="home-release">
	<div class="home-release__head">
		<div class="home-release__stamp">
			<span class="home-release__index">{card.Index}</span>

			{/* THE STAMP IS PRINTED WITHOUT WHITESPACE BETWEEN ITS SEGMENTS.
			    The segments are the line, and a mark contributes its own gap
			    (`Mark/_Punctuation.scss`) - the template contributes none. A
			    whitespace-only line between two elements survives as a text
			    node and collapses to a real space, which is what turned the
			    containment pair into `〈 ACTIVE SOURCE 〉` and what made the
			    same colon print on two different sides in two cards. See
			    `Mark/Containment.astro` and `Content/Home/Roadmap.ts`. */}
			{card.Stamp.map((Line) => (
				<span class="home-release__stamp-line">{Line.map((Span) => ("Mark" in Span ? <Mark kind={Span.Mark} tone={Span.Tone} inline style={InkStyle(Span.Ink)} /> : <span style={InkStyle(Span.Ink)}>{Span.Text}</span>))}</span>
			))}
		</div>

		<div class="home-release__action">
			{Primary ? (
				<a
					class="home-release__anchor"
					href={card.Action.Href}
					target="_blank"
					rel="noopener noreferrer"
				>
					<jelly-button block style={ActionInk}>
						{card.Action.Label}
					</jelly-button>
				</a>
			) : (
				<a
					class="home-release__destination"
					href={card.Action.Href}
					target="_blank"
					rel="noopener noreferrer"
				>
					<Mark kind="slash" />{card.Action.Label}
				</a>
			)}
		</div>

		<h3 class="home-release__title">{card.Title}</h3>
	</div>

	<div class="home-release__body">
		<p class="home-release__section">Elements</p>

		<ul class="home-release__list">
			{card.Elements.map((Element) => (
				<li class="home-release__item">
					<a
						class="home-release__element"
						href={Element.Href}
						style={`color:${Element.Ink}`}
					>
						<jelly-badge
							shape="square"
							style="--jelly-fill:var(--SpineIPCMute);--jelly-label:currentColor;--jelly-badge-radius:0px;--jelly-badge-font-size:0.78em"
						>
							{Element.Name}
						</jelly-badge>
					</a>

					<span class="home-release__role">{Element.Role}</span>

					<span class="home-release__line">
						{Element.Before}
						{Element.Badge && (
							<Fragment>
								{" "}
								<jelly-badge
									shape="square"
									style="--jelly-fill:var(--SpineIPCMute);--jelly-label:currentColor;--jelly-badge-radius:0px;--jelly-badge-font-size:0.78em"
								>
									{Element.Badge}
								</jelly-badge>{" "}
							</Fragment>
						)}
						{Element.After}
					</span>
				</li>
			))}
		</ul>

		<p class="home-release__section">Manifest</p>

		<ul class="home-release__manifest">
			{card.Manifest.map((Line) => (
				<li class="home-release__manifest-row">{Line.map((Span) => ("Mark" in Span ? <Mark kind={Span.Mark} inline style={InkStyle(Span.Ink)} /> : <span style={InkStyle(Span.Ink)}>{Span.Text}</span>))}</li>
			))}
		</ul>
	</div>
</article>
