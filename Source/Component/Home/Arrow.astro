---
/**
 * Arrow - the external-link mark that follows a record's own name.
 *
 * A record's name is a link out of the page: it opens the element's repository
 * in a second tab. The mark says so, and it is `aria-hidden` because the link's
 * accessible name already says where it goes.
 */
---

<svg
	class="home-record__arrow"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	<path d="M15 3h6v6"></path>
	<path d="M10 14 21 3"></path>
	<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
</svg>
