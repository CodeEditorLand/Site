---
/**
 * PlatformCard - one of the three platform records in the download band.
 *
 * The card prints the platform's name in that platform's own ink beside its
 * glyph, the architecture it ships for inside containment, the channel, and then
 * the four justified rows a release is read through - version, size, signing and
 * status - with the platform's action between them.
 *
 * The action is a Jelly button inside its own anchor, so the row works with and
 * without JavaScript: the element is the control, the anchor is the destination.
 */
import { Apple, Monitor, Terminal } from "lucide-react";

import type { PlatformCard as PlatformCardData } from "../../Content/Home/Type.js";

interface Props {
	card: PlatformCardData;
}

const { card } = Astro.props;

/** The three platform glyphs, by the name the data carries. */
const Glyphs = { Apple, Monitor, Terminal } as const;

const Glyph = Glyphs[card.Icon as keyof typeof Glyphs] ?? Monitor;
---

<jelly-card class="home-card home-platform">
	<div class="home-platform__head">
		<span class="home-platform__index">{card.Index}</span>

		<h3 class="home-platform__name" style={`color:${card.Ink}`}>
			<Glyph className="home-platform__icon" size={18} aria-hidden="true" />
			{card.Name}
		</h3>
	</div>

	<p class="home-platform__architecture">
		<span class="home-record__bracket" aria-hidden="true">〈</span>
		{card.Architecture}
		<span class="home-record__bracket" aria-hidden="true">〉</span>
	</p>

	<p class="home-platform__route">
		<span class="home-record__slash" aria-hidden="true">/</span>
		<span class="home-record__route-key">CHANNEL</span>
		<span class="home-record__route-value">: {card.Channel}</span>
	</p>

	<dl class="home-platform__ledger">
		<div class="home-platform__row">
			<dt class="home-platform__key">Version:</dt>
			<dd class="home-platform__value">{card.Version}</dd>
		</div>
		<div class="home-platform__row">
			<dt class="home-platform__key">Size:</dt>
			<dd class="home-platform__value">{card.Size}</dd>
		</div>
		<div class="home-platform__row">
			<dt class="home-platform__key">SIGNING:</dt>
			<dd class="home-platform__value">{card.Signing}</dd>
		</div>
	</dl>

	<div class="home-platform__action">
		<a class="home-platform__anchor" href={card.Action.Href}>
			<jelly-button block class="home-platform__button">
				{card.Action.Label}
			</jelly-button>
		</a>
	</div>

	<p class="home-platform__status">
		<span class="home-record__status-key">{card.Status.Label}</span>
		<span class="home-record__status-value">{card.Status.Value}</span>
	</p>
</jelly-card>
