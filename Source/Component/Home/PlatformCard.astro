---
/**
 * PlatformCard - one artefact row of the download manifest.
 *
 * The band is the page's **Manifest** artifact (`DESIGN.md` §1.8: "verified
 * facts + available artifacts - download, releases, checksums, compatibility"),
 * so it is one plate with three rows, not three cards. Each row prints one
 * platform: its marker and its name in the platform's own ink, the architecture
 * it ships for inside containment, the channel, and the seven facts a release is
 * read through - version, size, signing, webview, minimum OS, checksum and
 * toolchain - then its status and the one action that gets it.
 *
 * The row is a short ledger, not eight columns: the identity on the left and the
 * facts beside it, with the status and the action at the right end of the fact
 * line. At `md` and up the identity takes its own column, so the three names
 * line up down the plate. Eight columns of 13px mono in one line is a
 * spreadsheet; two ruled lines per artefact is a manifest.
 *
 * The action is a Jelly button inside its own anchor, so the row works with and
 * without JavaScript: the element is the control, the anchor is the destination.
 * Its ink is the site's, not Jelly's default blue - the same five properties the
 * hero's action and the release manifest's action set.
 */
import { Apple, Monitor, Terminal } from "lucide-react";

import type { PlatformCard as PlatformCardData } from "../../Content/Home/Type.js";

import Containment from "../Mark/Containment.astro";

import { ToneOf } from "./Tone.js";

interface Props {
	card: PlatformCardData;
}

const { card } = Astro.props;

/** The three platform glyphs, by the name the data carries. */
const Glyphs = { Apple, Monitor, Terminal } as const;

const Glyph = Glyphs[card.Icon as keyof typeof Glyphs] ?? Monitor;

/** The action's Jelly ink: ink fill, creme label, radius 0. */
const ActionInk =
	"--jelly-button-radius:var(--RadiusButton);--jelly-button-height:40px;" +
	"--jelly-button-padding-inline:1.25rem;--jelly-button-min-width:0px;" +
	"--jelly-color-background-accent:var(--Foreground);" +
	"--jelly-color-foreground-on-accent:var(--Background)";
---

<div class="home-platform">
	<div class="home-platform__id">
		<span class="home-platform__index">{card.Index}</span>

		<h3 class="home-platform__name" style={`color:${card.Ink}`}>
			<Glyph
				className="home-platform__icon"
				size={18}
				aria-hidden="true"
			/>
			{card.Name}
		</h3>

		<p class="home-platform__architecture">
			<Containment label={card.Architecture} />
		</p>
	</div>

	<div class="home-platform__facts">
		<p class="home-platform__route">
			<span class="home-record__slash" aria-hidden="true">/</span>{" "}
			<span class="home-record__route-key">CHANNEL</span><span class="home-record__route-value">: {card.Channel}</span>
		</p>

		<dl class="home-platform__ledger">
			<div class="home-platform__row">
				<dt class="home-platform__key">Version:</dt>
				<dd class="home-platform__value">{card.Version}</dd>
			</div>
			<div class="home-platform__row">
				<dt class="home-platform__key">Size:</dt>
				<dd class="home-platform__value">{card.Size}</dd>
			</div>
			<div class="home-platform__row">
				<dt class="home-platform__key">SIGNING:</dt>
				<dd class="home-platform__value">{card.Signing}</dd>
			</div>
			<div class="home-platform__row">
				<dt class="home-platform__key">WEBVIEW:</dt>
				<dd class="home-platform__value">{card.Webview}</dd>
			</div>
			<div class="home-platform__row">
				<dt class="home-platform__key">MINIMUM:</dt>
				<dd class="home-platform__value">{card.Minimum}</dd>
			</div>
			<div class="home-platform__row">
				<dt class="home-platform__key">CHECKSUM:</dt>
				<dd class="home-platform__value">{card.Checksum}</dd>
			</div>
			<div class="home-platform__row">
				<dt class="home-platform__key">TOOLCHAIN:</dt>
				<dd class="home-platform__value">{card.Toolchain}</dd>
			</div>
		</dl>

		{/*
			The reason the three absent rows are absent, stated once at the card's
			floor. `UNAVAILABLE` is the vocabulary's word for a fact that exists and
			is empty; the note is what makes it a fact rather than a hole with a
			word in it. It is a record line, not a caption: same size, muted ink,
			and it rules off the ledger above it.
		*/}
		<p class="home-platform__note">
			<span class="home-record__status-key">NOTE:</span>
			{card.Note}
		</p>

		<p class="home-platform__status">
			<span class="home-record__status-key">{card.Status.Label}</span>
			<span
				class="home-record__status-value"
				data-tone={ToneOf(card.Status.Value)}
			>
				{card.Status.Value}
			</span>
		</p>

		<div class="home-platform__action">
			<a class="home-platform__anchor" href={card.Action.Href}>
				<jelly-button class="PlatformDownloadButton" style={ActionInk}>
					{card.Action.Label}
				</jelly-button>
			</a>
		</div>
	</div>
</div>
