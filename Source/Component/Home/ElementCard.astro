---
/**
 * ElementCard - one of the fifteen element records in the architecture band.
 *
 * The card is the features card plus the three things an element record carries
 * and a feature record does not: its name row (the element's own name, its glyph
 * and the mark that says the name leaves the page), its role chips, and the
 * paragraph that says what it does.
 *
 * `span` is the card's width in the twelve-column masonry. It is a custom
 * property rather than a class because the five widths the baseline uses are
 * values, not styles - the band sets the span per card and the stylesheet reads
 * it, so adding a width needs no new rule.
 *
 * The one element the record set draws without a device prints the seal's own
 * FORM instead - the neutral roundel (`Mark/SealNeutral.tsx`), with the grammar's
 * `◎` in its empty field - in the same box as every other element's seal, so the
 * band's markers line up and the wall carries one seal form rather than a
 * roundel beside a glyph in a box.
 */
import { FieldRecordSeal } from "../Brand/FieldRecordSeal";
import type { FieldRecordElement } from "../Brand/FieldRecordSeal";

import { SpecimenSeal } from "../UI/SpecimenSeal";

import RecordLedger from "../Record/RecordLedger.astro";
import RecordTrace from "../Record/RecordTrace.astro";
import { RegisterOf } from "../Record/RegisterLine.js";

import Arrow from "./Arrow.astro";
import RecordAnatomy from "./RecordAnatomy.astro";

import type { ElementCard as ElementCardData } from "../../Content/Home/Type.js";

interface Props {
	card: ElementCardData;
}

const { card } = Astro.props;

const Seal = card.SealName as FieldRecordElement;

const Href = card.Source ?? card.Href;

/**
 * The working register, in the ledger's own row shape.
 *
 * The keys carry their colon here because a register row is a compact label
 * (`MANUAL:`), and the ledger prints a key verbatim - it never appends a mark the
 * caller did not write. The `MANUAL` row is the one row that leads somewhere, so
 * it becomes an anchor with the same text it prints as a fact.
 */
const RegisterRows = card.Register.map((Row) => ({
	key: `${Row.Label}:`,
	value: Row.Value,
	note: Row.Note,
	code: Row.Code,
	links:
		Row.Href === undefined
			? undefined
			: [{ text: Row.Value, href: Row.Href }],
}));

/** The trace's provenance is the register's own `MANUAL` row: one page, cited twice. */
const ManualRoute =
	card.Register.find((Row) => Row.Label === "MANUAL")?.Value ?? "UNAVAILABLE";

/**
 * The card's trace in the block's own shape.
 *
 * `Content/Element/Working.ts` writes a record table with capitalised fields;
 * the Record layer's props are lower camel case. The map is the seam, and it is
 * here so the block never grows a second vocabulary for the same three fields.
 */
const TraceSteps = card.Trace.map((Step) => ({
	index: Step.Index,
	path: Step.Path,
	note: Step.Note,
}));
---

<jelly-card
	class="home-card home-element"
	data-depth={card.Depth}
	style={`--masonry-col:${card.Span}`}
>
	<article class="home-record">
		<div class="home-record__head">
			<span class="home-record__index">{card.Index}</span>

			<span class="home-record__seal" aria-hidden="true">
				{card.Seal === "symbol" ? (
					<SpecimenSeal className="home-record__figure" />
				) : (
					<FieldRecordSeal
						element={Seal}
						size="s"
						className="home-record__figure"
					/>
				)}
			</span>
		</div>

		<div class="home-record__name-row">
			<span class="home-record__name">
				{Href === undefined ? (
					card.Title
				) : (
					<a
						class="home-record__name-link"
						href={Href}
						target="_blank"
						rel="noopener noreferrer"
					>
						{card.Title}
					</a>
				)}
			</span>

			<span class="home-record__glyph" aria-hidden="true">
				{card.Glyph}
			</span>

			{Href !== undefined && (
				<a
					class="home-record__source"
					href={Href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Open ${card.Title} source`}
				>
					<Arrow />
				</a>
			)}
		</div>

		{card.Chips.length > 0 && (
			<ul class="home-record__chips">
				{card.Chips.map((Chip) => (
					<li class="home-record__chip">
						<jelly-badge
							shape="square"
							style="--jelly-fill:var(--OSMacOSMute);--jelly-label:var(--CardForeground);--jelly-badge-radius:0;--jelly-badge-font-size:14px"
						>
							{Chip}
						</jelly-badge>
					</li>
				))}
			</ul>
		)}

		<RecordAnatomy card={card}>
			<p class="home-record__body">{card.Body}</p>

			<div class="home-record__working">
				<RecordLedger
					rows={RegisterRows}
					density="register"
					register={RegisterOf("WORKING", RegisterRows)}
					state={RegisterRows.length === 0 ? "empty" : "rest"}
					empty="NO WORKING IS RECORDED FOR THIS ELEMENT YET: THE RECORD PRINTS ITS OWN FACTS AND NAMES NO SOURCE."
				/>

				{card.Depth === "plate" && (
					<RecordTrace
						trace={{
							steps: TraceSteps,
							label: card.Title,
							source: ManualRoute,
							empty: "NO TRACE IS RECORDED FOR THIS ELEMENT: ITS MANUAL PAGE NAMES NO FILE.",
						}}
					/>
				)}
			</div>
		</RecordAnatomy>
	</article>
</jelly-card>
