---
/**
 * TrustClause - one clause of a legal document, and the fact that its number is
 * a place you can link to.
 *
 * A legal document is cited by number: "the Terms, §07". A number that lives
 * only in a CSS `::before` cannot be cited - it is not in the markup, so it is
 * not in the text, not in the search index, and not a target anyone can copy.
 * This block moves the number into the markup and makes it the anchor:
 *
 *   <h2 class="reading-clause reading-clause--cited trust-clause" id="fee-changes">
 *     <a class="trust-clause__cite" href="#fee-changes">§07</a>
 *     <span class="trust-clause__name">Fee Changes</span>
 *   </h2>
 *
 * Four rules this file keeps, and a caller must not break:
 *
 * - **The number is the document's own.** `number` is the value the document's
 *   index already prints (`Library/Document/<Name>/Data.ts`), passed verbatim -
 *   this block derives nothing, so the rail and the heading cannot disagree
 *   about which clause is §07.
 * - **The id is the id the clause already carried.** Every inbound
 *   `#governing-law` keeps working, because the heading's id is not re-derived
 *   from the label.
 * - **The heading is an `h2` and only an `h2`.** The page's one `h1` is the
 *   document's title; a clause that opened a second level-one heading is the
 *   defect the reading surface exists to remove.
 * - **The name is the slot, untouched.** No clause's words are edited here -
 *   the block wraps the sentence the page already carried.
 *
 * `reading-clause` is still worn, so the clause role (1.5rem, weight 500,
 * balanced wrapping, the anchor offset) stays in one place; the `--cited`
 * marker is what tells that role's counter to stand down, because two
 * numbering mechanisms on one heading is a defect.
 *
 * ─── WHAT THE MATRIX ADDED ────────────────────────────────────────────────
 * The legal set's worst state is a clause the document's index names and the
 * text does not carry: a licence page with a missing clause. The block had no
 * way to print it - a caller either omitted the heading (and the index's row
 * pointed at nothing) or printed an empty one. `state="missing"` keeps the
 * number, the anchor and the name, and prints `STATUS: UNAVAILABLE` and the
 * caller's sentence under them, so a cited clause that cannot be read is a
 * tombstone in the record grammar rather than a dead link.
 *
 * The accessible name prints the number as the document wrote it, never a parsed
 * integer: `Clause §${number}` is right for `07`, for `07A` and for `12.1`, where
 * `Clause ${Number(number)}` would print "Clause NaN" for any number written as a
 * word or a sub-clause.
 */
import Mark from "../Mark/Mark.astro";

interface Props {
	/** The clause's number as the document's index prints it: `07`. */
	number: string;

	/** The id the clause already carried, so every inbound anchor still lands. */
	id: string;

	/**
	 * `rest` prints the clause. `missing` prints the same heading as a
	 * tombstone: the number and the anchor stay, and the state says the text
	 * this clause names is not in the document.
	 */
	state?: "rest" | "missing";

	/**
	 * The sentence the missing arm prints: what this clause is, why its text is
	 * not here, and where to read it. Required in spirit when `state` is
	 * `missing` - the state word alone is a fact without a cause.
	 */
	missing?: string;

	/** Extra classes from the page - Contributing's first clause is `sr-only`. */
	class?: string;
}

const {
	number,
	id,
	state = "rest",
	missing,
	class: Class,
} = Astro.props;
---

<h2
	class:list={[
		"reading-clause",
		"reading-clause--cited",
		"trust-clause",
		state === "missing" && "trust-clause--missing",
		Class,
	]}
	id={id}
>
	<a
		class="trust-clause__cite"
		href={`#${id}`}
		aria-label={`Clause §${number}`}
	>
		<span class="trust-clause__mark" aria-hidden="true">
			&#167;
		</span>
		{number}
	</a>
	<span class="trust-clause__name">
		<slot />
	</span>
</h2>

{state === "missing" ? (
	<div class="trust-clause__absent">
		<p class="trust-clause__absent-status">
			<Mark kind="square" tone="quiet" fill="unknown" />
			<span class="trust-clause__absent-key">STATUS:</span>
			UNAVAILABLE
		</p>
		<p class="trust-clause__absent-sentence">
			{missing ??
				`The document's index names this clause, and the text this build carries does not include it. The number still resolves, so a citation to §${number} lands on this statement rather than on the next clause.`}
		</p>
	</div>
) : null}
