---
/**
 * TrustContents - the clause rail: the document's own index, beside the text
 * rather than above it, and marked as the reader moves.
 *
 * Two registers, one data shape, and the register is the only thing a caller
 * chooses:
 *
 * - **`rail`** - the sticky column in the page margin at >= 1024px. It carries
 *   the count (`CLAUSES 26`), the reader's position (`§07`), and every clause
 *   as a `§NN  name` row. The rail is bounded to the viewport and scrolls
 *   itself, so a 26-clause document never pushes the page.
 * - **`disclosure`** - a CSS-only `<details>` above the document below 1024px,
 *   where the rail is not painted at all. Collapsed by default: the reading
 *   column stays the first thing on the screen, and the whole contents list is
 *   one tap away.
 *
 * The list is rendered from `index` - the document's own `ReadingIndexItem[]` -
 * so a rail row and the clause it names cannot disagree. The marking is
 * `Trust/TrustContents.ts`: `aria-current="location"`, the ink, the weight and
 * a 2px `--Accent` rule on the row's leading edge - the four marks every rail on
 * the site uses for the row in force. With JavaScript off the list is still a
 * working jump list; only the marking and the position figure are absent, which
 * is why the position cell reserves its width instead of printing a guess.
 *
 * Both registers carry `data-trust-contents`, so the wiring finds one behaviour
 * and which of the two is painted is the CSS's business, not the script's.
 *
 * ─── WHAT THE MATRIX ADDED ────────────────────────────────────────────────
 * A document whose index is empty printed `CLAUSES 0` over an empty `<ol>`: a
 * count with nothing under it, which reads as a list that failed to render
 * rather than as a document with no clauses. `empty` prints the composed
 * sentence instead - what would be here, why it is not - in both registers, and
 * the count still prints, because the count is the one thing that must not
 * disappear: `0` is a counted zero and it is the honest figure.
 *
 * The rail also stops printing a position cell it cannot fill before the first
 * clause is reached - the cell is reserved in the stylesheet, so the row does
 * not reflow when the figure arrives.
 */
import TrustContentsList from "./TrustContentsList.astro";
import type { ReadingIndexItem } from "../Reading/Type.js";

interface Props {
	/** The document's clauses, in document order. */
	items: readonly ReadingIndexItem[];

	/** The list's visible label and its accessible name (`Clauses`, `Parts`). */
	label: string;

	/** `rail` in the margin at >= 1024px; `disclosure` above the document below it. */
	variant?: "rail" | "disclosure";

	/**
	 * What the register says when the document's index is empty: what would be
	 * here, why it is not, and what to do. Absent, an empty index prints the
	 * count over an empty list - which is the state this prop exists to replace.
	 */
	empty?: string;

	/** Extra classes from the caller, appended after the block's own. */
	class?: string;
}

const {
	items,
	label,
	variant = "rail",
	empty,
	class: Class,
} = Astro.props;

/** Whether the register has anything to list. */
const Held = items.length > 0;
---

{variant === "disclosure" ? (
	<details
		class:list={["trust-contents", "trust-contents--disclosure", Class]}
		data-trust-contents
	>
		<summary class="trust-contents__summary">
			<span class="trust-contents__label">{label}</span>
			<span class="trust-contents__count">{items.length}</span>
			<span class="trust-contents__toggle" aria-hidden="true">
				&#8595;
			</span>
		</summary>
		{Held ? (
			<TrustContentsList items={items} />
		) : empty ? (
			<p class="trust-contents__empty">{empty}</p>
		) : (
			<TrustContentsList items={items} />
		)}
	</details>
) : (
	<nav
		class:list={["trust-contents", "trust-contents--rail", Class]}
		data-trust-contents
		aria-label={label}
	>
		<p class="trust-contents__head">
			<span class="trust-contents__label">{label}</span>
			<span class="trust-contents__count">{items.length}</span>
			{/*
			 * The reader's position. Empty in the server HTML on purpose: before
			 * the first clause is reached there is no clause to name, and a guess
			 * printed here would be a number the reader is not standing on.
			 */}
			<span class="trust-contents__position" data-trust-position />
		</p>
		{Held ? (
			<TrustContentsList items={items} />
		) : empty ? (
			<p class="trust-contents__empty">{empty}</p>
		) : (
			<TrustContentsList items={items} />
		)}
	</nav>
)}
