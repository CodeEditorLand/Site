---
import "@Stylesheet/Base.css";

import Background from "../Background.astro";
import { ErrorBoundary } from "../Component/ErrorBoundary";
import { Footer } from "../Component/Layout/Footer";
import { AnalyticsProvider } from "../Component/Provider/AnalyticsProvider";
import { PageviewTracker } from "../Component/Provider/PageviewTracker";
import MetaTags from "../Component/Social/MetaTags";
import { PascalCaseCanonical } from "../Function/Route/Map";
import { GetI18n } from "../Library/I18n/Server";

// Resolve PascalCase canonical URL for SEO tags.
// Astro builds pages at lowercase paths (e.g., /downloads), but our canonical
// URLs are PascalCase (e.g., /Download). Look up the mapping so that
// <link rel="canonical">, og:url, and all meta tags reference the correct URL.
const RawPath =
	Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");

const CanonicalPath = PascalCaseCanonical[RawPath] ?? RawPath;

const DefaultURL = `https://editor.land${CanonicalPath === "/" ? "" : CanonicalPath}`;

const {
	Title,
	Description,
	Language = "en",
	Direction = "ltr",
	Image = "/Favicon/og-image.png",
	Url = DefaultURL,
	Type = "website",
	NoIndex = false,
} = Astro.props;

interface Props {
	Title?: string;

	Description?: string;

	Language?: string;

	Direction?: string;

	Image?: string;

	Url?: string;

	Type?: "website" | "article";

	NoIndex?: boolean;
}

// Get i18n instance - works in both SSR and static with fallback
const T = GetI18n();
---

<!doctype html>
<html lang={Language} class="no-js" dir={Direction}>
	<head>
		<meta charset="utf-8" />

		<script>
			document.documentElement.classList.remove("no-js");

			document.documentElement.classList.add("js");
		</script>

		<!-- Dynamic Meta Tags -->
		<MetaTags
			title={Title || T("meta.title", { defaultValue: "Land" })}
			description={Description ||
				T("meta.description", { defaultValue: "Code Editor" })}
			image={Image}
			url={Url}
			type={Type}
			lang={Language}
			noIndex={NoIndex}
		/>
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="twitter:dnt" content="on" />

		<!-- Fonts: preconnect + async load via media=print swap to avoid render-blocking.
		     No <link rel="preload"> - preload + media=print causes a credentials-mode
		     mismatch warning (preload uses same-origin, stylesheet uses crossorigin=anonymous
		     via the CrossOrigin Vite plugin) and a "not used within a few seconds" warning.
		     The media=print technique already loads the CSS async without blocking render. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&display=swap"
			/>
		</noscript>

		<style is:global>
			@import "@Stylesheet/Global.css";
		</style>

		<!-- i18n client - must initialize before any React component hydrates -->
		<script>
			import "@/Library/I18n/Client.js";
		</script>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"name": "Code Editor Land",
				"operatingSystem": "Windows, macOS, Linux",
				"applicationCategory": "DeveloperApplication",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				},
				"url": "https://editor.land",
				"downloadUrl": "https://editor.land/Download",
				"license": "https://creativecommons.org/publicdomain/zero/1.0/"
			}
		</script>

		<slot name="Head" />

		<!-- Favicon -->
		<link
			rel="icon"
			type="image/png"
			href="/Favicon/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/Favicon/favicon.svg" />
		<link rel="shortcut icon" href="/Favicon/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/Favicon/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="Code Editor Land" />
		<link rel="manifest" href="/Favicon/site.webmanifest" />
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only fixed left-2 top-2 z-[100] -translate-y-full bg-[var(--Primary)] px-4 py-2 text-sm font-medium text-white transition-transform focus:not-sr-only focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
			Skip to main content
		</a>

		<Background />

		<AnalyticsProvider>
			{/* Client-side only component for pageview tracking */}
			<PageviewTracker />
			<main id="main-content" class="grow" tabindex="-1">
				<ErrorBoundary client:load>
					<slot />
				</ErrorBoundary>
			</main>
		</AnalyticsProvider>

		<div id="Footer" class="shrink">
			<Footer client:idle />
		</div>

		<script>
			import "@Script/Firebase";
		</script>

		<script>
			await import("@Function/Route/Policy.js");

			await import("@Function/Route/Register.js");
		</script>

		<script>
			const ReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (!ReducedMotion) {
				const Staccato = await import("@Function/Noise/Staccato.js");

				const Engine = await Staccato.default;

				Engine.Start();

				// Seed every Staccato element once, strictly after window.load.
				//
				// WHY window.load is required - not just requestIdleCallback:
				// React 18 concurrent mode breaks hydration into small chunks
				// and yields to the browser between each one. requestIdleCallback
				// fires precisely during those yield gaps, BEFORE hydration is
				// complete. If SeedSelector runs then, it writes --StaccatoSeed /
				// --StaccatoSeedPhase onto DOM elements that React's virtual DOM
				// doesn't know about → hydration attribute mismatch warnings.
				//
				// window.load fires only after all resources are loaded AND after
				// React's client:load hydration has flushed. Scheduling via
				// requestIdleCallback (or setTimeout as fallback) AFTER load
				// ensures we land in the first true idle slot post-hydration.
				const Seed = () => Engine.SeedSelector('[class*="Staccato"]');

				const SeedAfterLoad = () => {
					if (typeof requestIdleCallback !== "undefined") {
						requestIdleCallback(Seed);
					} else {
						setTimeout(Seed, 0);
					}
				};

				if (document.readyState === "complete") {
					SeedAfterLoad();
				} else {
					window.addEventListener("load", SeedAfterLoad, {
						once: true,
					});
				}
			}
		</script>

		<a
			class="absolute left-0 top-0 hidden"
			rel="me"
			href="https://x.com/CodeEditorLand"
			aria-hidden="true"
			tabindex="-1"></a>
	</body>
</html>
