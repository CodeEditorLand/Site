---
import "@Stylesheet/System.scss";

import Background from "../Background.astro";
import Footer from "../Component/Layout/Footer.astro";
import { AnalyticsProvider } from "../Component/Provider/AnalyticsProvider";
import { PageviewTracker } from "../Component/Provider/PageviewTracker";
import MetaTags from "../Component/Social/MetaTags";
import { PascalCaseCanonical } from "../Function/Route/Map";
import { GetI18n } from "../Library/I18n/Server";

const RawPath =
	Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const CanonicalPath = PascalCaseCanonical[RawPath] ?? RawPath;
const DefaultURL = Astro.url.href;
const OpenGraphSlug =
	CanonicalPath === "/" ? "" : CanonicalPath.replace(/^\//, "");
const DefaultOpenGraphImage = OpenGraphSlug
	? `/OpenGraph/${OpenGraphSlug}.svg`
	: "/OpenGraph.svg";

const {
	Title,
	Description,
	Language = "en",
	Direction = "ltr",
	Image = DefaultOpenGraphImage,
	Url = DefaultURL,
	Type = "website",
	NoIndex = false,
} = Astro.props;
interface Props {
	Title?: string;
	Description?: string;
	Language?: string;
	Direction?: string;
	Image?: string;
	Url?: string;
	Type?: "website" | "article";
	NoIndex?: boolean;
}
const T = GetI18n();
---

<!doctype html>
<html lang={Language} dir={Direction}>
	<head>
		<meta charset="utf-8" />
		<MetaTags
			title={Title || T("meta.title", { defaultValue: "Land" })}
			description={Description ||
				T("meta.description", { defaultValue: "Code Editor" })}
			image={Image}
			url={Url}
			type={Type}
			lang={Language}
			noIndex={NoIndex}
		/>
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
		<meta name="theme-color" content="#F2EDE3" />
		<!-- Fonts: preconnect to Google Fonts origins, then preload the CSS
		 stylesheet as a high-priority fetch. IBM Plex Mono for the Daylight Field Record design system. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			crossorigin="anonymous"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=optional"
		/>
		<link
			rel="stylesheet"
			crossorigin="anonymous"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=optional"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				crossorigin="anonymous"
				href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=optional"
			/>
		</noscript>
		<style is:inline>
			/* Mermaid diagrams render ink-on-white via the Base.css token
			   overrides (var(--CardForeground) / var(--Card)) - no invert
			   filter on the daylight canvas. */
		</style>
		<script>
			import "@/Library/I18n/Client.js";
		</script>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: "Code Editor Land",
				operatingSystem: "Windows, macOS, Linux",
				applicationCategory: "DeveloperApplication",
				offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
				url: Astro.site?.href ?? "",
				downloadUrl: `${Astro.site?.href ?? ""}Download`,
				license: "https://creativecommons.org/publicdomain/zero/1.0/",
			})}
		/>
		<slot name="Head" />
		<link
			rel="icon"
			type="image/png"
			href="/Favicon/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/Favicon/favicon.svg" />
		<link rel="shortcut icon" href="/Favicon/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/Favicon/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="Code Editor Land" />
		<link rel="manifest" href="/Favicon/site.webmanifest" />
		<script>
		import jellyUrl from "../../Vendor/JellyUI/dist/jelly.js?url";
		document.head.appendChild(
			Object.assign(document.createElement("script"), {
				type: "module",
				src: jellyUrl,
			}),
		);
	</script>
	</head>
	<body>
		<a
			href="#main-content"
			class="text-primary-fg sr-only fixed left-2 top-2 z-[100] -translate-y-full bg-primary px-4 py-2 font-medium transition-transform focus:not-sr-only focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Ring)]"
			>Skip to main content</a
		>
		<jelly-theme id="JellyTheme" mode="light">
			<Background />
			<AnalyticsProvider>
				<PageviewTracker />
				<!--
					The shell's band order is header -> main -> footer. A page that hands
					its header to this slot keeps <header> outside <main>, where it is a
					real banner landmark; a page that renders <Header> as the default
					slot's first child still works, because the header carries an
					explicit role="banner" and lands first in the document.
				-->
				<slot name="Header" />
				<main id="main-content" class="grow" tabindex="-1">
					<!--
						No React error boundary here, on purpose. It was
						`<ErrorBoundary client:load><slot /></ErrorBoundary>`
						and it cost two things it could not repay:

						1. It cannot catch anything. The page body reaches a
						   framework component as `<astro-slot>` innerHTML, never
						   as React nodes, so `getDerivedStateFromError` can
						   never fire for page content and the boundary's "Try
						   again" fallback is unreachable.
						2. It gated every island on the page. Astro's
						   `astro-island.hydrate()` returns early when
						   `parentElement.closest("astro-island[ssr]")` matches
						   and waits for that ancestor's `astro:hydrate` event -
						   and this boundary wrapped the whole of `<slot />`, so
						   every island below it waited for a React root that
						   provided no coverage. Measured on
						   `/Doc/deep-dive-mountain/`: removing it is what lets
						   the doc rail hydrate on its own directive.
					-->
					<slot />
				</main>
			</AnalyticsProvider>
			<div id="Footer" class="shrink"><Footer /></div>
		</jelly-theme>
		<script>
			import "@Script/Firebase";
			import "@/Function/Utility/CopyCommand";
		</script>
		<script>
			await import("@Function/Route/Policy.js");
			await import("@Function/Route/Register.js");
		</script>
		<a
			class="absolute left-0 top-0 hidden"
			rel="me"
			href="https://x.com/CodeEditorLand"
			aria-hidden="true"
			tabindex="-1"></a>
	</body>
</html>
