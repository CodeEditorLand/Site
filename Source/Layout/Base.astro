---
import "@Stylesheet/Base.css";

import Background from "../Background.astro";
import { ErrorBoundary } from "../Component/ErrorBoundary";
import { Footer } from "../Component/Layout/Footer";
import { AnalyticsProvider } from "../Component/Provider/AnalyticsProvider";
import { PageviewTracker } from "../Component/Provider/PageviewTracker";
import MetaTags from "../Component/Social/MetaTags";
import { PascalCaseCanonical } from "../Function/Route/Map";
import { GetI18n } from "../Library/I18n/Server";

// Resolve PascalCase canonical URL for SEO tags.
// Astro builds pages at lowercase paths (e.g., /downloads), but our canonical
// URLs are PascalCase (e.g., /Download). Look up the mapping so that
// <link rel="canonical">, og:url, and all meta tags reference the correct URL.
const RawPath =
	Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const CanonicalPath = PascalCaseCanonical[RawPath] ?? RawPath;
const DefaultURL = `https://editor.land${CanonicalPath === "/" ? "" : CanonicalPath}`;

const {
	Title,
	Description,
	Language = "en",
	Direction = "ltr",
	Image = "/Favicon/og-image.png",
	Url = DefaultURL,
	Type = "website",
	NoIndex = false,
} = Astro.props;

interface Props {
	Title?: string;
	Description?: string;
	Language?: string;
	Direction?: string;
	Image?: string;
	Url?: string;
	Type?: "website" | "article";
	NoIndex?: boolean;
}

// Get i18n instance - works in both SSR and static with fallback
const T = GetI18n();
---

<!doctype html>
<html lang={Language} class="no-js" dir={Direction}>
	<head>
		<script>
			document.documentElement.classList.remove("no-js");
			document.documentElement.classList.add("js");
		</script>

		<!-- Dynamic Meta Tags -->
		<MetaTags
			title={Title || T("meta.title", { defaultValue: "Land" })}
			description={Description ||
				T("meta.description", { defaultValue: "Code Editor" })}
			image={Image}
			url={Url}
			type={Type}
			lang={Language}
			noIndex={NoIndex}
		/>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="twitter:dnt" content="on" />

		<!-- Links -->
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
			crossorigin
		/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&display=swap"
		/>

		<style is:global>
			@import "@Stylesheet/Global.css";
		</style>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"name": "Code Editor Land",
				"operatingSystem": "Windows, macOS, Linux",
				"applicationCategory": "DeveloperApplication",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				},
				"url": "https://editor.land",
				"downloadUrl": "https://editor.land/Download",
				"license": "https://creativecommons.org/publicdomain/zero/1.0/"
			}
		</script>

		<slot name="Head" />

		<!-- Favicon -->
		<link
			rel="icon"
			type="image/png"
			href="/Favicon/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/Favicon/favicon.svg" />
		<link rel="shortcut icon" href="/Favicon/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/Favicon/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="Code Editor Land" />
		<link rel="manifest" href="/Favicon/site.webmanifest" />
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only fixed left-2 top-2 z-[100] -translate-y-full bg-[var(--Primary)] px-4 py-2 text-sm font-medium text-white transition-transform focus:not-sr-only focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
			Skip to main content
		</a>

		<Background />

		<AnalyticsProvider>
			{/* Client-side only component for pageview tracking */}
			<PageviewTracker />
			<main id="main-content" class="grow" tabindex="-1">
				<ErrorBoundary client:load>
					<slot />
				</ErrorBoundary>
			</main>
		</AnalyticsProvider>

		<div id="Footer" class="shrink">
			<Footer client:load />
		</div>

		<script>
			import "@Script/Firebase";
		</script>

		<script>
			await import("@Function/Route/Policy.js");
			await import("@Function/Route/Register.js");
		</script>

		<script>
			const ReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (!ReducedMotion) {
				const Staccato = await import("@Function/Noise/Staccato.js");
				const Engine = await Staccato.default;
				Engine.Start();

				// Seed every Staccato element once.
				// This sets --StaccatoSeed and --StaccatoSeedPhase per element
				// so each gets a unique static offset that is different on every
				// page load but structurally stable — the noise is "baked in"
				// at startup and not re-animated on each frame.
				Engine.SeedSelector('[class*="Staccato"]');
			}
		</script>

		<a
			class="absolute left-0 top-0 hidden"
			rel="me"
			href="https://x.com/CodeEditorLand"
			aria-hidden="true"
			tabindex="-1"></a>
	</body>
</html>
