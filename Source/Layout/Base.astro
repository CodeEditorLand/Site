---
import "@Stylesheet/Base.css";

import Background from "../Background.astro";
import { ErrorBoundary } from "../Components/ErrorBoundary";
import { Footer } from "../Components/Layout/Footer";
import { AnalyticsProvider } from "../Components/providers/AnalyticsProvider";
import { PageviewTracker } from "../Components/providers/PageviewTracker";
import MetaTags from "../Components/Social/MetaTags";
import { getI18n } from "../Lib/I18n/Server";

const canonicalPath =
	Astro.url.pathname === "/" ? "" : Astro.url.pathname.replace(/\/$/, "");
const defaultUrl = `https://editor.land${canonicalPath}`;

const {
	Title,
	Description,
	lang = "en",
	dir = "ltr",
	Image = "/Favicon/og-image.png",
	Url = defaultUrl,
	Type = "website",
	noIndex = false,
} = Astro.props;

interface Props {
	Title?: string;
	Description?: string;
	lang?: string;
	dir?: string;
	Image?: string;
	Url?: string;
	Type?: "website" | "article";
	noIndex?: boolean;
}

// Get i18n instance - works in both SSR and static with fallback
const t = getI18n();
---

<!doctype html>
<html lang={lang} class="no-js" dir={dir}>
	<head>
		<script>
			document.documentElement.classList.remove("no-js");
			document.documentElement.classList.add("js");
		</script>

		<!-- Dynamic Meta Tags -->
		<MetaTags
			title={Title || t("meta.title", { defaultValue: "Land" })}
			description={Description ||
				t("meta.description", { defaultValue: "Code Editor" })}
			image={Image}
			url={Url}
			type={Type}
			lang={lang}
			noIndex={noIndex}
		/>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="twitter:dnt" content="on" />

		<!-- Links -->
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
			crossorigin
		/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&display=swap"
		/>

		<style is:global>
			@import "@Stylesheet/Global.css";
		</style>

		<slot name="Head" />

		<!-- Favicon -->
		<link
			rel="icon"
			type="image/png"
			href="/Favicon/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/Favicon/favicon.svg" />
		<link rel="shortcut icon" href="/Favicon/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/Favicon/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="Code Editor Land" />
		<link rel="manifest" href="/Favicon/site.webmanifest" />
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only fixed left-2 top-2 z-[100] -translate-y-full bg-[var(--primary)] px-4 py-2 text-sm font-medium text-white transition-transform focus:not-sr-only focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-[var(--primary)]">
			Skip to main content
		</a>

		<Background />

		<AnalyticsProvider>
			{/* Client-side only component for pageview tracking */}
			<PageviewTracker />
			<main id="main-content" class="grow" tabindex="-1">
				<ErrorBoundary client:load>
					<slot />
				</ErrorBoundary>
			</main>
		</AnalyticsProvider>

		<div id="Footer" class="shrink">
			<Footer />
		</div>

		<script>
			import "@Script/Firebase";
		</script>

		<a
			class="absolute left-0 top-0 hidden"
			rel="me"
			href="https://x.com/CodeEditorLand"
			aria-hidden="true"
			tabindex="-1"></a>
	</body>
</html>
