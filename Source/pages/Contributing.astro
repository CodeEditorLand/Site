---
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";
import { LinkMentions } from "../Library/CodeMentions";
import ReadingDocument from "../Component/Reading/ReadingDocument.astro";
import {
	Index,
	Ledger,
	Process,
	ResolveSteps,
} from "../Library/Document/Contributing/Data.js";

const T = GetI18n();

/** The four steps of the contribution process, resolved through the page's `T`. */
const Steps = ResolveSteps(Process, (Key, Default) =>
	T(Key, { defaultValue: Default }),
);

const MetaTitle = T("meta.contributing.title", {
	defaultValue: "Contributing | Code Editor Land",
});

const MetaDescription = T("meta.contributing.description", {
	defaultValue:
		"An open source code editor built with Rust and Tauri.\nLearn how to contribute to Code Editor Land.",
});

/**
 * The card surfaces' Jelly custom properties.
 *
 * The white information box on the creme field, square, at the documented inset
 * - the same five values `Doc.astro` and the release manifest pass, so every
 * white box on the site is one surface. HEAD painted these boxes with `bg-card`
 * on a `StaccatoCard`; a card is a `jelly-card`, not a `<div>` plus utilities
 * (`DESIGN.md` §6.5), and `StaccatoCard`'s seed-scatter transform rotates and
 * offsets static content, which §2.9 forbids.
 */
const Card =
	"--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:var(--space-group)";
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load slot="Header" />

	<div class="container mx-auto max-w-4xl px-4 py-16">
		<!-- Breadcrumbs -->
		<nav aria-label="Breadcrumb" class="mb-8">
			<ol class="flex flex-wrap items-center space-x-2 text-muted-foreground">
				<li>
					<a href="/" class="transition-colors hover:text-foreground">
						{T("common.breadcrumb.home", {
							defaultValue: "Home",
						})}
					</a>
				</li>
				<li class="mx-2">/</li>
				<li>
					<span class="font-medium text-foreground">
						{T("common.contributing.pageTitle", {
							defaultValue: "Contributing",
						})}
					</span>
				</li>
			</ol>
		</nav>

				<ReadingDocument
			kicker="/CONTRIBUTING"
			heading={T("common.contributing.pageTitle", {
				defaultValue: "Contributing",
			})}
			standfirstHtml={LinkMentions(
				T("common.contributing.pageSubtitle", {
					defaultValue:
						"Land is open source and built in public.\n\nEvery contribution - code, docs, tests, or design - ships to real users.",
				}),
			)}
			rows={Ledger}
			index={Index}
			indexLabel="Parts"
			measure="full">
		<!-- Quick Links -->
		<section class="reading-document__part">
			<h2 class="sr-only reading-clause" id="quick-links">
				{T("common.contributing.quickLinks.heading", {
					defaultValue: "Quick Links",
				})}
			</h2>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				<a
					href="https://github.com/CodeEditorLand/Land/tree/Current/CONTRIBUTING.md"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer block bg-card p-6 transition-colors hover:bg-secondary focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]"
				>
					<h3 class="text-card-foreground mb-2 type-sub font-medium" id="contributing-guide">
						{T("common.contributing.guide.title", {
							defaultValue: "Contributing Guide",
						})}
						<span class="InlineSeparator">→</span>
					</h3>
					<p class="whitespace-pre-line text-card-foreground">
						{T("common.contributing.guide.description", {
							defaultValue:
								"Read CONTRIBUTING.md on GitHub for the full setup walkthrough: environment, branch conventions, and how to submit changes.",
						})}
					</p>
				</a>

				<a
					href="https://github.com/CodeEditorLand/Land/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer block bg-card p-6 transition-colors hover:bg-secondary focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]"
				>
					<h3 class="text-card-foreground mb-2 type-sub font-medium" id="good-first-issues">
						{T("common.contributing.goodFirstIssues.title", {
							defaultValue: "Good First Issues",
						})}
						<span class="InlineSeparator">→</span>
					</h3>
					<p class="whitespace-pre-line text-card-foreground">
						{T("common.contributing.goodFirstIssues.description", {
							defaultValue:
								'Browse issues labeled "good first issue" to find approachable tasks for new contributors.',
						})}
					</p>
				</a>
			</div>
		</section>

		<!-- How to Contribute -->
		<section class="reading-document__part">
			<h2 class="reading-clause" id="how-to-contribute">
				{T("common.contributing.howToContribute.heading", {
					defaultValue: "How to Contribute",
				})}
			</h2>
			<div class="contributing-steps">
				<ol class="contributing-steps__list">
					{
						Steps.map((Step) => (
							<li class="contributing-steps__step">
								<span class="contributing-steps__index">{Step.index}</span>
								<div class="contributing-steps__body">
									<h3 class="contributing-steps__title">{Step.title}</h3>
									<p
										class="contributing-steps__line"
										set:html={LinkMentions(Step.line)}
									/>
									{Step.command ? (
										<div class="contributing-steps__command">
											<pre class="contributing-steps__pre">{Step.command}</pre>
											<jelly-icon-button
												data-copy
												aria-label="Copy to clipboard"
												label="Copy to clipboard"
												title="Copy to clipboard"
												shape="square"
												size="small"
												style="--jelly-fill: var(--Mute); --jelly-label: var(--Foreground); --jelly-icon-button-radius: 0px; --jelly-ring: var(--Accent);"
											>
												<svg
													aria-hidden="true"
													viewBox="0 0 24 24"
													fill="none"
													height="24"
													stroke="currentColor"
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													width="24"
													style="color: var(--jelly-label)"
												>
													<rect
														height="14"
														rx="2"
														ry="2"
														width="14"
														x="8"
														y="8"
													/>
													<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
												</svg>
											</jelly-icon-button>
										</div>
									) : null}
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Elements Architecture -->
		<section class="reading-document__part">
			<h2 class="reading-clause" id="fifteen-elements-one-editor">
				{T("common.contributing.elements.heading", {
					defaultValue: "Fifteen Elements, One Editor",
				})}
			</h2>
			<p
				class="mb-6 whitespace-pre-line text-muted-foreground"
				set:html={LinkMentions(
					T("common.contributing.elements.description", {
						defaultValue:
							"Land is built from fifteen modular Elements, each a standalone Rust crate or TypeScript package. Each element can be developed, tested, and published independently without touching the others.",
					}),
				)}
			/>
			<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
				<a
					href="https://github.com/CodeEditorLand/Mountain"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">
						Mountain&#x2001;&#x26F0;&#xFE0F;
					</span>
					<span class="block text-card-foreground">
						Native backend
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Cocoon"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Cocoon&#x2001;&#x1F98B;</span>
					<span class="block text-card-foreground">
						Extension host
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Wind"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Wind&#x2001;&#x1F343;</span>
					<span class="block text-card-foreground">
						Workbench shell
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Sky"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Sky&#x2001;&#x1F30C;</span>
					<span class="block text-card-foreground">
						UI components
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Air"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Air&#x2001;&#x1FA81;</span>
					<span class="block text-card-foreground">
						Background daemon
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Echo"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Echo&#x2001;&#x1F4E3;</span>
					<span class="block text-card-foreground">
						Work-stealing scheduler
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Common"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">
						Common&#x2001;&#x1F468;&#x1F3FB;&#x200D;&#x1F3ED;
					</span>
					<span class="block text-card-foreground">
						Traits &amp; DTOs
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Vine"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Vine&#x2001;&#x1F33F;</span>
					<span class="block text-card-foreground">
						gRPC protocol
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Rest"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">
						Rest&#x2001;&#x26F1;&#xFE0F;
					</span>
					<span class="block text-card-foreground">
						TypeScript compiler
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Output"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Output&#x2001;&#x26AB;</span>
					<span class="block text-card-foreground">Build output</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Mist"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">
						Mist&#x2001;&#x1F32B;&#xFE0F;
					</span>
					<span class="block text-card-foreground">DNS resolver</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Grove"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Grove&#x2001;&#x1F333;</span>
					<span class="block text-card-foreground">WASM sandbox</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/SideCar"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">SideCar&#x2001;&#x1F683;</span>
					<span class="block text-card-foreground">
						Node.js binary distributor
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Worker"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">Worker&#x2001;&#x1F369;</span>
					<span class="block text-card-foreground">
						Web Worker pool
					</span>
				</a>
				<a
					href="https://github.com/CodeEditorLand/Maintain"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer bg-card p-3 text-center transition-colors hover:bg-secondary"
				>
					<span class="font-medium">
						Maintain&#x2001;&#x1F4AA;&#x1F3FB;
					</span>
					<span class="block text-card-foreground">
						Build orchestrator
					</span>
				</a>
			</div>
			<p
				class="mt-4 whitespace-pre-line text-muted-foreground"
				set:html={LinkMentions(
					T("common.contributing.elements.docs", {
						defaultValue:
							"Every Element has its own README with architecture details. Find them in Land/Element/",
					}),
				)}
			/>
		</section>

		<!-- Ways to Contribute -->
		<section class="reading-document__part">
			<h2 class="reading-clause" id="ways-to-contribute">
				{T("common.contributing.ways.heading", {
					defaultValue: "Ways to Contribute",
				})}
			</h2>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<jelly-card style={Card}>
					<h3 class="text-card-foreground mb-2 font-medium" id="code">
						{T("common.contributing.ways.code.title", {
							defaultValue: "Code",
						})}
						&#x2001;&#x1F4BB;
					</h3>
					<p
						class="whitespace-pre-line text-card-foreground"
						set:html={LinkMentions(
							T("common.contributing.ways.code.description", {
								defaultValue:
									"Fix bugs, implement features, or improve performance in Rust or TypeScript.",
							}),
						)}
					/>
				</jelly-card>
				<jelly-card style={Card}>
					<h3 class="text-card-foreground mb-2 font-medium" id="documentation">
						{T("common.contributing.ways.documentation.title", {
							defaultValue: "Documentation",
						})}
						&#x2001;&#x1F4D6;
					</h3>
					<p
						class="whitespace-pre-line text-card-foreground"
						set:html={LinkMentions(
							T(
								"common.contributing.ways.documentation.description",
								{
									defaultValue:
										"Improve guides, add examples, or translate existing content into other languages.",
								},
							),
						)}
					/>
				</jelly-card>
				<jelly-card style={Card}>
					<h3 class="text-card-foreground mb-2 font-medium" id="testing">
						{T("common.contributing.ways.testing.title", {
							defaultValue: "Testing",
						})}
						&#x2001;&#x1F9EA;
					</h3>
					<p
						class="whitespace-pre-line text-card-foreground"
						set:html={LinkMentions(
							T("common.contributing.ways.testing.description", {
								defaultValue:
									"Write tests, reproduce reported bugs, or help triage open issues.",
							}),
						)}
					/>
				</jelly-card>
				<jelly-card style={Card}>
					<h3 class="text-card-foreground mb-2 font-medium" id="design">
						{T("common.contributing.ways.design.title", {
							defaultValue: "Design",
						})}
						&#x2001;&#x1F3A8;
					</h3>
					<p
						class="whitespace-pre-line text-card-foreground"
						set:html={LinkMentions(
							T("common.contributing.ways.design.description", {
								defaultValue:
									"Contribute UI and UX improvements, icons, or visual design work for the editor or website.",
							}),
						)}
					/>
				</jelly-card>
			</div>
		</section>

		<!-- Funding -->
		<section class="reading-document__part">
			<h2 class="reading-clause" id="funding">
				{T("common.contributing.funding.heading", {
					defaultValue: "Funding",
				})}
			</h2>
			<jelly-card style={Card}>
				<div class="mb-4 flex flex-wrap gap-x-4 gap-y-1">
					<a
						href="https://nlnet.nl/project/Land/"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-card-foreground hover:underline"
					>
						NLnet Project Page
						<span class="InlineSeparator">&#x1F310;</span>
					</a>
					<a
						href="https://nlnet.nl/commonsfund"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-card-foreground hover:underline"
					>
						NGI0 Commons Fund
						<span class="InlineSeparator">&#x1F91D;</span>
					</a>
					<a
						href="https://nlnet.nl"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-card-foreground hover:underline"
					>
						NLnet<span class="InlineSeparator">&#x1F3E0;</span>
					</a>
				</div>
				<p
					class="mb-4 whitespace-pre-line text-card-foreground"
					set:html={LinkMentions(
						T("common.contributing.funding.nlnetIntro", {
							defaultValue:
								"Code Editor Land has been funded through the NGI0 Commons Fund, supported by NLnet.",
						}),
					)}
				/>
				<p
					class="whitespace-pre-line text-card-foreground"
					set:html={LinkMentions(
						T("common.contributing.funding.playformInfo", {
							defaultValue:
								"The project is operated by PlayForm, a company based in Sofia, Bulgaria.\n\nPlayForm acts as the open-source steward for Code Editor Land under the NGI0 Commons Fund grant.",
						}),
					)}
				/>
			</jelly-card>
		</section>

		<!-- Code of Conduct -->
		<section class="reading-document__part">
			<h2 class="reading-clause" id="code-of-conduct">
				{T("common.contributing.conduct.heading", {
					defaultValue: "Code of Conduct",
				})}
			</h2>
			<jelly-card style={Card}>
				<a
					href="https://github.com/CodeEditorLand/Land/tree/Current/CODE_OF_CONDUCT.md"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoButton font-medium text-card-foreground hover:underline"
				>
					Code of Conduct<span class="InlineSeparator">→</span>
				</a>
				<p
					class="mt-2 text-card-foreground"
					set:html={LinkMentions(
						T("common.contributing.conduct.description", {
							defaultValue:
								"All participants in the Land community are expected to be respectful and constructive.\n\nRead the full Code of Conduct on GitHub.",
						}),
					)}
				/>
			</jelly-card>
		</section>
		</ReadingDocument>

		<!-- Back to top -->
		<div class="mt-12 border-t pt-8">
			<a href="#top" class="StaccatoButton text-primary hover:underline">
				{T("common.button.backToTop", {
					defaultValue: "Back to top",
				})}
				<span class="InlineSeparator">↑</span>
			</a>
		</div>
	</div>
</Base>

<script>
	import { WireCopyButtons } from "../Function/Utility/CopyCommand";
	WireCopyButtons();
</script>
