---
import { getCollection, render } from "astro:content";

import DocArticle from "../../Component/Doc/DocArticle.astro";
import DocLayout from "../../Component/Doc/DocLayout.astro";
import MermaidFallback from "../../Component/Dynamic/MermaidFallback.astro";
import { Header } from "../../Component/Layout/Header";
import BuildDocSidebar from "../../Function/Doc/BuildDocSidebar";
import BuildDocStrip from "../../Function/Doc/BuildDocStrip";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

/**
 * One documentation page: the reading shell, the markdown on a white card, then
 * the pager.
 *
 * `DesignSystem-Pages.md` §5 is the shape: **doc pages read on white cards**.
 * The shell (`DocArticle`) renders the page's single `h1`, the section as its
 * kicker, the frontmatter `description` as the standfirst, the metadata strip,
 * and then the body - which sits on one `jelly-card` surface, the same card the
 * prose carried at HEAD (`bg-card p-6`), now as the design system's own surface
 * rather than a utility class. The five custom properties are the ones that
 * card set: `--Card` fill, radius 0, inherited type, and no padding of its own -
 * the inset belongs to `.doc-prose` in `System/Component/Doc/_Article.scss`,
 * which is also where the 72ch measure lives, so the card's edge and the
 * prose's edge are one decision.
 *
 * **The strip is this page's to build, and the shell's to place.** Only the page
 * knows its section and its source, so `BuildDocStrip` runs here with the three
 * facts a markdown file can prove about itself - `LAYER:` from `section`,
 * `SOURCE:` from the file's own path, and the two extras the schema carries,
 * `ORDER:` and `GROUP:`. `COMPAT:` and `UPDATED:` have no field in the `doc`
 * collection, so the builder prints `UNAVAILABLE` for them in the quiet ink
 * rather than inventing a value.
 *
 * **The body's own `# ` line is demoted at the pipeline**, not here:
 * `Function/Markdown/Heading.ts` turns the document's opening `h1` into the
 * prose's first `h2`, so the shell's title stays the page's only level-one
 * heading - 39 of the 81 documents under `Source/Content/doc` open that way.
 *
 * The pager's two links sit on a `jelly-card` each, as at HEAD; the card is the
 * pager's flex item and the anchor fills it (`_Article.scss`).
 */
export async function getStaticPaths() {
	const Entries = await getCollection("doc");
	return Entries.map((Entry) => ({
		params: { Slug: Entry.id },
		props: { Entry },
	}));
}

const { Entry } = Astro.props;
const { Content } = await render(Entry);

const AllEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

// Group entries by section (and optionally by mid-level group) for the sidebar
const SidebarSections = BuildDocSidebar(AllEntries);

// Sorted list for prev/next navigation (within same section for better UX)
const SectionEntries = AllEntries.filter(
	(E) => E.data.section === Entry.data.section,
);
const SectionIndex = SectionEntries.findIndex((E) => E.id === Entry.id);
const PrevEntry =
	SectionIndex > 0
		? SectionEntries[SectionIndex - 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) - 1] ??
			null);
const NextEntry =
	SectionIndex < SectionEntries.length - 1
		? SectionEntries[SectionIndex + 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) + 1] ??
			null);

const T = GetI18n();

/**
 * The page's metadata strip: the five documented fields, then the two facts the
 * `doc` collection's schema carries beyond them. `LAYER` is the section as the
 * sidebar names it, `SOURCE` is the file the prose comes from, and `ORDER` is
 * the page's position in its section - the number the sidebar already sorts by,
 * printed so a reader can see it.
 */
const PageStrip = BuildDocStrip(
	{
		Layer: Entry.data.section,
		Source: `Source/Content/doc/${Entry.id}.md`,
		Extras: [
			{
				Label: T("strip.order", { ns: "doc", defaultValue: "ORDER:" }),
				Value: String(Entry.data.order),
			},
			...(Entry.data.group
				? [
						{
							Label: T("strip.group", { ns: "doc", defaultValue: "GROUP:" }),
							Value: Entry.data.group,
						},
					]
				: []),
		],
	},
	T,
);

const MetaTitle = `${Entry.data.title} | Code Editor Land`;
const MetaDescription = Entry.data.description;

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const Documentation = T("sidebar.title", {
	ns: "doc",
	defaultValue: "Documentation",
});
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:idle={{ timeout: 2000 }} Mode="functional" slot="Header" />

	<DocLayout sections={SidebarSections} activeId={Entry.id}>
		<DocArticle
			kicker={Entry.data.section}
			title={Entry.data.title}
			standfirst={Entry.data.description}
			strip={PageStrip}
			crumbs={[
				{ label: Home, href: "/" },
				{ label: Documentation, href: "/Doc" },
				{ label: Entry.data.title },
			]}
			measure={false}
		>
			<jelly-card
				class="doc-prose"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
			>
				<div class="doc-article__body doc-prose__body">
					<Content />
				</div>
			</jelly-card>
		</DocArticle>

		<MermaidFallback />

		{
			(PrevEntry || NextEntry) && (
				<nav class="doc-pager" aria-label="Page navigation">
					{PrevEntry ? (
						<jelly-card
							class="doc-pager__card"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
						>
							<a
								class="doc-pager__link doc-pager__link--prev"
								href={`/Doc/${PrevEntry.id}`}
							>
								<span class="doc-pager__label">
									<span aria-hidden="true">←</span> Previous
								</span>
								<span class="doc-pager__title">
									{PrevEntry.data.title}
								</span>
							</a>
						</jelly-card>
					) : null}
					{NextEntry ? (
						<jelly-card
							class="doc-pager__card doc-pager__card--next"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
						>
							<a
								class="doc-pager__link doc-pager__link--next"
								href={`/Doc/${NextEntry.id}`}
							>
								<span class="doc-pager__label">
									Next <span aria-hidden="true">→</span>
								</span>
								<span class="doc-pager__title">
									{NextEntry.data.title}
								</span>
							</a>
						</jelly-card>
					) : null}
				</nav>
			)
		}
	</DocLayout>
</Base>
