---
import { getCollection, render } from "astro:content";

import DocArticle from "../../Component/Doc/DocArticle.astro";
import DocLayout from "../../Component/Doc/DocLayout.astro";
import MermaidFallback from "../../Component/Dynamic/MermaidFallback.astro";
import { Header } from "../../Component/Layout/Header";
import BuildDocSidebar from "../../Function/Doc/BuildDocSidebar";
import BuildDocStrip from "../../Function/Doc/BuildDocStrip";
import BuildDocToc from "../../Function/Doc/BuildDocToc";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

/**
 * One documentation page: the reading shell, then the markdown on a white card.
 *
 * `DesignSystem-Pages.md` §5 is the shape: **doc pages read on white cards**.
 * The shell (`DocArticle`) renders the page's single `h1`, the section as its
 * kicker, the frontmatter `description` as the standfirst, an in-page contents
 * list built from this page's own `##` headings, and then the body - which sits
 * on one `jelly-card` surface, the same card the prose carried at HEAD
 * (`bg-card p-6`), now as the design system's own surface rather than a utility
 * class. The five custom properties are the ones that card set: `--Card` fill,
 * radius 0, inherited type, and no padding of its own - the inset belongs to
 * `.doc-prose` in `System/Component/Doc/_Article.scss`, which is also where the
 * 72ch measure lives, so the card's edge and the prose's edge are one decision.
 *
 * **The metadata strip** (§5: "compact index + `STATUS`/`LAYER`/`SOURCE`/
 * `COMPAT`/`UPDATED` mono metadata strip above prose") is placed by the shell,
 * above the card and above the prose. It is built by `BuildDocStrip` from the
 * collection's own fields - the section is the layer, the entry id is the
 * source file, `order` is the position - so every value printed is a fact the
 * build can read. `COMPAT` and `UPDATED` have no field in the `doc` schema
 * (`Source/content.config.ts` declares title, section, order, description,
 * navTitle, group), so they render the grammar's documented empty state,
 * `UNAVAILABLE` (`DesignSystem-Grammar.md` §2), rather than being dropped from
 * a strip the design system fixes at five fields.
 *
 * The contents list is generated, never hand-written: `BuildDocToc` reads the
 * headings `render()` actually emitted, so an anchor can never disagree with its
 * heading. Pages that carry their own `## Table of Contents` get none from here -
 * two contents lists above one document is worse than one.
 *
 * The pager's two links sit on a `jelly-card` each, as at HEAD; the card is the
 * pager's flex item and the anchor fills it (`_Article.scss`).
 */
export async function getStaticPaths() {
	const Entries = await getCollection("doc");
	return Entries.map((Entry) => ({
		params: { Slug: Entry.id },
		props: { Entry },
	}));
}

const { Entry } = Astro.props;
const { Content, headings } = await render(Entry);

const AllEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

// Group entries by section (and optionally by mid-level group) for the sidebar
const SidebarSections = BuildDocSidebar(AllEntries);

// Sorted list for prev/next navigation (within same section for better UX)
const SectionEntries = AllEntries.filter(
	(E) => E.data.section === Entry.data.section,
);
const SectionIndex = SectionEntries.findIndex((E) => E.id === Entry.id);
const PrevEntry =
	SectionIndex > 0
		? SectionEntries[SectionIndex - 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) - 1] ??
			null);
const NextEntry =
	SectionIndex < SectionEntries.length - 1
		? SectionEntries[SectionIndex + 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) + 1] ??
			null);

const T = GetI18n();

const MetaTitle = `${Entry.data.title} | Code Editor Land`;
const MetaDescription = Entry.data.description;

const Toc = BuildDocToc(
	headings,
	T("article.toc", { ns: "doc", defaultValue: "On this page" }),
);

/**
 * The page's own provenance, in the mono record grammar: `BuildDocStrip` writes
 * the five fields §5 fixes - published state, the section as the layer, the
 * markdown file that renders here, and `COMPAT`/`UPDATED` at their documented
 * empty state - and the page appends its `order`, the same number the index
 * sorts on, so a reader can place this page in the tree without the rail.
 * `GROUP` prints only when the page declares one. U+2001 EM QUAD separates the
 * items.
 */
const PageStrip = BuildDocStrip(
	{
		Layer: Entry.data.section,
		Source: `${Entry.id}.md`,
		Extras: [
			{
				Label: T("strip.order", { ns: "doc", defaultValue: "ORDER:" }),
				Value: String(Entry.data.order),
			},
			...(Entry.data.group
				? [
						{
							Label: T("strip.group", {
								ns: "doc",
								defaultValue: "GROUP:",
							}),
							Value: Entry.data.group,
						},
					]
				: []),
		],
	},
	T,
);

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const Documentation = T("sidebar.title", {
	ns: "doc",
	defaultValue: "Documentation",
});
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load Mode="functional" slot="Header" />

	<DocLayout sections={SidebarSections} activeId={Entry.id}>
		<DocArticle
			kicker={`/${Entry.data.section.toUpperCase()}`}
			title={Entry.data.title}
			standfirst={Entry.data.description}
			strip={PageStrip}
			toc={Toc}
			crumbs={[
				{ label: Home, href: "/" },
				{ label: Documentation, href: "/Doc" },
				{ label: Entry.data.title },
			]}
			measure={false}
		>
			<jelly-card
				class="doc-prose"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
			>
				<div class="doc-article__body doc-prose__body">
					<Content />
				</div>
			</jelly-card>
		</DocArticle>

		<MermaidFallback />

		{
			(PrevEntry || NextEntry) && (
				<nav class="doc-pager" aria-label="Page navigation">
					{PrevEntry ? (
						<jelly-card
							class="doc-pager__card"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
						>
							<a
								class="doc-pager__link doc-pager__link--prev"
								href={`/Doc/${PrevEntry.id}`}
							>
								<span class="doc-pager__label">
									<span aria-hidden="true">←</span> Previous
								</span>
								<span class="doc-pager__title">
									{PrevEntry.data.title}
								</span>
							</a>
						</jelly-card>
					) : null}
					{NextEntry ? (
						<jelly-card
							class="doc-pager__card doc-pager__card--next"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
						>
							<a
								class="doc-pager__link doc-pager__link--next"
								href={`/Doc/${NextEntry.id}`}
							>
								<span class="doc-pager__label">
									Next <span aria-hidden="true">→</span>
								</span>
								<span class="doc-pager__title">
									{NextEntry.data.title}
								</span>
							</a>
						</jelly-card>
					) : null}
				</nav>
			)
		}
	</DocLayout>
</Base>
