---
import { getCollection, render } from "astro:content";

import DocArticle from "../../Component/Doc/DocArticle.astro";
import DocLayer from "../../Component/Doc/DocLayer.astro";
import DocLayout from "../../Component/Doc/DocLayout.astro";
import MermaidFallback from "../../Component/Dynamic/MermaidFallback.astro";
import { Header } from "../../Component/Layout/Header";
import RecordInset from "../../Component/Record/RecordInset.astro";
import RecordMargin from "../../Component/Record/RecordMargin.astro";
import RecordTranscript from "../../Component/Record/RecordTranscript.astro";
import { PageInset } from "../../Content/Artifact/Inset.js";
import { ElementPlateForSlug } from "../../Content/Artifact/Plate.js";
import { SetupSession } from "../../Content/Artifact/Session.js";
import BuildDocSidebar from "../../Function/Doc/BuildDocSidebar";
import BuildDocStrip from "../../Function/Doc/BuildDocStrip";
import BuildDocToc from "../../Function/Doc/BuildDocToc";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

/**
 * One documentation page: the reading shell, the markdown on a white card, then
 * the pager.
 *
 * `DesignSystem-Pages.md` §5 is the shape: **doc pages read on white cards**.
 * The shell (`DocArticle`) renders the page's single `h1`, the section as its
 * kicker, the frontmatter `description` as the standfirst, the metadata strip,
 * and then the body - which sits on one `jelly-card` surface, the same card the
 * prose carried at HEAD (`bg-card p-6`), now as the design system's own surface
 * rather than a utility class. The five custom properties are the ones that
 * card set: `--Card` fill, radius 0, inherited type, and no padding of its own -
 * the inset belongs to `.doc-prose` in `System/Component/Doc/_Article.scss`,
 * which is also where the 72ch measure lives, so the card's edge and the
 * prose's edge are one decision.
 *
 * **This card never animates, and that is the library's own rule, not a bug
 * here.** A `jelly-card` starts its physics on `pointerenter`, and
 * `startHoverLoop` refuses a host taller than the viewport outright
 * (`offsetHeight > window.innerHeight`, `Vendor/JellyUI/src/element/index.ts:1238`,
 * present in the shipped `dist/jelly.js`). Every article in the manual is taller
 * than a laptop viewport - the shortest, `why-cc0`, is 4,066 bytes - so on all
 * 78 pages the element has no hover loop to run, and what it costs is a backing
 * store: `applyShape` sizes the canvas to the host's whole box, past which
 * `MAX_CANVAS_EDGE` (8192 device px) and `MAX_CANVAS_AREA` (16,777,216) flatten
 * it to a CSS surface with no bitmap and no body. At 2x DPR that cap is a
 * 4,000px host, so every article long enough to be felt as a slow scroll has no
 * canvas at all; the ones that keep one are short enough that its size is
 * bounded. `t_5e83b25f` owns that balance inside Jelly and `t_b31aa15b` measured
 * it: this is a texture, not a frame.
 *
 * **The strip is this page's to build, and the shell's to place.** Only the page
 * knows its section and its source, so `BuildDocStrip` runs here with the three
 * facts a markdown file can prove about itself - `LAYER:` from `section`,
 * `SOURCE:` from the file's own path, and the two extras the schema carries,
 * `ORDER:` and `GROUP:`. `COMPAT:` and `UPDATED:` have no field in the `doc`
 * collection, so the builder prints `UNAVAILABLE` for them in the quiet ink
 * rather than inventing a value.
 *
 * **The body's own `# ` line is demoted at the pipeline**, not here:
 * `Function/Markdown/Heading.ts` turns the document's opening `h1` into the
 * prose's first `h2`, so the shell's title stays the page's only level-one
 * heading - 39 of the 81 documents under `Source/Content/doc` open that way.
 *
 * The pager's two links sit on a `jelly-card` each, as at HEAD; the card is the
 * pager's flex item and the anchor fills it (`_Article.scss`).
 */
export async function getStaticPaths() {
	const Entries = await getCollection("doc");
	return Entries.map((Entry) => ({
		params: { Slug: Entry.id },
		props: { Entry },
	}));
}

const { Entry } = Astro.props;
const { Content, headings } = await render(Entry);

const AllEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

// Group entries by section (and optionally by mid-level group) for the sidebar
const SidebarSections = BuildDocSidebar(AllEntries);

// Sorted list for prev/next navigation (within same section for better UX)
const SectionEntries = AllEntries.filter(
	(E) => E.data.section === Entry.data.section,
);
const SectionIndex = SectionEntries.findIndex((E) => E.id === Entry.id);
const PrevEntry =
	SectionIndex > 0
		? SectionEntries[SectionIndex - 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) - 1] ??
			null);
const NextEntry =
	SectionIndex < SectionEntries.length - 1
		? SectionEntries[SectionIndex + 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) + 1] ??
			null);

const T = GetI18n();

/**
 * The page's metadata strip: the five documented fields, then the two facts the
 * `doc` collection's schema carries beyond them. `LAYER` is the section as the
 * sidebar names it, `SOURCE` is the file the prose comes from, and `ORDER` is
 * the page's position in its section - the number the sidebar already sorts by,
 * printed so a reader can see it.
 */
const PageSource = `Source/Content/doc/${Entry.id}.md`;

const PageStrip = BuildDocStrip(
	{
		Layer: Entry.data.section,
		Source: PageSource,
		Extras: [
			{
				Label: T("strip.order", { ns: "doc", defaultValue: "ORDER:" }),
				Value: String(Entry.data.order),
			},
			...(Entry.data.group
				? [
						{
							Label: T("strip.group", {
								ns: "doc",
								defaultValue: "GROUP:",
							}),
							Value: Entry.data.group,
						},
					]
				: []),
		],
	},
	T,
);

/**
 * The page's own contents: the `##` sections of this document, as the rail's
 * pinned head and the narrow-viewport disclosure.
 *
 * Two facts the page knows and the builder cannot: a document that opens with
 * its own `# ` line has that line demoted to the first `##` at the pipeline
 * (`Function/Markdown/Heading.ts`), and that heading is the page's title - which
 * the shell already prints as the `h1`. Listing it as section `01` would name the
 * page twice, so it is dropped here, before the builder sees the list. Everything
 * else is `BuildDocToc`'s: its id is the pipeline's id, its label the heading's
 * own words, and its rules (no list under two sections, none on a page that
 * carries its own table of contents) are the ones this page wants.
 */
const OpensWithTitle = /^\s*#\s/.test(Entry.body ?? "");

const Contents = BuildDocToc(
	OpensWithTitle ? headings.slice(1) : headings,
	T("article.toc", { ns: "doc", defaultValue: "On this page" }),
);

/**
 * The layer this page sits in: every page of the same section, in the order the
 * collection puts them. The rail prints the short `navTitle` for a destination
 * (`Sky`, `Overview`), and this list is a list of destinations, so it does too -
 * the index prints the full `title` because a card is a thing to choose between.
 */
const Layer = SectionEntries.map((Page) => ({
	Id: Page.id,
	Label: Page.data.navTitle ?? Page.data.title,
	Href: `/Doc/${Page.id}`,
}));

const MetaTitle = `${Entry.data.title} | Code Editor Land`;
const MetaDescription = Entry.data.description;

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const Documentation = T("sidebar.title", {
	ns: "doc",
	defaultValue: "Documentation",
});

/**
 * The page's apparatus, for the margin channel.
 *
 * Three facts about the *page* rather than its subject, which the article had
 * nowhere to print: which section filed it and at what order, which group it
 * nests under (when it has one), and where a correction goes. Every value is the
 * frontmatter's - the margin derives nothing and invents nothing - and each note
 * carries its own source, because the margin is where an unsourced claim does
 * the most damage.
 */
const Notes = [
	{
		index: "NOTE_01",
		label: "FILED",
		body: `This page is filed under ${Entry.data.section}, at position ${Entry.data.order} in that section.`,
		source: `SOURCE: SOURCE/CONTENT/DOC/${Entry.id.toUpperCase()}.MD`,
	},
	...(Entry.data.group
		? [
				{
					index: "NOTE_02",
					label: "GROUP",
					body: `It nests under ${Entry.data.group}, with every page that shares the group.`,
					source: "SOURCE: FRONTMATTER `GROUP`",
				},
			]
		: []),
	{
		index: Entry.data.group ? "NOTE_03" : "NOTE_02",
		label: "CORRECTIONS",
		body: "The prose is a markdown file in the repository. A correction is a pull request against it, not a comment on the page.",
		source: "SOURCE: THE REPOSITORY",
		link: {
			label: "OPEN THE SOURCE TREE",
			href: "https://github.com/CodeEditorLand/WebSite",
		},
	},
];

/**
 * The page's plate: the element's evidence, when the page is about one of the
 * fifteen element records. Fifteen of the manual's documents are; the rest get
 * no plate at all, because a page about a build flag has no capture to show and a
 * default plate would be a picture of nothing.
 */
const PagePlate = ElementPlateForSlug(Entry.id);

/**
 * The page's own extent, as the margin's measure figure: sections, words and
 * minutes, plus the one fact the metadata strip prints without a denominator -
 * this page's position in its section.
 */
const PageExtent = PageInset({
	body: Entry.body ?? "",
	sections: Contents?.Items.length ?? 0,
	order: Entry.data.order,
	inSection: SectionEntries.length,
	section: Entry.data.section,
	file: `SOURCE/CONTENT/DOC/${Entry.id.toUpperCase()}.MD`,
});
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:idle={{ timeout: 2000 }} Mode="functional" slot="Header" />

	<DocLayout
		sections={SidebarSections}
		activeId={Entry.id}
		contents={Contents}
	>
		<DocArticle
			kicker={`/${Entry.data.section}`}
			title={Entry.data.title}
			standfirst={Entry.data.description}
			strip={PageStrip}
			contents={Contents}
			crumbs={[
				{ label: Home, href: "/" },
				{ label: Documentation, href: "/Doc" },
				{ label: Entry.data.title },
			]}
			measure={false}
			plate={PagePlate}
			source={PageSource}
		>
			<jelly-card
				class="doc-prose"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
			>
				<div class="doc-article__body doc-prose__body">
					<Content />
				</div>
			</jelly-card>

			{
				/* The manual's own session, printed on the one page whose subject is
				   the toolchain. It is the manual's words, marked as the manual's - not
				   captured output dressed as a recording. */
				Entry.id === "getting-started" ? (
					<div class="doc-article__session">
						<RecordTranscript transcript={SetupSession} />
					</div>
				) : null
			}
		</DocArticle>

		<MermaidFallback />

		{
			/* The margin channel: the page's figure first, then its apparatus. An
			   inset leads because it is the only thing in the margin with evidence
			   in it; the notes under it are claims about the page. */
			<div slot="margin">
				<RecordInset inset={PageExtent} />
			</div>
		}

		{
			/* The margin channel: the page's apparatus, beside the measure. */
			Notes.map((Note) => (
				<div slot="margin">
					<RecordMargin note={Note} />
				</div>
			))
		}

		<DocLayer
			label={T("strip.layer", { ns: "doc", defaultValue: "LAYER:" })}
			heading={Entry.data.section}
			unit={T("archive.pages", { ns: "doc", defaultValue: "PAGES" })}
			entries={Layer}
			activeId={Entry.id}
		/>

		{(PrevEntry || NextEntry) && (
			<nav class="doc-pager" aria-label="Page navigation">
				{PrevEntry ? (
					<jelly-card
						class="doc-pager__card"
						style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
					>
						<a
							class="doc-pager__link doc-pager__link--prev"
							href={`/Doc/${PrevEntry.id}`}
						>
							<span class="doc-pager__label">
								<span aria-hidden="true">←</span>{"\u2001"}Previous
							</span>
							<span class="doc-pager__title">
								{PrevEntry.data.title}
							</span>
						</a>
					</jelly-card>
				) : null}
				{NextEntry ? (
					<jelly-card
						class="doc-pager__card doc-pager__card--next"
						style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
					>
						<a
							class="doc-pager__link doc-pager__link--next"
							href={`/Doc/${NextEntry.id}`}
						>
							<span class="doc-pager__label">
								Next{"\u2001"}<span aria-hidden="true">→</span>
							</span>
							<span class="doc-pager__title">
								{NextEntry.data.title}
							</span>
						</a>
					</jelly-card>
				) : null}
			</nav>
		)}
	</DocLayout>
</Base>
