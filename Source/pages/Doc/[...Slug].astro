---
import { getCollection, render } from "astro:content";

import DocArticle from "../../Component/Doc/DocArticle.astro";
import DocLayout from "../../Component/Doc/DocLayout.astro";
import MermaidFallback from "../../Component/Dynamic/MermaidFallback.astro";
import { Header } from "../../Component/Layout/Header";
import BuildDocSidebar from "../../Function/Doc/BuildDocSidebar";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

/**
 * One documentation page: the reading shell, then the markdown on a white card,
 * then the pager.
 *
 * `DesignSystem-Pages.md` §5 is the shape: **doc pages read on white cards**.
 * The shell (`DocArticle`) renders the page's single `h1`, the section as its
 * kicker, the frontmatter `description` as the standfirst, and then the body -
 * which sits on one `jelly-card` surface, the same card the prose carried at
 * HEAD (`bg-card p-6`), now as the design system's own surface rather than a
 * utility class. The five custom properties are the ones that card set:
 * `--Card` fill, radius 0, inherited type, and no padding of its own - the inset
 * belongs to `.doc-prose` in `System/Component/Doc/_Article.scss`, which is also
 * where the 72ch measure lives, so the card's edge and the prose's edge are one
 * decision.
 *
 * **What this page does not render, because the baseline did not:** a metadata
 * strip above the prose, and a contents list of its own. The baseline's only
 * contents list was the document's own `## Table of Contents`, which the prose
 * renders in place; a strip of `STATUS` / `LAYER` / `SOURCE` / `COMPAT` /
 * `UPDATED` never appeared on a documentation article at all. Both were added
 * by an earlier pass and both are gone, so the page's element sequence is the
 * reference's: breadcrumb, kicker, `h1`, standfirst, prose, pager.
 *
 * The pager's two links sit on a `jelly-card` each, as at HEAD; the card is the
 * pager's flex item and the anchor fills it (`_Article.scss`).
 */
export async function getStaticPaths() {
	const Entries = await getCollection("doc");
	return Entries.map((Entry) => ({
		params: { Slug: Entry.id },
		props: { Entry },
	}));
}

const { Entry } = Astro.props;
const { Content } = await render(Entry);

const AllEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

// Group entries by section (and optionally by mid-level group) for the sidebar
const SidebarSections = BuildDocSidebar(AllEntries);

// Sorted list for prev/next navigation (within same section for better UX)
const SectionEntries = AllEntries.filter(
	(E) => E.data.section === Entry.data.section,
);
const SectionIndex = SectionEntries.findIndex((E) => E.id === Entry.id);
const PrevEntry =
	SectionIndex > 0
		? SectionEntries[SectionIndex - 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) - 1] ??
			null);
const NextEntry =
	SectionIndex < SectionEntries.length - 1
		? SectionEntries[SectionIndex + 1]
		: (AllEntries[AllEntries.findIndex((E) => E.id === Entry.id) + 1] ??
			null);

const T = GetI18n();

const MetaTitle = `${Entry.data.title} | Code Editor Land`;
const MetaDescription = Entry.data.description;

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const Documentation = T("sidebar.title", {
	ns: "doc",
	defaultValue: "Documentation",
});
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load Mode="functional" slot="Header" />

	<DocLayout sections={SidebarSections} activeId={Entry.id}>
		<DocArticle
			kicker={Entry.data.section}
			title={Entry.data.title}
			standfirst={Entry.data.description}
			crumbs={[
				{ label: Home, href: "/" },
				{ label: Documentation, href: "/Doc" },
				{ label: Entry.data.title },
			]}
			measure={false}
		>
			<jelly-card
				class="doc-prose"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
			>
				<div class="doc-article__body doc-prose__body">
					<Content />
				</div>
			</jelly-card>
		</DocArticle>

		<MermaidFallback />

		{
			(PrevEntry || NextEntry) && (
				<nav class="doc-pager" aria-label="Page navigation">
					{PrevEntry ? (
						<jelly-card
							class="doc-pager__card"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
						>
							<a
								class="doc-pager__link doc-pager__link--prev"
								href={`/Doc/${PrevEntry.id}`}
							>
								<span class="doc-pager__label">
									<span aria-hidden="true">←</span> Previous
								</span>
								<span class="doc-pager__title">
									{PrevEntry.data.title}
								</span>
							</a>
						</jelly-card>
					) : null}
					{NextEntry ? (
						<jelly-card
							class="doc-pager__card doc-pager__card--next"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:0;--jelly-card-padding-inline:0"
						>
							<a
								class="doc-pager__link doc-pager__link--next"
								href={`/Doc/${NextEntry.id}`}
							>
								<span class="doc-pager__label">
									Next <span aria-hidden="true">→</span>
								</span>
								<span class="doc-pager__title">
									{NextEntry.data.title}
								</span>
							</a>
						</jelly-card>
					) : null}
				</nav>
			)
		}
	</DocLayout>
</Base>
