---
import DocArticle from "../../Component/Doc/DocArticle.astro";
import DocIndex from "../../Component/Doc/DocIndex.astro";
import {
	RustBand,
	RustCrates,
	RustViewerBand,
} from "../../Component/Doc/Rust/Data";
import RustViewer from "../../Component/Doc/RustViewer.astro";
import { Header } from "../../Component/Layout/Header";
import RecordBand from "../../Component/Record/RecordBand.astro";
import Base from "../../Layout/Base.astro";
import { LinkMentions } from "../../Library/CodeMentions";
import { GetI18n } from "../../Library/I18n/Server";

/**
 * The Rust API surface: the crate list, then the frame that reads one.
 *
 * The same shell as every other documentation page (`DocArticle`), so the Rust
 * documentation reads like the rest: a kicker, one `h1`, the standfirst, then
 * the body. What it does not have is the rail - this page is a viewer, and its
 * position is carried by the breadcrumb and the back link.
 *
 * The crate list is `RustBand` (a `DocBand`, rendered by the same `DocIndex` the
 * index page uses) and the frame is `RustViewer`. Every rustdoc URL, label and
 * description is in `Component/Doc/Rust/Data.ts`, and every one of them is the
 * string this page printed before it was a composition.
 */
const T = GetI18n();

const MetaTitle = T("meta.docs.rust.title", {
	defaultValue: "Rust API Documentation | Code Editor Land",
});

const MetaDescription = T("meta.docs.rust.description", {
	defaultValue:
		"Browse the generated Rust API documentation for Land's core crates.",
});

const Heading = T("rust.heading", {
	ns: "doc",
	defaultValue: "Rust API Documentation",
});

const Standfirst =
	"Generated <code>rustdoc</code> output for Land's Rust crates. Select a crate below, or open directly in a new tab.";

const ViewerBand = RustViewerBand(T);

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const Documentation = T("common.docs.pageTitle", {
	defaultValue: "Documentation",
});
const Crumb = T("rust.crumb", { ns: "doc", defaultValue: "Rust API" });
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load Mode="functional" slot="Header" />

	<div class="doc-rust">
		<DocArticle
			kicker="/RUST API"
			title={Heading}
			standfirstHtml={LinkMentions(Standfirst)}
			crumbs={[
				{ label: Home, href: "/" },
				{ label: Documentation, href: "/Doc" },
				{ label: Crumb },
			]}
			measure={false}
			banded
		>
			<jelly-card
				class="doc-index-card"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:clamp(1rem,4vw,2.5rem)"
			>
				<DocIndex band={RustBand(T)} />
			</jelly-card>

			<jelly-card
				class="doc-appendix__card"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:clamp(1rem,4vw,2.5rem)"
			>
				<RecordBand band={ViewerBand}>
					<RustViewer
						crates={RustCrates}
						label={T("rust.viewer.label", {
							ns: "doc",
							defaultValue: "Rust crate group",
						})}
						title={T("rust.viewer.title", {
							ns: "doc",
							defaultValue: "Rust API Documentation",
						})}
					/>
				</RecordBand>
			</jelly-card>

			<p class="doc-rust__back">
				<a href="/Doc">{Documentation}<span aria-hidden="true"> ←</span></a>
			</p>
		</DocArticle>
	</div>
</Base>
