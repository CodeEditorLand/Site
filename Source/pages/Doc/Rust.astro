---
import { Header } from "../../Component/Layout/Header";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.docs.rust.title", {
	defaultValue: "Rust API Documentation | Code Editor Land",
});

const MetaDescription = T("meta.docs.rust.description", {
	defaultValue:
		"Browse the generated Rust API documentation for Land's core crates.",
});

const RustDocSite = [
	{
		Id: "mountain",
		Label: "Mountain (Core Crates)",
		Url: "https://rust-documentation-mountain-land.pages.dev",
		Description:
			"Mountain, Echo, Common, CommonLibrary, Air, AirLibrary, SideCar, Download",
	},
	{
		Id: "rest",
		Label: "Rest (Bundler)",
		Url: "https://rust-documentation-rest-land.pages.dev",
		Description: "Rest OXC-based JavaScript bundler",
	},
	{
		Id: "maintain",
		Label: "Maintain (Tooling)",
		Url: "https://rust-documentation-maintain-land.pages.dev",
		Description: "CI/CD and maintenance scripts",
	},
];
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url="https://editor.land/Doc/Rust"
	lang="en">
	<Header client:load />

	<div class="container mx-auto max-w-6xl px-4 py-16">
		<!-- Breadcrumbs -->
		<nav aria-label="Breadcrumb" class="mb-8">
			<ol
				class="flex flex-wrap items-center space-x-2 text-sm text-muted-foreground">
				<li>
					<a href="/" class="transition-colors hover:text-foreground">
						{T("common.breadcrumb.home", { defaultValue: "Home" })}
					</a>
				</li>
				<li class="mx-2">/</li>
				<li>
					<a
						href="/Doc"
						class="transition-colors hover:text-foreground">
						{
							T("common.docs.pageTitle", {
								defaultValue: "Documentation",
							})
						}
					</a>
				</li>
				<li class="mx-2">/</li>
				<li>
					<span class="font-medium text-foreground">Rust API</span>
				</li>
			</ol>
		</nav>

		<!-- Page Header -->
		<header class="mb-8">
			<h1 class="mb-3 text-4xl font-bold tracking-tight">
				Rust API Documentation
			</h1>
			<p class="text-lg text-muted-foreground">
				Generated <code>rustdoc</code> output for Land's Rust crates. Select
				a crate group below, or open directly in a new tab.
			</p>
		</header>

		<!-- Crate selector cards -->
		<div
			class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3"
			role="group"
			aria-label="Rust crate documentation sets">
			{
				RustDocSite.map((Site) => (
					<a
						href={Site.Url}
						target="_blank"
						rel="noopener noreferrer"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-4 transition-colors hover:border-[var(--Primary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<p class="font-medium text-[var(--Primary)]">
							{Site.Label}
							<span class="InlineSeparator">↗</span>
						</p>
						<p class="mt-1 text-xs text-muted-foreground">
							{Site.Description}
						</p>
					</a>
				))
			}
		</div>

		<!-- Iframe embed with switcher -->
		<div
			class="StaccatoCard StaccatoBorderShimmer overflow-hidden border border-[var(--Border)] bg-white">
			<!-- Tab bar -->
			<div
				class="flex items-center gap-1 border-b border-[var(--Border)] px-4 py-2"
				role="tablist"
				aria-label="Rust crate group">
				{
					RustDocSite.map((Site, Index) => (
						<button
							type="button"
							role="tab"
							aria-selected={Index === 0 ? "true" : "false"}
							aria-controls="RustDocFrame"
							data-rustdoc-url={Site.Url}
							class={`RustDocTab border px-3 py-1 text-xs font-medium transition-colors focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)] ${
								Index === 0
									? "border-[var(--Primary)] bg-[var(--Primary)] text-white"
									: "border-[var(--Border)] bg-white text-muted-foreground hover:bg-[var(--Secondary)]"
							}`}>
							{Site.Label.split(" ")[0]}
						</button>
					))
				}
				<span class="ml-auto text-xs text-muted-foreground">
					Opens in iframe - use ↗ above to open in new tab
				</span>
			</div>

			<iframe
				id="RustDocFrame"
				src="https://rust-documentation-mountain-land.pages.dev"
				title="Rust API Documentation"
				class="h-[70vh] w-full border-0"
				loading="lazy"
				sandbox="allow-scripts allow-same-origin allow-popups allow-top-navigation-by-user-activation"
			></iframe>
		</div>

		<!-- Back to docs -->
		<div class="mt-8 border-t pt-6">
			<a
				href="/Doc"
				class="StaccatoButton text-sm text-primary hover:underline">
				{T("common.docs.pageTitle", { defaultValue: "Documentation" })}
				<span class="InlineSeparator">←</span>
			</a>
		</div>
	</div>
</Base>

<script>
	// Tab switcher for iframe
	const Tabs = document.querySelectorAll<HTMLButtonElement>(".RustDocTab");
	const Frame = document.getElementById("RustDocFrame") as HTMLIFrameElement;

	Tabs.forEach((Tab) => {
		Tab.addEventListener("click", () => {
			const Url = Tab.dataset.rustdocUrl;
			if (!Url || !Frame) return;

			// Update iframe src
			Frame.src = Url;

			// Update tab styles
			Tabs.forEach((OtherTab) => {
				OtherTab.setAttribute("aria-selected", "false");
				OtherTab.className = OtherTab.className.replace(
					"border-[var(--Primary)] bg-[var(--Primary)] text-white",
					"border-[var(--Border)] bg-white text-muted-foreground hover:bg-[var(--Secondary)]",
				);
			});
			Tab.setAttribute("aria-selected", "true");
			Tab.className = Tab.className.replace(
				"border-[var(--Border)] bg-white text-muted-foreground hover:bg-[var(--Secondary)]",
				"border-[var(--Primary)] bg-[var(--Primary)] text-white",
			);

			// Update URL hash
			const Id = Tab.textContent?.trim().toLowerCase();
			if (Id) history.replaceState(null, "", `#${Id}`);
		});
	});

	// Restore tab from URL hash
	const Hash = window.location.hash.slice(1);
	if (Hash) {
		const MatchTab = Array.from(Tabs).find(
			(T) => T.textContent?.trim().toLowerCase() === Hash,
		);
		MatchTab?.click();
	}
</script>
