---
/**
 * The home page - five bands, in the order the site has always printed them.
 *
 *   hero        `# LAND_01`   the two-panel record: the card beside the evidence
 *   #features                 the six element records that carry the claim
 *   #pricing                  the two release records: what is out, what is next
 *   #testimonials             all fifteen element records, as a wall
 *   #download                 the three platform records
 *   close                     the six badges the page stops on
 *
 * The order is the page's meaning and it is not free: the claim comes first, then
 * what is released, then what the thing is made of, then where it runs. A page
 * that prints the architecture before the release state answers a question the
 * reader has not asked yet.
 *
 * The hero is the one band that hydrates: it is a React island
 * (`DynamicHeroSection`) because it carries the record's seal, its status and its
 * evidence as components. The four bands below it are static `.astro` - they are
 * printed records with no state, so they ship no JavaScript at all.
 *
 * There is no `h1` on this page, and that is the baseline's own composition: the
 * page's opening statement is the hero's record, not a heading, and the loudest
 * type above the fold is the mono runtime claim inside the card. The first
 * heading a reader meets is the features band's `h2`.
 */
import ArchitectureBand from "../Component/Home/ArchitectureBand.astro";
import FeatureBand from "../Component/Home/FeatureBand.astro";
import PlatformBand from "../Component/Home/PlatformBand.astro";
import RoadmapBand from "../Component/Home/RoadmapBand.astro";
import { DynamicHeroSection } from "../Component/Dynamic/DynamicHeroSection";
import { HeroBandFor } from "../Component/Dynamic/Hero/Data.js";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.home.title", {
	defaultValue: "Code Editor Land | Rust and Tauri Editor Stack",
});

const MetaDescription = T("meta.home.description", {
	defaultValue:
		"Code Editor Land is an open-source editor stack built with Rust, Tauri, and a VS Code-compatible extension host. Source builds are active while public installers and full extension coverage are still in progress.",
});

const SiteURL = Astro.site?.href ?? "";

/** The hero island's record band, resolved once from the locale files. */
const HeroBand = HeroBandFor(T);

/**
 * The hero's content surface. The island reads one field from it - the page's
 * primary destination - so the object is that field and nothing else; the band's
 * own copy travels beside it as `HeroBand`.
 */
const HeroContent = { PrimaryCTA: { Href: "/Download" } };
---

<Base Title={MetaTitle} Description={MetaDescription} lang="en">
	<Fragment slot="Head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: "Code Editor Land",
				alternateName: "Land",
				description:
					"An open-source editor stack built with Rust, Tauri, and a VS Code-compatible extension host. Source builds are active while public installers and full extension coverage are still in progress.",
				url: SiteURL,
				applicationCategory: "DeveloperApplication",
				operatingSystem: "macOS, Windows, Linux",
				offers: {
					"@type": "Offer",
					price: "0",
					priceCurrency: "USD",
				},
				license: "https://creativecommons.org/publicdomain/zero/1.0/",
				softwareVersion: "Pre-release",
				downloadUrl: `${SiteURL}Download`,
				screenshot: `${SiteURL}Favicon/og-image.png`,
				author: [
					{
						"@type": "Person",
						name: "Nikola R. Hristov",
						url: "https://github.com/NikolaRHristov",
					},
					{
						"@type": "Organization",
						name: "Code Editor Land",
						url: SiteURL,
					},
					{
						"@type": "Organization",
						name: "PlayForm",
						url: "https://PlayForm.Cloud",
					},
				],
				publisher: {
					"@type": "Organization",
					name: "Code Editor Land",
					url: SiteURL,
					logo: {
						"@type": "ImageObject",
						url: `${SiteURL}Favicon/favicon.svg`,
					},
				},
				featureList: [
					"Native Rust backend with gRPC IPC",
					"VS Code API compatibility through Cocoon",
					"Effect-TS type-safe UI services",
					"Source build targets for macOS, Windows, and Linux",
					"Open source under CC0 license",
				],
				isAccessibleForFree: true,
			})}
		/>
	</Fragment>

	<Header client:load slot="Header" />

	<DynamicHeroSection client:load Content={HeroContent} Band={HeroBand} />

	<FeatureBand />

	<RoadmapBand />

	<ArchitectureBand />

	<PlatformBand />

	<div class="home-close">
		<img
			alt="Code Editor Land logo"
			title="Code Editor Land"
			src="/Asset/Logo/Glyph/Land.svg"
			width="20"
			height="20"
		/>

		<jelly-badge
			variant="mint"
			shape="square"
			style="--jelly-fill:var(--SpinegRPCMute);--jelly-label:var(--SpinegRPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			Telemetry Feature Gated&#x2001;<span
				class="home-close__dot"
				style="background-color:var(--SpinegRPC)"
				aria-hidden="true"></span>
		</jelly-badge>

		<jelly-badge
			variant="mint"
			shape="square"
			style="--jelly-fill:var(--SpinegRPCMute);--jelly-label:var(--SpinegRPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			CC0 Licensed&#x2001;<img
				src="/Image/CC0.svg"
				alt=""
				width="12"
				height="12"
				aria-hidden="true"
			/>
		</jelly-badge>

		<jelly-badge
			variant="azure"
			shape="square"
			style="--jelly-fill:var(--SpineIPCMute);--jelly-label:var(--SpineIPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			Rust&#x2001;<img
				src="/Image/Rust.svg"
				alt=""
				width="12"
				height="12"
				aria-hidden="true"
			/>&#x2001;+&#x2001;Tauri&#x2001;<img
				src="/Image/Tauri.svg"
				alt=""
				width="12"
				height="12"
				aria-hidden="true"
			/>
		</jelly-badge>

		<jelly-badge
			variant="platinum"
			shape="square"
			outline
			style="--jelly-label:var(--Foreground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			VS Code API In Progress
		</jelly-badge>

		<jelly-badge
			variant="platinum"
			shape="square"
			outline
			class="home-close__action"
			tabindex="0"
			style="--jelly-label:var(--Foreground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
			onclick="window.open('https://PlayForm.Cloud','_blank','noopener noreferrer')"
		>
			PlayForm
		</jelly-badge>

		<jelly-badge
			variant="platinum"
			shape="square"
			outline
			class="home-close__action"
			tabindex="0"
			style="--jelly-label:var(--Foreground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
			onclick="location.href='/'"
		>
			CodeEditorLand
		</jelly-badge>
	</div>
</Base>
