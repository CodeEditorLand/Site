---
/**
 * The home page - the opening spread of the dossier, and four parts after it.
 *
 *   hero        `# LAND_01`   the two-panel record: the card beside the evidence,
 *                             with the runtime trace and the stack as its foot
 *   #features   `# OBSERVATION_01`      the six element records, as one matrix
 *   #pricing    `# CONDITIONS_01`       the two release states, as one manifest
 *   #testimonials `# CLASSIFICATION_01` all fifteen element records, as a wall
 *   #method     `# METHOD_01`           how the claim is checked: the build's
 *                                       trace beside the release's register, and
 *                                       the three documented failures under both
 *   #download   `# ACTION_01`           the three platform artefacts, as a manifest
 *   close       `/MARKS`                the six marks the page stops on
 *
 * The order is the page's meaning and it is not free: the claim comes first, then
 * what is released, then what the thing is made of, then where it runs. A page
 * that prints the architecture before the release state answers a question the
 * reader has not asked yet.
 *
 * THE RHYTHM IS WIDE / WIDE / TIGHT / WIDE / TIGHT / WIDE, and each band declares
 * its own step (`Band`'s `rhythm` prop). The spread is one screen; the proof and
 * the release state open a subject; the wall packs; the method opens again,
 * because a reader who has just read fifteen records needs air before the
 * mechanism; the action closes. The method band is the one this page gained
 * after the wall: a page of six bands with three tight ones in a row is a page
 * that never lets the reader rest.
 *
 * The page has ONE `h1`, and it is the hero record's claim - the baseline printed
 * no `h1` at all, and the fidelity wave's own composition gave the claim that
 * role. The four band headings are `h2`s, a full tier below it.
 *
 * The hero is the one band that hydrates: it is a React island
 * (`DynamicHeroSection`) because it carries the record's seal, its status and its
 * evidence as components. The four bands below it are static `.astro` - they are
 * printed records with no state, so they ship no JavaScript at all.
 */
import ArchitectureBand from "../Component/Home/ArchitectureBand.astro";
import FeatureBand from "../Component/Home/FeatureBand.astro";
import PlatformBand from "../Component/Home/PlatformBand.astro";
import RoadmapBand from "../Component/Home/RoadmapBand.astro";
import WorkingBand from "../Component/Home/WorkingBand.astro";
import { DynamicHeroSection } from "../Component/Dynamic/DynamicHeroSection";
import { HeroBandFor } from "../Component/Dynamic/Hero/Data.js";
import RecordLedger from "../Component/Record/RecordLedger.astro";
import RecordStage from "../Component/Record/RecordStage.astro";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.home.title", {
	defaultValue: "Code Editor Land | Rust and Tauri Editor Stack",
});

const MetaDescription = T("meta.home.description", {
	defaultValue:
		"Code Editor Land is an open-source editor stack built with Rust, Tauri, and a VS Code-compatible extension host. Source builds are active while public installers and full extension coverage are still in progress.",
});

const SiteURL = Astro.site?.href ?? "";

/** The hero island's record band, resolved once from the locale files. */
const HeroBand = HeroBandFor(T);

/**
 * The hero's content surface. The island reads one field from it - the page's
 * primary destination - so the object is that field and nothing else; the band's
 * own copy travels beside it as `HeroBand`.
 */
const HeroContent = { PrimaryCTA: { Href: "/Download" } };
---

<Base Title={MetaTitle} Description={MetaDescription} lang="en">
	<Fragment slot="Head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: "Code Editor Land",
				alternateName: "Land",
				description:
					"An open-source editor stack built with Rust, Tauri, and a VS Code-compatible extension host. Source builds are active while public installers and full extension coverage are still in progress.",
				url: SiteURL,
				applicationCategory: "DeveloperApplication",
				operatingSystem: "macOS, Windows, Linux",
				offers: {
					"@type": "Offer",
					price: "0",
					priceCurrency: "USD",
				},
				license: "https://creativecommons.org/publicdomain/zero/1.0/",
				softwareVersion: "Pre-release",
				downloadUrl: `${SiteURL}Download`,
				screenshot: `${SiteURL}Favicon/og-image.png`,
				author: [
					{
						"@type": "Person",
						name: "Nikola R. Hristov",
						url: "https://github.com/NikolaRHristov",
					},
					{
						"@type": "Organization",
						name: "Code Editor Land",
						url: SiteURL,
					},
					{
						"@type": "Organization",
						name: "PlayForm",
						url: "https://PlayForm.Cloud",
					},
				],
				publisher: {
					"@type": "Organization",
					name: "Code Editor Land",
					url: SiteURL,
					logo: {
						"@type": "ImageObject",
						url: `${SiteURL}Favicon/favicon.svg`,
					},
				},
				featureList: [
					"Native Rust backend with gRPC IPC",
					"VS Code API compatibility through Cocoon",
					"Effect-TS type-safe UI services",
					"Source build targets for macOS, Windows, and Linux",
					"Open source under CC0 license",
				],
				isAccessibleForFree: true,
			})}
		/>
	</Fragment>

	<Header client:load slot="Header" />

	<DynamicHeroSection client:load Content={HeroContent} Band={HeroBand}>
		{/*
		 * The two blocks the hero's `.tsx` island cannot import: they are
		 * `.astro`, and an `.astro` component cannot be imported from a
		 * `.tsx` file. Astro renders a `slot` child to HTML and hands the
		 * framework component that HTML as a prop, so the route carries the
		 * import and the island places it - the facts ledger in the record
		 * card, the runtime path as the evidence plate's Signal Trace.
		 *
		 * `HeroBand.facts` already prints its labels with their colons
		 * (`TARGET:`, `LICENSE:`, `SIGNAL:`); the block prints the row as it
		 * is given and the page supplies nothing to it.
		 */}
		<RecordLedger
			slot="ledger"
			rows={HeroBand.facts}
			class="hero-band__facts"
		/>

		<div slot="stage" class="hero-band__trace-stage">
			<RecordStage stages={HeroBand.steps} orientation="row" />
		</div>
	</DynamicHeroSection>

	<FeatureBand />

	<RoadmapBand />

	<ArchitectureBand />

	<WorkingBand />

	<PlatformBand />

	<div class="home-band__inner">
		<div class="home-close">
			<p class="home-close__label">/MARKS</p>

			<img
			alt="Code Editor Land logo"
			title="Code Editor Land"
			src="/Asset/Logo/Glyph/Land.svg"
			width="20"
			height="20"
		/>

		<jelly-badge
			variant="mint"
			shape="square"
			style="--jelly-fill:var(--SpinegRPCMute);--jelly-label:var(--SpinegRPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			Telemetry Feature Gated&#x2001;<span
				class="home-close__dot"
				style="background-color:var(--SpinegRPC)"
				aria-hidden="true"></span>
		</jelly-badge>

		<jelly-badge
			variant="mint"
			shape="square"
			style="--jelly-fill:var(--SpinegRPCMute);--jelly-label:var(--SpinegRPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			CC0 Licensed&#x2001;<img
				src="/Image/CC0.svg"
				alt=""
				width="12"
				height="12"
				aria-hidden="true"
			/>
		</jelly-badge>

		<jelly-badge
			variant="azure"
			shape="square"
			style="--jelly-fill:var(--SpineIPCMute);--jelly-label:var(--SpineIPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			Rust&#x2001;<img
				src="/Image/Rust.svg"
				alt=""
				width="12"
				height="12"
				aria-hidden="true"
			/>&#x2001;+&#x2001;Tauri&#x2001;<img
				src="/Image/Tauri.svg"
				alt=""
				width="12"
				height="12"
				aria-hidden="true"
			/>
		</jelly-badge>

		<jelly-badge
			variant="platinum"
			shape="square"
			outline
			style="--jelly-label:var(--Foreground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
		>
			VS Code API In Progress
		</jelly-badge>

		<a
			class="home-close__link"
			href="https://PlayForm.Cloud"
			target="_blank"
			rel="noopener noreferrer"
		>
			<jelly-badge
				variant="platinum"
				shape="square"
				outline
				style="--jelly-label:var(--Foreground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
			>
				PlayForm
			</jelly-badge>
		</a>

		<a class="home-close__link" href="/">
			<jelly-badge
				variant="platinum"
				shape="square"
				outline
				style="--jelly-label:var(--Foreground);--jelly-badge-radius:0;--jelly-badge-font-size:13px"
			>
				CodeEditorLand
			</jelly-badge>
		</a>
		</div>
	</div>
</Base>
