---
import { HomePage } from "../Component/Dynamic/HomePage";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.home.title", {
	defaultValue: "Code Editor Land | Rust and Tauri Editor Stack",
});
const MetaDescription = T("meta.home.description", {
	defaultValue:
		"Code Editor Land is an open-source editor stack built with Rust, Tauri, and a VS Code-compatible extension host. Source builds are active while public installers and full extension coverage are still in progress.",
});
---

<Base Title={MetaTitle} Description={MetaDescription} lang="en">
	<Fragment slot="Head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"name": "Code Editor Land",
				"alternateName": "Land",
				"description":
					"An open-source editor stack built with Rust, Tauri, and a VS Code-compatible extension host. Source builds are active while public installers and full extension coverage are still in progress.",
				"url": Astro.site?.href ?? "",
				"applicationCategory": "DeveloperApplication",
				"operatingSystem": "macOS, Windows, Linux",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD",
				},
				"license": "https://creativecommons.org/publicdomain/zero/1.0/",
				"softwareVersion": "Pre-release",
				"downloadUrl": `${Astro.site?.href ?? ""}Download`,
				"screenshot": `${Astro.site?.href ?? ""}Favicon/og-image.png`,
				"author": [
					{
						"@type": "Person",
						"name": "Nikola R. Hristov",
						"url": "https://github.com/NikolaRHristov",
					},
					{
						"@type": "Organization",
						"name": "Code Editor Land",
						"url": Astro.site?.href ?? "",
					},
					{
						"@type": "Organization",
						"name": "PlayForm",
						"url": "https://PlayForm.Cloud",
					},
				],
				"publisher": {
					"@type": "Organization",
					"name": "Code Editor Land",
					"url": Astro.site?.href ?? "",
					"logo": {
						"@type": "ImageObject",
						"url": `${Astro.site?.href ?? ""}Favicon/favicon.svg`,
					},
				},
				"featureList": [
					"Native Rust backend with gRPC IPC",
					"VS Code API compatibility through Cocoon",
					"Effect-TS type-safe UI services",
					"Source build targets for macOS, Windows, and Linux",
					"Open source under CC0 license",
				],
				"isAccessibleForFree": true,
			})}
		/>
	</Fragment>
	<Header client:load />
	<HomePage
		client:load
		MetaTitle={MetaTitle}
		MetaDescription={MetaDescription}
	/>
	<div
		class="container mx-auto flex flex-wrap items-center justify-center gap-3 px-4 py-10 text-muted-foreground">
		<picture>
			<img
				alt="Code Editor Land logo"
				title="Code Editor Land"
				src="/Asset/Logo/Glyph/Land.svg"
				width="20"
				height="20"
			/>
		</picture>
		<span
			class="inline-flex items-center border px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wide"
			style="border-color:var(--SpinegRPC);color:var(--SpinegRPCFore);background-color:var(--SpinegRPCMute)">
			Telemetry Feature Gated&#x2001;<span
				class="h-1.5 w-1.5 rounded-none"
				style="background-color:var(--SpinegRPC)"
				aria-hidden="true"></span>
		</span>
		<span
			class="inline-flex items-center border px-2.5 py-0.5 align-middle font-mono text-[11px] font-medium uppercase tracking-wide"
			style="border-color:var(--SpinegRPC);color:var(--SpinegRPCFore);background-color:var(--SpinegRPCMute)">
			CC0 Licensed&#x2001;<img
				src="/Image/CC0.svg"
				alt=""
				width="12"
				height="12"
				class="inline-block align-middle opacity-70 dark:hidden"
				aria-hidden="true"
			/><img
				src="/Dark/Image/CC0.svg"
				alt=""
				width="12"
				height="12"
				class="inline-block hidden align-middle opacity-70 dark:block"
				aria-hidden="true"
			/>
		</span>
		<span
			class="inline-flex items-center border px-2.5 py-0.5 align-middle font-mono text-[11px] font-medium uppercase tracking-wide"
			style="border-color:var(--SpineIPC);color:var(--SpineIPCFore);background-color:var(--SpineIPCMute)">
			Rust&#x2001;<img
				src="/Image/Rust.svg"
				alt=""
				width="12"
				height="12"
				class="inline-block align-middle opacity-70 dark:hidden"
				aria-hidden="true"
			/><img
				src="/Dark/Image/Rust.svg"
				alt=""
				width="12"
				height="12"
				class="inline-block hidden align-middle opacity-70 dark:block"
				aria-hidden="true"
			/>&#x2001;+&#x2001;Tauri&#x2001;<img
				src="/Image/Tauri.svg"
				alt=""
				width="12"
				height="12"
				class="inline-block align-middle opacity-70 dark:hidden"
				aria-hidden="true"
			/><img
				src="/Dark/Image/Tauri.svg"
				alt=""
				width="12"
				height="12"
				class="inline-block hidden align-middle opacity-70 dark:block"
				aria-hidden="true"
			/>
		</span>
		<span
			class="inline-flex items-center border px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wide"
			style="border-color:var(--Border);color:var(--MuteForeground)">
			VS Code API In Progress
		</span>
		<a
			href="https://PlayForm.Cloud"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center border px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wide transition-colors hover:text-foreground"
			style="border-color:var(--Border);color:var(--MuteForeground)">
			PlayForm
		</a>
		<a
			href="/"
			class="inline-flex items-center border px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wide transition-colors hover:text-foreground"
			style="border-color:var(--Border);color:var(--MuteForeground)">
			CodeEditorLand
		</a>
	</div>
</Base>
