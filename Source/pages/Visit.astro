---
// ─── Visit - Universal Dispatch Center ───────────────────────────────────────
//
// This page is the catch-all landing target for ALL unresolved paths on
// Cloudflare Pages. It is served via a `/* /Visit/ 200` rewrite rule in
// _redirects - the browser URL stays as the original path, but the content
// served is this page's HTML.
//
// Time horizons:
//
// T0 - Cold start (no SW): Cloudflare's _redirects `/* /Visit/ 200` rule
// proxies this page for any path that has no static file. The client
// script resolves the original path from window.location and redirects.
//
// T1 - SW just installed: SW registers, page reloads. From T2 onwards,
// the SW intercepts ALL navigations before they reach CF or this page.
//
// T2 - SW active, known variant: SW's ResolveRoute() handles it with a
// 301 redirect in-browser - this page is never served. /Visit itself
// is mapped to "/" in SemanticAlias so the SW redirects it directly.
//
// T3 - SW active, truly unknown path: SW passes to network → CF returns
// this page's content (200 rewrite) → client script → home.
//
// Design constraints:
// - No React, no hydration, no Base.astro layout - minimal HTML only.
// Every ms counts; this page is a redirect trampoline, not a destination.
// - Route map is embedded at SSG time via define:vars - no RouteMap.json
// fetch needed, works on first visit with no network round-trips.
// - window.location.replace() is used for all redirects - no history entry.
// ─────────────────────────────────────────────────────────────────────────────

import {
	CanonicalPath,
	GeneratePathVariant,
	SemanticAlias,
} from "../Function/Route/Map";
import { VisitTombstone } from "../Content/Layout/Visit.js";

// Build the full variant map at SSG time - identical logic to Integration.ts
// so this page and the SW resolve routes the same way.
const VariantMap: Record<string, string> = {};

for (const PascalPath of CanonicalPath) {
	const BuiltPath = PascalPath.toLowerCase();
	VariantMap[BuiltPath] = PascalPath;
	for (const Variant of GeneratePathVariant(PascalPath, BuiltPath)) {
		if (!VariantMap[Variant]) {
			VariantMap[Variant] = PascalPath;
		}
	}
}

for (const [Alias, Target] of Object.entries(SemanticAlias)) {
	VariantMap[Alias] = Target;
}

const CanonicalList = [...CanonicalPath];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1.0" />
		<title>Resolving This Address</title>
		<meta name="robots" content="noindex,nofollow" />
		<!-- Instant redirect: if JS is disabled, fall back to home after 3s -->
		<noscript>
			<meta http-equiv="refresh" content="3;url=/" />
		</noscript>
		<style>
			/* Minimal no-flash shell - never visible longer than one frame.
			   The canvas is the site's own paper (--Background, defined in
			   Source/Stylesheet/System/_Token.scss), not white: this page is
			   served for every unresolved path, so a white frame reads as a
			   flash against the creme canvas. This page loads no stylesheet by
			   design, so the token's value is inlined as the fallback. */
			html,
			body {
				margin: 0;
				padding: 0;
				background: var(--Background, #f2ede3);
			}

			/* The tombstone. It prints only when the script does not run, so it
			   is inlined and flat: one field, one hairline, mono type at two
			   sizes, no shadow, no radius, no accent. The grammar's marks are
			   text, not images, so the block costs a few hundred bytes. */
			.visit-record {
				max-width: 44rem;
				margin: 14vh auto 0;
				padding: 0 1.5rem 4rem;
				color: #1c1c1e;
				font: 400 14px/1.65 ui-monospace, "IBM Plex Mono", SFMono-Regular,
					Menlo, monospace;
			}
			.visit-record__head {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				margin: 0;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgba(28, 28, 30, 0.2);
				font-size: 13px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.visit-record__route {
				color: #70685b;
			}
			.visit-record__state {
				margin: 1.75rem 0 0;
				font-size: 13px;
				letter-spacing: 0.08em;
			}
			.visit-record__rows {
				margin: 1.25rem 0 0;
				padding: 0;
			}
			.visit-record__rows > div {
				display: grid;
				grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
				gap: 1rem;
				padding: 0.6rem 0;
				border-top: 1px solid rgba(28, 28, 30, 0.12);
			}
			.visit-record__rows dt {
				font-size: 13px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #70685b;
			}
			.visit-record__rows dd {
				margin: 0;
			}
			.visit-record__note {
				margin: 1.5rem 0 0;
				font-size: 13px;
				color: #70685b;
			}
			.visit-record__back {
				margin: 2rem 0 0;
			}
			.visit-record a {
				color: #1c1c1e;
				text-decoration: underline;
				text-decoration-thickness: 2px;
				text-underline-offset: 3px;
			}
			@media (max-width: 30rem) {
				.visit-record__rows > div {
					grid-template-columns: minmax(0, 1fr);
					gap: 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		{/*
			THE MISSING STATE. Without the script this route used to print a blank
			field and redirect after three seconds. The tombstone says what the
			address is (nothing), why (the build emits no route and the redirect
			table carries no entry) and where to go (the index, which names every
			address the build does emit). It is `<noscript>`-only: a reader whose
			script runs never sees it, and pays nothing for it.
		*/}
		<noscript>
			<div class="visit-record">
				<p class="visit-record__head">
					<span>{VisitTombstone.index}</span>
					<span class="visit-record__route">{VisitTombstone.route}</span>
				</p>

				<p class="visit-record__state">
					<span aria-hidden="true">◎</span>
					{"\u2001"}STATUS:{"\u2001"}{VisitTombstone.state}
				</p>

				<dl class="visit-record__rows">
					<div>
						<dt>WOULD BE HERE:</dt>
						<dd>{VisitTombstone.statement}</dd>
					</div>
					<div>
						<dt>WHY NOT:</dt>
						<dd>{VisitTombstone.cause}</dd>
					</div>
					{VisitTombstone.rows.map((Row) => (
						<div>
							<dt>{Row.key}</dt>
							<dd>{Row.value}</dd>
						</div>
					))}
					<div>
						<dt>NEXT:</dt>
						<dd>
							<a href={VisitTombstone.next.href}>
								{VisitTombstone.next.label}
								{"\u2001"}
								<span aria-hidden="true">&rarr;</span>
							</a>
						</dd>
					</div>
				</dl>

				<p class="visit-record__note">{VisitTombstone.note}</p>

				<p class="visit-record__back">
					<a href={VisitTombstone.back.href}>
						{VisitTombstone.back.label}
						{"\u2001"}
						<span aria-hidden="true">&rarr;</span>
					</a>
				</p>
			</div>
		</noscript>
		<script define:vars={{ VariantMap, CanonicalList }}>
			(function () {
				// ── Read the original path ──────────────────────────────────
				// CF Pages' 200 rewrite preserves the original URL in the
				// browser, so window.location reflects the user's intended path.
				var RawPath = window.location.pathname;
				var Search = window.location.search;
				var Hash = window.location.hash;

				// Normalise: strip trailing slash, lowercase
				var Cleaned =
					RawPath === "/" ? "/" : RawPath.replace(/\/+$/, "");

				var Lower = Cleaned.toLowerCase();

				// ── If we are literally ON /Visit with no other path ────────
				// (direct navigation or unknown path with no alias) → home
				if (
					Cleaned === "/Visit" ||
					Cleaned === "/visit" ||
					Cleaned === "/"
				) {
					window.location.replace("/" + Search + Hash);
					return;
				}

				// ── Already a known canonical - serve it directly ───────────
				// (shouldn't normally reach here when SW is active, but handle
				// the edge case where CF serves this page for a canonical path)
				if (CanonicalList.indexOf(Cleaned) !== -1) {
					window.location.replace(Cleaned + Search + Hash);
					return;
				}

				// ── Exact lowercase match ───────────────────────────────────
				var Canonical = VariantMap[Lower] || VariantMap[Cleaned];

				// ── Strip hyphens/underscores and retry ─────────────────────
				if (!Canonical) {
					var Stripped = Lower.replace(/[-_]/g, "");
					Canonical = VariantMap[Stripped];
				}

				// ── Strip trailing 's' (plural → singular) and retry ────────
				if (!Canonical && Lower.length > 2 && Lower.endsWith("s")) {
					Canonical = VariantMap[Lower.slice(0, -1)];
				}

				// ── Redirect or fall back to home ───────────────────────────
				if (Canonical) {
					// Preserve query string and hash from original navigation
					window.location.replace(Canonical + Search + Hash);
				} else {
					// Truly unknown path - send to home
					window.location.replace("/" + Search + Hash);
				}
			})();
		</script>
	</body>
</html>
