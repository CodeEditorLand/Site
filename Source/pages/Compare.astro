---
/**
 * Compare - Land against the editor it replaces, in the site's own words.
 *
 * ─── WHY THIS PAGE EXISTS ─────────────────────────────────────────────────
 * The site's central claim is that it is the same editor on a different
 * substrate. That claim is made in a sentence on the homepage, argued in a
 * document, and printed as an eight-row table halfway down
 * `Content/doc/cocoon.md` - where a reader deciding whether to switch will never
 * find it. This page is that table where the decision is made, with the two
 * things the table does not carry: what each substitution changes, and what
 * nobody has measured.
 *
 * ─── THE LANGUAGE: WORKSPACE ──────────────────────────────────────────────
 * `Language.ts` files this route as `workspace`, and the contract is a rail, two
 * panes and a drawer:
 *
 *   rail     the citations - the documents this comparison is drawn from, and
 *            the two surfaces a reader needs beside it
 *   panes    the substitution (a matrix, in the wide pane) beside what carries
 *            over (a rail of positions, in the narrow one)
 *   drawer   the check: three files and one command, closed until asked for
 *
 * The drawer is the right home for the check because it is the one thing on this
 * page a reader consults rather than reads - and a `<details>` is found by the
 * browser's own in-page search while closed.
 *
 * ─── THE OPENING IS A RECORD, AND IT HAS NO EVIDENCE PANEL ────────────────
 * `RecordHero` asserts what the page is: the claim (`〈THE SAME EDITOR〉`), the
 * route (`/SUBSTRATE:DIFFERENT`), the state, and four facts. No evidence panel -
 * a comparison has no picture of itself, and a figure invented to fill the second
 * panel would be the thing this page argues against two screens further down.
 *
 * ─── THE ADVERSE STATES ARE THE PAGE'S ARGUMENT ───────────────────────────
 * Under the measured table, two states explain it: the one figure is dated, and
 * four of the five do not exist. A comparison page is the easiest page on a site
 * to lie on, because the reader arrives wanting a verdict - so the page prints
 * what it cannot say, in the same band as what it can.
 */
import { Header } from "../Component/Layout/Header";
import Onward from "../Component/More/Onward.astro";
import RecordBand from "../Component/Record/RecordBand.astro";
import RecordCompare from "../Component/Record/RecordCompare.astro";
import RecordHero from "../Component/Record/RecordHero.astro";
import RecordLedger from "../Component/Record/RecordLedger.astro";
import RecordMatrix from "../Component/Record/RecordMatrix.astro";
import RecordTrace from "../Component/Record/RecordTrace.astro";
import RecordWell from "../Component/Record/RecordWell.astro";
import { RegisterOf } from "../Component/Record/RegisterLine.js";
import Trail from "../Component/Route/Trail.astro";
import PageShell from "../Component/Shell/PageShell.astro";
import ShellPanes from "../Component/Shell/ShellPanes.astro";
import ShellRail from "../Component/Shell/ShellRail.astro";
import ShellState from "../Component/Shell/ShellState.astro";
import Base from "../Layout/Base.astro";
import MatrixControl from "../Component/UI/Matrix/MatrixControl.astro";

import {
	Bands,
	Carries,
	Changes,
	Check,
	Columns,
	MeasureColumns,
	Measured,
	Measurements,
	Rail,
	Record,
	Rows,
	Show,
} from "../Content/More/Compare.js";
import { CompareOnward } from "../Content/More/Page.js";

const MetaTitle = "Compare | Code Editor Land";

const MetaDescription =
	"Land against the editor it replaces, aspect by aspect: eight substitutions quoted from the project's own document, what carries over, and the five figures nobody has measured.";

/** The architecture matrix: the aspect, then one cell per column. */
const RowCells = Rows.map((Row) => ({
	label: Row.aspect,
	cells: [Row.land, Row.other],
}));

/** The measured matrix: the measure, this site, the alternative, the source. */
const MeasureCells = Measurements.map((Row) => ({
	label: Row.measure,
	cells: [Row.land, Row.other, Row.source],
}));

/** The one row's date, as the stale state prints it. */
const Dated =
	Measurements.find((Row) => Row.asOf !== undefined)?.asOf ?? "UNAVAILABLE";

/**
 * The register above the substitution's reading: `# WHAT CHANGES / 08`. The mark
 * is the grammar's and `RecordLedger` prints it; the name is the band's; the
 * count is `Changes.length` - the same eight aspects the matrix above prints,
 * because `Changes` is `Rows` mapped. `RegisterOf` takes the array it counts, so
 * the register cannot name a number its rows do not have, and the block
 * recomposes the figure from the rows it is handed, so the line and the set
 * cannot disagree. A page that could not count its set would build the line with
 * `RegisterUnavailable` - the vocabulary's word, never a zero - and this page
 * always can.
 */
const ChangesRegister = RegisterOf("WHAT CHANGES", Changes);

const TrailItems = [{ label: "/HOME", href: "/" }, { label: "/COMPARE" }];

/** The substitution matrix's control: its two columns, named by their own heads. */
const SubstitutionFacets = Columns.map((Column, Index) => ({
	Key: String(Index),
	Label: Column.label,
}));
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load Mode="functional" slot="Header" />

	<PageShell
		index="# WORKSPACE_06"
		label="THE SUBSTITUTION"
		class="PageShell--more"
		railLabel="The citations"
	>
		<Trail slot="head" trail={TrailItems} />

		<RecordHero slot="head" {...Record} />

		<ShellRail
			slot="rail"
			label="THE CITATIONS"
			count={Rail.length}
			items={Rail}
			current="page"
			sticky={false}
		/>

		<RecordBand band={Bands.Rows}>
			<MatrixControl
				Target="substitution-matrix"
				Facets={SubstitutionFacets}
				Name="THE SUBSTITUTION"
				Total={RowCells.length}
				PageSize={6}
			/>
			<RecordMatrix
				id="substitution-matrix"
				columns={Columns}
				rows={RowCells}
				caption="SOURCE: SOURCE/CONTENT/DOC/COCOON.MD. Both columns are that document's table, verbatim."
			/>

			<RecordLedger
				register={ChangesRegister}
				rows={Changes}
				columns={1}
			/>
		</RecordBand>

		{/*
			THE BAND HOLDS THE TWO THINGS CONSULTED BESIDE THE MATRIX, STACKED.

			A workspace's pane is a 5fr or 7fr track, and the three-column
			comparison at that measure would be a table the reader scrolls
			sideways - the one thing a matrix exists to avoid. So the matrix is
			the page's artifact at the track's full width, and the band holds
			what a reader consults *while* reading it: what carries over, and
			the three documents that answer it. The drawer holds the command.

			The two are stacked rather than set beside each other, and the
			measure is why: at a 1280 window the panes' container is 768px, so a
			7fr track gave the compare's five stops 83px each and a 5fr track
			gave the trace's paths 42px - five characters a line for a 41-
			character path. Neither block could lay itself out: `RecordCompare`
			and `RecordTrace` read the *window* (their wide rules are 768px media
			queries), not the box they sit in. Stacked, each takes the
			container's full 768px, which is the width both blocks' wide rules
			were drawn for.

			The workspace contract is still honoured - a rail, two panes and a
			drawer - and the instrument is still the page's subject; it is
			simply the one thing on the page that is not inside a pane, because
			a pane would narrow it.
		*/}
		<RecordBand band={Bands.Carries}>
			<ShellPanes
				layout="stack"
				primary={{
					mark: "# PANE_01",
					label: "WHAT CARRIES OVER",
					meta: `1 OF ${Carries.stops.length}`,
					note: "One claim with a source. The other four are not stated anywhere in this tree, and the rail prints that rather than a verdict.",
				}}
				secondary={{
					mark: "# PANE_02",
					label: "THE CHECK",
					meta: `${Check.steps.length} FILES`,
					note: "The three documents this page quotes, in the order a reader would open them.",
				}}
				drawer={{
					label: "THE COMMAND",
					note: "show the substitution in the tree",
				}}
			>
				<RecordCompare slot="primary" compare={Carries} />

				<RecordTrace slot="secondary" trace={Check} />

				<RecordWell
					slot="drawer"
					label={Show.label}
					language={Show.language}
					lines={Show.lines}
					source={Show.source}
				/>
			</ShellPanes>
		</RecordBand>

		<RecordBand band={Bands.Measure}>
			<RecordMatrix
				class="more-measured"
				columns={MeasureColumns}
				rows={MeasureCells}
				caption={`${Measured} of ${Measurements.length} measures exist. The one that does is weighted coverage across the measured \`vscode.*\` namespaces; the four that do not are stated as \`UNAVAILABLE\` in both columns, because this site does not measure other people's software.`}
			/>

			<div class="more-states">
				<ShellState
					kind="stale"
					index="MEASURE / 01"
					statement="The one figure on this page was measured in May 2026, and the document that states it has not been re-run since."
					cause="A coverage figure ages with the API surface, not with the page."
					asOf={Dated}
					age="THE DOCUMENT'S OWN DATE"
					rows={[
						{ key: "FIGURE:", value: "88% WEIGHTED COVERAGE" },
						{
							key: "DOCUMENT:",
							value: "/BLOG/VSCODE-COMPATIBILITY",
							code: true,
						},
					]}
					note="SOURCE: SOURCE/CONTENT/BLOG/VSCODECOMPATIBILITY.MD"
				/>

				<ShellState
					kind="partial"
					index="MEASURE / 02"
					statement="Four of the five measurements a reader wants before switching do not exist on this site: startup time, memory, installer size and a public build."
					cause="Three are unmeasured and one has no artifact to measure. The table prints `UNAVAILABLE` in both columns rather than borrowing a number from a benchmark nobody here ran."
					next={{
						label: "BUILD FROM SOURCE",
						href: "/Doc/installation",
					}}
					rows={[
						{ key: "MEASURED:", value: "1 OF 5" },
						{
							key: "UNAVAILABLE:",
							value: "STARTUP, MEMORY, SIZE, BUILD",
						},
					]}
					note="SOURCE: SOURCE/CONTENT/MORE/COMPARE.TS"
				/>
			</div>
		</RecordBand>

		<Onward
			slot="foot"
			rows={CompareOnward.rows}
			copy={CompareOnward.copy}
		/>
	</PageShell>
</Base>
