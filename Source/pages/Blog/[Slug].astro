---
/**
 * One article, on the reading surface.
 *
 * The markdown is the piece; this file is the apparatus around it. The shell
 * renders the page's only `h1` from the frontmatter `title`, the tag chips from
 * the frontmatter `tags`, the `summary` as standfirst, the baseline's mono
 * metadata row (author, date, reading time), a contents list built from the
 * headings `render()` actually emitted, and the body on one measure.
 *
 * Two rules the article files keep, and this page enforces:
 *
 * - **The markdown opens at `##`.** Its own `# ` line would be a second `h1`
 *   under the title the shell renders, so every article's top-level heading is
 *   `##` and the title carries the page.
 * - **The contents list is generated, never hand-written.** `BuildToc` reads the
 *   pipeline's own slugs, so an anchor can never drift from its heading, and an
 *   article below the heading floor gets no list at all.
 *
 * The diagram renderer mounts only for an article that carries a Mermaid fence:
 * the vendored SVGs cover the documentation pages, and an article's own diagram
 * is drawn by the client renderer, so loading it for the seven articles without
 * one would be weight nothing on the page uses.
 */
import { getCollection, render } from "astro:content";

import BlogArticle from "../../Component/Blog/BlogArticle.astro";
import {
	BuildAside,
	BuildNotes,
	BuildSummary,
	BuildToc,
	HasDiagram,
	ManualTargetFor,
	ReadTimeLabel,
	RegisterEmpty,
} from "../../Component/Blog/Data.js";
import { PieceInset } from "../../Content/Artifact/Inset.js";
import MermaidFallback from "../../Component/Dynamic/MermaidFallback.astro";
import { Header } from "../../Component/Layout/Header";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

export async function getStaticPaths() {
	const Entries = await getCollection("blog");

	return Entries.map((Entry) => ({
		params: { Slug: Entry.id },
		props: { Entry },
	}));
}

const { Entry } = Astro.props;
const { Content, headings } = await render(Entry);

const T = GetI18n();

const MetaTitle = `${Entry.data.title} | Code Editor Land`;
const MetaDescription = Entry.data.summary;

const TocLabel = T("article.toc", { ns: "blog", defaultValue: "On this page" });
const MinRead = T("card.minRead", { ns: "blog", defaultValue: "min read" });
const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const PageTitle = T("page.title", { ns: "blog", defaultValue: "Blog" });

/** The reading time, as the schema's number plus the site's unit. */
const ReadTime = ReadTimeLabel(Entry.data.readTime, MinRead);

const Toc = BuildToc(headings, TocLabel);
const Diagram = HasDiagram(Entry.body);

/**
 * The margin's four parts, derived from the article and the manual it points at.
 *
 * `Sections` counts the `##` headings the pipeline actually emitted, which is
 * the same list the register prints - so a piece that says "9 sections" has nine
 * anchors under it. `DocIds` is the manual's own collection, read here so the
 * note's destination is resolved at build time: a note that names a page the
 * build no longer contains prints the tombstone instead of a dead link.
 */
const Docs = await getCollection("doc");
const DocIds = Docs.map((Doc) => Doc.id);

const Sections = headings.filter((Heading) => Heading.depth === 2).length;
const Manual = ManualTargetFor(Entry.id, DocIds);
const Summary = BuildSummary(Entry, Sections, ReadTime);
const Notes = BuildNotes(Entry, Sections, Manual, Toc !== null);
const Aside = BuildAside(Entry);

/**
 * The margin's figure: the piece's own extent, counted from the file.
 *
 * It hangs above the notes because it is the one object in the margin that is
 * evidence rather than a claim about the piece - and because a reader who wants
 * to know how long the thing is should not have to scroll to find out.
 */
const Extent = PieceInset({
	title: Entry.data.title,
	body: Entry.body,
	sections: Sections,
	minutes: Entry.data.readTime,
	readTime: ReadTime,
	file: `SOURCE/CONTENT/BLOG/${Entry.id}.MD`,
});

/**
 * The trail above the article: the two surfaces it sits under, then its own
 * title. The crumbs print place names, not routes - the baseline's breadcrumb
 * read `Home / Blog / <title>`.
 */
const Trail = [
	{ label: Home, href: "/" },
	{ label: PageTitle, href: "/Blog" },
	{ label: Entry.data.title },
];
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load slot="Header" />

	<BlogArticle
		title={Entry.data.title}
		summary={Entry.data.summary}
		tags={Entry.data.tags}
		author={Entry.data.author}
		date={Entry.data.publishedAt}
		readTime={ReadTime}
		toc={Toc}
		trail={Trail}
		backLabel={PageTitle}
		backHref="/Blog"
		summaryRows={Summary}
		summaryRegister={`SUMMARY / ${String(Summary.length).padStart(2, "0")}`}
		notes={Notes}
		insets={[Extent]}
		aside={Aside}
		registerEmpty={RegisterEmpty}
	>
		<Content />
	</BlogArticle>

	{Diagram ? <MermaidFallback /> : null}
</Base>
