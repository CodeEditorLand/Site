---
import AuthShell from "../../Component/Auth/AuthShell.astro";
import Auth0CallbackHandler from "../../Component/Dynamic/Auth0CallbackHandler";
import { AuthFrameFor } from "../../Component/Auth/Data";
import {
	OAuthResult,
	type OAuthFailureCode,
} from "../../Content/Layout/OAuth.js";
import { Header } from "../../Component/Layout/Header";
import PageShell from "../../Component/Shell/PageShell.astro";
import ShellPlate from "../../Component/Shell/ShellPlate.astro";
import ShellState from "../../Component/Shell/ShellState.astro";
import { Row } from "../../Component/Surface/State";
import SurfaceState from "../../Component/Surface/SurfaceState.astro";
import Auth0ClientIdentifier from "../../Function/Configuration/Auth0ClientIdentifier.js";
import Auth0Domain from "../../Function/Configuration/Auth0Domain.js";
import Base from "../../Layout/Base.astro";
import { GetI18n, LoadServerNamespace } from "../../Library/I18n/Server";

/* The signed-in arm's word is `Account.json`'s own
   `auth.oauthSuccess.signedInStatus`; the four core bundles do not carry it. */
LoadServerNamespace("account");

const T = GetI18n();

/* The frame, as data: `/OAUTH CALLBACK`, the page's `h1`, one sentence. It has
   no alternate action because the page's two endings each carry their own -
   "Go to Dashboard" and "Back to Sign In" - and a third way out would be a
   second action on an artifact that has exactly one.

   **The frame is the shell's now.** This route used to print the frame itself,
   by hand, with `auth-shell__kicker` and `auth-shell__heading` on its own
   markup - the only credential route with no `AuthShell`, and the reason it had
   two `h1`s (one per state, only one of them ever visible). `AuthShell` prints
   the kicker, the single `h1` and the sentence above the card, exactly as it
   does on `/Account/SignIn`, `/Account/SignUp` and `/Verify`, so the five
   credential routes now open the same way. */
const Frame = AuthFrameFor("oauthSuccess", T);

const MetaTitle = T("meta.oauth.success", {
	defaultValue: "Authentication Successful - Code Editor Land",
});
const MetaDescription = T("meta.oauth.successDescription", {
	defaultValue: "You have been authenticated successfully.",
});

/* The three live arms' words. Each one is a state of the record, not a toast:
   the loading arm says what is being read, the success arm says what was
   written and for how long, and the failure arms are the register below. */
const CompletingText = T("common.oauth.completing", {
	defaultValue:
		"The provider has returned you here. The code in the query string is being exchanged for a session.",
});
const SuccessTitle = T("common.oauth.success.title", {
	defaultValue: "Session Written",
});
const SuccessRedirect = T("common.oauth.success.redirect", {
	defaultValue: "The dashboard opens next. The session lasts seven days.",
});
const GoToDashboardText = T("common.oauth.goToDashboard", {
	defaultValue: "OPEN THE DASHBOARD",
});

/* The four failure arms, resolved once. Every arm is printed into the document
   at build time and the script reveals the one the provider named - so the copy
   is server-rendered, translatable and readable with the script off, and no
   sentence is assembled in the browser. */
const Failure = OAuthResult(T);

const FailureCodes: readonly OAuthFailureCode[] = [
	"expired",
	"provider",
	"absent",
	"unknown",
];

/* The three states' words, from `State.ts`'s table through `Row()`: LOADING
   while the callback is read, ACTIVE once the session is written, INTERRUPTED
   when the provider returned an error. `SignedInStatus` is `Account.json`'s own
   `auth.oauthSuccess.signedInStatus`, so the word a reader sees here is the one
   the locale file already carried. */
const LoadingWords = [Row("STATUS", "LOADING")];
const SignedInWords = [
	Row(
		"STATUS",
		T("account:auth.oauthSuccess.signedInStatus", {
			defaultValue: "STATUS: ACTIVE",
		}),
	),
];
const ErrorWords = [Row("STATUS", "INTERRUPTED")];
---

<Base Title={MetaTitle} Description={MetaDescription} noIndex={true}>
	<!-- The baseline mounts the header with no `Mode`, so it renders on the
	     creme field rather than as a white bar (`Header` defaults to `minimal`);
	     the island stays `client:load` so the bar is in the first paint. -->
	<Header client:load slot="Header" />
	<Auth0CallbackHandler
		client:only="react"
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>

	<!--
		Three mutually exclusive states, toggled by the inline script below and
		by Auth0CallbackHandler through these ids. The card is the shell's - the
		baseline's one centred `max-w-md` panel, square, on the creme field - and
		each state carries its word through `SurfaceState`, so the state is a
		state of the record and not a spinner that happens to be on screen.
	-->
	<PageShell index="# PLATE_03" label="THE EXCHANGE">
		<AuthShell Label="Sign-in result" Frame={Frame}>
			<div
				id="LoadingState"
				class="flex flex-col items-center gap-4 p-8 text-center"
			>
				<SurfaceState states={LoadingWords} />

				{/*
				The loading arm, in the record grammar. It used to be a
				`animate-spin` div: a spinner says something is happening, and a
				skeleton says *what* is happening, because it prints the schema.
				The keys are known before the values are. `surface="bare"` because
				this state is printed inside the route's card - a white box inside
				a white card is a card in a card.
			*/}
				<ShellState
					surface="bare"
					kind="loading"
					index="EXCHANGE / 00"
					statement={CompletingText}
					cause={T("layout.oauth.loading.cause", {
						defaultValue:
							"The callback's query string, read in the browser.",
					})}
					keys={["CODE:", "STATE:", "SESSION:"]}
				/>
			</div>

			<div
				id="SuccessState"
				class="hidden flex-col items-center gap-4 p-8 text-center"
			>
				<SurfaceState states={SignedInWords} />

				<div class="flex h-12 w-12 items-center justify-center rounded-none border-2 border-[color:var(--Accent)] text-[color:var(--Accent)]">
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						height="24"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						width="24"
					>
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				</div>

				<h3 class="type-heading">{SuccessTitle}</h3>

				<p class="text-card-foreground">{SuccessRedirect}</p>

				<a
					href="/Dashboard"
					id="DashboardFallback"
					class="StaccatoButton mt-2 inline-flex h-10 items-center justify-center bg-primary px-4 py-2 font-medium text-primary-fg transition-all hover:opacity-90 focus:outline-2 focus:outline-[var(--Primary)] focus:outline-offset-2"
				>
					{GoToDashboardText}
					{"\u2001"}
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>

			<div id="ErrorState" class="hidden p-8">
				<SurfaceState states={ErrorWords} />

				<h3 class="type-heading mt-4 mb-6">{Failure.heading}</h3>

				{/*
				THE FAILURE REGISTER. Four arms, each a composed `error` state:
				`WHAT FAILED:` / `CAUSE:` / `RETRY:` and the three facts the callback
				actually holds. The script reveals the arm the provider named; the
				other three stay in the document, hidden, so the page states every
				way the exchange can end rather than the one that happened today.
				`surface="bare"` because this is printed inside the route's card.
			*/}
				{FailureCodes.map((Code, Position) => (
					<div class="oauth-failure" data-failure={Code} hidden>
						<ShellState
							surface="bare"
							kind="error"
							index={`FAILURE / ${String(Position + 1).padStart(2, "0")}`}
							statement={Failure.arms[Code].statement}
							cause={Failure.arms[Code].cause}
							note={Failure.arms[Code].note}
							rows={[
								{ key: "ARM:", value: Code.toUpperCase() },
								{
									key: "EXCHANGE:",
									value: "/OAUTH/SUCCESS",
									code: true,
								},
								{ key: "SESSION:", value: "NOT WRITTEN" },
							]}
							next={Failure.next}
						/>
					</div>
				))}
			</div>
		</AuthShell>

		{/*
			The page's one artifact, as a plate: the callback route the provider
			returns to. The card above reports what the exchange answered; this
			plate says where the answer arrives and who produced it, which is the
			one fact a reader looking at a sign-in result cannot otherwise check.

			`STATE: READY` is the honest word: the route is ready to receive the
			callback at build time, and the exchange itself is the browser's.
		*/}
		<ShellPlate
			index="01"
			figure={T("layout.oauth.plate.figure", {
				defaultValue: "THE CALLBACK ROUTE",
			})}
			source="AUTH0"
			state="READY"
			proposition={T("layout.oauth.plate.proposition", {
				defaultValue:
					"The provider returns here with a code; the exchange runs in the browser and the card above is its receipt.",
			})}
			trace={{
				mark: "\u2192",
				value: "/OAuth/Success",
				note: T("layout.oauth.plate.note", {
					defaultValue: "THE PROVIDER RETURNS HERE",
				}),
			}}
			height="clamp(11rem, 24vh, 17rem)"
		/>
	</PageShell>
</Base>

<script>
	function HandleOAuthSuccess(): void {
		const SearchParameters = new URLSearchParams(window.location.search);
		const Token = SearchParameters.get("token");
		const Code = SearchParameters.get("code");
		const ErrorParameter = SearchParameters.get("error");

		// Auth0 PKCE callback - let Auth0CallbackHandler React island handle it
		if (Code && !Token) return;

		const LoadingState = document.getElementById("LoadingState");
		const SuccessState = document.getElementById("SuccessState");
		const ErrorState = document.getElementById("ErrorState");

		if (ErrorParameter || !Token) {
			if (LoadingState) LoadingState.classList.add("hidden");
			if (ErrorState) ErrorState.classList.remove("hidden");

			// The arm the provider named, from the same mapping the page was
			// built with: `invalid_state` is a spent state parameter,
			// `oauth_failed` is the provider refusing, any other error is
			// unnamed, and no error with no token is an empty callback.
			const Arm = ErrorParameter
				? ErrorParameter === "invalid_state"
					? "expired"
					: ErrorParameter === "oauth_failed"
						? "provider"
						: "unknown"
				: "absent";

			document
				.querySelectorAll<HTMLElement>("[data-failure]")
				.forEach((Element) => {
					Element.hidden = Element.dataset.failure !== Arm;
				});

			return;
		}

		// Store token in cookie and localStorage
		try {
			document.cookie = `session=${Token}; path=/; max-age=${7 * 24 * 60 * 60}; SameSite=Strict`;
		} catch {
			// Cookie API not available
		}
		localStorage.setItem("session_token", Token);

		// Write token to service worker auth cache so the SW auth gate
		// on /Dashboard lets the navigation through.
		const WriteToServiceWorker = (): Promise<void> => {
			return new Promise<void>((Resolve) => {
				if (!navigator.serviceWorker?.controller) {
					Resolve();
					return;
				}
				let UserId = "";
				try {
					const Payload = JSON.parse(
						atob(Token.split(".")[1] ?? "e30="),
					) as Record<string, unknown>;
					UserId =
						(Payload["sub"] as string) ||
						(Payload["user_id"] as string) ||
						"";
				} catch {
					// non-JWT token - UserId stays empty
				}
				const Timeout = setTimeout(Resolve, 5000);
				const OnMessage = (Event: MessageEvent) => {
					if (Event.data?.Type === "Auth:Written") {
						clearTimeout(Timeout);
						navigator.serviceWorker.removeEventListener(
							"message",
							OnMessage,
						);
						Resolve();
					}
				};
				navigator.serviceWorker.addEventListener("message", OnMessage);
				navigator.serviceWorker.controller.postMessage({
					Type: "Auth:Write",
					Token,
					ExpiresAt: Date.now() + 7 * 24 * 60 * 60 * 1000,
					UserId,
				});
			});
		};

		// Show success state
		if (LoadingState) LoadingState.classList.add("hidden");
		if (SuccessState) {
			SuccessState.classList.remove("hidden");
			SuccessState.classList.add("flex");
		}

		// Write to SW then redirect (SW write runs during the 2-second display)
		WriteToServiceWorker().then(() => {
			window.location.href = "/Dashboard";
		});
	}

	HandleOAuthSuccess();
</script>
