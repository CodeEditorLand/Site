---
import AuthShell from "../../Component/Auth/AuthShell.astro";
import { AuthFrameFor } from "../../Component/Auth/Data";
import Auth0CallbackHandler from "../../Component/Dynamic/Auth0CallbackHandler";
import { Header } from "../../Component/Layout/Header";
import Auth0ClientIdentifier from "../../Function/Configuration/Auth0ClientIdentifier.js";
import Auth0Domain from "../../Function/Configuration/Auth0Domain.js";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.oauth.success", {
	defaultValue: "Authentication Successful - Code Editor Land",
});
const MetaDescription = T("meta.oauth.successDescription", {
	defaultValue: "You have been authenticated successfully.",
});

const CompletingText = T("common.oauth.completing", {
	defaultValue: "Completing sign-in...",
});
const CompletingSentence = T("auth.oauthSuccess.completingSentence", {
	defaultValue:
		"Your identity provider has returned you to Land. This page continues once the session is written.",
});
const SignedInStatus = T("auth.oauthSuccess.signedInStatus", {
	defaultValue: "SIGNED IN",
});
const SuccessTitle = T("common.oauth.success.title", {
	defaultValue: "You're signed in",
});
const SuccessRedirect = T("common.oauth.success.redirect", {
	defaultValue: "Redirecting to your dashboard...",
});
const FailedText = T("common.oauth.failed", {
	defaultValue: "Sign-In Failed",
});
const ErrorGenericText = T("common.oauth.errorGeneric", {
	defaultValue: "Something went wrong during sign-in. Please try again.",
});
const BackToSignInText = T("common.oauth.backToSignIn", {
	defaultValue: "Back to Sign In",
});
const GoToDashboardText = T("common.oauth.goToDashboard", {
	defaultValue: "Go to Dashboard",
});

const Frame = AuthFrameFor("oauthSuccess", T);
---

<Base Title={MetaTitle} Description={MetaDescription} noIndex={true}>
	<Header client:only="react" />
	<Auth0CallbackHandler
		client:only="react"
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>
	<AuthShell frame={Frame}>
		<!--
			Three mutually exclusive states, toggled by the inline script below and
			by Auth0CallbackHandler through these ids. Each states what it is, what
			happened, and what the reader can do - never a bare "Success".
		-->
		<div id="LoadingState" class="auth-shell__report" role="status">
			<p class="auth-shell__status">{CompletingText}</p>
			<p class="auth-shell__report-sentence">{CompletingSentence}</p>
		</div>

		<div id="SuccessState" class="auth-shell__report hidden">
			<p class="auth-shell__status auth-shell__status--success">
				{SignedInStatus}
			</p>
			<p class="auth-shell__report-sentence">
				{SuccessTitle}. {SuccessRedirect}
			</p>
			<a
				href="/Dashboard"
				id="DashboardFallback"
				class="auth-shell__primary emphasis-expressive"
			>
				{GoToDashboardText}
				{"\u2001"}
				<span aria-hidden="true">&rarr;</span>
			</a>
		</div>

		<div id="ErrorState" class="auth-shell__report hidden">
			<p class="auth-shell__status auth-shell__status--failure">
				{FailedText}
			</p>
			<p id="ErrorMessage" class="auth-shell__report-sentence">
				{ErrorGenericText}
			</p>
			<a
				href="/Account/SignIn"
				class="auth-shell__primary emphasis-expressive"
			>
				{BackToSignInText}
				{"\u2001"}
				<span aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</AuthShell>
</Base>

<script>
	function HandleOAuthSuccess(): void {
		const SearchParameters = new URLSearchParams(window.location.search);
		const Token = SearchParameters.get("token");
		const Code = SearchParameters.get("code");
		const ErrorParameter = SearchParameters.get("error");

		// Auth0 PKCE callback - let Auth0CallbackHandler React island handle it
		if (Code && !Token) return;

		const LoadingState = document.getElementById("LoadingState");
		const SuccessState = document.getElementById("SuccessState");
		const ErrorState = document.getElementById("ErrorState");
		const ErrorMessage = document.getElementById("ErrorMessage");

		if (ErrorParameter || !Token) {
			if (LoadingState) LoadingState.classList.add("hidden");
			if (ErrorState) ErrorState.classList.remove("hidden");
			if (ErrorMessage) {
				ErrorMessage.textContent =
					ErrorParameter === "invalid_state"
						? "Authentication session expired. Please try again."
						: ErrorParameter === "oauth_failed"
							? "OAuth provider returned an error. Please try again."
							: "No authentication token received.";
			}
			return;
		}

		// Store token in cookie and localStorage
		try {
			document.cookie = `session=${Token}; path=/; max-age=${7 * 24 * 60 * 60}; SameSite=Strict`;
		} catch {
			// Cookie API not available
		}
		localStorage.setItem("session_token", Token);

		// Write token to service worker auth cache so the SW auth gate
		// on /Dashboard lets the navigation through.
		const WriteToServiceWorker = (): Promise<void> => {
			return new Promise<void>((Resolve) => {
				if (!navigator.serviceWorker?.controller) {
					Resolve();
					return;
				}
				let UserId = "";
				try {
					const Payload = JSON.parse(
						atob(Token.split(".")[1] ?? "e30="),
					) as Record<string, unknown>;
					UserId =
						(Payload["sub"] as string) ||
						(Payload["user_id"] as string) ||
						"";
				} catch {
					// non-JWT token - UserId stays empty
				}
				const Timeout = setTimeout(Resolve, 5000);
				const OnMessage = (Event: MessageEvent) => {
					if (Event.data?.Type === "Auth:Written") {
						clearTimeout(Timeout);
						navigator.serviceWorker.removeEventListener(
							"message",
							OnMessage,
						);
						Resolve();
					}
				};
				navigator.serviceWorker.addEventListener("message", OnMessage);
				navigator.serviceWorker.controller.postMessage({
					Type: "Auth:Write",
					Token,
					ExpiresAt: Date.now() + 7 * 24 * 60 * 60 * 1000,
					UserId,
				});
			});
		};

		// Show success state
		if (LoadingState) LoadingState.classList.add("hidden");
		if (SuccessState) {
			SuccessState.classList.remove("hidden");
			SuccessState.classList.add("flex");
		}

		// Write to SW then redirect (SW write runs during the 2-second display)
		WriteToServiceWorker().then(() => {
			window.location.href = "/Dashboard";
		});
	}

	HandleOAuthSuccess();
</script>
