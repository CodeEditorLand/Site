---
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const t = GetI18n();

const MetaTitle = t("common.error.404", {
	defaultValue: "404 - Page Not Found",
});
const MetaDescription = t("common.error.pageNotFound", {
	defaultValue: "The page you're looking for doesn't exist.",
});
---

<Base Title={MetaTitle} Description={MetaDescription} noIndex={true}>
	<section class="py-20" aria-label="Page not found">
		<div class="container mx-auto px-4 text-center">
			<h1 class="mb-4 text-6xl font-bold">404</h1>
			<p class="mb-8 text-xl text-muted-foreground">
				{
					t("common.error.pageNotFound", {
						defaultValue: "Page not found",
					})
				}
			</p>
			<a
				href="/"
				class="inline-flex h-10 items-center justify-center gap-2 border border-[var(--border)] bg-[var(--primary)] px-4 py-2 text-sm font-medium text-white transition-all hover:opacity-90 focus:outline-2 focus:outline-offset-2 focus:outline-[var(--primary)]">
				&larr; {
					t("common.button.backToHome", {
						defaultValue: "Back to Home",
					})
				}
			</a>
		</div>
	</section>
</Base>
