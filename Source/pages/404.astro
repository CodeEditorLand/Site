---
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("common.error.404", {
	defaultValue: "404 - Page Not Found",
});
const MetaDescription = T("common.error.pageNotFound", {
	defaultValue: "The page you're looking for doesn't exist.",
});
---

<Base Title={MetaTitle} Description={MetaDescription} noIndex={true}>
	<Header client:load />
	<section id="NotFoundContent" class="py-20" aria-label="Page not found">
		<div class="container mx-auto px-4 text-center">
			<p id="RouteRedirectNotice" class="mb-4 text-sm text-muted-foreground hidden">
				Redirecting...
			</p>
			<h1 class="StaccatoJitter mb-4 text-6xl font-bold">404</h1>
			<p class="StaccatoBreath mb-8 text-xl text-muted-foreground">
				{
					T("common.error.pageNotFound", {
						defaultValue: "Page not found",
					})
				}
			</p>
			<a
				href="/"
				class="StaccatoButton inline-flex h-10 items-center justify-center gap-2 border border-[var(--Border)] bg-[var(--Primary)] px-4 py-2 text-sm font-medium text-white transition-all hover:opacity-90 focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
				{
					T("common.button.backToHome", {
						defaultValue: "Back to Home",
					})
				}&#x2001;&rarr;
			</a>
		</div>
	</section>

	<script>
		const Notice = document.getElementById("RouteRedirectNotice");

		if (Notice) {
			Notice.classList.remove("hidden");
		}

		const RedirectFromRouteMap = (
			await import("@Function/Route/Redirect.js")
		).default;

		await RedirectFromRouteMap();

		if (Notice) {
			Notice.classList.add("hidden");
		}
	</script>
</Base>
