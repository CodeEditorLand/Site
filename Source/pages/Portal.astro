---
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";
import RecordBand from "../Component/Record/RecordBand.astro";
import RecordEntry from "../Component/Record/RecordEntry.astro";
import RecordFigure from "../Component/Record/RecordFigure.astro";
import RecordLedger from "../Component/Record/RecordLedger.astro";
import RecordMatrix from "../Component/Record/RecordMatrix.astro";
import RecordStage from "../Component/Record/RecordStage.astro";
import SurfaceShell from "../Component/Surface/SurfaceShell.astro";
import SurfaceState from "../Component/Surface/SurfaceState.astro";
import { Split } from "../Component/Surface/State.js";
import { PortalPage } from "../Content/Surface/Portal.js";

const T = GetI18n();

const MetaTitle = T("meta.portal.title", {
	defaultValue: "Editor Portal | Code Editor Land",
});
const MetaDescription = T("meta.portal.description", {
	defaultValue:
		"CodeEditorLand account sign-in and planned portal modes for cloud, provider, local-first, and enterprise workflows.",
});

// Every fact on the page comes from this table: the four tiers, their
// protocols, their feature and capability copy, and the four sign-in links.
// The page owns the band order and nothing else.
const Page = PortalPage(T);

/**
 * The page's status block, split into states and facts.
 *
 * `DesignSystem-Components.md` §7: a status that renders exactly like an
 * ordinary fact has lost its state. `STATUS: PLANNED` is the page's one state at
 * the top, and each tier states the same word about itself, so both are lifted
 * into the register that carries the marker. Nothing is re-worded: `Split` reads
 * the values the content table already wrote and separates them by the
 * vocabulary in `Surface/State.ts`.
 */
const Status = Split(Page.status);

/** Each tier with its own facts split the same way, so a tier's state carries a marker too. */
const Tiers = Page.tiers.map((Tier) => ({ ...Tier, parts: Split(Tier.facts) }));
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<!-- Portal is the auth gateway itself; use the plain header so the
	 Auth0-aware DynamicAuthHeader does not place a "Sign In" link on
	 the auth-selection page, and more importantly does not instantiate
	 Auth0AccountGate (which auto-calls loginWithRedirect() on mount). -->
	<Header client:load Mode="functional" slot="Header" />

	<SurfaceShell
		index={Page.index}
		title={Page.title}
		standfirst={Page.standfirst}
		states={Status.states}
		rows={Status.facts}
	>
		<RecordBand band={Page.roadmap}>
			<RecordStage stages={Page.stages} />
			<div class="surface__panel">
				<RecordFigure
					src="/Evidence/Land/NightGlass-01.png"
					alt="Rain-speckled glass reflecting a green light at night"
					caption="Rain-speckled glass reflecting a green light at night."
					provenance={"PORTAL_01\u2001EVIDENCE"}
				/>
			</div>
		</RecordBand>

		{
			Tiers.map((Tier) => (
				<RecordBand band={Tier.band}>
					{Tier.rest.map((Line) => (
						<p class="surface__prose">{Line}</p>
					))}
					<div class="surface__panel">
						<SurfaceState states={Tier.parts.states} />
						<RecordLedger rows={Tier.parts.facts} />
					</div>
					<div class="surface__stack">
						{Tier.features.map((Feature) => (
							<RecordEntry {...Feature} />
						))}
					</div>
					<div class="surface__panel">
						<RecordMatrix
							columns={Page.capabilityColumns}
							rows={Tier.capabilities}
							caption={`${Tier.title} capabilities`}
						/>
					</div>
				</RecordBand>
			))
		}

		<RecordBand band={Page.actions}>
			<div class="surface__stack">
				{
					Page.decisions.map((Decision) => (
						<RecordEntry {...Decision} />
					))
				}
			</div>
		</RecordBand>
	</SurfaceShell>
</Base>
