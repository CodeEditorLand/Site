---
/**
 * Download - the installation contract: can I install this today, and if not,
 * what can I do instead?
 *
 * The page is one artifact, opened by the keeper masthead:
 *
 *   1. masthead        the page's one h1, its answer in one sentence, the
 *                      lifecycle register (`LIFECYCLE: PLANNED`), eight marks
 *   2. `#release-manifest` - the `# RELEASE_01` record: its head (index, seal,
 *                      claim, channel, state, and the release's own ledger), then
 *                      the seven regions the artifact continues into, then the
 *                      colophon that says what it does not carry and where every
 *                      figure came from
 *
 * The regions are the sceptic's questions, in order:
 *
 *   /POSITION       how far along the line from source to signed artifact
 *   /PLATFORMS      what each target's artifact state is today - the matrix
 *   /EVIDENCE       what the release has a picture of: one verified plate beside
 *                   the three screens the manual documents and does not photograph
 *   /REQUIREMENTS   what a build needs, minimum and recommended, plus the toolchain
 *   /INSTALL        the only install path that exists: two build wells, the run
 *                   command each platform documents, the one action - and the
 *                   build session as a transcript
 *   /VERIFY         the checksum and signature record, the check as a template,
 *                   and the edition stamp the record is issued under
 *   /TRANSPARENCY   the telemetry disclosure, as the region's body
 *   /PREVIOUS       the releases before this one, as a closed disclosure
 *
 * One record, one index, one seal, one h2. The baseline printed the index on
 * three cards and the same six fields on each, which read as three releases; the
 * artifact now prints its release-level facts once (in the head) and its
 * platform-level facts once per target (in the matrix and the run entries). The
 * regions are parts of one subject, so they separate at `--space-group` and the
 * chapter distance is spent once, between the masthead and the record.
 *
 * Every row, label and figure lives in `Component/Dynamic/Download/Data.ts`,
 * every block is a component, and this page owns the artifact order and nothing
 * else (BRIDGE §2.1).
 *
 * The disclosure is still a `.tsx` island (`DynamicTransparency`) and it keeps
 * its body, its markup and its hydrating noise. What it no longer prints is its
 * own centred heading: the region supplies `/TRANSPARENCY`, the h3 and the
 * standfirst, so the record keeps the page's only h2 and the island is the
 * region's body rather than a second chapter. The page hands it the
 * `download-transparency` class so `Download/_Page.scss` can take off the
 * padding it gives itself - the record's own rhythm owns the distance.
 */
import DownloadMasthead from "../Component/Dynamic/DownloadMasthead.astro";
import Install from "../Component/Dynamic/Download/Install.astro";
import PlatformMatrix from "../Component/Dynamic/Download/PlatformMatrix.astro";
import PreviousReleases from "../Component/Dynamic/Download/PreviousReleases.astro";
import Record from "../Component/Dynamic/Download/Record.astro";
import Region from "../Component/Dynamic/Download/Region.astro";
import RecordAside from "../Component/Record/RecordAside.astro";
import RecordCompare from "../Component/Record/RecordCompare.astro";
import BandFoot from "../Component/Detail/BandFoot.astro";
import RecordPlate from "../Component/Record/RecordPlate.astro";
import RecordPlateSet from "../Component/Record/RecordPlateSet.astro";
import RecordStamp from "../Component/Record/RecordStamp.astro";
import RecordTranscript from "../Component/Record/RecordTranscript.astro";
import Requirements from "../Component/Dynamic/Download/Requirements.astro";
import Verify from "../Component/Dynamic/Download/Verify.astro";
import { ReleasePlate, ReleasePlateSet } from "../Content/Artifact/Plate.js";
import { BuildSession } from "../Content/Artifact/Session.js";
import { ReleaseStamp } from "../Content/Artifact/Stamp.js";
import { DynamicTransparency } from "../Component/Dynamic/DynamicTransparency";
import {
	BuildSteps,
	InstallAction,
	Ladder,
	Manifest,
	Marks,
	OperatingSystems,
	Platforms,
	PlatformTable,
	PreviousReleases as PreviousReleasesData,
	Regions,
	ReleaseCaption,
	ReleaseColumns,
	ReleaseFacts,
	Requirements as RequirementsData,
	SourceAssumptions,
	Toolchain,
	Transparency,
	Verification,
	VerificationWell,
} from "../Component/Dynamic/Download/Data";
import { Header } from "../Component/Layout/Header";
import { SurfaceLives } from "../Content/Surface/Life.js";
import Base from "../Layout/Base.astro";
import { GetI18n, LoadServerNamespace } from "../Library/I18n/Server";

/* The whole record reads `download:` - the masthead, the six regions, the
   manifest, the ladder, the install well and the previous-releases plate.
   Declared before `GetI18n()` because `Client.ts` has already initialised the
   shared instance on this route. */
LoadServerNamespace("download");

const T = GetI18n();

/** The record's six regions, in the order a sceptic asks. */
const RegionCopy = Regions(T);

/** The page's meta, from the site's own keys. */
const MetaTitle = T("meta.downloads.title", {
	defaultValue:
		"Download Code Editor Land | Source Builds and Public Release Prep",
});
const MetaDescription = T("meta.downloads.description", {
	defaultValue:
		"Code Editor Land source builds target macOS, Windows, and Linux. Public installers, signing, and verification artifacts are still being prepared.",
});
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load Mode="functional" slot="Header" />

	<DownloadMasthead
		title={T("download:page.title", { defaultValue: "Download Land" })}
		sentence={T("download:status.sentence", {
			defaultValue:
				"Nothing here is downloadable yet. Land builds from source on macOS, Windows and Linux; public installers, signing and verification artifacts are still in preparation.",
		})}
		marks={Marks}
		life={SurfaceLives.DOWNLOAD.term}
		lifeNote={SurfaceLives.DOWNLOAD.source}
	/>

	<Record record={Manifest(T)} release={ReleaseFacts(T)}>
		<Region region={RegionCopy.Ladder}>
			<RecordCompare compare={Ladder()} />
		</Region>

		<Region region={RegionCopy.Platforms}>
			<PlatformMatrix matrix={PlatformTable(T)} />
		</Region>

		{/* The evidence spread: one verified plate beside the set of screens the
		    manual documents and the build does not photograph. Two artifacts of
		    one subject, one hairline gutter - the endorsed hero pair's model at
		    block scale, and the only place on the site the two plate forms meet. */}
		<Region region={RegionCopy.Evidence}>
			<div class="record-spread">
				<div class="record-spread__plate">
					<RecordPlate plate={ReleasePlate} />
				</div>
				<div class="record-spread__gutter" aria-hidden="true" />
				<div class="record-spread__set">
					<RecordPlateSet set={ReleasePlateSet} />
				</div>
			</div>
		</Region>

		<Region region={RegionCopy.Requirements}>
			<Requirements
				panels={RequirementsData(T)}
				osLabel={T("download:systemRequirements.supportedOS", {
					defaultValue: "Supported Operating Systems",
				})}
				operatingSystems={OperatingSystems(T)}
				toolchain={Toolchain}
				toolchainLabel={T("download:requirements.toolchain", {
					defaultValue: "BUILD TOOLCHAIN (SOURCE)",
				})}
			/>
			<RecordAside aside={SourceAssumptions} />
		</Region>

		<Region region={RegionCopy.Install}>
			<Install
				steps={BuildSteps(T)}
				platforms={Platforms(T)}
				action={InstallAction}
			/>
			{/* The session the manual documents, beside the wells it quotes: the
			    wells are what you type, the transcript is what happened when it
			    was typed - turns, speakers, and the manual's own answers. */}
			<div class="download-region__apparatus">
				<RecordTranscript transcript={BuildSession} />
			</div>
		</Region>

		<Region region={RegionCopy.Verify}>
			<Verify rows={Verification(T)} well={VerificationWell} />
			{/* The mark the verification record is issued under. A stamp with no
			    authority is a decoration; this one names /Verify itself. */}
			<div class="download-region__apparatus">
				<RecordStamp stamp={ReleaseStamp} />
			</div>
		</Region>

		<Region region={RegionCopy.Transparency}>
			<DynamicTransparency
				Content={Transparency()}
				ClassName="download-transparency"
				client:load
			/>
		</Region>

		<Region region={RegionCopy.Previous}>
			<PreviousReleases
				releases={PreviousReleasesData}
				columns={ReleaseColumns}
				label={T("download:previousReleases.state", {
					defaultValue: "RECORD: EMPTY",
				})}
				empty={T("download:previousReleases.description", {
					defaultValue:
						"No public releases yet. Older versions will appear here once public releases ship.",
				})}
				caption={ReleaseCaption}
			/>
		</Region>

		{/* The edition's foot: the same release read as a board, as a manual and
		    as an index, then where in the document the reader has got to. The
		    figure is the artifact count the platform region prints - zero, which
		    is a measurement and not an absence. No as-of: nothing is published,
		    so there is no date at which anything was true. */}
		<BandFoot
			slot="foot"
			index="03"
			part="/THE EDITION"
			see={[
				{
					route: "/STATUS",
					href: "/Status",
					reason: "the same edition read as a board: every record's state, in the vocabulary",
				},
				{
					route: "/DOC",
					href: "/Doc",
					reason: "the manual for building from source, which is what this edition offers today",
				},
				{
					route: "/CONTENTS",
					href: "/Contents",
					reason: "the index: where this record sits in the document, and what else is in it",
				},
			]}
			figure={{ value: "0", unit: "ARTIFACTS" }}
			source="SOURCE/COMPONENT/DYNAMIC/DOWNLOAD/DATA.TS"
		/>
	</Record>
</Base>
