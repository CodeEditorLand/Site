			Description:
				"Full debug symbols for stepping through code. Three profiles: Browser, Mountain, and Electron.",
			Icon: "Code",
			Command: "bash Maintain/Debug/Build.sh --profile debug-mountain",
			Feature: [
				"Debug Symbols",
				"3 Profiles",
				"Source Maps",
				"File Watch",
			],
		},
		{
			Identifier: "production-release",
			Name: "Release Build",
			Description:
				"Optimized release packaging path. Public signing and verification artifacts are still being prepared.",
			Icon: "Server",
			Command: "bash Maintain/Release/Build.sh --profile production",
			Feature: [
				"Optimized",
				"Signing Planned",
				"Clean Build",
				"Packaged",
			],
		},
		{
			Identifier: "web-only",
			Name: "Web Deployment",
			Description:
				"Run Land in the browser without installing anything. No native shell needed.",
			Icon: "Layers",
			Command: "bash Maintain/Release.sh --profile web-browser",
			Feature: ["No Install", "Browser Only", "Web Deploy", "OXC Bundled"],
		},
	],
	MatrixPermutation: 16,
	SourceURL: "https://github.com/CodeEditorLand/Land",
} as const;

const MetaTitle = T("meta.downloads.title", {
	defaultValue:
		"Download Code Editor Land | Source Builds and Public Release Prep",
});
const MetaDescription = T("meta.downloads.description", {
	defaultValue:
		"Code Editor Land source builds target macOS, Windows, and Linux. Public installers, signing, and verification artifacts are still being prepared.",
});
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load Mode="functional" slot="Header" />

	<DownloadMasthead
		title={T("download:page.title", { defaultValue: "Download Land" })}
		sentence={T("download:status.sentence", {
			defaultValue:
				"Nothing here is downloadable yet. Land builds from source on macOS, Windows and Linux; public installers, signing and verification artifacts are still in preparation.",
		})}
		marks={Marks}
	/>

	<DynamicReleaseManifest
		record={Record}
		platforms={ManifestPlatforms(T)}
		verification={Verification(T)}
		verificationHeading={T("download:verification.title", {
			defaultValue: "Verification Will Ship With Public Releases.",
		})}
		empty={T("download:manifest.empty", {
			defaultValue: "No release published yet.",
		})}
		build={{
			label: T("download:status.well", {
				defaultValue: "BUILD FROM SOURCE",
			}),
			language: "sh",
			lines: BuildLines,
		}}
	/>

	<RecordBand band={Band.Requirements}>
		<DynamicSystemRequirements
			platforms={Requirements(T)}
			toolchain={Toolchain}
			toolchainLabel={T("download:requirements.toolchain", {
				defaultValue: "BUILD TOOLCHAIN (SOURCE)",
			})}
		/>
	</RecordBand>

	<RecordBand band={Band.Previous}>
		<DynamicPreviousReleases
			releases={PreviousReleases}
			columns={ReleaseColumns}
			label={T("download:previousReleases.state", {
				defaultValue: "RECORD: EMPTY",
			})}
			empty={T("download:previousReleases.description", {
				defaultValue:
					"No public releases yet. Older versions will appear here once public releases ship.",
			})}
		/>
	</RecordBand>

	<RecordBand band={Band.Transparency}>
		<DynamicTransparency
			Content={TransparencyContent}
			ClassName="download-transparency"
			client:load
		/>
	</RecordBand>
</Base>
