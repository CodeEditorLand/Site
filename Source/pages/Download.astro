---
import { DownloadsPage } from "../Component/Dynamic/DownloadsPage";
import { DynamicTransparency } from "../Component/Dynamic/DynamicTransparency";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const TransparencyContent = {
	Title: T("download.transparency.title", {
		defaultValue: "Nothing Hidden. Full Build Disclosure.",
	}),
	Subtitle: T("download.transparency.subtitle", {
		defaultValue:
			"Zero telemetry by default. Build variants, deployment targets, and signing keys are all public.\n\nVerify everything in source.",
	}),
	Policy: [
		{
			Identifier: "no-telemetry-default",
			Title: "Your editor never phones home",
			Description:
				"Production builds ship with telemetry completely disabled. Not just off by default. Absent from the binary entirely.",
			Icon: "EyeOff",
			Status: "Disabled" as const,
			Detail: "Telemetry is a Cargo feature flag, not in default features. Must be explicitly opted in at compile time.",
		},
		{
			Identifier: "no-crash-reporter",
			Title: "Errors stay on your machine",
			Description:
				"No crash reporter, no external error endpoints, no silent uploads. When something goes wrong, the data stays local.",
			Icon: "Shield",
			Status: "Disabled" as const,
			Detail: "CC0-licensed Code-OSS base with all Microsoft telemetry endpoints removed.",
		},
		{
			Identifier: "no-phone-home",
			Title: "No analytics. Period.",
			Description:
				"No usage tracking, no analytics endpoints. You don't need DO_NOT_TRACK because there is nothing to track.",
			Icon: "Lock",
			Status: "Disabled" as const,
		},
		{
			Identifier: "zero-cost-noop",
			Title: "Zero performance cost",
			Description:
				"Disabled telemetry compiles to nothing. No runtime branches, no empty function calls. The code is not even in the binary.",
			Icon: "Zap",
			Status: "Active" as const,
			Detail: "Rust cfg(feature) gates eliminate dead code at compile time.",
		},
		{
			Identifier: "opt-in-otel",
			Title: "Opt in when you want observability",
			Description:
				"Need traces? Enable OpenTelemetry with a compile flag. Metrics, spans, and distributed tracing. All data stays on your infrastructure.",
			Icon: "Eye",
			Status: "Optional" as const,
			Detail: "cargo build --features Telemetry\nSub-features: MetricsCollection, DistributedTracing.",
		},
		{
			Identifier: "effect-ts-local",
			Title: "Extension host metrics stay local",
			Description:
				"The Cocoon extension host collects internal timing for RPC and bootstrap. Nothing leaves the process. Mock layer available for testing.",
			Icon: "Layers",
			Status: "Active" as const,
			Detail: "Effect-TS TelemetryService with TelemetryMock layer for zero-overhead testing.",
		},
	],
	Variant: [
		{
			Identifier: "debug",
			Name: "debug",
			Tier: "Debug" as const,
			Workbench: "Browser",
			Feature: "70-80%",
			Status: "Available" as const,
		},
		{
			Identifier: "debug-mountain",
			Name: "debug-mountain",
			Tier: "Debug" as const,
			Workbench: "Mountain",
			Feature: "80-90%",
			Status: "Recommended" as const,
		},
		{
			Identifier: "debug-electron",
			Name: "debug-electron",
			Tier: "Debug" as const,
			Workbench: "Electron",
			Feature: "95%+",
			Status: "Legacy" as const,
		},
		{
			Identifier: "production",
			Name: "production",
			Tier: "Release" as const,
			Workbench: "Mountain",
			Feature: "80-90%",
			Status: "Recommended" as const,
		},
		{
			Identifier: "release",
			Name: "release",
			Tier: "Release" as const,
			Workbench: "Mountain",
			Feature: "100%",
			Status: "Available" as const,
		},
		{
			Identifier: "web-browser",
			Name: "web-browser",
			Tier: "Release" as const,
			Workbench: "Browser",
			Feature: "70-80%",
			Status: "Available" as const,
		},
		{
			Identifier: "bundler-preparation",
			Name: "bundler-preparation",
			Tier: "Build" as const,
			Workbench: "-",
			Feature: "-",
			Status: "Available" as const,
		},
		{
			Identifier: "swc-bundle",
			Name: "swc-bundle",
			Tier: "Build" as const,
			Workbench: "-",
			Feature: "-",
			Status: "Experimental" as const,
		},
		{
			Identifier: "oxc-bundle",
			Name: "oxc-bundle",
			Tier: "Build" as const,
			Workbench: "-",
			Feature: "-",
			Status: "Experimental" as const,
		},
	],
	Strategy: [
		{
			Identifier: "dev-hot-reload",
			Name: "Development",
			Description:
				"Change a file, see it instantly. Hot-reload in Tauri with the Sky dev server. No manual rebuilds needed.",
			Icon: "Zap",
			Command: "bash Maintain/Dev-Mountain.sh",
			Feature: [
				"Hot Reload",
				"Instant Preview",
				"Dev Server",
				"No Bundling",
			],
		},
		{
			Identifier: "debug-build",
			Name: "Debug Build",
			Description:
				"Full debug symbols for stepping through code. Three profiles: Browser, Mountain, and Electron.",
			Icon: "Code",
			Command: "bash Maintain/Debug/Build.sh --profile debug-mountain",
			Feature: [
				"Debug Symbols",
				"3 Profiles",
				"Source Maps",
				"File Watch",
			],
		},
		{
			Identifier: "production-release",
			Name: "Release Build",
			Description:
				"Optimized, signed, and ready to ship. Full bundling with PGP signatures for every artifact.",
			Icon: "Server",
			Command: "bash Maintain/Release/Build.sh --profile production",
			Feature: ["Optimized", "PGP Signed", "Clean Build", "Packaged"],
		},
		{
			Identifier: "web-only",
			Name: "Web Deployment",
			Description:
				"Run Land in the browser without installing anything. No native shell needed.",
			Icon: "Layers",
			Command: "bash Maintain/Release.sh --profile web-browser",
			Feature: [
				"No Install",
				"Browser Only",
				"Web Deploy",
				"OXC Bundled",
			],
		},
	],
	MatrixPermutation: 16,
	SourceURL: "https://github.com/CodeEditorLand/Land",
} as const;

// For static generation, we'll provide empty platforms - DynamicPlatformGrid will fetch from API
const DownloadContent = {
	PlatformGrid: {
		Title: T("download.page.title", { defaultValue: "Download Land" }),
		Subtitle: T("download.page.subtitle", {
			defaultValue:
				"Native on macOS, Windows, and Linux.\n\nZero cost, zero tracking, full VS Code extension support.",
		}),
		Platforms: [], // Will be fetched by DynamicPlatformGrid
		ShowVerification: true,
		OnDownload: async (Platform: { Name: string; Id?: string }) => {
			if (Platform.Id) {
				try {
					const { default: DownloadAPI } =
						await import("../Library/API/Download");
					const Information = await DownloadAPI.GetInfo(Platform.Id);
					window.open(Information.downloadUrl, "_blank");
					await DownloadAPI.TrackDownload(Platform.Id);
				} catch (DownloadError) {
					console.error("Download failed:", DownloadError);
				}
			}
		},
	},
	SystemRequirements: {
		Title: T("download.systemRequirements.title", {
			defaultValue: "System Requirements",
		}),
		Description: T("download.systemRequirements.subtitle", {
			defaultValue:
				"A quick check before you download saves a reinstall later.",
		}),
		Requirements: {
			Minimum: [
				{
					Id: "cpu-min",
					Label: "Processor",
					Value: "Intel Core i5 or AMD Ryzen 5 / Apple Silicon",
				},
				{ Id: "ram-min", Label: "Memory", Value: "4 GB RAM" },
				{ Id: "disk-min", Label: "Disk Space", Value: "500 MB" },
			],
			Recommended: [
				{
					Id: "cpu-rec",
					Label: "Processor",
					Value: "Intel Core i7 or AMD Ryzen 7",
				},
				{ Id: "ram-rec", Label: "Memory", Value: "8 GB RAM" },
				{ Id: "disk-rec", Label: "Disk Space", Value: "1 GB SSD" },
			],
		},
		Os: [
			"macOS 11+",
			"Windows 10+",
			"Ubuntu 20.04+ / Fedora 35+ / Debian 11+",
		],
	},
	VerificationInfo: {
		Title: T("download.verification.title", {
			defaultValue: "Every Release is Signed. Verify Yours.",
		}),
		Description: T("download.verification.description", {
			defaultValue:
				"Every Land release is PGP-signed before it ships.\n\nVerify your download to confirm you got exactly what was built.",
		}),
		DownloadVerification: {
			SHA256: "Available at first public release",
			PGPSignature: "Available at first public release",
			SigningKeyId: "Available at first public release",
			VerificationInstructions:
				"To verify: shasum -a 256 <filename> and compare output with the published checksum. For PGP: gpg --verify <file>.sig <file>",
		},
		IntegrityVerification: {
			SHA256: "Available at first public release",
			PGPSignature: "Available at first public release",
			VerificationInstructions:
				"Verification instructions will be published alongside the first release. All releases will include SHA-256 checksums and PGP signatures.",
		},
		DownloadButton: {
			Text: T("download.verification.downloadButton", {
				defaultValue: "Download PGP Public Key",
			}),
			Variant: "outline",
			Size: "default",
			FullWidth: false,
		},
		VerifyButton: {
			Text: T("download.verification.verifyButton", {
				defaultValue: "Verify Download",
			}),
			Variant: "default",
			Size: "default",
			FullWidth: false,
		},
	},
	PreviousReleases: {
		Title: T("download.previousReleases.title", {
			defaultValue: "Previous Releases",
		}),
		Description: T("download.previousReleases.description", {
			defaultValue:
				"Download an older version if you need to pin to a specific release.",
		}),
		Releases: [],
		ShowChangelog: false,
	},
	Header: undefined,
	Footer: {},
};

const MetaTitle = T("meta.downloads.title", {
	defaultValue: "Download Land | The Next-Generation Code Editor",
});
const MetaDescription = T("meta.downloads.description", {
	defaultValue:
		"Download Land for macOS, Windows, and Linux. All releases are signed and verified for your security.",
});
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load />
	<div
		class="container mx-auto flex flex-wrap items-center justify-center gap-3 px-4 pt-6 text-xs text-muted-foreground">
		<picture>
			<img
				alt="Land"
				src="/Asset/Logo/Glyph/Land.svg"
				width="24"
				height="24"
			/>
		</picture>
		<span
			class="inline-flex items-center border border-green-200 bg-green-50 px-2.5 py-0.5 font-medium text-green-700">
			No Telemetry&#x2001;<span
				class="h-1.5 w-1.5 rounded-none bg-green-500"
				aria-hidden="true"></span>
		</span>
		<span
			class="inline-flex items-center border border-[var(--Border)] bg-[var(--Mute)] px-2.5 py-0.5 font-medium">
			CC0 Licensed
		</span>
		<span
			class="inline-flex items-center border border-[var(--Border)] bg-[var(--Mute)] px-2.5 py-0.5 font-medium">
			PGP Signed
		</span>
		<span
			class="inline-flex items-center gap-1.5 border border-blue-200 bg-blue-50 px-2.5 py-0.5 font-medium text-blue-700">
			<img src="/Image/Rust.svg" alt="" width="14" height="14" class="opacity-70" aria-hidden="true" />
			Native Rust&#x2001;<span
				class="h-1.5 w-1.5 rounded-none bg-blue-500"
				aria-hidden="true"></span>
		</span>
		<span
			class="inline-flex items-center gap-1.5 border border-sky-200 bg-sky-50 px-2.5 py-0.5 font-medium text-sky-700">
			<img src="/Image/Tauri.svg" alt="" width="14" height="14" class="opacity-70" aria-hidden="true" />
			Tauri&#x2001;<span
				class="h-1.5 w-1.5 rounded-none bg-sky-500"
				aria-hidden="true"></span>
		</span>
		<span
			class="inline-flex items-center gap-1.5 border border-purple-200 bg-purple-50 px-2.5 py-0.5 font-medium text-purple-700">
			<img src="/Image/EffectTS.svg" alt="" width="14" height="14" class="opacity-70" aria-hidden="true" />
			Effect-TS
		</span>
		<span
			class="inline-flex items-center border border-[var(--Border)] bg-[var(--Mute)] px-2.5 py-0.5 font-medium">
			macOS + Windows + Linux
		</span>
		<span
			class="inline-flex items-center border border-[var(--Border)] bg-[var(--Mute)] px-2.5 py-0.5 font-medium">
			VS Code Extensions
		</span>
	</div>
	<DownloadsPage
		Content={DownloadContent}
		MetaTitle={MetaTitle}
		MetaDescription={MetaDescription}
	/>
	<DynamicTransparency Content={TransparencyContent} client:load />
</Base>
