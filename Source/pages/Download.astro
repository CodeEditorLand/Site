---
/**
 * Download - the installation contract: can I install this today, and if not,
 * what can I do instead?
 *
 * The page is one release record, then three sections:
 *
 *   1. masthead    the page's one h1, its answer in one sentence, eight marks
 *   2. record      `# RELEASE_01` - the manifest: three platform entries, the
 *                  verification entry, and the one action that exists today
 *   3. requirements what each platform needs, and what a source build needs
 *   4. previous    the releases before this one - none, said with RECORD: EMPTY
 *   5. transparency the telemetry and build-profile disclosure this page carried
 *
 * The record opens the page. `DesignSystem-Pages.md` §2 specifies the download
 * surface as a release manifest, and a manifest that sits inside a chapter is a
 * stack of sections rather than a record: the five-band version buried the
 * record's own index one level down (DESIGN.md §7 DR-9). The manifest is now the
 * page's first artifact, with the record's index, stamp, route, field set,
 * action and status in the document's order.
 *
 * The page owns the artifact order and nothing else (BRIDGE §2.1): every row,
 * label and figure lives in `Component/Dynamic/Download/Data.ts`, every group is
 * a component, and every block is the Record layer's inside a Jelly surface.
 *
 * The last section is still built by a `.tsx` island (`DynamicTransparency`). It
 * is outside this card's ownership, so it keeps its markup, its hydrating noise
 * and its four strategy commands exactly as they were; the section supplies its
 * h2 and standfirst, and the island is asked for its body only.
 */
import DownloadMasthead from "../Component/Dynamic/DownloadMasthead.astro";
import DynamicPreviousReleases from "../Component/Dynamic/DynamicPreviousReleases.astro";
import DynamicReleaseManifest from "../Component/Dynamic/DynamicReleaseManifest.astro";
import DynamicSystemRequirements from "../Component/Dynamic/DynamicSystemRequirements.astro";
import { DynamicTransparency } from "../Component/Dynamic/DynamicTransparency";
import { Header } from "../Component/Layout/Header";
import RecordBand from "../Component/Record/RecordBand.astro";
import {
	Bands,
	BuildLines,
	Manifest,
	ManifestPlatforms,
	Marks,
	PreviousReleases,
	ReleaseColumns,
	Requirements,
	Toolchain,
	Verification,
} from "../Component/Dynamic/Download/Data";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const Band = Bands(T);

/** The record's own copy: its index, its claim, its state and its two sources. */
const Record = Manifest(T);

/**
 * The disclosure section's body, carried over unchanged from this page's
 * previous version: six telemetry policy items, nine named build profiles,
 * sixteen test permutations, four deployment strategies with their commands, and
 * the source URL. `Title` and `Subtitle` are absent on purpose - they are the
 * section's heading and standfirst now, so the island renders its body without a
 * second h2.
 */
const TransparencyContent = {
