---
// Enterprise inquiries - the sale route, read as a READING page.
//
// ─── WHAT CHANGED, AND WHY ────────────────────────────────────────────────
// The page was a two-thirds / one-third split: one large card beside a stack of
// three. That is a marketing layout, and this page is not marketing - it is a
// letter with a desk behind it, and a reader reads it top to bottom before
// deciding. So it is composed in the site's reading language: a rail of its own
// five sections in the margin, the letter on the 72ch measure, and the three
// pieces of apparatus (what the plan includes, the direct contact, the licence)
// as one ruled row under the letter.
//
// Nothing is dropped. The large card is still one white panel with the site's
// one 4px left rule, `How to Reach Us` is still a label and not a heading, the
// page is still `h1` 1 / `h2` 1 / `h3` 3, the GitHub issue is still the page's
// one `.emphasis-expressive` action, and the address is still a link rather than
// an action (`DESIGN.md` §5 A6, §7 DR-13). The six features, the direct contact
// and the licence reminder keep their cards and their words; only the grid they
// sat in is the shell's now.
//
// ─── THE ONE ADVERSE STATE ────────────────────────────────────────────────
// An enterprise page that prints no price has a hole in it, and the hole is the
// honest fact. The `partial` state says so in the site's grammar - WHAT IT COSTS
// is `UNAVAILABLE`, never `0`, because a zero would be a claim that the plan is
// free - and gives the reader the way to ask.
//
// Every string still comes through `T` with its key, so the locale files keep
// their copy. The GitHub issue URL, the DEALS route and the PlayForm line are
// unchanged.
import ContactPage from "../../Component/Contact/ContactPage.astro";
import PageShell from "../../Component/Shell/PageShell.astro";
import ShellRail from "../../Component/Shell/ShellRail.astro";
import ShellState from "../../Component/Shell/ShellState.astro";
import { GetI18n } from "../../Library/I18n/Server";
import type { ContactTrailItem } from "../../Library/Contact/Data.js";

const T = GetI18n();

const MetaTitle = T("meta.contact.sales.title", {
	defaultValue: "Enterprise Inquiries | Code Editor Land",
});

const MetaDescription = T("meta.contact.sales.description", {
	defaultValue:
		"Contact the Code Editor Land team for enterprise licensing, support, and deployment options.",
});

const PageTitle = T("common.sales.pageTitle", {
	defaultValue: "Enterprise Inquiries",
});

const PageSubtitle = T("common.sales.pageSubtitle", {
	defaultValue:
		"Enterprise adds support, an SLA and custom development. The code stays CC0. A request is filed as a GitHub issue, so the whole team reads it and the answer is public.",
});

/**
 * The locale strings carry their paragraph breaks as blank lines. The baseline
 * prints each of them as one paragraph, so the blank line folds to a space -
 * every word survives, the paragraph count is the baseline's.
 */
const OneLine = (Value: string): string => Value.replace(/\s*\n\s*/g, " ");

const HomeLabel = T("common.breadcrumb.home", { defaultValue: "Home" });

/* The site's one breadcrumb grammar (`DESIGN.md` §9 Q3): each crumb prints as
   `/LABEL`, the leading slash the only separator. The labels stay translated -
   the slash is added around the locale's word, never instead of it. */
const Trail: readonly ContactTrailItem[] = [
	{ label: `/${HomeLabel.toUpperCase()}`, href: "/" },
	{ label: `/${PageTitle.toUpperCase()}` },
];

const BackToTop = T("common.button.backToTop", { defaultValue: "Back to top" });

/** The six things an enterprise plan adds, in the order the page lists them. */
const Features: readonly string[] = [
	T("common.sales.features.prioritySupport", {
		defaultValue: "Priority support and SLA",
	}),
	T("common.sales.features.customDeployment", {
		defaultValue:
			"Custom deployment options: cloud, on-prem, or air-gapped",
	}),
	T("common.sales.features.volumeLicensing", {
		defaultValue: "Volume licensing for large teams",
	}),
	T("common.sales.features.accountManagement", {
		defaultValue: "Direct contact with the maintainers",
	}),
	T("common.sales.features.securityReview", {
		defaultValue: "Security review and compliance documentation",
	}),
	T("common.sales.features.customIntegrations", {
		defaultValue: "Custom integrations and development work",
	}),
];

/** The one address that is not a form. A working mailbox, not a placeholder. */
const DirectAddress = "Community@PlayForm.Cloud";

const HowToReachUs = T("common.sales.contact.heading", {
	defaultValue: "How to Reach Us",
});

const GithubNote = OneLine(
	T("common.sales.contact.githubNote", {
		defaultValue:
			"Enterprise requests are filed as GitHub issues: the thread is the record, the whole team reads it, and the answer stays public.",
	}),
);

const OpenIssueHeading = T("common.sales.contact.openIssueHeading", {
	defaultValue: "Open a GitHub Issue",
});

const OpenIssueDescription = OneLine(
	T("common.sales.contact.openIssueDescription", {
		defaultValue:
			"Open an issue on the Land repository with the organisation, the team size, the use case and the deployment target.\n\nA request that names those four can be answered in one reply; one that does not needs a thread.",
	}),
);

const IssueIncludeLabel = T("common.sales.contact.issueIncludeLabel", {
	defaultValue: "What to include in your issue:",
});

const IssueIncludeText = T("common.sales.contact.issueIncludeText", {
	defaultValue:
		"Company name, team size, intended use case, deployment environment, timeline, and any specific support or compliance requirements.",
});

const DirectContactHeading = T("common.sales.contact.directHeading", {
	defaultValue: "Direct Contact",
});

const DirectContactNote = T("common.sales.contact.description", {
	defaultValue: "Prefer email? Reach us directly:",
});

const OperatedBy = T("common.sales.contact.operatedBy", {
	defaultValue: "Operated by PlayForm, Sofia, Bulgaria",
});

const OpenSourceHeading = T("common.sales.openSource.heading", {
	defaultValue: "Still Open Source",
});

const OpenSourceDescription = OneLine(
	T("common.sales.openSource.description", {
		defaultValue:
			"Enterprise plans add support, SLA, and custom development.\n\nThe code itself remains CC0. Fork it, read it, ship it.",
	}),
);

/**
 * The rail: the letter's own five parts, in the order it reads them. The marks
 * are positions, because a letter has an order and the reader may want to skip
 * to the part that answers their question.
 */
const SaleRail = [
	{
		mark: "01",
		label: T("common.sales.contact.heading", {
			defaultValue: "How to Reach Us",
		}).toUpperCase(),
		href: "#reach",
	},
	{
		mark: "02",
		label: OpenIssueHeading.toUpperCase(),
		href: "#open-issue",
	},
	{
		mark: "03",
		label: T("common.sales.features.heading", {
			defaultValue: "What Enterprise Includes",
		}).toUpperCase(),
		href: "#includes",
	},
	{
		mark: "04",
		label: DirectContactHeading.toUpperCase(),
		href: "#direct",
	},
	{
		mark: "05",
		label: OpenSourceHeading.toUpperCase(),
		href: "#open-source",
	},
];
---

<ContactPage
	metaTitle={MetaTitle}
	metaDescription={MetaDescription}
	trail={Trail}
	record={{ code: "SALE", article: "ENTERPRISE", route: "/CONTACT" }}
	heading={PageTitle}
	standfirst={PageSubtitle}
	width="wide"
>
	<PageShell
		index="# READING_04"
		label="THE ENTERPRISE DESK"
		class="PageShell--inset"
	>
		<ShellRail
			slot="rail"
			label="ON THIS PAGE"
			count={SaleRail.length}
			items={SaleRail}
		/>

		<ShellState
			kind="partial"
			index="TERMS / 01"
			slot="margin"
			statement={T("layout.sale.partial.statement", {
				defaultValue:
					"The plan's terms are agreed per agreement: what an enterprise deployment costs, and what its SLA states in figures, are not published on this page.",
			})}
			cause={T("layout.sale.partial.cause", {
				defaultValue:
					"COST is UNAVAILABLE rather than 0. A published zero would be a claim that the plan is free, and an invented figure would be the one number on this page with no source.",
			})}
			next={{
				label: T("layout.sale.partial.next", {
					defaultValue: "OPEN AN ENTERPRISE ISSUE",
				}),
				href: "https://github.com/CodeEditorLand/Land/issues/new?title=Enterprise+Inquiry&labels=enterprise",
			}}
			rows={[
				{ key: "COST:", value: "UNAVAILABLE" },
				{ key: "SLA:", value: "AGREED PER AGREEMENT" },
				{ key: "LICENCE:", value: "CC0 1.0", code: true },
				{ key: "DESK:", value: DirectAddress, code: true },
			]}
			note="SOURCE: THIS PAGE'S OWN COPY"
		/>

		<div class="contact-sale">
			<div
				class="contact-sale__panel StaccatoBorderShimmer StaccatoCard"
				id="reach"
			>
				<div class="contact-sale__rule">
					<p class="contact-sale__rule-label">{HowToReachUs}</p>
					<p class="contact-sale__prose">{GithubNote}</p>
				</div>

				<a
					class="contact-sale__action emphasis-expressive"
					href="https://github.com/CodeEditorLand/Land/issues/new?title=Enterprise+Inquiry&labels=enterprise"
					target="_blank"
					rel="noopener noreferrer"
				>
					{T("common.sales.contact.openIssueButton", {
						defaultValue: "Open GitHub Issue",
					})}
					<span class="InlineSeparator">→</span>
				</a>

				<h2 class="contact-sale__heading" id="open-issue">
					{OpenIssueHeading}
				</h2>

				<p class="contact-sale__prose">{OpenIssueDescription}</p>

				<div class="contact-sale__inset">
					<p class="contact-sale__inset-text">
						<strong>{IssueIncludeLabel}</strong> {IssueIncludeText}
					</p>
				</div>
			</div>

			<div class="PageShell__row" style="--row-tracks:3">
				<div
					class="contact-sale__card StaccatoBorderShimmer StaccatoCard"
					id="includes"
				>
					<h3 class="contact-sale__subheading">
						{T("common.sales.features.heading", {
							defaultValue: "What Enterprise Includes",
						})}
					</h3>

					<ul class="contact-sale__features">
						{Features.map((Feature) => (
							<li>{Feature}</li>
						))}
					</ul>
				</div>

				<div
					class="contact-sale__card StaccatoBorderShimmer StaccatoCard"
					id="direct"
				>
					<a class="contact-sale__route" href="/Contact/Deals">
						{T("common.sales.contact.dealsButton", {
							defaultValue: "Enterprise Sales form (DEALS)",
						})}
						<span class="InlineSeparator">&#9993;</span>
					</a>

					<h3 class="contact-sale__subheading">
						{DirectContactHeading}
					</h3>

					<p class="contact-sale__prose">{DirectContactNote}</p>

					<p class="contact-sale__prose">
						<a
							class="contact-sale__address"
							href={`mailto:${DirectAddress}`}
						>
							{DirectAddress}
						</a>
					</p>

					<p class="contact-sale__prose">{OperatedBy}</p>
				</div>

				<div
					class="contact-sale__card StaccatoBorderShimmer StaccatoCard"
					id="open-source"
				>
					<h3 class="contact-sale__subheading">
						{OpenSourceHeading}
					</h3>

					<p class="contact-sale__prose">{OpenSourceDescription}</p>
				</div>
			</div>

			<div class="contact-sale__top">
				<a class="StaccatoButton" href="#top">
					{BackToTop}
					<span class="InlineSeparator">↑</span>
				</a>
			</div>
		</div>
	</PageShell>
</ContactPage>
