---
// Enterprise inquiries - the sale route.
//
// The page is a two-thirds / one-third split under one page opening. The left
// two columns are a single card: a block with the site's one heavy left rule
// carrying `How to Reach Us` and the sentence that explains why the route is a
// GitHub issue, the issue action, the `h2` that names it, the prose under it,
// and an inset listing what the issue should contain. The right column is a
// stack of three cards: what an enterprise plan adds, the direct contact, and
// the licence reminder.
//
// `How to Reach Us` is a label, not a heading: the baseline prints it as a
// paragraph inside the rule block, and the page's heading count is `h1` 1,
// `h2` 1, `h3` 3. Promoting it would invert the levels, which is exactly the
// defect this restore removes.
//
// The page's one expressive element is the GitHub issue action. The
// `Community@PlayForm.Cloud` address is a link, not an action, so it keeps ink
// and an underline on hover only (`DESIGN.md` §5 A6, §7 DR-13).
//
// No record header: the baseline renders no `# SALE` / `〈 〉` / `/CONTACT`
// line here.
//
// Every string still comes through `T` with its key, so the locale files keep
// their copy. The GitHub issue URL, the DEALS route and the PlayForm line are
// unchanged.
import ContactPage from "../../Component/Contact/ContactPage.astro";
import { GetI18n } from "../../Library/I18n/Server";
import type { ContactTrailItem } from "../../Library/Contact/Data.js";

const T = GetI18n();

const MetaTitle = T("meta.contact.sales.title", {
	defaultValue: "Enterprise Inquiries | Code Editor Land",
});

const MetaDescription = T("meta.contact.sales.description", {
	defaultValue:
		"Contact the Code Editor Land team for enterprise licensing, support, and deployment options.",
});

const PageTitle = T("common.sales.pageTitle", {
	defaultValue: "Enterprise Inquiries",
});

const PageSubtitle = T("common.sales.pageSubtitle", {
	defaultValue:
		"Deploying Land across your organization? Get in touch and we'll work out the details together.",
});

/**
 * The locale strings carry their paragraph breaks as blank lines. The baseline
 * prints each of them as one paragraph, so the blank line folds to a space -
 * every word survives, the paragraph count is the baseline's.
 */
const OneLine = (Value: string): string => Value.replace(/\s*\n\s*/g, " ");

const HomeLabel = T("common.breadcrumb.home", { defaultValue: "Home" });

const Trail: readonly ContactTrailItem[] = [
	{ label: HomeLabel, href: "/" },
	{ label: PageTitle },
];

const BackToTop = T("common.button.backToTop", { defaultValue: "Back to top" });

/** The six things an enterprise plan adds, in the order the page lists them. */
const Features: readonly string[] = [
	T("common.sales.features.prioritySupport", {
		defaultValue: "Priority support and SLA",
	}),
	T("common.sales.features.customDeployment", {
		defaultValue: "Custom deployment options: cloud, on-prem, or air-gapped",
	}),
	T("common.sales.features.volumeLicensing", {
		defaultValue: "Volume licensing for large teams",
	}),
	T("common.sales.features.accountManagement", {
		defaultValue: "Direct contact with the maintainers",
	}),
	T("common.sales.features.securityReview", {
		defaultValue: "Security review and compliance documentation",
	}),
	T("common.sales.features.customIntegrations", {
		defaultValue: "Custom integrations and development work",
	}),
];

/** The one address that is not a form. A working mailbox, not a placeholder. */
const DirectAddress = "Community@PlayForm.Cloud";

const HowToReachUs = T("common.sales.contact.heading", {
	defaultValue: "How to Reach Us",
});

const GithubNote = OneLine(
	T("common.sales.contact.githubNote", {
		defaultValue:
			"We handle enterprise inquiries through GitHub Issues.\n\nThis ensures your request is tracked, visible to the full team, and responded to.",
	}),
);

const OpenIssueHeading = T("common.sales.contact.openIssueHeading", {
	defaultValue: "Open a GitHub Issue",
});

const OpenIssueDescription = OneLine(
	T("common.sales.contact.openIssueDescription", {
		defaultValue:
			"Create an issue on our GitHub repository describing your organization's needs.\n\nInclude your company name, team size, use case, and deployment requirements.\n\nWe review issues regularly.",
	}),
);

const IssueIncludeLabel = T("common.sales.contact.issueIncludeLabel", {
	defaultValue: "What to include in your issue:",
});

const IssueIncludeText = T("common.sales.contact.issueIncludeText", {
	defaultValue:
		"Company name, team size, intended use case, deployment environment, timeline, and any specific support or compliance requirements.",
});

const DirectContactHeading = T("common.sales.contact.directHeading", {
	defaultValue: "Direct Contact",
});

const DirectContactNote = T("common.sales.contact.description", {
	defaultValue: "Prefer email? Reach us directly:",
});

const OperatedBy = T("common.sales.contact.operatedBy", {
	defaultValue: "Operated by PlayForm, Sofia, Bulgaria",
});

const OpenSourceHeading = T("common.sales.openSource.heading", {
	defaultValue: "Still Open Source",
});

const OpenSourceDescription = OneLine(
	T("common.sales.openSource.description", {
		defaultValue:
			"Enterprise plans add support, SLA, and custom development.\n\nThe code itself remains CC0. Fork it, read it, ship it.",
	}),
);
---

<ContactPage
	metaTitle={MetaTitle}
	metaDescription={MetaDescription}
	trail={Trail}
	heading={PageTitle}
	standfirst={PageSubtitle}
	width="narrow"
>
	<div class="contact-sale">
		<div class="contact-sale__grid">
			<div class="contact-sale__main">
				<div class="contact-sale__panel StaccatoBorderShimmer StaccatoCard">
					<div class="contact-sale__rule">
						<p class="contact-sale__rule-label">{HowToReachUs}</p>
						<p class="contact-sale__prose">{GithubNote}</p>
					</div>

					<a
						class="contact-sale__action emphasis-expressive"
						href="https://github.com/CodeEditorLand/Land/issues/new?title=Enterprise+Inquiry&labels=enterprise"
						target="_blank"
						rel="noopener noreferrer"
						>{T("common.sales.contact.openIssueButton", {
							defaultValue: "Open GitHub Issue",
						})}<span class="InlineSeparator">→</span></a
					>

					<h2 class="contact-sale__heading">{OpenIssueHeading}</h2>

					<p class="contact-sale__prose">{OpenIssueDescription}</p>

					<div class="contact-sale__inset">
						<p class="contact-sale__inset-text">
							<strong>{IssueIncludeLabel}</strong>{" "}{IssueIncludeText}
						</p>
					</div>
				</div>
			</div>

			<div class="contact-sale__aside">
				<div class="contact-sale__card StaccatoBorderShimmer StaccatoCard">
					<h3 class="contact-sale__subheading">
						{T("common.sales.features.heading", {
							defaultValue: "What Enterprise Includes",
						})}
					</h3>

					<ul class="contact-sale__features">
						{Features.map((Feature) => <li>{Feature}</li>)}
					</ul>
				</div>

				<div class="contact-sale__card StaccatoBorderShimmer StaccatoCard">
					<a class="contact-sale__route" href="/Contact/Deals"
						>{T("common.sales.contact.dealsButton", {
							defaultValue: "Enterprise Sales form (DEALS)",
						})}<span class="InlineSeparator">&#9993;</span></a
					>

					<h3 class="contact-sale__subheading">{DirectContactHeading}</h3>

					<p class="contact-sale__prose">{DirectContactNote}</p>

					<p class="contact-sale__prose">
						<a class="contact-sale__address" href={`mailto:${DirectAddress}`}
							>{DirectAddress}</a
						>
					</p>

					<p class="contact-sale__prose">{OperatedBy}</p>
				</div>

				<div class="contact-sale__card StaccatoBorderShimmer StaccatoCard">
					<h3 class="contact-sale__subheading">{OpenSourceHeading}</h3>

					<p class="contact-sale__prose">{OpenSourceDescription}</p>
				</div>
			</div>
		</div>

		<div class="contact-sale__top">
			<a class="StaccatoButton" href="#top"
				>{BackToTop}<span class="InlineSeparator">↑</span></a
			>
		</div>
	</div>
</ContactPage>
