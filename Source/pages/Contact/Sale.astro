---
// Enterprise inquiries - the sale route, in the same language as the request
// routes.
//
// The page used to be a Tailwind two-column layout: a card with a shimmering
// border, a sidebar of three more cards, and a breadcrumb list with `/`
// separators. It carried the same facts in the same order, so nothing was cut -
// each card became a band, and the sentence "Prefer email? Reach us directly:"
// finally has the address it was asking the reader to use.
//
// Two corrections since: the bands no longer alternate paper and canvas
// (`DESIGN.md` §5 A5 - surface follows the artifact, not the position, so every
// band but the opening one is the canvas), and the direct address is no longer
// ink-inverted (§7 DR-13 - the GitHub issue is the page's one action, and an
// address is not an action).
//
// Every string still comes through `T` with its key, so the locale files keep
// their copy. The GitHub issue URL, the DEALS route and the PlayForm line are
// unchanged.
import ContactPage from "../../Component/Contact/ContactPage.astro";
import RecordBand from "../../Component/Record/RecordBand.astro";
import { GetI18n } from "../../Library/I18n/Server";
import type { ContactTrailItem } from "../../Library/Contact/Data.js";

const T = GetI18n();

const MetaTitle = T("meta.contact.sales.title", {
	defaultValue: "Enterprise Inquiries | Code Editor Land",
});

const MetaDescription = T("meta.contact.sales.description", {
	defaultValue:
		"Contact the Code Editor Land team for enterprise licensing, support, and deployment options.",
});

const PageTitle = T("common.sales.pageTitle", {
	defaultValue: "Enterprise Inquiries",
});

const PageSubtitle = T("common.sales.pageSubtitle", {
	defaultValue:
		"Deploying Land across your organization? Get in touch and we'll work out the details together.",
});

const HomeLabel = T("common.breadcrumb.home", { defaultValue: "Home" });

const Trail: readonly ContactTrailItem[] = [
	{ label: `/${HomeLabel.toUpperCase()}`, href: "/" },
	{ label: "/CONTACT", href: "/Contact" },
	{ label: `/${PageTitle.toUpperCase()}` },
];

/**
 * The record header: the page's own series marker, the classification inside
 * `〈 〉`, and the route it is filed on - the same three symbols every contact
 * route opens with, so the fifteen routes read as one set.
 */
const Record = { index: "# SALE", stamp: "ENTERPRISE", route: "/CONTACT" };

/** The six things an enterprise plan adds, in the order the page lists them. */
const Features: readonly string[] = [
	T("common.sales.features.prioritySupport", {
		defaultValue: "Priority support and SLA",
	}),
	T("common.sales.features.customDeployment", {
		defaultValue: "Custom deployment options: cloud, on-prem, or air-gapped",
	}),
	T("common.sales.features.volumeLicensing", {
		defaultValue: "Volume licensing for large teams",
	}),
	T("common.sales.features.accountManagement", {
		defaultValue: "Direct contact with the maintainers",
	}),
	T("common.sales.features.securityReview", {
		defaultValue: "Security review and compliance documentation",
	}),
	T("common.sales.features.customIntegrations", {
		defaultValue: "Custom integrations and development work",
	}),
];

/** The one address that is not a form. A working mailbox, not a placeholder. */
const DirectAddress = "Community@PlayForm.Cloud";

/**
 * The GitHub issue note is written as two paragraphs in the locale file. A
 * standfirst is one sentence-run, so the blank line is folded to a space rather
 * than dropped - both paragraphs survive.
 */
const GithubNote = T("common.sales.contact.githubNote", {
	defaultValue:
		"We handle enterprise inquiries through GitHub Issues.\n\nThis ensures your request is tracked, visible to the full team, and responded to.",
}).replace(/\s*\n\s*/g, " ");
---

<ContactPage
	metaTitle={MetaTitle}
	metaDescription={MetaDescription}
	trail={Trail}
	heading={PageTitle}
	standfirst={PageSubtitle}
	record={Record}
>
	<RecordBand
		band={{
			kicker: "/ENTERPRISE",
			heading: T("common.sales.contact.heading", {
				defaultValue: "How to Reach Us",
			}),
			standfirst: GithubNote,
			tone: "flush",
		}}
	>
		<a
			class="contact-sale__action emphasis-expressive"
			href="https://github.com/CodeEditorLand/Land/issues/new?title=Enterprise+Inquiry&labels=enterprise"
			target="_blank"
			rel="noopener noreferrer"
			>{T("common.sales.contact.openIssueButton", {
				defaultValue: "Open GitHub Issue",
			})}<span class="InlineSeparator">→</span></a
		>

		<h3 class="contact-sale__subheading">
			{
				T("common.sales.contact.openIssueHeading", {
					defaultValue: "Open a GitHub Issue",
				})
			}
		</h3>

		<p class="contact-sale__prose">
			{
				T("common.sales.contact.openIssueDescription", {
					defaultValue:
						"Create an issue on our GitHub repository describing your organization's needs.\n\nInclude your company name, team size, use case, and deployment requirements.\n\nWe review issues regularly.",
				})
			}
		</p>

		<div class="contact-sale__panel emphasis-quiet">
			<p class="contact-sale__prose">
				<strong
					>{
						T("common.sales.contact.issueIncludeLabel", {
							defaultValue: "What to include in your issue:",
						})
					}</strong
				>
				{
					T("common.sales.contact.issueIncludeText", {
						defaultValue:
							"Company name, team size, intended use case, deployment environment, timeline, and any specific support or compliance requirements.",
					})
				}
			</p>
		</div>
	</RecordBand>

	<RecordBand
		band={{
			kicker: "/WHAT ENTERPRISE ADDS",
			heading: T("common.sales.features.heading", {
				defaultValue: "What Enterprise Includes",
			}),
			tone: "canvas",
		}}
	>
		<ul class="contact-sale__features">
			{Features.map((feature) => <li>{feature}</li>)}
		</ul>
	</RecordBand>

	<RecordBand
		band={{
			kicker: "/DIRECT CONTACT",
			heading: T("common.sales.contact.directHeading", {
				defaultValue: "Direct Contact",
			}),
			tone: "canvas",
		}}
	>
		<p class="contact-sale__prose">
			{
				T("common.sales.contact.description", {
					defaultValue: "Prefer email? Reach us directly:",
				})
			}
		</p>

		<a
			class="contact-sale__address"
			href={`mailto:${DirectAddress}`}>{DirectAddress}</a
		>

		<p class="contact-sale__prose">
			{
				T("common.sales.contact.operatedBy", {
					defaultValue: "Operated by PlayForm, Sofia, Bulgaria",
				})
			}
		</p>

		<p>
			<a class="contact-sale__route" href="/Contact/Deals"
				>Enterprise Sales form (DEALS)<span class="InlineSeparator"
					>&#9993;</span
				></a
			>
		</p>
	</RecordBand>

	<RecordBand
		band={{
			kicker: "/LICENCE",
			heading: T("common.sales.openSource.heading", {
				defaultValue: "Still Open Source",
			}),
			tone: "canvas",
		}}
	>
		<p class="contact-sale__prose">
			{
				T("common.sales.openSource.description", {
					defaultValue:
						"Enterprise plans add support, SLA, and custom development.\n\nThe code itself remains CC0. Fork it, read it, ship it.",
				})
			}
		</p>

		<p class="contact-sale__top">
			<a href="#top"
				>{T("common.button.backToTop", { defaultValue: "Back to top" })}<span
					class="InlineSeparator">↑</span
				></a
			>
		</p>
	</RecordBand>
</ContactPage>
