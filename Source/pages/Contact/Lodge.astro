---
import DynamicContactForm from "../../Component/Dynamic/DynamicContactForm";
import { Header } from "../../Component/Layout/Header";
import Base from "../../Layout/Base.astro";
import { Requests } from "../../Library/Contact/Request.js";

const { Auth0Domain, Auth0ClientIdentifier } =
	await import("../../Function/Configuration/Auth.js");

const Config = Requests["LODGE"];
---

<Base
	Title={`${Config.Title} | Code Editor Land`}
	Description={Config.Subtitle}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load />

	<div class="container mx-auto max-w-5xl px-4">
		<nav aria-label="Breadcrumb" class="pt-6">
			<ol
				class="flex flex-wrap items-center space-x-2 text-muted-foreground"
			>
				<li>
					<a href="/" class="transition-colors hover:text-foreground"
						>Home</a
					>
				</li>
				<li class="mx-2">/</li>
				<li>
					<a
						href="/Dashboard"
						class="transition-colors hover:text-foreground"
						>Dashboard</a
					>
				</li>
				<li class="mx-2">/</li>
				<li>
					<span class="font-medium text-foreground"
						>Lodge a Complaint</span
					>
				</li>
			</ol>
		</nav>
	</div>

	<DynamicContactForm
		client:load
		Config={Config}
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>
</Base>
