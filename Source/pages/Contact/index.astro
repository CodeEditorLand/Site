---
// The Contact hub - one index of request routes.
//
// The page is a single three-column grid of fourteen link cards: a slug, a
// title and one sentence per cell. It answers "which one is mine" by printing
// every route the site answers on, in alphabetical order, and nothing else -
// there is no family grouping, no second level of navigation and no display
// type anywhere on it.
//
// Every slug, title and subtitle comes from `Request.ts` through
// `Library/Contact/Data.ts` - nothing is retyped here - so a card cannot
// disagree with the route it links to. The one card that is a page rather than
// an income code is `SALE`, and it is the one entry whose words the data module
// carries itself.
//
// The address that closes the page is the one contact that does not go through a
// form. It is a link, not an action: an address is not something the page
// performs, so it takes ink, no fill, and an underline on hover only
// (`DESIGN.md` §5 A6, §7 DR-12). It is one quiet line between the grid and the
// closing rule - never a heading, because the page's heading count is its own.
//
// No record header: the baseline renders no `# CONTACT` / `/INDEX` line here,
// and the hub is an index rather than a record.
import ContactPage from "../../Component/Contact/ContactPage.astro";
import {
	ContactDirect,
	ContactEntries,
	ContactHubTrail,
} from "../../Library/Contact/Data.js";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.contact.hub.title", {
	defaultValue: "Contact | Code Editor Land",
});

const MetaDescription = T("meta.contact.hub.description", {
	defaultValue:
		"Contact the Code Editor Land team: data requests, technical support, legal, and enterprise inquiries.",
});

const Heading = T("common.contact.pageTitle", { defaultValue: "Contact" });

const Standfirst = T("common.contact.pageSubtitle", {
	defaultValue:
		"Data requests, technical support, legal, and enterprise inquiries - each contact carries a 5-letter income code.",
});

const BackToTop = T("common.button.backToTop", { defaultValue: "Back to top" });
---

<ContactPage
	metaTitle={MetaTitle}
	metaDescription={MetaDescription}
	trail={ContactHubTrail}
	heading={Heading}
	standfirst={Standfirst}
	mode="functional"
>
	<div class="contact-hub">
		<div class="contact-hub__grid">
			{
				ContactEntries.map((Entry) => (
					<a class="contact-hub__card" href={Entry.href}>
						<p class="contact-hub__slug">{Entry.slug}</p>
						<h2 class="contact-hub__name">{Entry.title}</h2>
						<p class="contact-hub__note">{Entry.subtitle}</p>
					</a>
				))
			}
		</div>

		<p class="contact-hub__direct">
			<span class="contact-hub__direct-label">{ContactDirect.label}</span>
			<a class="contact-hub__address" href={`mailto:${ContactDirect.address}`}
				>{ContactDirect.address}</a
			>
		</p>

		<div class="contact-hub__top">
			<a class="StaccatoButton" href="#top"
				>{BackToTop}<span class="InlineSeparator">↑</span></a
			>
		</div>
	</div>
</ContactPage>
