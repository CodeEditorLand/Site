---
/**
 * The blog index: what exists, newest first.
 *
 * The page is the baseline render's composition: a breadcrumb, a centred header
 * carrying the page's one `h1` and one line under it, then the articles in a
 * three-column grid, then the way back to the top. Eight articles in a
 * three-across grid leave a hole in the last row; the baseline had that hole and
 * the page is restored with it, because the shape a reader recognises is the
 * grid rather than the ledger that replaced it.
 *
 * The page composes, it does not lay out. `Component/Blog/Data.ts` orders the
 * collection and derives the reading-time label; `BlogIndex` renders the header
 * and the grid; the partial under `Stylesheet/System/Component/Blog/` styles
 * both. What is left here is the copy and the trail.
 */
import { getCollection } from "astro:content";

import BlogIndex from "../Component/Blog/BlogIndex.astro";
import { BuildRows } from "../Component/Blog/Data.js";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.title", {
	ns: "blog",
	defaultValue: "Blog | Code Editor Land",
});

const MetaDescription = T("meta.description", {
	ns: "blog",
	defaultValue: "Architecture deep-dives, release notes, and updates.",
});

const PageTitle = T("page.title", { ns: "blog", defaultValue: "Blog" });
const PageSubtitle = T("page.subtitle", {
	ns: "blog",
	defaultValue:
		"Entries on the architecture, the build and the licence, newest first. Each card prints its date, its tags and the time it takes to read.",
});

/**
 * The empty state, composed: what would be here, why it is not, and the next
 * place to read. An archive that says "check back soon" has asked the reader to
 * wait without telling them what for - and this site has a manual today.
 */
const EmptyTitle = T("empty.title", {
	ns: "blog",
	defaultValue: "NO ENTRIES FILED",
});

const EmptySubtitle = T("empty.subtitle", {
	ns: "blog",
	defaultValue:
		"The collection is empty: no article has been published to Source/Content/blog, so the plate above prints a tombstone instead of four zeroes. Nothing failed and nothing is hidden - the archive has not started. /DOC carries the manual that is written.",
});

/** The unit the schema's `readTime` number is printed with. */
const MinRead = T("card.minRead", { ns: "blog", defaultValue: "min read" });

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });
const BackToTop = T("common.button.backToTop", {
	defaultValue: "Back to top",
});

const Entries = await getCollection("blog");

/** Every article, ordered by `publishedAt` descending - see `BuildRows`. */
const Rows = BuildRows(Entries, MinRead);

/**
 * The plate's four measures, counted from the collection this page renders.
 *
 * They are counted here rather than written: `ENTRIES` is the length of the row
 * list the grid prints, `TOPICS` is the set of tags those rows carry, `SPAN` is
 * the first and last date in the sorted list, and `READING` is the sum of the
 * frontmatter's own minutes. A page whose plate and whose grid could disagree
 * would be two claims about one archive.
 */
const Topics = new Set(Rows.flatMap((Row) => Row.tags)).size;

const Dates = Rows.map((Row) => Row.date).sort();

const PlateMeasures = [
	{ label: "ENTRIES", value: String(Rows.length), unit: "FILED" },
	{ label: "TOPICS", value: String(Topics), unit: "TAGGED" },
	{
		label: "SPAN",
		value: `${Dates[0] ?? "UNAVAILABLE"} \u2192 ${Dates[Dates.length - 1] ?? "UNAVAILABLE"}`,
	},
	{
		label: "READING",
		value: String(Entries.reduce((Sum, Entry) => Sum + Entry.data.readTime, 0)),
		unit: "MINUTES",
	},
];

/**
 * The trail above the header. Both crumbs print the surface's own name, without
 * the `/` prefix the record grammar uses elsewhere: the baseline's breadcrumb
 * read `Home / Blog`, and a crumb is a place, not a route.
 */
const Trail = [{ label: Home, href: "/" }, { label: PageTitle }];
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load slot="Header" />

	<BlogIndex
		heading={PageTitle}
		standfirst={PageSubtitle}
		trail={Trail}
		rows={Rows}
		emptyTitle={EmptyTitle}
		emptyNote={EmptySubtitle}
		backLabel={BackToTop}
		backHref="#top"
		plateLabel={`BLOG / ${String(Rows.length).padStart(2, "0")} ENTRIES`}
		plateMeasures={PlateMeasures}
		plateCaption="The archive's extent, counted from the collection: the entries filed, the distinct topics they carry, the dates they span, and the reading time they add up to. A figure this page could not count would print UNAVAILABLE, never a zero."
		plateSource="Source/Content/blog/*.md"
	/>
</Base>
