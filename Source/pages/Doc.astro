---
import { getCollection } from "astro:content";

import DocArticle from "../Component/Doc/DocArticle.astro";
import DocIndex from "../Component/Doc/DocIndex.astro";
import DocLayout from "../Component/Doc/DocLayout.astro";
import { Header } from "../Component/Layout/Header";
import BuildDocIndex from "../Function/Doc/BuildDocIndex";
import BuildDocSidebar from "../Function/Doc/BuildDocSidebar";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

/**
 * The documentation index - one Archive Index artifact, then its four
 * appendices.
 *
 * `DesignSystem-Artifacts.md` §2 and `DESIGN.md` §1.8 give many records one
 * physical form: an **Archive Index**, "an index of filed observations", never
 * a wall of equal cards and never a stack of chapters. So the ten section bands
 * are rows inside ONE surface, and the four appendix bands are four artifacts
 * after it:
 *
 * - **The index card** carries every section: its name as the band's heading,
 *   its page count in the kicker (`/ELEMENTS · 16 PAGES`), then one dense row
 *   per page - `navTitle` (or `title`), the page's `description` as the row's
 *   note, in `order`. The rows are built in `Function/Doc/BuildDocIndex.ts`;
 *   this page only maps one component over one array.
 * - **The four appendices** (where to start, architecture, backend services,
 *   live deployments) are one artifact each: `start-here`, `architecture`,
 *   `backend`, `deployments` in `BuildDocIndex`. They are not sections of the
 *   index, so they do not live inside its card.
 *
 * Every band is a `jelly-card` surface and nothing else. `RecordBand` paints a
 * background, a top hairline and a `--space-chapter` of padding of its own; a
 * card around that band paints a second boundary at the same edge, and the
 * alternating `flush` → `paper` → `canvas` tone turns one artifact into a stack
 * of chapters (DESIGN.md §7 DR-6, DR-8). Both are neutralised inside these
 * cards by `System/Component/Doc/_Index.scss`: one surface, one inset, one
 * `--space-group` between sections.
 *
 * The five custom properties are the ones the page's cards set at HEAD:
 * `--Card` fill, radius 0, inherited type, and an inset the card owns because
 * the bands no longer bring one.
 *
 * The sidebar is the collection's own tree, unchanged: same entries, same
 * `group` nesting, same order.
 */
const DocEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

const SidebarSections = BuildDocSidebar(DocEntries);

const Bands = BuildDocIndex(DocEntries, T);

/** The four appendix band ids, as `BuildDocIndex` names them. */
const AppendixId = new Set([
	"start-here",
	"architecture",
	"backend",
	"deployments",
]);

const SectionBands = Bands.filter((Band) => !AppendixId.has(Band.Id));

const AppendixBands = Bands.filter((Band) => AppendixId.has(Band.Id));

const PageTitle = T("common.docs.pageTitle", { defaultValue: "Documentation" });

/**
 * The index's metadata strip, in the site's mono record grammar: the state of
 * this artifact, its layer, and the two counts a reader can check against the
 * rows below (`PAGES` is the collection, `SECTIONS` the bands that survived an
 * empty-section drop). U+2001 EM QUAD separates the items, as it does on every
 * other record on the site.
 */
const IndexStrip = [
	T("strip.published", { ns: "doc", defaultValue: "STATUS: PUBLISHED" }),
	`${T("strip.layer", { ns: "doc", defaultValue: "LAYER:" })} ${PageTitle.toUpperCase()}`,
	`${T("strip.pages", { ns: "doc", defaultValue: "PAGES:" })} ${DocEntries.length}`,
	`${T("strip.sections", { ns: "doc", defaultValue: "SECTIONS:" })} ${SectionBands.length}`,
].join("\u2001");

const MetaTitle = T("meta.docs.title", {
	defaultValue: "Documentation | Code Editor Land",
});

const MetaDescription = T("meta.docs.description", {
	defaultValue:
		"Browse the Code Editor Land documentation, architecture guides, and developer resources.",
});

const PageStandfirst = T("common.docs.pageSubtitle", {
	defaultValue: "Everything you need to install, build, and contribute to Land.",
});

const Home = T("common.breadcrumb.home", { defaultValue: "Home" });

const BackToTop = T("common.button.backToTop", {
	defaultValue: "Back to top",
});
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<Header client:load Mode="functional" slot="Header" />

	<DocLayout sections={SidebarSections}>
		<DocArticle
			kicker="/DOCUMENTATION"
			title={PageTitle}
			standfirst={PageStandfirst}
			crumbs={[{ label: Home, href: "/" }, { label: PageTitle }]}
			measure={false}
			banded
		>
			<p class="doc-index__strip">{IndexStrip}</p>

			<jelly-card
				class="doc-index-card"
				style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:clamp(1rem,4vw,2.5rem)"
			>
				{
					SectionBands.map((Band) => (
						<DocIndex band={Band} />
					))
				}
			</jelly-card>

			<div class="doc-appendix">
				{
					AppendixBands.map((Band) => (
						<jelly-card
							class="doc-appendix__card"
							style="--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:clamp(1rem,4vw,2.5rem)"
						>
							<DocIndex band={Band} />
						</jelly-card>
					))
				}
			</div>

			<p class="doc-index__back">
				<a href="#top">{BackToTop}<span aria-hidden="true"> ↑</span></a>
			</p>
		</DocArticle>
	</DocLayout>
</Base>
