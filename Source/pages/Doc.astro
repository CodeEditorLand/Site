---
import { getCollection } from "astro:content";

import { DynamicDocSidebar } from "../Component/Dynamic/DynamicDocSidebar";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const DocEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

// Group entries by section for hierarchical sidebar
const SectionOrder = [
	"Start",
	"Architecture",
	"Usage",
	"Development",
	"Community",
	"Support",
	"Element",
	"Technology",
	"License",
];

const GroupedBySection = new Map<
	string,
	{ Id: string; Label: string }[]
>();

for (const Entry of DocEntries) {
	const Section = Entry.data.section ?? "Other";
	if (!GroupedBySection.has(Section)) {
		GroupedBySection.set(Section, []);
	}
	GroupedBySection.get(Section)!.push({
		Id: Entry.id,
		Label: Entry.data.title,
	});
}

const SidebarSections = SectionOrder
	.filter((Section) => GroupedBySection.has(Section))
	.map((Section) => ({
		Id: Section.toLowerCase().replace(/\s+/g, "-"),
		Label: Section,
		Children: GroupedBySection.get(Section)!,
	}));

const T = GetI18n();

const MetaTitle = T("meta.docs.title", {
	defaultValue: "Documentation | Code Editor Land",
});

const MetaDescription = T("meta.docs.description", {
	defaultValue:
		"Browse the Code Editor Land documentation, architecture guides, and developer resources.",
});

// Data-driven architecture - replaces 450 lines of manual JSX
const Element = [
	{
		Name: "Mountain",
		Emoji: "⛰️",
		Repo: "Mountain",
		Description: T("common.docs.architecture.mountain.description", {
			defaultValue: "VS Code's main process is Electron: a bundled Chromium instance plus Node.js. Every window adds another renderer process heap. Every OS interaction crosses a JSON IPC pipe.\n\nMountain replaces it entirely with a Rust binary using Tauri. The OS's own WebView renders the UI. File dialogs, clipboard, and window management go directly to the OS. Authentication tokens live in the keychain. RAM footprint drops 60-80% per window.",
		}),
		Subtitle: T("common.docs.architecture.mountain.subtitle", {
			defaultValue: "No Electron. No Chromium. No IPC tax.",
		}),
	},
	{
		Name: "Cocoon",
		Emoji: "🦋",
		Repo: "Cocoon",
		Description: T("common.docs.architecture.cocoon.description", {
			defaultValue: "VS Code's extension host is a single Node.js event loop. One hung Promise blocks every other extension in the process. There is no way to cancel an in-flight operation.\n\nCocoon intercepts require and import at the module level. Every VS Code API call becomes a typed Effect running on a fiber scheduler. Extensions activate concurrently. A hung operation times out and the fiber is interrupted. The full VS Code API surface is preserved. Nothing needs to be rewritten.",
		}),
		Subtitle: T("common.docs.architecture.cocoon.subtitle", {
			defaultValue: "Every VS Code extension runs. Nothing blocks.",
		}),
	},
	{
		Name: "Wind",
		Emoji: "🌀",
		Repo: "Wind",
		Description: T("common.docs.architecture.wind.description", {
			defaultValue: "VS Code's workbench lives in the Chromium renderer. Every panel interaction that touches files or state crosses the Electron IPC bridge twice: serialize, pipe, deserialize.\n\nWind re-implements the VS Code Workbench as composable Effect-TS Layers. File dialogs, clipboard, configuration, and output channels each become a typed service. OS calls go through Mountain's Tauri bindings directly. Refactoring a service breaks its consumers at compile time, not silently.",
		}),
		Subtitle: T("common.docs.architecture.wind.subtitle", {
			defaultValue: "Workbench actions hit the OS. No proxy.",
		}),
	},
	{
		Name: "Sky",
		Emoji: "🌤️",
		Repo: "Sky",
		Description: T("common.docs.architecture.sky.description", {
			defaultValue: "Three workbench layouts — full desktop, embedded, minimal — each built from Astro components with instant hot-reload. Tauri reloads Sky immediately on any component change.\n\nHigh-fidelity VS Code UI compatibility with a significantly smaller footprint. No special Electron magic. Just web components rendered by the OS's own WebView.",
		}),
		Subtitle: T("common.docs.architecture.sky.subtitle", {
			defaultValue: "Every panel is a component. Instant hot-reload.",
		}),
	},
	{
		Name: "Air",
		Emoji: "💨",
		Repo: "Air",
		Description: T("common.docs.architecture.air.description", {
			defaultValue:
				"VS Code cold-starts slowly because everything initializes fresh each launch: extension host, language servers, file index. Updates require a full restart that kills open terminals and in-progress work.\n\nAir is a persistent background daemon. It pre-downloads and PGP-verifies the next version between sessions. It pre-indexes workspace changes while the editor is closed. When you launch Land, the expensive work is already done. You never see a Restart to Update prompt.",
		}),
		Subtitle: T("common.docs.architecture.air.subtitle", {
			defaultValue: "Already updated before you decide to update.",
		}),
	},
	{
		Name: "Echo",
		Emoji: "📣",
		Repo: "Echo",
		Description: T("common.docs.architecture.echo.description", {
			defaultValue:
				"VS Code's background tasks — file indexing, symbol scanning, git blame — run in a single-threaded Node.js process. Heavy indexing freezes everything on that thread. The only escape is spawning more processes, adding memory and IPC overhead.\n\nEcho is a lock-free work-stealing scheduler built on Rust's crossbeam-deque. Every task runs in a supervised worker pool spanning all CPU cores. Heavy indexing and analysis never block the editor. Tasks cannot outlive their scope: teardown is guaranteed.",
		}),
		Subtitle: T("common.docs.architecture.echo.subtitle", {
			defaultValue: "Every CPU core working. Nothing blocking.",
		}),
	},
	{
		Name: "Common",
		Emoji: "📦",
		Repo: "Common",
		Description: T("common.docs.architecture.common.description", {
			defaultValue: "VS Code's codebase imports concrete implementations. Testing requires mocking entire modules. There is no dependency injection at the architecture level.\n\nCommon defines pure abstract traits with zero concrete implementations. Every element builds on typed effects and composable building blocks. Mock any trait and test any element without launching a window, a WebView, or a sidecar.",
		}),
		Subtitle: T("common.docs.architecture.common.subtitle", {
			defaultValue: "Test any element. No running editor required.",
		}),
	},
	{
		Name: "Vine",
		Emoji: "🌿",
		Repo: "Vine",
		Description: T("common.docs.architecture.vine.description", {
			defaultValue: "Electron's IPC is untyped: you send a string event name and hope the handler matches. Refactoring a message field breaks things silently in production.\n\nVine starts every inter-process interface as a .proto file. The generated Rust and TypeScript stubs are the only way Land processes communicate. A message field change fails at the compiler. gRPC over a Unix domain socket runs at memory-copy speed: microseconds for messages under 64KB.",
		}),
		Subtitle: T("common.docs.architecture.vine.subtitle", {
			defaultValue: "Typed IPC. Change a field, break every consumer at compile time.",
		}),
	},
	{
		Name: "Mist",
		Emoji: "🌫️",
		Repo: "Mist",
		Description: T("common.docs.architecture.mist.description", {
			defaultValue:
				"Creates a fully sandboxed DNS zone that resolves every *.editor.land domain to 127.0.0.1. All Land services communicate through this local layer.\n\nNothing leaks to the public internet. A clean network boundary between the editor and the outside world.",
		}),
		Subtitle: T("common.docs.architecture.mist.subtitle", {
			defaultValue: "DNS Sandbox Local *.editor.land Resolution",
		}),
	},
	{
		Name: "Rest",
		Emoji: "⚡",
		Repo: "Rest",
		Description: T("common.docs.architecture.rest.description", {
			defaultValue:
				"VS Code's TypeScript build uses tsc with Node.js overhead on every incremental compile. Build times grow with project size.\n\nRest is a drop-in replacement powered by OXC: the same parser VS Code uses internally, implemented in Rust. 100% compatible output at 2-3x the speed of esbuild. Zero Node.js overhead in the build path.",
		}),
		Subtitle: T("common.docs.architecture.rest.subtitle", {
			defaultValue: "VS Code's TypeScript build step. 2-3x faster.",
		}),
	},
	{
		Name: "Output",
		Emoji: "📤",
		Repo: "Output",
		Description: T("common.docs.architecture.output.description", {
			defaultValue: "VS Code's build process produces artifacts that differ between machines and CI environments. Debugging production issues requires reproducing exact build conditions.\n\nOutput processes TypeScript from VS Code, Land, and Rest into fully bundled artifacts through a plugin-routed architecture. Every bundle is deterministic and checksum-verified. Same commit always produces the same output.",
		}),
		Subtitle: T("common.docs.architecture.output.subtitle", {
			defaultValue: "Same commit. Same output. Every time.",
		}),
	},
	{
		Name: "Grove",
		Emoji: "🌳",
		Repo: "Grove",
		Description: T("common.docs.architecture.grove.description", {
			defaultValue: "VS Code extensions run with full Node.js capabilities in a shared process. A malicious or buggy extension can access any file, make any network request, and read another extension's state. The extension sandbox is a policy document, not a technical boundary.\n\nGrove runs extensions compiled to WASM inside WASMtime with capability-based security. An extension can only touch what you explicitly grant: a directory, a network endpoint, an IPC channel. The boundary is enforced by the runtime, not by hope.",
		}),
		Subtitle: T("common.docs.architecture.grove.subtitle", {
			defaultValue: "Extension isolation enforced by hardware.",
		}),
	},
	{
		Name: "Worker",
		Emoji: "⚙️",
		Repo: "Worker",
		Description: T("common.docs.architecture.worker.description", {
			defaultValue: "The editor shell stays functional and authenticated even when the network drops. Auth tokens are AES-GCM encrypted, requests are HMAC-signed, and tokens refresh automatically without any user action.\n\nCaching, offline support, and dynamic CSS imports all managed through the Service Worker layer.",
		}),
		Subtitle: T("common.docs.architecture.worker.subtitle", {
			defaultValue: "Offline-capable. Auth tokens encrypted. Auto-refreshed.",
		}),
	},
	{
		Name: "SideCar",
		Emoji: "🚂",
		Repo: "SideCar",
		Description: T("common.docs.architecture.sidecar.description", {
			defaultValue:
				"VS Code ships one Node.js binary and detects the platform at runtime, with fallback chains that fail in edge cases (Alpine Linux, custom glibc versions, ARM configurations).\n\nSideCar packages the exact Node.js binary for each target triple at compile time: aarch64-apple-darwin, x86_64-pc-windows-msvc, and four others. Cocoon always gets the binary that matches the host. No runtime detection, no fallback chains, no surprises.",
		}),
		Subtitle: T("common.docs.architecture.sidecar.subtitle", {
			defaultValue: "The right Node.js binary. Compiled in. No detection.",
		}),
	},
	{
		Name: "Maintain",
		Emoji: "🔧",
		Repo: "Maintain",
		Description: T("common.docs.architecture.maintain.description", {
			defaultValue:
				"Build pipelines that change behavior based on environment variables, implicit tool versions, or undeclared dependencies make debugging production issues impossible.\n\nMaintain builds the entire Land ecosystem with Rhai scripting for flexible build logic, compile-time validated TOML and JSON5 configurations, and deterministic artifact generation. The same commit always produces the same output across all machines.",
		}),
		Subtitle: T("common.docs.architecture.maintain.subtitle", {
			defaultValue: "Deterministic builds. Same commit, same output, guaranteed.",
		}),
	},
];
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url="https://editor.land/Doc"
	lang="en">
	<Header client:load />

	<div class="container mx-auto max-w-6xl px-4 py-16">
		<div class="flex gap-8">
			<!-- Sidebar - sticky on desktop, hidden on mobile -->
			<aside class="hidden w-56 shrink-0 lg:block">
				<div class="sticky top-8">
					<p
						class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
						{
							T("sidebar.title", {
								ns: "doc",
								defaultValue: "Documentation",
							})
						}
					</p>
					<DynamicDocSidebar Sections={SidebarSections} client:load />
					<div class="mt-4 border-t border-[var(--Border)] pt-4">
						<a
							href="/Doc/Rust"
							class="block px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
							Rust API
						</a>
					</div>
				</div>
			</aside>

			<!-- Main content -->
			<main id="main-content" class="min-w-0 flex-1">
				<!-- Breadcrumbs -->
				<nav aria-label="Breadcrumb" class="mb-8">
					<ol
						class="flex flex-wrap items-center space-x-2 text-sm text-muted-foreground">
						<li>
							<a
								href="/"
								class="transition-colors hover:text-foreground"
								>{
									T("common.breadcrumb.home", {
										defaultValue: "Home",
									})
								}</a
							>
						</li>
						<li class="mx-2">/</li>
						<li>
							<span class="font-medium text-foreground"
								>{
									T("common.docs.pageTitle", {
										defaultValue: "Documentation",
									})
								}</span
							>
						</li>
					</ol>
				</nav>

				<!-- Page Header -->
				<header class="mb-12">
					<h1 class="mb-4 text-4xl font-bold tracking-tight">
						{
							T("common.docs.pageTitle", {
								defaultValue: "Documentation",
							})
						}
					</h1>
					<p class="text-lg text-muted-foreground">
						{
							T("common.docs.pageSubtitle", {
								defaultValue:
									"Everything you need to install, build, and contribute to Land.",
							})
						}
					</p>
				</header>

				<!-- Quick Links: GitHub, Issues, Rust API -->
				<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
					<a
						href="https://github.com/CodeEditorLand/Land#readme"
						target="_blank"
						rel="noopener noreferrer"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<h2 class="mb-2 text-xl font-semibold">
							{
								T("common.docs.gettingStarted.title", {
									defaultValue: "Get Started in Minutes",
								})
							}
						</h2>
						<p class="text-sm text-muted-foreground">
							{
								T("common.docs.gettingStarted.description", {
									defaultValue:
										"The README walks you through installation, first build, and the six-element architecture. No prior Rust or Tauri knowledge required.",
								})
							}
						</p>
					</a>

					<a
						href="https://github.com/CodeEditorLand/Land/issues"
						target="_blank"
						rel="noopener noreferrer"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<h2 class="mb-2 text-xl font-semibold">
							{
								T("common.docs.issueTracker.title", {
									defaultValue: "Report a Bug or Request a Feature",
								})
							}
						</h2>
						<p class="text-sm text-muted-foreground">
							{
								T("common.docs.issueTracker.description", {
									defaultValue:
										"Open an issue on GitHub. The team monitors daily and labels good-first-issue tasks for new contributors.",
								})
							}
						</p>
					</a>

					<a
						href="/Doc/Rust"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<h2 class="mb-2 text-xl font-semibold">
							{
								T("common.docs.rustApi.title", {
									defaultValue: "Rust API Reference",
								})
							}
						</h2>
						<p class="text-sm text-muted-foreground">
							{
								T("common.docs.rustApi.description", {
									defaultValue:
										"Browse generated rustdoc output for Mountain, Echo, Air, and 11 more Rust crates.",
								})
							}
						</p>
					</a>
				</div>

				<!-- Guides: grouped by section -->
				{
					SectionOrder
						.filter((Section) => GroupedBySection.has(Section))
						.map((Section) => {
							const Entries = DocEntries.filter(
								(E) => E.data.section === Section,
							);
							if (Entries.length === 0) return null;
							return (
								<section class="mt-12" id={Section.toLowerCase().replace(/\s+/g, "-")}>
									<h2 class="mb-6 text-2xl font-semibold">
										{Section}
									</h2>
									<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
										{Entries.map((Entry) => (
											<a
												href={`/Doc/${Entry.id}`}
												class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-4 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
												<h3 class="font-medium">
													{Entry.data.title}
												</h3>
												{Entry.data.description && (
													<p class="mt-1 text-xs text-muted-foreground">
														{Entry.data.description}
													</p>
												)}
											</a>
										))}
									</div>
								</section>
							);
						})
				}

				<!-- Architecture Section - data-driven -->
				<section class="mt-12">
					<a
						href="https://github.com/CodeEditorLand"
						target="_blank"
						rel="noopener noreferrer"
						class="mb-2 inline-block text-sm text-[var(--Primary)] hover:underline">
						github.com/CodeEditorLand
					</a>
					<h2 class="mb-6 text-2xl font-semibold">
						{
							T("common.docs.architecture.heading", {
								defaultValue: "How Land Replaces VS Code's Electron Stack",
							})
						}
					</h2>
					<div
						class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
						<p class="mb-4 text-muted-foreground">
							{
								T("common.docs.architecture.intro", {
									defaultValue:
										"VS Code runs on Electron: a Chromium browser, a Node.js runtime, and a single-threaded extension host. Land replaces each of these piece by piece with elements that preserve the VS Code extension API while eliminating the architectural constraints that cause the RAM tax, the blocked editor, and the slow startup. Each of the fifteen elements is an independent open-source repository:",
								})
							}
						</p>
						<ul class="space-y-4 text-sm">
							{
								Element.map((E) => (
									<li>
										<a
											href={`https://github.com/CodeEditorLand/${E.Repo}`}
											target="_blank"
											rel="noopener noreferrer"
											class="font-semibold text-[var(--Primary)] hover:underline">
											{E.Name}&#x2001;{E.Emoji}
										</a>
										<p class="mt-1 text-muted-foreground">
											{E.Description}
										</p>
										<p class="text-muted-foreground/70 text-xs">
											{E.Subtitle}
										</p>
									</li>
								))
							}
						</ul>
						<div class="mt-6 border-t border-[var(--Border)] pt-4">
							<a
								href="https://github.com/CodeEditorLand"
								target="_blank"
								rel="noopener noreferrer"
								class="text-sm font-medium text-[var(--Primary)] hover:underline">
								{
									T("common.docs.repositories.viewAll", {
										defaultValue: "View all repositories",
									})
								}
								<span class="InlineSeparator">↗</span>
							</a>
						</div>
					</div>
				</section>

				<!-- Backend Services (Cloudflare Workers) -->
				<section class="mt-12">
					<h2 class="mb-6 text-2xl font-semibold">
						{
							T("common.docs.workers.heading", {
								defaultValue: "Backend Services",
							})
						}
					</h2>
					<div
						class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
						<p class="mb-4 text-muted-foreground">
							{
								T("common.docs.workers.intro", {
									defaultValue:
										"Five Cloudflare Workers power the Land backend infrastructure:",
								})
							}
						</p>
						<ul class="space-y-3 text-sm">
							<li>
								<span class="font-semibold">Auth</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.auth", {
											defaultValue:
												"OAuth 2.0, JWT session tokens, and Auth0 integration",
										})
									}
								</span>
							</li>
							<li>
								<span class="font-semibold">Download</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.download", {
											defaultValue:
												"Binary distribution, release metadata, and update checks",
										})
									}
								</span>
							</li>
							<li>
								<span class="font-semibold">Status</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.status", {
											defaultValue:
												"Health checks and uptime monitoring",
										})
									}
								</span>
							</li>
							<li>
								<span class="font-semibold">Analytics</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.analytics", {
											defaultValue:
												"Back to top",
										})
									}
								</span>
							</li>
						</ul>
					</div>
				</section>

				<!-- Back to top -->
				<div class="mt-12 border-t pt-8">
					<a
						href="#top"
						class="StaccatoButton text-sm text-primary hover:underline"
						>{
							T("common.button.backToTop", {
								defaultValue: "Back to top",
							})
						}<span class="InlineSeparator">↑</span></a
					>
				</div>
			</main>
		</div>
	</div>
</Base>
