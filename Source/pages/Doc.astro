---
import { getCollection } from "astro:content";

import { DynamicDocSidebar } from "../Component/Dynamic/DynamicDocSidebar";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const DocEntries = (await getCollection("doc")).sort(
	(A, B) => A.data.order - B.data.order,
);

const SidebarSections = DocEntries.map((Entry) => ({
	Id: Entry.id,
	Label: Entry.data.title,
}));

const T = GetI18n();

const MetaTitle = T("meta.docs.title", {
	defaultValue: "Documentation | Code Editor Land",
});

const MetaDescription = T("meta.docs.description", {
	defaultValue:
		"Browse the Code Editor Land documentation, architecture guides, and developer resources.",
});

// Data-driven architecture - replaces 450 lines of manual JSX
const Element = [
	{
		Name: "Mountain",
		Emoji: "⛰️",
		Repo: "Mountain",
		Description: T("common.docs.architecture.mountain.description", {
			defaultValue: "Replaces Electron's main process. Manages windows, file system, and process lifecycle at native speed.",
		}),
		Subtitle: T("common.docs.architecture.mountain.subtitle", {
			defaultValue: "Native process manager",
		}),
	},
	{
		Name: "Cocoon",
		Emoji: "🦋",
		Repo: "Cocoon",
		Description: T("common.docs.architecture.cocoon.description", {
			defaultValue: "Runs VS Code extensions via Effect-TS. Your existing extensions work without any modifications.",
		}),
		Subtitle: T("common.docs.architecture.cocoon.subtitle", {
			defaultValue: "Extension host, zero rewrites",
		}),
	},
	{
		Name: "Wind",
		Emoji: "🌀",
		Repo: "Wind",
		Description: T("common.docs.architecture.wind.description", {
			defaultValue: "Re-implements the VS Code Workbench. Panels, sidebars, and the activity bar rebuilt without Electron.",
		}),
		Subtitle: T("common.docs.architecture.wind.subtitle", {
			defaultValue: "Full workbench shell",
		}),
	},
	{
		Name: "Sky",
		Emoji: "🌤️",
		Repo: "Sky",
		Description: T("common.docs.architecture.sky.description", {
			defaultValue: "Renders the editor interface with Astro. Themes, layouts, and the visual layer load fast on every platform.",
		}),
		Subtitle: T("common.docs.architecture.sky.subtitle", {
			defaultValue: "Themes and layouts layer",
		}),
	},
	{
		Name: "Air",
		Emoji: "💨",
		Repo: "Air",
		Description: T("common.docs.architecture.air.description", {
			defaultValue:
				"Keeps Land current without interrupting you. Every update is cryptographically signed before it is applied.",
		}),
		Subtitle: T("common.docs.architecture.air.subtitle", {
			defaultValue: "Silent updates, always signed",
		}),
	},
	{
		Name: "Echo",
		Emoji: "📣",
		Repo: "Echo",
		Description: T("common.docs.architecture.echo.description", {
			defaultValue:
				"Saturates every CPU core with a work-stealing executor. Heavy indexing stays in the background; the editor stays fast.",
		}),
		Subtitle: T("common.docs.architecture.echo.subtitle", {
			defaultValue: "Uses every CPU core you have",
		}),
	},
	{
		Name: "Common",
		Emoji: "📦",
		Repo: "Common",
		Description: T("common.docs.architecture.common.description", {
			defaultValue: "Shared trait definitions and DTOs used across all elements. The foundation everything else builds on.",
		}),
		Subtitle: T("common.docs.architecture.common.subtitle", {
			defaultValue: "Core shared library",
		}),
	},
	{
		Name: "Vine",
		Emoji: "🌿",
		Repo: "Vine",
		Description: T("common.docs.architecture.vine.description", {
			defaultValue: "gRPC protocol definition bridging Rust and TypeScript at sub-millisecond latency.",
		}),
		Subtitle: T("common.docs.architecture.vine.subtitle", {
			defaultValue: "Native IPC protocol",
		}),
	},
	{
		Name: "Mist",
		Emoji: "🌫️",
		Repo: "Mist",
		Description: T("common.docs.architecture.mist.description", {
			defaultValue:
				"WebSocket communication layer between the daemon and the editor frontend.",
		}),
		Subtitle: T("common.docs.architecture.mist.subtitle", {
			defaultValue: "Live WebSocket bridge",
		}),
	},
	{
		Name: "Rest",
		Emoji: "⚡",
		Repo: "Rest",
		Description: T("common.docs.architecture.rest.description", {
			defaultValue:
				"Bundles VS Code platform JavaScript with OXC. Produces the JS runtime Land ships in.",
		}),
		Subtitle: T("common.docs.architecture.rest.subtitle", {
			defaultValue: "Platform JS bundler",
		}),
	},
	{
		Name: "Output",
		Emoji: "📤",
		Repo: "Output",
		Description: T("common.docs.architecture.output.description", {
			defaultValue: "The compiled JavaScript artifacts from Rest, ready for the editor runtime.",
		}),
		Subtitle: T("common.docs.architecture.output.subtitle", {
			defaultValue: "JavaScript runtime bundle",
		}),
	},
	{
		Name: "Grove",
		Emoji: "🌳",
		Repo: "Grove",
		Description: T("common.docs.architecture.grove.description", {
			defaultValue: "Hosts native WASM and Rhai extensions alongside the TypeScript extension host.",
		}),
		Subtitle: T("common.docs.architecture.grove.subtitle", {
			defaultValue: "WASM and Rhai extension host",
		}),
	},
	{
		Name: "Worker",
		Emoji: "⚙️",
		Repo: "Worker",
		Description: T("common.docs.architecture.worker.description", {
			defaultValue: "Web Workers that offload heavy computation from the main UI thread.",
		}),
		Subtitle: T("common.docs.architecture.worker.subtitle", {
			defaultValue: "Background web workers",
		}),
	},
	{
		Name: "SideCar",
		Emoji: "🚂",
		Repo: "SideCar",
		Description: T("common.docs.architecture.sidecar.description", {
			defaultValue:
				"Pre-built Node.js binaries that ship with Land for cross-platform compatibility.",
		}),
		Subtitle: T("common.docs.architecture.sidecar.subtitle", {
			defaultValue: "Bundled Node.js runtime",
		}),
	},
	{
		Name: "Maintain",
		Emoji: "🔧",
		Repo: "Maintain",
		Description: T("common.docs.architecture.maintain.description", {
			defaultValue:
				"CI/CD pipelines and maintenance scripts that keep every element building and tested.",
		}),
		Subtitle: T("common.docs.architecture.maintain.subtitle", {
			defaultValue: "Build automation",
		}),
	},
];
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url="https://editor.land/Doc"
	lang="en">
	<Header client:load />

	<div class="container mx-auto max-w-6xl px-4 py-16">
		<div class="flex gap-8">
			<!-- Sidebar - sticky on desktop, hidden on mobile -->
			<aside class="hidden w-56 shrink-0 lg:block">
				<div class="sticky top-8">
					<p
						class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
						{
							T("sidebar.title", {
								ns: "doc",
								defaultValue: "Documentation",
							})
						}
					</p>
					<DynamicDocSidebar Sections={SidebarSections} client:load />
					<div class="mt-4 border-t border-[var(--Border)] pt-4">
						<a
							href="/Doc/Rust"
							class="block px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
							Rust API
						</a>
					</div>
				</div>
			</aside>

			<!-- Main content -->
			<main id="main-content" class="min-w-0 flex-1">
				<!-- Breadcrumbs -->
				<nav aria-label="Breadcrumb" class="mb-8">
					<ol
						class="flex flex-wrap items-center space-x-2 text-sm text-muted-foreground">
						<li>
							<a
								href="/"
								class="transition-colors hover:text-foreground"
								>{
									T("common.breadcrumb.home", {
										defaultValue: "Home",
									})
								}</a
							>
						</li>
						<li class="mx-2">/</li>
						<li>
							<span class="font-medium text-foreground"
								>{
									T("common.docs.pageTitle", {
										defaultValue: "Documentation",
									})
								}</span
							>
						</li>
					</ol>
				</nav>

				<!-- Page Header -->
				<header class="mb-12">
					<h1 class="mb-4 text-4xl font-bold tracking-tight">
						{
							T("common.docs.pageTitle", {
								defaultValue: "Documentation",
							})
						}
					</h1>
					<p class="text-lg text-muted-foreground">
						{
							T("common.docs.pageSubtitle", {
								defaultValue:
									"Everything you need to install, build, and contribute to Land.",
							})
						}
					</p>
				</header>

				<!-- Quick Links: GitHub, Issues, Rust API -->
				<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
					<a
						href="https://github.com/CodeEditorLand/Land#readme"
						target="_blank"
						rel="noopener noreferrer"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<h2 class="mb-2 text-xl font-semibold">
							{
								T("common.docs.gettingStarted.title", {
									defaultValue: "Get Started in Minutes",
								})
							}
						</h2>
						<p class="text-sm text-muted-foreground">
							{
								T("common.docs.gettingStarted.description", {
									defaultValue:
										"The README walks you through installation, first build, and the six-element architecture. No prior Rust or Tauri knowledge required.",
								})
							}
						</p>
					</a>

					<a
						href="https://github.com/CodeEditorLand/Land/issues"
						target="_blank"
						rel="noopener noreferrer"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<h2 class="mb-2 text-xl font-semibold">
							{
								T("common.docs.issueTracker.title", {
									defaultValue: "Report a Bug or Request a Feature",
								})
							}
						</h2>
						<p class="text-sm text-muted-foreground">
							{
								T("common.docs.issueTracker.description", {
									defaultValue:
										"Open an issue on GitHub. The team monitors daily and labels good-first-issue tasks for new contributors.",
								})
							}
						</p>
					</a>

					<a
						href="/Doc/Rust"
						class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
						<h2 class="mb-2 text-xl font-semibold">
							{
								T("common.docs.rustApi.title", {
									defaultValue: "Rust API Reference",
								})
							}
						</h2>
						<p class="text-sm text-muted-foreground">
							{
								T("common.docs.rustApi.description", {
									defaultValue:
										"Browse generated rustdoc output for Mountain, Echo, Air, and 11 more Rust crates.",
								})
							}
						</p>
					</a>
				</div>

				<!-- Guides: links to /Doc/{slug} pages -->
				<section class="mt-12">
					<h2 class="mb-6 text-2xl font-semibold">
						{
							T("common.docs.guides.heading", {
								defaultValue: "Guides",
							})
						}
					</h2>
					<div
						class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
						{
							DocEntries.map((Entry) => (
								<a
									href={`/Doc/${Entry.id}`}
									class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-4 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
									<p class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
										{Entry.data.section}
									</p>
									<h3 class="font-medium">
										{Entry.data.title}
									</h3>
									{Entry.data.description && (
										<p class="mt-1 text-xs text-muted-foreground">
											{Entry.data.description}
										</p>
									)}
								</a>
							))
						}
					</div>
				</section>

				<!-- Architecture Section - data-driven -->
				<section class="mt-12">
					<a
						href="https://github.com/CodeEditorLand"
						target="_blank"
						rel="noopener noreferrer"
						class="mb-2 inline-block text-sm text-[var(--Primary)] hover:underline">
						github.com/CodeEditorLand
					</a>
					<h2 class="mb-6 text-2xl font-semibold">
						{
							T("common.docs.architecture.heading", {
								defaultValue: "How the Architecture Works",
							})
						}
					</h2>
					<div
						class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
						<p class="mb-4 text-muted-foreground">
							{
								T("common.docs.architecture.intro", {
									defaultValue:
										"Land replaces VS Code's Electron stack piece by piece. Each element is an independent open-source repository:",
								})
							}
						</p>
						<ul class="space-y-4 text-sm">
							{
								Element.map((E) => (
									<li>
										<a
											href={`https://github.com/CodeEditorLand/${E.Repo}`}
											target="_blank"
											rel="noopener noreferrer"
											class="font-semibold text-[var(--Primary)] hover:underline">
											{E.Name}&#x2001;{E.Emoji}
										</a>
										<p class="mt-1 text-muted-foreground">
											{E.Description}
										</p>
										<p class="text-muted-foreground/70 text-xs">
											{E.Subtitle}
										</p>
									</li>
								))
							}
						</ul>
						<div class="mt-6 border-t border-[var(--Border)] pt-4">
							<a
								href="https://github.com/CodeEditorLand"
								target="_blank"
								rel="noopener noreferrer"
								class="text-sm font-medium text-[var(--Primary)] hover:underline">
								{
									T("common.docs.repositories.viewAll", {
										defaultValue: "View all repositories",
									})
								}
								<span class="InlineSeparator">↗</span>
							</a>
						</div>
					</div>
				</section>

				<!-- Backend Services (Cloudflare Workers) -->
				<section class="mt-12">
					<h2 class="mb-6 text-2xl font-semibold">
						{
							T("common.docs.workers.heading", {
								defaultValue: "Backend Services",
							})
						}
					</h2>
					<div
						class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
						<p class="mb-4 text-muted-foreground">
							{
								T("common.docs.workers.intro", {
									defaultValue:
										"Five Cloudflare Workers power the Land backend infrastructure:",
								})
							}
						</p>
						<ul class="space-y-3 text-sm">
							<li>
								<span class="font-semibold">Auth</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.auth", {
											defaultValue:
												"OAuth 2.0, JWT session tokens, and Auth0 integration",
										})
									}
								</span>
							</li>
							<li>
								<span class="font-semibold">Download</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.download", {
											defaultValue:
												"Binary distribution, release metadata, and update checks",
										})
									}
								</span>
							</li>
							<li>
								<span class="font-semibold">Status</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.status", {
											defaultValue:
												"Health checks and uptime monitoring",
										})
									}
								</span>
							</li>
							<li>
								<span class="font-semibold">Analytics</span>
								<span class="text-muted-foreground">
									{" - "}
									{
										T("common.docs.workers.analytics", {
											defaultValue:
												"Back to top",
										})
									}
								</span>
							</li>
						</ul>
					</div>
				</section>

				<!-- Back to top -->
				<div class="mt-12 border-t pt-8">
					<a
						href="#top"
						class="StaccatoButton text-sm text-primary hover:underline"
						>{
							T("common.button.backToTop", {
								defaultValue: "Back to top",
							})
						}<span class="InlineSeparator">↑</span></a
					>
				</div>
			</main>
		</div>
	</div>
</Base>
