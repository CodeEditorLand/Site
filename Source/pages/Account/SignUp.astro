---
import Auth0Account from "../../Component/Dynamic/Auth0Account";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.account.signUp", {
	defaultValue: "Registration Coming Soon - Code Editor Land",
});
const MetaDescription = T("account.signUp.subtitle", {
	defaultValue:
		"Account creation is not open yet while the portal flow is being finished.",
});

const { Auth0Domain, Auth0ClientIdentifier } =
	await import("../../Function/Configuration/Auth.js");

/* Registration is closed, so this page's honest state is a report, not a
   form. The island decides that (RegistrationEnabled) and renders the report
   with its own heading, sentence and action - the page adds none above it, and
   mounts no site header: the baseline's `<body>` on this route is the skip
   link, the island and the footer. */
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Auth0Account
		client:only="react"
		Route="signup"
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>
</Base>
