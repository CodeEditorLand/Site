---
import AuthShell from "../../Component/Auth/AuthShell.astro";
import { AccountContent } from "../../Component/Auth/Content";
import { AuthFrameFor } from "../../Component/Auth/Data";
import { AccountPage } from "../../Component/Dynamic/AccountPage";
import { Header } from "../../Component/Layout/Header";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

/* The four form content tables live in Component/Auth/Content.ts - both
   account pages import the same object instead of retyping it. */
const Account = AccountContent(T);

const MetaTitle = T("meta.account.forgotPassword", {
	defaultValue: "Forgot Password - Code Editor Land",
});
const MetaDescription = T("account.forgotPassword.subtitle", {
	defaultValue:
		"Enter your email and we'll send a secure reset link to your inbox.",
});

const Frame = AuthFrameFor("forgotPassword", T);
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load Mode="functional" />
	<AuthShell frame={Frame}>
		<AccountPage
			Content={Account}
			Route="forgot-password"
			MetaTitle={MetaTitle}
			MetaDescription={MetaDescription}
		/>
	</AuthShell>
</Base>
