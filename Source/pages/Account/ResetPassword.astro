---
import AuthShell from "../../Component/Auth/AuthShell.astro";
import { AccountContent } from "../../Component/Auth/Content";
import { AuthFrameFor } from "../../Component/Auth/Data";
import { AccountPage } from "../../Component/Dynamic/AccountPage";
import { Header } from "../../Component/Layout/Header";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const Account = AccountContent(T);

const Token = Astro.url.searchParams.get("token");

const MetaTitle = T("meta.account.resetPassword", {
	defaultValue: "Reset Password - Code Editor Land",
});
const MetaDescription = T("account.resetPassword.subtitle", {
	defaultValue: "Enter your new password below",
});

/* The frame supplies the page's `h1`, the kicker and the one alternate action.
   Its sentence is deliberately not carried: the card prints the same sentence
   under its own title, and one fact printed twice is not two facts. */
const { kicker, heading, action } = AuthFrameFor("resetPassword", T);

const Frame = { kicker, heading, ...(action ? { action } : {}) };
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load Mode="functional" slot="Header" />
	<AuthShell Label="Reset password" Center Frame={Frame}>
		<AccountPage
			Content={Account}
			Route="reset-password"
			{...Token ? { ResetToken: Token } : {}}
			MetaTitle={MetaTitle}
			MetaDescription={MetaDescription}
		/>
	</AuthShell>
</Base>
