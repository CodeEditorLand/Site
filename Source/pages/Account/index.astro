---
import { AccountCrumbs } from "../../Component/Auth/Data";
import DynamicAccountProfile from "../../Component/Dynamic/DynamicAccountProfile";
import DynamicAuthHeader from "../../Component/Dynamic/DynamicAuthHeader";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const { Auth0Domain, Auth0ClientIdentifier } =
	await import("../../Function/Configuration/Auth.js");

const MetaTitle = T("meta.account.title", {
	defaultValue: "Account | Code Editor Land",
});

const MetaDescription = T("meta.account.description", {
	defaultValue: "Manage your Code Editor Land account and profile.",
});

/* The baseline's only visible copy on this route is the breadcrumb: the page
   itself is a loading state until the profile island answers, and it carries
   no heading, no card and no sentence of its own. */
const Crumbs = AccountCrumbs(T);
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<DynamicAuthHeader
		client:load
		slot="Header"
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>

	<div class="container mx-auto max-w-5xl px-4">
		<nav aria-label="Breadcrumb" class="pt-6">
			<ol class="flex flex-wrap items-center space-x-2 text-muted-foreground">
				{
					Crumbs.map(({ Label, Href }, Index) => (
						<>
							<li>
								{Href ? (
									<a class="transition-colors hover:text-foreground" href={Href}>
										{Label}
									</a>
								) : (
									<span class="font-medium text-foreground">{Label}</span>
								)}
							</li>
							{Index < Crumbs.length - 1 && <li class="mx-2">/</li>}
						</>
					))
				}
			</ol>
		</nav>
	</div>

	<DynamicAccountProfile
		client:load
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>
</Base>
