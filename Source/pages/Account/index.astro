---
import AuthShell from "../../Component/Auth/AuthShell.astro";
import { AccountCrumbs, AuthFrameFor } from "../../Component/Auth/Data";
import DynamicAccountProfile from "../../Component/Dynamic/DynamicAccountProfile";
import DynamicAuthHeader from "../../Component/Dynamic/DynamicAuthHeader";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const { Auth0Domain, Auth0ClientIdentifier } =
	await import("../../Function/Configuration/Auth.js");

const MetaTitle = T("meta.account.title", {
	defaultValue: "Account | Code Editor Land",
});

const MetaDescription = T("meta.account.description", {
	defaultValue: "Manage your Code Editor Land account and profile.",
});

/* The profile surface is a field table, not a form, so this is the one route
   that asks the shell for the wide measure. Reported on the card. */
const Frame = AuthFrameFor("account", T);

const Crumbs = AccountCrumbs(T);
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<DynamicAuthHeader
		client:load
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>

	<AuthShell frame={Frame} measure="wide">
		<nav class="auth-shell__crumbs" aria-label="Breadcrumb">
			<ol class="auth-shell__crumb-list">
				{
					Crumbs.map(({ Label, Href }, Index) => (
						<li class="auth-shell__crumb">
							{Href ? (
								<a class="auth-shell__crumb-link" href={Href}>
									{Label}
								</a>
							) : (
								<span
									class="auth-shell__crumb-current"
									aria-current="page"
								>
									{Label}
								</span>
							)}
							{Index < Crumbs.length - 1 && (
								<span
									class="auth-shell__crumb-separator"
									aria-hidden="true"
								>
									/
								</span>
							)}
						</li>
					))
				}
			</ol>
		</nav>

		<DynamicAccountProfile
			client:load
			Domain={Auth0Domain}
			ClientIdentifier={Auth0ClientIdentifier}
		/>
	</AuthShell>
</Base>
