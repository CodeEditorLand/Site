---
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.contributing.title", {
	defaultValue: "Contributing | Code Editor Land",
});

const MetaDescription = T("meta.contributing.description", {
	defaultValue:
		"An open source code editor built with Rust and TypeScript. Learn how to contribute to Code Editor Land.",
});
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url="https://editor.land/contributing"
	lang="en">
	<Header client:load />

	<div class="container mx-auto max-w-4xl px-4 py-16">
		<!-- Breadcrumbs -->
		<nav aria-label="Breadcrumb" class="mb-8">
			<ol
				class="flex flex-wrap items-center space-x-2 text-sm text-muted-foreground">
				<li>
					<a href="/" class="transition-colors hover:text-foreground"
						>{
							T("common.breadcrumb.home", {
								defaultValue: "Home",
							})
						}</a
					>
				</li>
				<li class="mx-2">/</li>
				<li>
					<span class="font-medium text-foreground"
						>{
							T("common.contributing.pageTitle", {
								defaultValue: "Contributing",
							})
						}</span
					>
				</li>
			</ol>
		</nav>

		<!-- Page Header -->
		<header class="mb-12">
			<h1 class="mb-4 text-4xl font-bold tracking-tight">
				{
					T("common.contributing.pageTitle", {
						defaultValue: "Contributing",
					})
				}
			</h1>
			<p class="text-lg text-muted-foreground">
				{
					T("common.contributing.pageSubtitle", {
						defaultValue:
							"Code Editor Land is open source and welcomes contributions from everyone. Here is how to get involved.",
					})
				}
			</p>
		</header>

		<!-- Quick Links -->
		<section class="mb-12">
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				<a
					href="https://github.com/CodeEditorLand/Land/blob/Current/CONTRIBUTING.md"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
					<h2 class="mb-2 text-xl font-semibold">
						{
							T("common.contributing.guide.title", {
								defaultValue: "Contributing Guide",
							})
						}<span class="InlineSeparator">→</span>
					</h2>
					<p class="text-sm text-muted-foreground">
						{
							T("common.contributing.guide.description", {
								defaultValue:
									"Read the full CONTRIBUTING.md on GitHub for detailed instructions on setting up the development environment and submitting changes.",
							})
						}
					</p>
				</a>

				<a
					href="https://github.com/CodeEditorLand/Land/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoCard StaccatoBorderShimmer block border border-[var(--Border)] bg-white p-6 transition-colors hover:bg-[var(--Secondary)] focus:outline-2 focus:outline-offset-2 focus:outline-[var(--Primary)]">
					<h2 class="mb-2 text-xl font-semibold">
						{
							T("common.contributing.goodFirstIssues.title", {
								defaultValue: "Good First Issues",
							})
						}<span class="InlineSeparator">→</span>
					</h2>
					<p class="text-sm text-muted-foreground">
						{
							T(
								"common.contributing.goodFirstIssues.description",
								{
									defaultValue:
										'Browse issues labeled "good first issue" to find approachable tasks for new contributors.',
								},
							)
						}
					</p>
				</a>
			</div>
		</section>

		<!-- How to Contribute -->
		<section class="mb-12">
			<h2 class="mb-6 text-2xl font-semibold">
				{
					T("common.contributing.howToContribute.heading", {
						defaultValue: "How to Contribute",
					})
				}
			</h2>
			<div
				class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
				<ol class="space-y-6">
					<li class="flex items-start gap-4">
						<span
							class="flex h-8 w-8 shrink-0 items-center justify-center border border-[var(--Border)] bg-[var(--Secondary)] text-sm font-semibold"
							>1</span
						>
						<div>
							<h3 class="font-semibold">
								{
									T("common.contributing.step1.title", {
										defaultValue: "Fork and Clone",
									})
								}
							</h3>
							<p class="mt-1 text-sm text-muted-foreground">
								{
									T("common.contributing.step1.description", {
										defaultValue:
											"Fork the Land repository on GitHub and clone it locally with submodules:",
									})
								}
							</p>
							<pre
								class="mt-2 overflow-x-auto border border-[var(--Border)] bg-[var(--Mute)] p-3 font-mono text-xs">git clone --recurse-submodules https://github.com/YOUR_USERNAME/Land.git</pre>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span
							class="flex h-8 w-8 shrink-0 items-center justify-center border border-[var(--Border)] bg-[var(--Secondary)] text-sm font-semibold"
							>2</span
						>
						<div>
							<h3 class="font-semibold">
								{
									T("common.contributing.step2.title", {
										defaultValue: "Set Up the Environment",
									})
								}
							</h3>
							<p class="mt-1 text-sm text-muted-foreground">
								{
									T("common.contributing.step2.description", {
										defaultValue:
											"Install Rust (1.95.0+), Node.js, and pnpm. Then run:",
									})
								}
							</p>
							<pre
								class="mt-2 overflow-x-auto border border-[var(--Border)] bg-[var(--Mute)] p-3 font-mono text-xs">cd Land && pnpm install && cargo build</pre>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span
							class="flex h-8 w-8 shrink-0 items-center justify-center border border-[var(--Border)] bg-[var(--Secondary)] text-sm font-semibold"
							>3</span
						>
						<div>
							<h3 class="font-semibold">
								{
									T("common.contributing.step3.title", {
										defaultValue: "Make Your Changes",
									})
								}
							</h3>
							<p class="mt-1 text-sm text-muted-foreground">
								{
									T("common.contributing.step3.description", {
										defaultValue:
											"Create a new branch, make your changes, and follow the PascalCase naming convention used throughout the project.",
									})
								}
							</p>
						</div>
					</li>
					<li class="flex items-start gap-4">
						<span
							class="flex h-8 w-8 shrink-0 items-center justify-center border border-[var(--Border)] bg-[var(--Secondary)] text-sm font-semibold"
							>4</span
						>
						<div>
							<h3 class="font-semibold">
								{
									T("common.contributing.step4.title", {
										defaultValue: "Submit a Pull Request",
									})
								}
							</h3>
							<p class="mt-1 text-sm text-muted-foreground">
								{
									T("common.contributing.step4.description", {
										defaultValue:
											"Push your branch and open a pull request against the Current branch. Describe what you changed and why.",
									})
								}
							</p>
						</div>
					</li>
				</ol>
			</div>
		</section>

		<!-- Ways to Contribute -->
		<section class="mb-12">
			<h2 class="mb-6 text-2xl font-semibold">
				{
					T("common.contributing.ways.heading", {
						defaultValue: "Ways to Contribute",
					})
				}
			</h2>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<div
					class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-5">
					<h3 class="mb-2 font-semibold">
						{
							T("common.contributing.ways.code.title", {
								defaultValue: "Code",
							})
						}
					</h3>
					<p class="text-sm text-muted-foreground">
						{
							T("common.contributing.ways.code.description", {
								defaultValue:
									"Fix bugs, implement features, or improve performance in Rust or TypeScript.",
							})
						}
					</p>
				</div>
				<div
					class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-5">
					<h3 class="mb-2 font-semibold">
						{
							T("common.contributing.ways.documentation.title", {
								defaultValue: "Documentation",
							})
						}
					</h3>
					<p class="text-sm text-muted-foreground">
						{
							T(
								"common.contributing.ways.documentation.description",
								{
									defaultValue:
										"Improve guides, add examples, or translate existing documentation to other languages.",
								},
							)
						}
					</p>
				</div>
				<div
					class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-5">
					<h3 class="mb-2 font-semibold">
						{
							T("common.contributing.ways.testing.title", {
								defaultValue: "Testing",
							})
						}
					</h3>
					<p class="text-sm text-muted-foreground">
						{
							T("common.contributing.ways.testing.description", {
								defaultValue:
									"Write tests, report bugs, or help reproduce and triage existing issues.",
							})
						}
					</p>
				</div>
				<div
					class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-5">
					<h3 class="mb-2 font-semibold">
						{
							T("common.contributing.ways.design.title", {
								defaultValue: "Design",
							})
						}
					</h3>
					<p class="text-sm text-muted-foreground">
						{
							T("common.contributing.ways.design.description", {
								defaultValue:
									"Contribute UI/UX improvements, icons, or visual design work for the editor or website.",
							})
						}
					</p>
				</div>
			</div>
		</section>

		<!-- Funding -->
		<section class="mb-12">
			<h2 class="mb-6 text-2xl font-semibold">
				{
					T("common.contributing.funding.heading", {
						defaultValue: "Funding",
					})
				}
			</h2>
			<div
				class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
				<div class="mb-4 flex flex-wrap gap-x-4 gap-y-1">
					<a
						href="https://nlnet.nl/project/Land/"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-[var(--Primary)] hover:underline">
						NLnet Project Page
					</a>
					<a
						href="https://nlnet.nl/commonsfund"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-[var(--Primary)] hover:underline">
						NGI0 Commons Fund
					</a>
					<a
						href="https://nlnet.nl"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-[var(--Primary)] hover:underline">
						NLnet
					</a>
				</div>
				<p class="mb-4 text-muted-foreground">
					{
						T("common.contributing.funding.nlnetIntro", {
							defaultValue:
								"Code Editor Land has been funded through the NGI0 Commons Fund, a fund established by NLnet with financial support from the European Commission's Next Generation Internet programme, under grant agreement No.\u00a0101135429. This funding enables sustained open-source development on the project.",
						})
					}
				</p>
				<p class="text-muted-foreground">
					{
						T("common.contributing.funding.playformInfo", {
							defaultValue:
								"The project is operated by PlayForm, a company based in Sofia, Bulgaria. PlayForm acts as the open-source steward for Code Editor Land under the NGI0 Commons Fund grant.",
						})
					}
				</p>
			</div>
		</section>

		<!-- Code of Conduct -->
		<section class="mb-12">
			<h2 class="mb-6 text-2xl font-semibold">
				{
					T("common.contributing.conduct.heading", {
						defaultValue: "Code of Conduct",
					})
				}
			</h2>
			<div
				class="StaccatoCard StaccatoBorderShimmer border border-[var(--Border)] bg-white p-6">
				<a
					href="https://github.com/CodeEditorLand/Land/blob/Current/CODE_OF_CONDUCT.md"
					target="_blank"
					rel="noopener noreferrer"
					class="StaccatoButton font-medium text-[var(--Primary)] hover:underline"
					>Code of Conduct<span class="InlineSeparator">→</span></a
				>
				<p class="mt-2 text-muted-foreground">
					{
						T("common.contributing.conduct.description", {
							defaultValue:
								"All participants in the Code Editor Land community are expected to be respectful and constructive.",
						})
					}
				</p>
			</div>
		</section>

		<!-- Back to top -->
		<div class="mt-12 border-t pt-8">
			<a
				href="#top"
				class="StaccatoButton text-sm text-primary hover:underline"
				>{
					T("common.button.backToTop", {
						defaultValue: "Back to top",
					})
				}<span class="InlineSeparator">↑</span></a
			>
		</div>
	</div>
</Base>
