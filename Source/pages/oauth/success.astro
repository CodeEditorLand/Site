---
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.oauth.success", {
	defaultValue: "Authentication Successful - Land",
});
const MetaDescription = T("meta.oauth.successDescription", {
	defaultValue: "You have been authenticated successfully.",
});
---

<Base Title={MetaTitle} Description={MetaDescription} noIndex={true}>
	<section class="flex min-h-screen items-center justify-center py-20">
		<div class="container mx-auto px-4">
			<div class="mx-auto max-w-md text-center">
				<div class="rounded-none border border-[var(--border)] p-8">
					<div
						id="LoadingState"
						class="flex flex-col items-center gap-4">
						<div
							class="h-8 w-8 animate-spin rounded-full border-2 border-current border-t-transparent">
						</div>
						<p class="text-muted-foreground">
							{"Completing authentication..."}
						</p>
					</div>
					<div id="ErrorState" class="hidden">
						<h1 class="mb-2 text-2xl font-bold">
							{"Authentication Failed"}
						</h1>
						<p id="ErrorMessage" class="mb-6 text-muted-foreground">
							{"An error occurred during authentication."}
						</p>
						<a
							href="/account/signin"
							class="inline-flex h-10 items-center justify-center gap-2 rounded-none border border-[var(--border)] bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-all hover:bg-primary">
							{"Back to Sign In"}
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	function HandleOAuthSuccess(): void {
		const SearchParameters = new URLSearchParams(window.location.search);
		const Token = SearchParameters.get("token");
		const ErrorParameter = SearchParameters.get("error");

		const LoadingState = document.getElementById("LoadingState");
		const ErrorState = document.getElementById("ErrorState");
		const ErrorMessage = document.getElementById("ErrorMessage");

		if (ErrorParameter || !Token) {
			if (LoadingState) LoadingState.classList.add("hidden");
			if (ErrorState) ErrorState.classList.remove("hidden");
			if (ErrorMessage) {
				ErrorMessage.textContent =
					ErrorParameter === "invalid_state"
						? "Authentication session expired. Please try again."
						: ErrorParameter === "oauth_failed"
							? "OAuth provider returned an error. Please try again."
							: "No authentication token received.";
			}
			return;
		}

		// Store token in cookie and localStorage
		try {
			document.cookie = `session=${Token}; path=/; max-age=${7 * 24 * 60 * 60}; SameSite=Strict`;
		} catch {
			// Cookie API not available
		}
		localStorage.setItem("session_token", Token);

		// Redirect to home
		window.location.href = "/";
	}

	HandleOAuthSuccess();
</script>
