---
import DynamicAuthHeader from "../Component/Dynamic/DynamicAuthHeader";
import DynamicDashboardUser from "../Component/Dynamic/DynamicDashboardUser";
import DynamicLocalFirstScan from "../Component/Dynamic/DynamicLocalFirstScan";
import PrivacyRequests from "../Component/Dashboard/PrivacyRequests.astro";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";
import RecordBand from "../Component/Record/RecordBand.astro";
import RecordEntry from "../Component/Record/RecordEntry.astro";
import RecordLedger from "../Component/Record/RecordLedger.astro";
import RecordStage from "../Component/Record/RecordStage.astro";
import SurfaceShell from "../Component/Surface/SurfaceShell.astro";
import { DashboardPage } from "../Content/Surface/Dashboard.js";

const T = GetI18n();

const { Auth0Domain, Auth0ClientIdentifier } =
	await import("../Function/Configuration/Auth.js");

const IsLocalMode = Astro.url.searchParams.get("mode") === "local";

const MetaTitle = T("meta.dashboard.title", {
	defaultValue: "Dashboard | Code Editor Land",
});

const MetaDescription = T("meta.dashboard.description", {
	defaultValue:
		"Manage your account, downloads, and settings.\nYour Code Editor Land dashboard.",
});

// Every label, row and band this page states comes from this table. The two
// Auth0 islands stay islands: who is signed in is client-side state, so the
// account band hosts the component rather than printing a value it cannot
// know at render time.
const Page = DashboardPage(T);

/**
 * The dashboard's status chips, as Jelly badges again.
 *
 * `Page.*.chips` are the page's own labels - `Disabled`, `Feature Gated`,
 * `Optional`, `Active`, `Coming Soon` - and the pre-programme dashboard printed
 * exactly those labels as `jelly-badge`. The rebuild turned them into a plain
 * `<li>` row; `jelly-badge` is a design-system element, so it comes back.
 *
 * One tone, not one ink per chip: these are state chips, not protocol chips, so
 * they take the neutral mute fill and its muted ink rather than a spine ink
 * (`DesignSystem.md` §3 - the protocol spine is for protocol chips).
 */
const ChipStyle =
	"--jelly-fill:var(--Mute);--jelly-label:var(--MuteForeground);--jelly-badge-radius:0;--jelly-badge-font-size:13px";

/**
 * The card the islands sit on. `jelly-card` is the design system's surface and
 * a `Record*` block may live inside one but never replace one
 * (`DESIGN.md` §1.7); an Auth0 island is functional UI, so it gets the surface
 * and the records keep theirs.
 */
const CardStyle =
	"--jelly-fill:var(--Card);--jelly-radius:0;--jelly-card-font-size:inherit;--jelly-card-padding-block:var(--space-group);--jelly-card-padding-inline:var(--space-group)";
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en"
>
	<DynamicAuthHeader
		client:load
		slot="Header"
		Domain={Auth0Domain}
		ClientIdentifier={Auth0ClientIdentifier}
	/>

	<SurfaceShell
		index={Page.index}
		title={Page.title}
		standfirst={Page.standfirst}
		rows={Page.status}
	>
		<RecordBand band={Page.account}>
			<div class="surface__panel">
				<jelly-card style={CardStyle}>
					<DynamicDashboardUser
						client:load
						Domain={Auth0Domain}
						ClientIdentifier={Auth0ClientIdentifier}
					/>
				</jelly-card>
			</div>
		</RecordBand>

		<RecordBand band={Page.access}>
			<RecordStage stages={Page.accessStages} />
		</RecordBand>

		<RecordBand band={Page.data}>
			<div class="surface__panel">
				<jelly-card style={CardStyle}>
					<PrivacyRequests />
				</jelly-card>
			</div>
		</RecordBand>

		<RecordBand band={Page.build}>
			<RecordLedger rows={Page.buildFacts} columns={2} />
		</RecordBand>

		<RecordBand band={Page.telemetry}>
			<div class="surface__stack">
				{
					Page.telemetryPaths.map((Path) => (
						<div>
							{Path.chips?.length ? (
								<ul class="mb-3 flex list-none flex-wrap gap-2 p-0">
									{Path.chips.map((Chip) => (
										<li>
											<jelly-badge
												shape="square"
												variant="platinum"
												style={ChipStyle}
											>
												{Chip}
											</jelly-badge>
										</li>
									))}
								</ul>
							) : null}
							<RecordEntry {...Path} chips={undefined} />
						</div>
					))
				}
			</div>
		</RecordBand>

		<RecordBand band={Page.editor}>
			{
				IsLocalMode ? (
					<div class="surface__panel">
						<jelly-card style={CardStyle}>
							<DynamicLocalFirstScan
								client:load
								Domain={Auth0Domain}
								ClientIdentifier={Auth0ClientIdentifier}
							/>
						</jelly-card>
					</div>
				) : (
					<>
						<RecordLedger rows={Page.editorFacts} />
						<div class="surface__stack">
							{Page.editorDescription.map((Line) => (
								<p class="surface__prose">{Line}</p>
							))}
							{Page.editorActions.map((Action) => (
								<RecordEntry {...Action} />
							))}
						</div>
					</>
				)
			}
		</RecordBand>

		<RecordBand band={Page.settings}>
			<div class="surface__stack">
				{
					Page.settingsEntries.map((Setting) => (
						<div>
							{Setting.chips?.length ? (
								<ul class="mb-3 flex list-none flex-wrap gap-2 p-0">
									{Setting.chips.map((Chip) => (
										<li>
											<jelly-badge
												shape="square"
												variant="platinum"
												style={ChipStyle}
											>
												{Chip}
											</jelly-badge>
										</li>
									))}
								</ul>
							) : null}
							<RecordEntry {...Setting} chips={undefined} />
						</div>
					))
				}
			</div>
		</RecordBand>

		<RecordBand band={Page.start}>
			<div class="surface__stack">
				{
					Page.startEntries.map((Exit) => (
						<RecordEntry {...Exit} />
					))
				}
			</div>
		</RecordBand>

		<RecordBand band={Page.partners}>
			<div class="surface__stack">
				{
					Page.partnersEntries.map((Partner) => (
						<RecordEntry {...Partner} />
					))
				}
			</div>
		</RecordBand>
	</SurfaceShell>
</Base>
