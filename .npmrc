auto-install-peers=true
hoist=true
legacy-peer-deps=true
link-workspace-packages=deep
node-linker=isolated
node_options=--max-old-space-size=32768
prefer-frozen-lockfile=false
prefer-workspace-packages=true
shamefully-hoist=true
shared-workspace-lockfile=true
strict-peer-dependencies=false
unsafe-perm=true
use-beta-cli=true
minimum-release-age=0

# pnpm v11 requires explicit approval for dependency build scripts
# These are needed by the WebSite build on Cloudflare Pages
only-built-dependencies[]=@firebase/util
only-built-dependencies[]=@parcel/watcher
only-built-dependencies[]=browser-tabs-lock
only-built-dependencies[]=esbuild
only-built-dependencies[]=protobufjs
only-built-dependencies[]=sharp